# DisplayXR Browser — Android (arm64) chrome_public_apk build args.
# Written into $CHROMIUM_SRC/out/$OUT_DIR/args.gn by scripts/build.sh when
# DXR_TARGET_OS=android. The Linux twin of args.official.gn — keep the two in step.
target_os = "android"             # Chromium's Android build is LINUX-ONLY; the Windows box cannot do it
target_cpu = "arm64"              # NP02J and every DisplayXR 3D Android panel are arm64
is_official_build = true
is_component_build = false        # static — the inline-3D weave links into the APK, not a viz .so
is_debug = false
chrome_pgo_phase = 0              # no local PGO profile on a self-hosted box → must disable or gen fails
use_remoteexec = false            # no Google RBE on a self-hosted box
symbol_level = 1
blink_symbol_level = 0
dcheck_always_on = false
# Android-specific, and why:
#   The APK is signed with Chromium's checked-in DEBUG key (build/android/chromium-debug.keystore).
#   That is deliberate for the preview — a release keystore + apksigner step is deferred and lands
#   with branding (docs/android-port.md § Build lane). Nothing below overrides the signing config.
#
# NOT set, deliberately:
#   * android_channel / is_java_debug — default (dev/debug java) keeps the debug-key path intact.
#   * ffmpeg_branding / proprietary_codecs — same scope call as the Windows lane; a preview decision,
#     not an Android one. Turn both on in BOTH files or neither.
#   * android_static_analysis — left at its default; disabling it hides real R8/lint breakage, and
#     docs/android-pitfalls.md's R8/JNI items are exactly what it catches.
