# DisplayXR Browser build configuration — sourced by every script in this dir.
# The single source of truth for the pinned Chromium milestone. Bump this on each
# monthly rebase (see docs/rebase-runbook.md), regenerate patches/, re-verify.

# Pinned Chromium *stable* milestone tag (chromiumdash). The patch series in
# patches/ is generated against exactly this tag.
#
# ONE PIN FOR BOTH LANES. The Android lane reads the tag from HERE and nowhere else —
# there is deliberately no CHROMIUM_TAG_ANDROID. Two pins would let the APK and the .exe
# ship different Chromium milestones from the same patch series.
CHROMIUM_TAG="${CHROMIUM_TAG:-151.0.7922.174}"

# Which lane is being built: "win" (the shipping Windows chrome.exe) or "android"
# (chrome_public_apk on the EC2 Linux builder). Everything platform-shaped below
# switches on this ONE variable; a caller that never sets it gets the historical
# Windows behaviour byte-for-byte.
DXR_TARGET_OS="${DXR_TARGET_OS:-win}"

if [ "$DXR_TARGET_OS" = "android" ]; then
  # ── Android / Linux lane ────────────────────────────────────────────────────────
  # Staged under /opt/build on the EC2 Linux builder (the checklist in
  # docs/oidc-build-lane.md — "/opt/build/ or ~builder/", never C:\build\). Every one of
  # these is an env override, so a box whose checkout lives elsewhere sets CHROMIUM_SRC
  # in the workflow rather than editing this file.
  DXR_BUILD_ROOT="${DXR_BUILD_ROOT:-/opt/build}"
  CHROMIUM_SRC="${CHROMIUM_SRC:-$DXR_BUILD_ROOT/cr/src}"
  DEPOT_TOOLS="${DEPOT_TOOLS:-$DXR_BUILD_ROOT/depot_tools}"
  OUT_DIR="${OUT_DIR:-Android}"
  GN_ARGS_FILE="${GN_ARGS_FILE:-args.android.gn}"
  # chrome_public_apk, NOT chrome: the Android product is an APK. Its output lands at
  # out/$OUT_DIR/apks/ChromePublic.apk.
  NINJA_TARGET="${NINJA_TARGET:-chrome_public_apk}"
  APK_NAME="${APK_NAME:-ChromePublic.apk}"
else
  # ── Windows lane (unchanged — do not "tidy" these) ──────────────────────────────
  # Local Chromium checkout (the src/ dir that holds .gn, chrome/, out/).
  # NB: the AWS build box uses C:/cr/src — verified from a CI run, not assumed. The
  # old C:/src/chromium/src default was stale and had gone unnoticed because every
  # caller on the box overrides it. Keep the default matching the box we actually
  # build on; a local checkout elsewhere sets CHROMIUM_SRC in the environment.
  CHROMIUM_SRC="${CHROMIUM_SRC:-C:/cr/src}"

  # depot_tools install (autoninja/gn/gclient live here). Must be on PATH for a build.
  DEPOT_TOOLS="${DEPOT_TOOLS:-C:/src/depot_tools}"

  # Build output dir under $CHROMIUM_SRC/out. Official static distributable build.
  OUT_DIR="${OUT_DIR:-Official}"

  GN_ARGS_FILE="${GN_ARGS_FILE:-args.official.gn}"
  NINJA_TARGET="${NINJA_TARGET:-chrome}"
fi

# No Google RBE and no Win toolchain download on a self-hosted box.
export DEPOT_TOOLS_WIN_TOOLCHAIN=0
