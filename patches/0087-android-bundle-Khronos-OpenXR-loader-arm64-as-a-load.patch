From 7bb5475174941c77ff9b326433a228d55e0b8e3d Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Thu, 20 Aug 2026 12:10:14 +0000
Subject: [PATCH] android: bundle Khronos OpenXR loader (arm64) as a loadable
 module
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

displayxr_weave_client_android.cc dlopen()s "libopenxr_loader.so" by
soname and fails soft if it's absent. Bundle the official Khronos
loader (org.khronos.openxr:openxr_loader_for_android:1.1.62, arm64-v8a
slice only, sha256
50d699172cac4b5dabe0b02bc2a478d49073411778c11eead1dd0d605211da1e) as a
checked-in prebuilt under components/displayxr/android/prebuilt/, and
wire it into chrome_public_apk as a loadable_module gated on
target_cpu == "arm64", following the same lib*.so-copy trick used for
//third_party/crashpad/crashpad/handler:crashpad_handler_named_as_so.

The DisplayXR runtime .so itself is deliberately NOT bundled — it's
still resolved at run time via the device's installed OpenXR runtime
(loader discovery). Only the loader ships in the APK.

Verified lib/arm64-v8a/libopenxr_loader.so is packaged in
out/Android/apks/ChromePublic.apk after a chrome_public_apk rebuild.

Folded in from the device bring-up loop: the runtime broker's PACKAGE
VISIBILITY. Android 11 (R) gates ContentProvider resolution, and the Khronos
loader discovers the installed runtime by querying the
org.khronos.openxr.runtime_broker provider — without a <queries> entry that
provider is invisible and discovery silently finds no runtime, even with
DisplayXR installed. The entry mirrors the DisplayXR reference weave client's
(test_apps/weave/weave_client_vk_android) and is unconditional: the runtime
lookup is not tied to the enable_vr / channel==default gate that guards the
existing ARCore/GVR queries block.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 chrome/android/BUILD.gn                       |  12 +++++++++++
 chrome/android/java/AndroidManifest.xml       |  20 ++++++++++++++++++
 components/displayxr/android/BUILD.gn         |  15 +++++++++++++
 .../prebuilt/arm64-v8a/README.displayxr       |  20 ++++++++++++++++++
 .../prebuilt/arm64-v8a/libopenxr_loader.so    | Bin 0 -> 1662344 bytes
 5 files changed, 67 insertions(+)
 create mode 100644 components/displayxr/android/prebuilt/arm64-v8a/README.displayxr
 create mode 100644 components/displayxr/android/prebuilt/arm64-v8a/libopenxr_loader.so

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 0746ff7c773b4..d878cfb91b1de 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -2096,6 +2096,18 @@ if (_is_default_toolchain) {
     enable_lint = true
     lint_baseline_file = "expectations/lint-baseline.xml"
     lint_suppressions_file = "expectations/lint-suppressions.xml"
+
+    # DisplayXR (runtime #1056): bundle the Khronos OpenXR loader so the
+    # Android weave client can dlopen("libopenxr_loader.so") without relying
+    # on it being present elsewhere on the device. arm64 only — that's the
+    # only ABI DisplayXR ships a prebuilt loader for; see
+    # //components/displayxr/android/prebuilt/arm64-v8a/README.displayxr.
+    # The DisplayXR runtime .so itself is intentionally NOT bundled here —
+    # it's resolved at run time via the device's installed OpenXR runtime.
+    if (target_cpu == "arm64") {
+      deps = [ "//components/displayxr/android:openxr_loader_prebuilt" ]
+      loadable_modules = [ "$root_out_dir/libopenxr_loader.so" ]
+    }
   }
 
   chrome_public_bundle("chrome_public_bundle") {
diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index f8574cef5cb32..cf1e7d433317b 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -204,6 +204,26 @@ by a child template that "extends" this file.
       </queries>
     {% endif %}
 
+    <!--
+      DisplayXR inline-3D (XR_DXR_weave). Android 11 (R) package visibility also
+      gates ContentProvider resolution, and the Khronos OpenXR loader finds the
+      installed runtime by querying the org.khronos.openxr.runtime_broker
+      provider. Without these entries xrInitializeLoaderKHR / runtime discovery
+      silently sees no runtime and inline-3D stays dormant. Same set as the
+      DisplayXR reference weave client.
+    -->
+    <queries>
+      <intent>
+        <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
+      </intent>
+      <provider android:authorities="org.khronos.openxr.runtime_broker" />
+      <package android:name="org.freedesktop.monado.openxr_runtime.in_process" />
+      <package android:name="org.freedesktop.monado.openxr_runtime.out_of_process" />
+      <intent>
+        <action android:name="org.freedesktop.monado.ipc.CONNECT" />
+      </intent>
+    </queries>
+
     <!-- Set android:largeHeap to "true" to allow more than the default
          Java heap limit (32Mb on Nexus S, 48Mb on Xoom). -->
       <application android:name="{% block application_name %}org.chromium.chrome.browser.base.SplitChromeApplication{% endblock %}"
diff --git a/components/displayxr/android/BUILD.gn b/components/displayxr/android/BUILD.gn
index 25ddc613cc37d..fd099b3be1a93 100644
--- a/components/displayxr/android/BUILD.gn
+++ b/components/displayxr/android/BUILD.gn
@@ -35,3 +35,18 @@ source_set("android") {
     "//content/public/browser",
   ]
 }
+
+# Khronos OpenXR loader (arm64 only — matches Chrome's shipped Android arm64
+# target; see prebuilt/arm64-v8a/README.displayxr for version/provenance).
+# The runtime .so is deliberately NOT bundled — it's resolved at run time via
+# the device's installed OpenXR runtime (loader discovery); only the loader
+# itself ships in the APK. Copied under the lib*.so naming Android's APK
+# installer requires (same trick as
+# //third_party/crashpad/crashpad/handler:crashpad_handler_named_as_so), then
+# packaged as a chrome_public_apk loadable_module in chrome/android/BUILD.gn.
+if (target_cpu == "arm64") {
+  copy("openxr_loader_prebuilt") {
+    sources = [ "prebuilt/arm64-v8a/libopenxr_loader.so" ]
+    outputs = [ "$root_out_dir/libopenxr_loader.so" ]
+  }
+}
diff --git a/components/displayxr/android/prebuilt/arm64-v8a/README.displayxr b/components/displayxr/android/prebuilt/arm64-v8a/README.displayxr
new file mode 100644
index 0000000000000..41f86e5385584
--- /dev/null
+++ b/components/displayxr/android/prebuilt/arm64-v8a/README.displayxr
@@ -0,0 +1,20 @@
+Khronos OpenXR loader (arm64-v8a), bundled for the DisplayXR Android browser.
+
+Version:  1.1.62 (org.khronos.openxr:openxr_loader_for_android:1.1.62)
+Source:   https://repo.maven.apache.org/maven2/org/khronos/openxr/openxr_loader_for_android/1.1.62/openxr_loader_for_android-1.1.62.aar
+Extracted path within the AAR: prefab/modules/openxr_loader/libs/android.arm64-v8a/libopenxr_loader.so
+sha256:   50d699172cac4b5dabe0b02bc2a478d49073411778c11eead1dd0d605211da1e
+
+Only the arm64-v8a slice is bundled (matches Chrome's shipped Android arm64
+target); other ABI slices (armeabi-v7a, x86, x86_64) present in the AAR are
+NOT included.
+
+This is the loader ONLY. It resolves the runtime .so dynamically via the
+device's installed OpenXR runtime (loader discovery / active-runtime
+manifest) — the actual DisplayXR runtime .so is deliberately NOT bundled
+here; see components/displayxr/browser/displayxr_weave_client_android.cc,
+which dlopen()s "libopenxr_loader.so" by soname and fails soft if it's
+absent.
+
+To refresh: bump the version above, re-download the .aar from Maven
+Central, re-extract the same path, and update the sha256.
