 .../displayxr/common/displayxr_weave.mojom    | 17 ++++
 .../displayxr/gpu/displayxr_weave_gpu.cc      | 24 +++++
 .../displayxr_weave_provider.h                |  8 ++
 .../skia_output_surface_impl_on_gpu.cc        | 38 +++++++-
 .../skia_output_surface_impl_on_gpu.h         |  6 ++
