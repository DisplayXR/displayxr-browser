--- a/components/displayxr/browser/displayxr_service_impl.h
+++ b/components/displayxr/browser/displayxr_service_impl.h
@@ -11,6 +11,8 @@
 // forbids the weave RPC, so the client lives in the browser). Self-owned;
 // bound via the frame's BrowserInterfaceBroker, gated on --enable-inline-3d.
 
+#include <cstdint>
+
 #include "base/functional/callback.h"
 #include "content/public/browser/global_routing_id.h"
 #include "mojo/public/cpp/bindings/pending_receiver.h"
@@ -26,8 +28,19 @@ class DisplayXRServiceImpl : public blink::mojom::DisplayXRService {
   // foreground) and that lives in chrome/browser — a layer components/ must not
   // depend on. Unset in embedders that have no display-mode policy (content
   // shell), in which case demand reports are simply dropped.
+  //
+  // browser#90: |instance_id| identifies the PIPE, not the frame. A frame id is
+  // not unique over time — a same-RFH cross-document navigation gives the new
+  // document the very same GlobalRenderFrameHostId — and the old pipe's
+  // teardown retraction is unordered against the new pipe's first report.
+  // Without a generation token a late-arriving retraction erases the NEW
+  // document's demand, and since the renderer is edge-triggered it never
+  // re-reports: a 3D page stuck permanently in 2D. The sink must therefore
+  // honour a retraction only while the instance that made the claim is still
+  // the one holding it.
   using Inline3DDemandCallback =
       base::RepeatingCallback<void(content::GlobalRenderFrameHostId frame_id,
+                                   uint64_t instance_id,
                                    bool wants_3d)>;
   static void SetInline3DDemandCallback(Inline3DDemandCallback callback);
 
@@ -54,6 +67,11 @@ class DisplayXRServiceImpl : public blink::mojom::DisplayXRService {
   // the ID to a live RenderFrameHost at handling time or drops the report.
   const content::GlobalRenderFrameHostId frame_id_;
 
+  // browser#90: this pipe's generation, from a process-global counter. Unique
+  // for the life of the browser process, so it disambiguates two documents that
+  // share a frame id (see Inline3DDemandCallback).
+  const uint64_t instance_id_;
+
   // Last value handed to the embedder. The renderer is already edge-triggered;
   // this makes the browser side idempotent against a renderer that isn't (a
   // compromised one, or a future one that changes its mind about that).
