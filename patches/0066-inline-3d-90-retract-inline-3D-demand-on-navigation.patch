diff --git a/chrome/browser/displayxr/displayxr_display_mode_controller.cc b/chrome/browser/displayxr/displayxr_display_mode_controller.cc
index 7ec51559c10d0..c2843b6d4775f 100644
--- a/chrome/browser/displayxr/displayxr_display_mode_controller.cc
+++ b/chrome/browser/displayxr/displayxr_display_mode_controller.cc
@@ -4,7 +4,11 @@
 
 #include "chrome/browser/displayxr/displayxr_display_mode_controller.h"
 
+#include <memory>
+#include <utility>
+
 #include "base/command_line.h"
+#include "base/containers/flat_set.h"
 #include "base/functional/bind.h"
 #include "base/logging.h"
 #include "base/time/time.h"
@@ -42,6 +46,33 @@ content::WebContents* ActiveContents(BrowserWindowInterface* browser) {
 
 }  // namespace
 
+DisplayXRDisplayModeController::PageChangeObserver::PageChangeObserver(
+    content::WebContents* contents,
+    DisplayXRDisplayModeController* owner)
+    : content::WebContentsObserver(contents), owner_(owner) {}
+
+DisplayXRDisplayModeController::PageChangeObserver::~PageChangeObserver() =
+    default;
+
+void DisplayXRDisplayModeController::PageChangeObserver::PrimaryPageChanged(
+    content::Page& page) {
+  // browser#90: a new primary page owns this tab now. Whatever the old one
+  // claimed is either gone with it or parked in the back/forward cache with an
+  // inactive RenderFrameHost — either way ComputeWish() will now discount it.
+  // Fires on cross-document commits, bfcache restores and prerender
+  // activations; not on same-document navigations, which a live inline-3D
+  // session is expected to survive.
+  owner_->ScheduleApply();
+}
+
+void DisplayXRDisplayModeController::PageChangeObserver::
+    WebContentsDestroyed() {
+  // Self-erase so the map never holds a key to a freed WebContents. Safe from
+  // inside this notification: the base destructor's RemoveObserver() is exactly
+  // what the observer list permits during iteration.
+  owner_->OnObservedContentsDestroyed(web_contents());
+}
+
 // static
 void DisplayXRDisplayModeController::CreateForBrowserProcess() {
   if (InstancePtr()) {
@@ -78,11 +109,23 @@ DisplayXRDisplayModeController::~DisplayXRDisplayModeController() = default;
 
 void DisplayXRDisplayModeController::OnFrameDemandChanged(
     content::GlobalRenderFrameHostId frame_id,
+    uint64_t instance_id,
     bool wants_3d) {
   if (wants_3d) {
-    demanding_frames_.insert(frame_id);
+    // The newest claimant on this frame id wins outright.
+    demanding_frames_.insert_or_assign(frame_id, instance_id);
   } else {
-    demanding_frames_.erase(frame_id);
+    // browser#90 (C-2): honour the retraction only if the claim still belongs
+    // to the pipe retracting it. On a same-RFH cross-document navigation the
+    // old pipe's teardown retraction and the new document's first report are
+    // unordered; if the retraction arrives second, erasing here would clear a
+    // claim the new document has already made — and because the renderer is
+    // edge-triggered it would never make it again, stranding a 3D page in 2D
+    // for the life of the document.
+    auto it = demanding_frames_.find(frame_id);
+    if (it != demanding_frames_.end() && it->second == instance_id) {
+      demanding_frames_.erase(it);
+    }
   }
   ScheduleApply();
 }
@@ -117,8 +160,11 @@ bool DisplayXRDisplayModeController::ComputeWish() const {
 
   // Any live frame of that tab reporting visible 3D content. Frames are held by
   // id, not pointer, precisely so a dead one resolves to null here instead of
-  // dangling.
-  for (const content::GlobalRenderFrameHostId& id : demanding_frames_) {
+  // dangling. IsActive() is what discounts a document sitting in the
+  // back/forward cache — its pipe, and so its claim, outlives the navigation
+  // (browser#90 C-1); PageChangeObserver is what makes sure this runs again
+  // once that happens.
+  for (const auto& [id, instance_id] : demanding_frames_) {
     content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(id);
     if (rfh && rfh->IsActive() &&
         content::WebContents::FromRenderFrameHost(rfh) == foreground_contents) {
@@ -209,20 +255,59 @@ void DisplayXRDisplayModeController::ForceTwoDForShutdown() {
   shutting_down_ = true;
 }
 
+void DisplayXRDisplayModeController::RefreshActiveTabObservers() {
+  base::flat_set<content::WebContents*> active;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&active](BrowserWindowInterface* browser) {
+        if (content::WebContents* contents = ActiveContents(browser)) {
+          active.insert(contents);
+        }
+        return true;
+      });
+
+  // Stop watching tabs that are no longer the active tab of any window.
+  base::EraseIf(active_tab_observers_, [&active](const auto& entry) {
+    return !active.contains(entry.first);
+  });
+
+  // Start watching the ones that just became active. A tab dragged out into its
+  // own window arrives here as a new entry against the new window, and drops
+  // out of the old one on that window's active-tab change.
+  for (content::WebContents* contents : active) {
+    if (!active_tab_observers_.contains(contents)) {
+      active_tab_observers_.insert_or_assign(
+          contents, std::make_unique<PageChangeObserver>(contents, this));
+    }
+  }
+}
+
+void DisplayXRDisplayModeController::OnObservedContentsDestroyed(
+    content::WebContents* contents) {
+  // Deletes the calling observer. Nothing may touch it after this point.
+  active_tab_observers_.erase(contents);
+}
+
 void DisplayXRDisplayModeController::OnBrowserCreated(
     BrowserWindowInterface* browser) {
   if (!active_tab_subscriptions_.contains(browser)) {
-    active_tab_subscriptions_[browser] = browser->RegisterActiveTabDidChange(
-        base::BindRepeating([](DisplayXRDisplayModeController* self,
-                               BrowserWindowInterface*) { self->ScheduleApply(); },
-                            base::Unretained(this)));
+    active_tab_subscriptions_[browser] =
+        browser->RegisterActiveTabDidChange(base::BindRepeating(
+            [](DisplayXRDisplayModeController* self, BrowserWindowInterface*) {
+              // browser#90: the active tab changed, so both the wish
+              // and the set of tabs whose navigations matter may have.
+              self->RefreshActiveTabObservers();
+              self->ScheduleApply();
+            },
+            base::Unretained(this)));
   }
+  RefreshActiveTabObservers();
   ScheduleApply();
 }
 
 void DisplayXRDisplayModeController::OnBrowserClosed(
     BrowserWindowInterface* browser) {
   active_tab_subscriptions_.erase(browser);
+  RefreshActiveTabObservers();
   ScheduleApply();
 }
 
diff --git a/chrome/browser/displayxr/displayxr_display_mode_controller.h b/chrome/browser/displayxr/displayxr_display_mode_controller.h
