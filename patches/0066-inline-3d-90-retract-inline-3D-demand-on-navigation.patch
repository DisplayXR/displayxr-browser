@@ -33,19 +33,34 @@
 //     inferring anything from a return code, because the workspace gate is a
 //     silent XR_SUCCESS no-op.
 //
+// browser#90: the policy above is only as good as the events that trigger it.
+// The demand set is edge-driven, and a same-tab navigation produces no edge —
+// a document put in the back/forward cache keeps its mojo pipe, and therefore
+// its demand, alive indefinitely. ComputeWish() already filters it out (its
+// RenderFrameHost is no longer IsActive()), but nothing asked. So the
+// controller also watches the active tab of every window for primary-page
+// changes, which is what a cross-document commit, a bfcache restore, and a
+// prerender activation all have in common. Same-document navigations
+// deliberately do NOT fire: a live inline-3D session survives those and keeps
+// reporting.
+//
 // Browser process, UI thread. Windows-only in practice (the weave client is a
 // stub elsewhere), but the class itself is platform-neutral.
 
+#include <cstdint>
 #include <map>
-#include <set>
+#include <memory>
 
 #include "base/callback_list.h"
+#include "base/containers/flat_map.h"
+#include "base/memory/raw_ptr.h"
 #include "base/scoped_observation.h"
 #include "base/timer/timer.h"
 #include "chrome/browser/ui/browser_window/public/browser_collection.h"
 #include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
 #include "components/displayxr/common/displayxr_weave.mojom.h"
 #include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/web_contents_observer.h"
 #include "mojo/public/cpp/bindings/remote.h"
 
 class BrowserWindowInterface;
@@ -81,13 +96,45 @@ class DisplayXRDisplayModeController : public BrowserCollectionObserver {
   void OnBrowserDeactivated(BrowserWindowInterface* browser) override;
 
  private:
+  // browser#90: turns "the tab navigated" into "recompute the wish". Attached
+  // to the active tab of each window; see the file comment for why nothing else
+  // reaches the controller on a same-tab navigation.
+  class PageChangeObserver : public content::WebContentsObserver {
+   public:
+    PageChangeObserver(content::WebContents* contents,
+                       DisplayXRDisplayModeController* owner);
+    ~PageChangeObserver() override;
+
+    PageChangeObserver(const PageChangeObserver&) = delete;
+    PageChangeObserver& operator=(const PageChangeObserver&) = delete;
+
+    // content::WebContentsObserver:
+    void PrimaryPageChanged(content::Page& page) override;
+    void WebContentsDestroyed() override;
+
+   private:
+    const raw_ptr<DisplayXRDisplayModeController> owner_;
+  };
+
   DisplayXRDisplayModeController();
   ~DisplayXRDisplayModeController() override;
 
   // Renderer said this frame's visible inline-3D content appeared/disappeared.
+  // |instance_id| is the reporting pipe's generation; a retraction from a stale
+  // one is ignored (see DisplayXRServiceImpl::Inline3DDemandCallback).
   void OnFrameDemandChanged(content::GlobalRenderFrameHostId frame_id,
+                            uint64_t instance_id,
                             bool wants_3d);
 
+  // Bring |active_tab_observers_| in line with the active tabs of the current
+  // windows. Only active tabs are watched: a background tab's navigation cannot
+  // change ComputeWish()'s answer, and a tab that becomes active — including
+  // one dragged into another window — comes through here first.
+  void RefreshActiveTabObservers();
+
+  // A watched tab is going away.
+  void OnObservedContentsDestroyed(content::WebContents* contents);
+
   // Demand of the active tab of the frontmost window that is actually on screen.
   bool ComputeWish() const;
 
@@ -106,7 +153,12 @@ class DisplayXRDisplayModeController : public BrowserCollectionObserver {
   mojom::DisplayXRDisplayMode* GetSink();
   void OnSinkDisconnected();
 
-  std::set<content::GlobalRenderFrameHostId> demanding_frames_;
+  // Frames claiming visible inline-3D content -> the generation of the pipe
+  // that made the claim. Keyed by id rather than pointer so a dead frame
+  // resolves to null in ComputeWish() instead of dangling; valued by generation
+  // so a retraction that lost the race against the next document is discarded
+  // rather than clearing that document's claim (browser#90 C-2).
+  base::flat_map<content::GlobalRenderFrameHostId, uint64_t> demanding_frames_;
 
   mojo::Remote<mojom::DisplayXRDisplayMode> sink_;
 
@@ -116,6 +168,11 @@ class DisplayXRDisplayModeController : public BrowserCollectionObserver {
   std::map<BrowserWindowInterface*, base::CallbackListSubscription>
       active_tab_subscriptions_;
 
+  // browser#90: one per currently-active tab. Entries are removed when the tab
+  // stops being active or is destroyed, so the raw keys never dangle.
+  base::flat_map<content::WebContents*, std::unique_ptr<PageChangeObserver>>
+      active_tab_observers_;
+
   base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
       collection_observation_{this};
 
diff --git a/components/displayxr/browser/displayxr_service_impl.cc b/components/displayxr/browser/displayxr_service_impl.cc
index 259c94632b488..2d5fce0bf5d61 100644
--- a/components/displayxr/browser/displayxr_service_impl.cc
+++ b/components/displayxr/browser/displayxr_service_impl.cc
@@ -24,6 +24,15 @@ DisplayXRServiceImpl::Inline3DDemandCallback& DemandCallback() {
   return *cb;
 }
 
+// browser#90: monotonic pipe generation. Browser-UI-thread only (every
+// DisplayXRServiceImpl is constructed from the frame's interface broker, which
+// runs there), so a plain counter is enough — no atomic needed. Starts at 1 so
+// no live instance ever holds 0.
+uint64_t NextInstanceId() {
+  static uint64_t next = 0;
+  return ++next;
+}
+
 }  // namespace
 
 // static
@@ -34,15 +43,19 @@ void DisplayXRServiceImpl::SetInline3DDemandCallback(
 
 DisplayXRServiceImpl::DisplayXRServiceImpl(
     content::GlobalRenderFrameHostId frame_id)
-    : frame_id_(frame_id) {}
+    : frame_id_(frame_id), instance_id_(NextInstanceId()) {}
 
 DisplayXRServiceImpl::~DisplayXRServiceImpl() {
   // browser#55: the pipe is gone — navigation, frame teardown, or a renderer
   // crash. Whatever this frame last wanted, it cannot want it any more. Retract
   // it, otherwise a navigation away from a 3D page (the reported bug) would
   // leave the demand latched at true with no renderer left to clear it.
+  //
+  // browser#90: tagged with |instance_id_| because this retraction races the
+  // NEXT document's first report on a same-RFH navigation — the sink drops it
+  // if that race has already been lost.
   if (reported_demand_valid_ && reported_demand_ && DemandCallback()) {
-    DemandCallback().Run(frame_id_, false);
+    DemandCallback().Run(frame_id_, instance_id_, false);
   }
 }
 
@@ -61,7 +74,7 @@ void DisplayXRServiceImpl::SetInline3DDemand(bool wants_3d) {
   reported_demand_ = wants_3d;
   reported_demand_valid_ = true;
   if (DemandCallback()) {
-    DemandCallback().Run(frame_id_, wants_3d);
+    DemandCallback().Run(frame_id_, instance_id_, wants_3d);
   }
 }
 
diff --git a/components/displayxr/browser/displayxr_service_impl.h b/components/displayxr/browser/displayxr_service_impl.h
