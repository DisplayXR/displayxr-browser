   void SetOverscrollBehavior(const OverscrollBehavior& overscroll_behavior);
   const OverscrollBehavior& overscroll_behavior() const {
diff --git a/cc/trees/layer_tree_host_impl.cc b/cc/trees/layer_tree_host_impl.cc
index 2c5fdfae88100..dbdae228d0237 100644
--- a/cc/trees/layer_tree_host_impl.cc
+++ b/cc/trees/layer_tree_host_impl.cc
@@ -2462,6 +2462,13 @@ viz::CompositorFrameMetadata LayerTreeHostImpl::MakeCompositorFrameMetadata() {
   // DisplayXR (browser#28): viewport-fixed exclusion rects are held aside while
   // the scroll-delta patch below runs, then appended verbatim.
   std::vector<gfx::Rect> inline_3d_exclusion_fixed_rects;
+  // browser#83: the scroll-delta patch below only runs when the rects carry
+  // their measurement-time scroll base (the metadata/commit path). The
+  // TreesInViz-in-viz client copy has no base, so it gets NO shift — an
+  // unshifted, one-frame-stale rect still matches its quad (70% gate), whereas
+  // a mis-based shift moved rects by the full historical scroll and clipped
+  // them to empty.
+  bool inline_3d_have_scroll_base = false;
   if (settings().trees_in_viz_in_viz_process) {
     metadata.tracked_element_rects = tracked_element_rects_from_client_;
     metadata.inline_3d_rects = inline_3d_rects_from_client_;
@@ -2484,6 +2491,7 @@ viz::CompositorFrameMetadata LayerTreeHostImpl::MakeCompositorFrameMetadata() {
         active_tree()->inline_3d_exclusion_rects();
     inline_3d_exclusion_fixed_rects =
         active_tree()->inline_3d_exclusion_fixed_rects();
+    inline_3d_have_scroll_base = true;
   }
   // DisplayXR inline-3D (#625, Step B / Phase 2 — scroll-sync): the rects above
   // are getBoundingClientRect measured on the Blink main thread at the COMMITTED
@@ -2494,8 +2502,9 @@ viz::CompositorFrameMetadata LayerTreeHostImpl::MakeCompositorFrameMetadata() {
   // offset − committed base) so the weave rect tracks the pixels presented THIS
   // frame. Handles the dominant case (content scrolling with the root viewport);
   // nested-scroller content is a follow-up.
-  if (!metadata.inline_3d_rects.empty() ||
-      !metadata.inline_3d_exclusion_rects.empty()) {
+  if (inline_3d_have_scroll_base &&
+      (!metadata.inline_3d_rects.empty() ||
+       !metadata.inline_3d_exclusion_rects.empty())) {
     const ScrollNode* viewport_scroll = OuterViewportScrollNode();
     if (!viewport_scroll) {
       viewport_scroll = InnerViewportScrollNode();
@@ -2503,12 +2512,21 @@ viz::CompositorFrameMetadata LayerTreeHostImpl::MakeCompositorFrameMetadata() {
     if (viewport_scroll && viewport_scroll->element_id) {
       const ScrollTree& scroll_tree =
           active_tree_->property_trees()->scroll_tree();
-      if (const SyncedScrollOffset* synced =
-              scroll_tree.GetSyncedScrollOffset(viewport_scroll->element_id)) {
-        // Delta() == active offset − active base == impl scroll accumulated since
-        // the commit that supplied these rects (DIP; matches getBoundingClientRect
-        // units before the device-scale multiply Blink applied).
-        const gfx::Vector2dF delta = synced->Delta();
+      {
+        // browser#83: shift = current impl offset − the offset AT RECT
+        // MEASUREMENT (stamped by Blink and pushed with the rects, so the pair
+        // is self-consistent no matter how old the commit is). The previous
+        // baseline, SyncedScrollOffset::Delta() (active − base), assumed the
+        // base tracks the commit that supplied the rects; in this browser's
+        // configuration the base never resets after a scroll, so every rect
+        // was shifted by the FULL historical offset forever — driven above the
+        // surface, clipped to empty, and page chrome wove (with weave rects
+        // themselves landing hundreds of px off when the tracked channel was
+        // absent). CSS-px units on both sides; device-scale applied below,
+        // pinch-zoom refinements still deferred as before.
+        const gfx::Vector2dF delta =
+            scroll_tree.current_scroll_offset(viewport_scroll->element_id) -
+            active_tree()->inline_3d_scroll_base();
         const float dsf = active_tree_->device_scale_factor();
         const int dx = base::ClampRound(delta.x() * dsf);
         const int dy = base::ClampRound(delta.y() * dsf);
