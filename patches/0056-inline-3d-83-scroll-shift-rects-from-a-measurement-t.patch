   target_tree->SetBrowserControlsParams(browser_controls_params_);
   target_tree->SetInline3DRects(inline_3d_rects_, inline_3d_exclusion_rects_,
-                                inline_3d_exclusion_fixed_rects_);
+                                inline_3d_exclusion_fixed_rects_,
