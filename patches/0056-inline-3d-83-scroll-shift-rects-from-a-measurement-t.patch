 cc/trees/layer_tree_host_impl.cc              | 34 ++++++++++++++-----
 cc/trees/layer_tree_impl.cc                   |  6 ++--
 cc/trees/layer_tree_impl.h                    | 13 +++++--
 .../core/frame/web_frame_widget_impl.cc       |  7 ++--
 .../core/frame/web_frame_widget_impl.h        |  3 +-
 .../blink/renderer/modules/xr/xr_session.cc   | 12 ++++++-
 .../renderer/platform/widget/frame_widget.h   |  7 +++-
 10 files changed, 85 insertions(+), 20 deletions(-)

diff --git a/cc/trees/commit_state.h b/cc/trees/commit_state.h
index 8aa2c2a0d8897..1f51c7d004c8b 100644
--- a/cc/trees/commit_state.h
+++ b/cc/trees/commit_state.h
@@ -42,6 +42,7 @@
 #include "third_party/skia/include/core/SkColor.h"
 #include "ui/gfx/delegated_ink_metadata.h"
 #include "ui/gfx/display_color_spaces.h"
+#include "ui/gfx/geometry/point_f.h"
 #include "ui/gfx/geometry/rect.h"
 #include "ui/gfx/geometry/size.h"
 #include "ui/gfx/geometry/vector2d_f.h"
@@ -104,6 +105,14 @@ struct CC_EXPORT CommitState {
   // LayerTreeHostImpl::MakeCompositorFrameMetadata: a viewport-fixed element
   // does not move with the scroll, so shifting it by the delta IS the error.
   std::vector<gfx::Rect> inline_3d_exclusion_fixed_rects;
+  // DisplayXR (browser#83): outer-viewport scroll offset (CSS px) at the moment
+  // the inline-3d rect lists above were measured on the Blink main thread. The
+  // impl-scroll patch in LayerTreeHostImpl::MakeCompositorFrameMetadata shifts
+  // the scrolling lists by (current impl offset − this base). The previous
+  // baseline, SyncedScrollOffset::Delta(), never resets in this browser's
+  // configuration, so after any scroll every rect was shifted by the FULL
+  // historical offset forever — clipped to empty, and page chrome wove.
+  gfx::PointF inline_3d_scroll_base;
   std::array<EventListenerProperties, kEventListenerClassCount>
       event_listener_properties = {EventListenerProperties::kNone};
   float bottom_controls_shown_ratio = 0.f;
diff --git a/cc/trees/layer_tree_host.cc b/cc/trees/layer_tree_host.cc
index 87c43460a91b0..d61616467f2ce 100644
--- a/cc/trees/layer_tree_host.cc
+++ b/cc/trees/layer_tree_host.cc
@@ -1567,7 +1567,15 @@ void LayerTreeHost::SetBrowserControlsParams(
 void LayerTreeHost::SetInline3DRects(
     std::vector<gfx::Rect> rects,
     std::vector<gfx::Rect> exclusion_rects,
-    std::vector<gfx::Rect> exclusion_fixed_rects) {
+    std::vector<gfx::Rect> exclusion_fixed_rects,
+    const gfx::PointF& scroll_base) {
+  // NOTE (browser#83): scroll_base is deliberately NOT part of the dedup
+  // compare. The rects are viewport-relative, so identical rects measured at a
+  // different scroll offset describe the same on-screen geometry — committing
+  // for the base alone is pure churn. Skipping the commit keeps the OLD
+  // (rects, base) pair, which is still self-consistent: the impl-side shift is
+  // (current − base), and both halves of the pair came from the same
+  // measurement.
   if (pending_commit_state()->inline_3d_rects == rects &&
       pending_commit_state()->inline_3d_exclusion_rects == exclusion_rects &&
       pending_commit_state()->inline_3d_exclusion_fixed_rects ==
@@ -1579,6 +1587,7 @@ void LayerTreeHost::SetInline3DRects(
       std::move(exclusion_rects);
   pending_commit_state()->inline_3d_exclusion_fixed_rects =
       std::move(exclusion_fixed_rects);
+  pending_commit_state()->inline_3d_scroll_base = scroll_base;
   SetNeedsCommit();
 }
 
