+  const gfx::PointF& inline_3d_scroll_base() const {
+    return inline_3d_scroll_base_;
+  }
 
   bool browser_controls_shrink_blink_size() const {
     return browser_controls_params_.browser_controls_shrink_blink_size;
@@ -1044,7 +1051,9 @@ class CC_EXPORT LayerTreeImpl {
 
   BrowserControlsParams browser_controls_params_;
 
-  // DisplayXR inline-3D (#625, Step B / B4b; exclusions browser#18).
