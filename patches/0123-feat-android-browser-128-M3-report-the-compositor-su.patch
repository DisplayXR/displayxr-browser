diff --git a/components/displayxr/android/java/src/org/chromium/components/displayxr/DisplayXrWindowGeometry.java b/components/displayxr/android/java/src/org/chromium/components/displayxr/DisplayXrWindowGeometry.java
new file mode 100644
index 0000000000000..4ce0413fe42d6
--- /dev/null
+++ b/components/displayxr/android/java/src/org/chromium/components/displayxr/DisplayXrWindowGeometry.java
@@ -0,0 +1,171 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.components.displayxr;
+
+import android.app.Activity;
+import android.graphics.Rect;
+import android.os.Build;
+import android.view.Choreographer;
+import android.view.Display;
+import android.view.SurfaceView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowManager;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * browser#128 (M3): reports where the browser's content area ACTUALLY sits on
+ * the panel, so the GPU process's weave session can anchor the lenticular
+ * interlace phase to it.
+ *
+ * <p>Why this exists: the weave provider knows the surface SIZE (the root
+ * render pass) but not its screen ORIGIN — there is no window handle on
+ * Android, and a pure window MOVE raises no resize, so nothing on the native
+ * side ever learns the position. The placeholder origin (0,0) is correct only
+ * for a bottom-anchored full-width window; measured on NP02J, a freeform
+ * window at (2137,84) wove with its phase referenced ~2137 px away — visibly
+ * broken 3D 
+ *
+ * <p>Mechanism, exactly as the M3 seam prescribed: sample
+ * {@code View.getLocationOnScreen()} of the activity's content view on a
+ * Choreographer cadence, and forward changes over displayxr_weave.mojom.
+ * Change-gated with a ~1 s heartbeat: the heartbeat is what lets a restarted
+ * GPU process (whose mojo pipe died with the old one) recover the origin
+ * without waiting for the window to move.
+ *
+ * <p>The content view ({@code android.R.id.content}) is the right rect: the
+ * compositor SurfaceView fills it, and the browser toolbar lives INSIDE it —
+ * matching the root-pass-sized staging surface the weave actually fills.
+ *
+ * <p>Per ADR-033 this reports geometry and NOTHING else; the weaver alone owns
+ * phase and snapping. Multi-window Chrome (two activities, one weave session)
+ * follows the FOCUSED activity — a strict improvement on the fixed (0,0), and
+ * the full multi-session story is the rest of browser#128.
+ */
+@JNINamespace("displayxr")
+@NullMarked
+public final class DisplayXrWindowGeometry implements Choreographer.FrameCallback {
+    private static @Nullable DisplayXrWindowGeometry sInstance;
+
+    // ~1 s at 60 Hz. Cheap on both sides: the runtime dedupes identical
+    // geometry, so the steady-state cost is one no-op mojo message a second.
+    private static final int HEARTBEAT_FRAMES = 60;
+
+    private final int[] mLoc = new int[2];
+    private int mLastX = Integer.MIN_VALUE;
+    private int mLastY = Integer.MIN_VALUE;
+    private int mLastW;
+    private int mLastH;
+    private int mLastDisplay = -1;
+    private boolean mLastScaled;
+    private int mFramesSinceSent;
+
+    /** Starts the sampler. Idempotent; callable from any thread. */
+    public static void start() {
+        ThreadUtils.runOnUiThread(
+                () -> {
+                    if (sInstance != null) return;
+                    sInstance = new DisplayXrWindowGeometry();
+                    Choreographer.getInstance().postFrameCallback(sInstance);
+                });
+    }
+
+    private DisplayXrWindowGeometry() {}
+
+    @Override
+    public void doFrame(long frameTimeNanos) {
+        sample();
+        Choreographer.getInstance().postFrameCallback(this);
+    }
+
+    private void sample() {
+        Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+        if (activity == null) return;
+        View root = activity.findViewById(android.R.id.content);
+        if (root == null) return;
+        // The COMPOSITOR SURFACE, not the content view: Chrome draws
+        // edge-to-edge, so android.R.id.content spans the whole panel
+        // (measured (0,0) 2560x1600 on NP02J) while the woven surface is the
+        // SurfaceView inset below the status bar ((0,60) 2560x1540). The
+        // surface is what the root render pass sizes to and what the weave
+        // fills, so its frame is the geometry the phase must anchor to.
+        View content = findSurfaceView(root);
+        if (content == null) content = root;
+        if (content.getWidth() == 0 || content.getHeight() == 0) return;
+        content.getLocationOnScreen(mLoc);
+        Display display = content.getDisplay();
+        int displayId = display != null ? display.getDisplayId() : 0;
+        int w = content.getWidth();
+        int h = content.getHeight();
+        // Container-scale detection (browser#128 option 1): an OEM freeform
+        // "mini window" renders the app at logical size and SCALES the whole
+        // surface for display (measured on NP02J: SurfaceFlinger
+        // tr=[0.67,0][0,0.67]). A woven texture resampled by ANY factor is
+        // destroyed — every subpixel lands on the wrong lens — so the weave
+        // must refuse. App-visible tell: the window's bounds exceed the
+        // display's maximum metrics (the OEM places a logical-size window in
+        // physical coordinates; measured bounds (1757,236,2837,1921) against a
+        // 2560x1600 panel). A window merely dragged off-edge unscaled would
+        // also trip this; the false positive costs 2D content, never a broken
+        // weave, which is the right direction to fail.
+        boolean scaled = false;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            WindowManager wm = activity.getWindowManager();
+            if (wm != null) {
+                Rect cur = wm.getCurrentWindowMetrics().getBounds();
+                Rect max = wm.getMaximumWindowMetrics().getBounds();
+                scaled = cur.right > max.right || cur.bottom > max.bottom
+                        || cur.left < max.left || cur.top < max.top;
+            }
+        }
+        boolean changed =
+                mLoc[0] != mLastX
+                        || mLoc[1] != mLastY
+                        || w != mLastW
+                        || h != mLastH
+                        || displayId != mLastDisplay
+                        || scaled != mLastScaled;
+        mFramesSinceSent++;
+        if (!changed && mFramesSinceSent < HEARTBEAT_FRAMES) return;
+        mLastX = mLoc[0];
+        mLastY = mLoc[1];
+        mLastW = w;
+        mLastH = h;
+        mLastDisplay = displayId;
+        mLastScaled = scaled;
+        mFramesSinceSent = 0;
+        DisplayXrWindowGeometryJni.get()
+                .onGeometry(mLoc[0], mLoc[1], w, h, displayId, scaled);
+    }
+
+    // First SurfaceView in hierarchy order — the compositor surface. A cached
+    // reference would dangle across tab-switcher rebuilds; a per-frame walk of
+    // Chrome's shallow view tree is cheap and always current. (If a page ever
+    // adds a second SurfaceView, first-in-order is still the compositor: it is
+    // attached at activity setup, before any content.)
+    private static @Nullable View findSurfaceView(View v) {
+        if (v instanceof SurfaceView) return v;
+        if (!(v instanceof ViewGroup)) return null;
+        ViewGroup g = (ViewGroup) v;
+        for (int i = 0; i < g.getChildCount(); i++) {
+            View found = findSurfaceView(g.getChildAt(i));
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    @NativeMethods
+    interface Natives {
+        void onGeometry(
+                int x, int y, int width, int height, int displayId, boolean containerScaled);
+    }
+}
diff --git a/components/displayxr/browser/displayxr_weave_client_android.cc b/components/displayxr/browser/displayxr_weave_client_android.cc
index 2384d10120b49..9c59b0ec88cfc 100644
--- a/components/displayxr/browser/displayxr_weave_client_android.cc
+++ b/components/displayxr/browser/displayxr_weave_client_android.cc
@@ -41,6 +41,7 @@
 
 #include "components/displayxr/browser/displayxr_weave_client_android.h"
 
+#include <atomic>
 #include <dlfcn.h>
 #include <jni.h>
 #include <stdlib.h>
@@ -142,6 +143,17 @@ AndroidWeaveState& State() {
   return *s;
 }
 
+// browser#128: the Java-reported window origin. Deliberately OUTSIDE
+// AndroidWeaveState: that struct is single-threaded (weave thread) by
+// construction, while these are written by the mojo receiver on another
+// GPU-process thread. Relaxed atomics: a frame that reads a half-updated
+// (x,y) pair mid-move is indistinguishable from sampling one frame earlier.
+std::atomic<int32_t> g_java_origin_x{0};
+std::atomic<int32_t> g_java_origin_y{0};
+std::atomic<int32_t> g_java_display_id{0};
+std::atomic<bool> g_java_origin_valid{false};
+std::atomic<bool> g_java_container_scaled{false};
+
 // The adopted runtime socket, published by gpu_main.cc's
 // MaybePublishDisplayXRAdoptedFd(). Its presence is the signal that the
 // browser-side connector worked and this process can talk to the runtime at
@@ -680,6 +692,53 @@ void SetWindowGeometryAndroid(int32_t origin_x,
   s.geometry_dirty = true;
 }
 
+void SetWindowScreenOriginAndroid(int32_t x,
+                                  int32_t y,
+                                  int32_t display_id,
+                                  int32_t reported_w,
+                                  int32_t reported_h,
+                                  bool container_scaled) {
+  const bool was_scaled =
+      g_java_container_scaled.exchange(container_scaled, std::memory_order_relaxed);
+  if (was_scaled != container_scaled) {
+    LOG(WARNING) << "[DisplayXR] window container "
+                 << (container_scaled
+                         ? "SCALED (OEM mini-window) — weave refused, page "
+                           "content shows 2D (browser#128 option 1)"
+                         : "unscaled — weaving re-enabled");
+  }
+  const bool first = !g_java_origin_valid.load(std::memory_order_relaxed);
+  const bool changed = first ||
+                       g_java_origin_x.load(std::memory_order_relaxed) != x ||
+                       g_java_origin_y.load(std::memory_order_relaxed) != y;
+  g_java_origin_x.store(x, std::memory_order_relaxed);
+  g_java_origin_y.store(y, std::memory_order_relaxed);
+  g_java_display_id.store(display_id, std::memory_order_relaxed);
+  g_java_origin_valid.store(true, std::memory_order_release);
+  if (changed) {
+    // One line per distinct origin (a drag emits a handful) — the on-device
+    // ground truth for the #128 phase-anchor investigations.
+    LOG(WARNING) << "[DisplayXR] window origin (browser#128): (" << x << ","
+                 << y << ") display " << display_id << " java-view "
+                 << reported_w << "x" << reported_h
+                 << (first ? " (first report)" : "");
+  }
+}
+
+bool IsWindowContainerScaledAndroid() {
+  return g_java_container_scaled.load(std::memory_order_relaxed);
+}
+
+bool GetWindowScreenOriginAndroid(int32_t* x, int32_t* y, int32_t* display_id) {
+  if (!g_java_origin_valid.load(std::memory_order_acquire)) {
+    return false;
+  }
+  *x = g_java_origin_x.load(std::memory_order_relaxed);
+  *y = g_java_origin_y.load(std::memory_order_relaxed);
+  *display_id = g_java_display_id.load(std::memory_order_relaxed);
+  return true;
+}
+
 std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectAndroid(
     const DisplayXRWeaveClient::WeaveRect& rect,
     float virtual_display_height) {
