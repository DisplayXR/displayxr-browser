diff --git a/components/displayxr/android/displayxr_window_geometry_android.cc b/components/displayxr/android/displayxr_window_geometry_android.cc
new file mode 100644
index 0000000000000..e09e610face7f
--- /dev/null
+++ b/components/displayxr/android/displayxr_window_geometry_android.cc
@@ -0,0 +1,59 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// browser#128 (M3): browser-process end of the window-geometry feed. The Java
+// sampler (DisplayXrWindowGeometry.java) calls in on the UI thread; this owns
+// the mojo remote to the GPU process's DisplayXRDisplayMode and forwards the
+// frame verbatim. Same interface the LocateViews hop already uses, so the two
+// stay ordered on one pipe.
+
+#include "base/no_destructor.h"
+#include "components/displayxr/android/jni_headers/DisplayXrWindowGeometry_jni.h"
+#include "components/displayxr/common/displayxr_weave.mojom.h"
+#include "content/public/browser/gpu_service_registry.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace displayxr {
+
+namespace {
+
+mojo::Remote<mojom::DisplayXRDisplayMode>& GetRemote() {
+  static base::NoDestructor<mojo::Remote<mojom::DisplayXRDisplayMode>> remote;
+  return *remote;
+}
+
+}  // namespace
+
+// UI thread (Choreographer cadence). Binds lazily and re-binds after a GPU
+// restart (reset_on_disconnect leaves the remote unbound); the Java side's ~1 s
+// heartbeat guarantees the new process receives the origin promptly even when
+// the window is not moving.
+void JNI_DisplayXrWindowGeometry_OnGeometry(JNIEnv* env,
+                                            jint x,
+                                            jint y,
+                                            jint width,
+                                            jint height,
+                                            jint display_id,
+                                            jboolean container_scaled) {
+  mojo::Remote<mojom::DisplayXRDisplayMode>& remote = GetRemote();
+  if (!remote.is_bound()) {
+    content::BindInterfaceInGpuProcess(remote.BindNewPipeAndPassReceiver());
+    remote.reset_on_disconnect();
+  }
+  if (!remote.is_bound()) {
+    return;
+  }
+  remote->SetWindowGeometry(gfx::Rect(x, y, width, height), display_id,
+                            container_scaled);
+}
+
+}  // namespace displayxr
+
+// jni_zero registration: instantiates the JNI stub that routes the Java
+// DisplayXrWindowGeometryJni.get().onGeometry() call to
+// displayxr::JNI_DisplayXrWindowGeometry_OnGeometry above. Must be invoked at
+// file scope after the implementation (the generated header enforces this with
+// an unused-function trap).
+DEFINE_JNI_FOR_DisplayXrWindowGeometry()
