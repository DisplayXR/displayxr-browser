+
+void SkiaOutputSurfaceImplOnGpu::DisplayXRReleaseTarget(
+    DisplayXRTargetState& st,
+    DisplayXRWeaveProvider* provider) {
+  if (!st.woven_mailbox.IsZero()) {
+    shared_image_factory_->DestroySharedImage(st.woven_mailbox);
+    st.woven_mailbox = gpu::Mailbox();
+  }
+  if (!st.scratch_mailbox.IsZero()) {
+    shared_image_factory_->DestroySharedImage(st.scratch_mailbox);
+    skia_representations_.erase(st.scratch_mailbox);
+    st.scratch_mailbox = gpu::Mailbox();
+  }
+  // Order matters: the provider must close this target's un-taken result
+  // handles and reset its keyed-mutex input BEFORE the slot goes back in the
+  // pool, or the next target admitted could take the slot and inherit them.
+  if (provider) {
+    provider->PruneTarget(st.slot);
+  }
+  displayxr_slots_in_use_.erase(st.slot);
+}
