+void DisplayXRWeaveGpu::PruneTarget(uint32_t target_id) {
+  // Single-id retirement (DisplayXR Phase 1): target ids are no longer dense
+  // and positional — an element in the middle of the range can retire while
+  // its neighbours stay live, and the caller reuses the freed id — so the
+  // [0, count) form of PruneTargets cannot express this.
+  auto result_it = results_.find(target_id);
+  if (result_it != results_.end()) {
+    if (result_it->second.have) {
+      CloseResultHandles(result_it->second.result);
+    }
+    results_.erase(result_it);
+  }
+  auto input_it = inputs_.find(target_id);
+  if (input_it != inputs_.end()) {
+    ResetInput(input_it->second);
+    inputs_.erase(input_it);
+  }
+}
