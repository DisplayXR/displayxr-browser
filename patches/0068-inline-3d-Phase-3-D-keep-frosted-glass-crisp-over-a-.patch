+    quads.push_back({quad, target_rect, own_rect});
   }
 
   // The canvas resources of ALL registered tiles: a tile's own canvas quad is
@@ -737,6 +755,47 @@ void DirectRenderer::ComputeInline3dPlaneSplit(
         // sample outside its own rect and outside this plane. "It only wraps
         // one pass so it is safe" is FALSE.
         ++excl_render_pass_quad;
+
+        // Phase 3 Stage 3 — D' (browser#88): the FROSTED case. An excluded pass
+        // carrying a BACKDROP FILTER over a tile is the worst cell of the
+        // occlusion matrix. It cannot join the over-plane (it samples a
+        // backdrop that plane does not have) and it cannot be left under the
+        // weave (the woven tile is opaque, so it vanishes) — which is why,
+        // before this, a frosted card over an inline-3D element simply
+        // disappeared behind it.
+        //
+        // D' is the honest compromise, and it is a THREE-part trade, all of it
+        // driven from this one recording:
+        //   1. the woven draw-back is CLIPPED OUT of this rect (Phase B), so
+        //      the element keeps the crisp frosted pixels the page already
+        //      drew;
+        //   2. the rect joins the FLAT list, so on a capable panel the region
+        //      goes hardware-2D via the wish and does not ghost;
+        //   3. what is LOST is depth behind the element: the page-drawn frosted
+        //      pixels blurred the flat page backdrop, because at page-draw time
+        //      the woven pixels did not exist yet. So the frosted region reads
+        //      as correct 2D glass over a FLAT patch of the scene.
+        //
+        // Unlike the Stage-2 flat rects this is NOT gated on opacity — a
+        // frosted element is translucent by definition. It is sound anyway
+        // precisely because of (1): the weave is removed from the rect, so
+        // there is no working 3D left underneath for the wish to flatten. The
+        // two effects are one decision and must stay together — a frosted rect
+        // in the flat list that was NOT punched out of the draw-back would
+        // switch the lens off over live woven pixels.
+        //
+        // |own_rect|, not |target_rect|: the latter is expanded by the pass's
+        // pixel-moving reach, and clipping THAT out of the draw-back would
+        // leave a halo of raw page around the element.
+        if (auto* rpdq = c.quad->DynamicCast<AggregatedRenderPassDrawQuad>();
+            rpdq && !rpdq->backdrop_filters.IsEmpty()) {
+          gfx::Rect frosted = c.own_rect;
+          frosted.Intersect(tile.rect);
+          if (!frosted.IsEmpty()) {
+            inline3d_frosted_rects_.push_back(frosted);
+            raw_flat.push_back(frosted);
+          }
+        }
         continue;
       }
       if (OverlayCandidate::RequiresOverlay(c.quad)) {
@@ -813,10 +872,17 @@ void DirectRenderer::ComputeInline3dPlaneSplit(
             // smallest ones were discarded, so those areas stay 3D (pre-v8
             // ghosting) rather than being merged into a bounding box that would
             // flatten working 3D.
