diff --git a/components/displayxr/gpu/displayxr_weave_gpu_android.cc b/components/displayxr/gpu/displayxr_weave_gpu_android.cc
index c8eb11c1d69f8..df31e6591fdef 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu_android.cc
+++ b/components/displayxr/gpu/displayxr_weave_gpu_android.cc
@@ -129,6 +129,41 @@ bool DisplayXRWeaveGpuAndroid::WeaveRectAndroid(const gfx::Rect& window_rect,
   return true;
 }
 
+// (browser#143) The N-piece form. Viz has repacked this target's eye pair into
+// each piece's own footprint inside the shared staging image (two clipped,
+// translated Skia passes per piece), so a piece is a self-contained
+// side-by-side pair exactly as wide as itself — srcRect == dstRect, and the
+// runtime's existing "split the submitted rect at its own midpoint" rule is
+// already correct on it. Nothing to copy; record one entry per piece.
+//
+// ALL OR NOTHING, like the Windows BatchCopyPiecesFrom: validate every rect
+// before pushing the first, because a half-staged decomposition would submit
+// some of a tile's pieces and silently drop the rest, which reads on the panel
+// as a hole rather than as a failure.
+bool DisplayXRWeaveGpuAndroid::WeaveRectsAndroid(
+    const std::vector<gfx::Rect>& rects,
+    uint32_t target_id) {
+  if (!batch_open_ || rects.empty()) {
+    return false;
+  }
+  for (const gfx::Rect& r : rects) {
+    if (r.IsEmpty() || r.x() < 0 || r.y() < 0) {
+      return false;
+    }
+  }
+  for (const gfx::Rect& r : rects) {
+    batch_entries_.push_back({target_id, r});
+  }
+  // (web#12 / browser#143) NOT recorded as keepable, and DROPPED if it was.
+  // |batch_last_copied_| means "this target's whole pair is at this one rect";
+  // after a repack the staging content at a given address is a function of the
+  // whole decomposition, which changes shape as the occluder moves. Replaying
+  // one recorded rect is unsound, so the record is erased rather than updated
+  // — the decline becomes structural instead of a flag someone must remember.
+  batch_last_copied_.erase(target_id);
+  return true;
+}
+
 // (web#12, patch 0074) Stage this target's entry WITHOUT a copy, so the runtime
 // re-weaves the pixels already sitting at |window_rect| in the shared staging
 // image. Honoured only when |batch_last_copied_| says this exact target wrote
