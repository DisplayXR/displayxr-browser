+  XrResult r = CreateWeaveInstance(exts, /*with_rig=*/s.has_rig_views,
+                                   &s.instance);
   if (XR_FAILED(r) && s.has_rig_views) {
     // The rig extensions only improve inline-3D scene geometry; the weave is
     // the core function. A rig-side rejection (an unmet extension dependency,
-    // a runtime that enumerates but won't enable one) must NOT take the weave
-    // with it — that turns a scene bug into "no 3D on the page at all". Retry
-    // with the weave-only set and run without the rig.
+    // a runtime that enumerates but won't enable one, or — the #92 case — a
+    // displayxr-service that happens to be restarting) must NOT take the weave
