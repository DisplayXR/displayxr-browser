index 8586359d4e2df..7e0310e9bf806 100644
--- a/components/displayxr/browser/displayxr_weave_client.cc
+++ b/components/displayxr/browser/displayxr_weave_client.cc
@@ -78,6 +78,20 @@ struct WeaveClientState {
   bool has_view_rig = false;
   bool has_display_zones = false;
   bool has_rig_views = false;
+  // browser#92 weave-mode negotiation. |degraded| means the weave came up but
+  // the rig did not, i.e. the session is live and batching normally while every
+  // inline-3D scene renders MONO. |renegotiable| is set only on the
+  // browser-process init path:
+  // the GPU process creates its session PRE-SANDBOX and can never create
+  // another (the runtime IPC pipe, the registry and OpenProcess are all past
+  // LowerToken by then), so its only defence is the bounded retry in
+  // PreSandboxInitializeForGpuProcessWin.
+  bool degraded = false;
+  bool degraded_warned = false;
+  bool renegotiable = false;
+  bool renegotiate_disabled = false;
+  int renegotiate_attempts = 0;
+  base::TimeTicks degraded_since;
   PFN_xrConvertWin32PerformanceCounterToTimeKHR convert_time = nullptr;
   // Locate space for the rig locates. LOCAL is display-anchored for a fixed 3D
   // display, so a zone-scoped locate returns element-centred eye poses.
@@ -253,14 +267,192 @@ uint32_t GetExtensionVersion(const std::vector<XrExtensionProperties>& exts,
 // only). Forward-declared so InitializeCore can call it.
 void InstallDragSnapSubclassIfOwned(HWND hwnd);
 
+// browser#92: arm the degraded-mode re-negotiation backoff. Defined far below
+// (it has to reach the sticky-state re-assertion helpers); forward-declared so
+// the init paths can call it.
+void ScheduleRenegotiate();
+
+// browser#92: why an init attempt failed, and therefore whether trying again
+// could ever produce a different answer.
+//
+//   kOk          — session live.
+//   kTransient   — the RUNTIME was there but something on the far side did not
+//                  answer: xrCreateInstance / xrGetSystem / xrCreateSession
+//                  against a displayxr-service that is restarting. Retrying a
+//                  second later routinely succeeds; this is the #92 race.
+//   kUnavailable — a machine fact, not a race: no loader, no runtime, the weave
+//                  extension absent, no weave entry points, no D3D11 device on
+//                  the runtime's adapter. Retrying only burns startup time.
+//
+// The split matters most in the GPU process, where the ONE pre-sandbox attempt
+// decides SyncMode() for the whole process lifetime (see below).
+enum class InitOutcome { kOk, kTransient, kUnavailable };
+
+// browser#92: is a rig-extension rejection PERMANENT for this runtime, or is it
+// the service-restart race? An old runtime that enumerates the rig names but
+// refuses to enable them answers with one of these, and no amount of retrying
+// will change its mind; anything else (XR_ERROR_RUNTIME_FAILURE = -2, the
+// observed value, XR_ERROR_INITIALIZATION_FAILED, XR_ERROR_RUNTIME_UNAVAILABLE)
+// describes the far side, not the feature.
+bool RigRejectionIsPermanent(XrResult r) {
+  switch (r) {
+    case XR_ERROR_EXTENSION_NOT_PRESENT:
+    case XR_ERROR_FEATURE_UNSUPPORTED:
+    case XR_ERROR_API_VERSION_UNSUPPORTED:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// The instance-free extension enumeration (NULL layer name), two-call form.
+// False = the loader/runtime could not answer at all.
+bool EnumerateInstanceExtensions(std::vector<XrExtensionProperties>* out) {
+  uint32_t ext_count = 0;
+  if (XR_FAILED(xrEnumerateInstanceExtensionProperties(nullptr, 0, &ext_count,
+                                                       nullptr))) {
+    return false;
+  }
+  out->assign(ext_count, {XR_TYPE_EXTENSION_PROPERTIES});
+  return XR_SUCCEEDED(xrEnumerateInstanceExtensionProperties(
+      nullptr, ext_count, &ext_count, out->data()));
+}
+
+// Does this runtime OFFER the whole rig set? XR_DXR_local_3d_zone is a hard
+// dependency of display_zones (oxr_verify.c: "XR_DXR_display_zones requires
+// XR_DXR_local_3d_zone and XR_DXR_view_rig"), so a runtime missing it cannot
+// enable zones no matter what we ask for.
+bool RigEnumerated(const std::vector<XrExtensionProperties>& exts) {
+  return HasExtension(exts, XR_DXR_VIEW_RIG_EXTENSION_NAME) &&
+         HasExtension(exts, XR_DXR_DISPLAY_ZONES_EXTENSION_NAME) &&
+         HasExtension(exts, XR_DXR_LOCAL_3D_ZONE_EXTENSION_NAME) &&
+         HasExtension(
+             exts,
+             XR_KHR_WIN32_CONVERT_PERFORMANCE_COUNTER_TIME_EXTENSION_NAME);
+}
+
+// browser#92: build the enabled-extension list and create the instance.
+// |with_rig| selects the FULL set (weave + rig) or the WEAVE-ONLY set.
+//
+// Factored out so InitializeCore and the degraded-mode re-negotiation probe
+// share one list by construction: a probe that tested a different extension set
+// than the real create would prove nothing about whether the real create is
+// going to work.
+//
+// Note what is deliberately NOT in here: the weave SPEC VERSION. That comes
+// from enumeration (GetExtensionVersion), is identical on both branches, and is
+// the only thing the batched submit shape is allowed to depend on — see the
+// invariant comment in SubmitBatchWin. The rig list changes what xrLocateViews
+// can answer; it must never change how pixels are submitted.
+XrResult CreateWeaveInstance(const std::vector<XrExtensionProperties>& exts,
+                             bool with_rig,
+                             XrInstance* out) {
+  std::vector<const char*> enabled = {
+      XR_KHR_D3D11_ENABLE_EXTENSION_NAME,
+      XR_DXR_WIN32_WINDOW_BINDING_EXTENSION_NAME,
+      XR_DXR_WEAVE_EXTENSION_NAME,
+  };
+  if (HasExtension(exts, XR_DXR_DISPLAY_INFO_EXTENSION_NAME)) {
+    enabled.push_back(XR_DXR_DISPLAY_INFO_EXTENSION_NAME);
+  }
+  if (with_rig) {
+    enabled.push_back(XR_DXR_VIEW_RIG_EXTENSION_NAME);
+    enabled.push_back(XR_DXR_DISPLAY_ZONES_EXTENSION_NAME);
+    // Required by display_zones (see RigEnumerated) even though we chain no
+    // local-2D layer — omitting it fails xrCreateInstance outright, which would
+    // take the WEAVE down with it, not just the rig.
+    enabled.push_back(XR_DXR_LOCAL_3D_ZONE_EXTENSION_NAME);
+    enabled.push_back(
+        XR_KHR_WIN32_CONVERT_PERFORMANCE_COUNTER_TIME_EXTENSION_NAME);
+  }
+
+  XrInstanceCreateInfo ci = {XR_TYPE_INSTANCE_CREATE_INFO};
+  UNSAFE_TODO(
+      std::strcpy(ci.applicationInfo.applicationName, "ChromiumInline3D"));
+  ci.applicationInfo.applicationVersion = 1;
+  UNSAFE_TODO(std::strcpy(ci.applicationInfo.engineName, "Chromium"));
+  ci.applicationInfo.apiVersion = XR_CURRENT_API_VERSION;
+  ci.enabledExtensionCount = static_cast<uint32_t>(enabled.size());
+  ci.enabledExtensionNames = enabled.data();
+  return xrCreateInstance(&ci, out);
+}
+
+// browser#92: drop everything an init attempt created, so the NEXT attempt
+// starts from the same state a cold process would. Called on a failed attempt
+// and by the re-negotiation swap.
+//
+// What survives on purpose:
+//   * |hwnd| — the bound browser window does not change, and the re-init binds
+//     the same one (the caller passes it straight back into InitializeCore).
+//   * |latched_screen_flat| — the 0069 sticky screen-flat memo. The RUNTIME's
+//     copy dies with the session, so |latched_screen_flat_valid| is cleared to
+//     force a resend, but the SET itself is the browser's own state and must be
+//     re-asserted verbatim on the new session.
+//   * |rect_*| — a pure cache for the DisplayXRService pull.
+//   * |degraded*| / |renegotiat*| — the negotiation bookkeeping this is
+//     part of.
+//   * |requested_3d| — the last panel hardware state we asked for. The VALIDITY
+//     flag is cleared (the new session has made no request yet) but the
+//     value is kept so the caller can re-assert it.
+void ResetForRetry(WeaveClientState& s) {
+  if (s.ref_space != XR_NULL_HANDLE) {
+    xrDestroySpace(s.ref_space);
+    s.ref_space = XR_NULL_HANDLE;
+  }
+  if (s.session != XR_NULL_HANDLE) {
+    xrDestroySession(s.session);
+    s.session = XR_NULL_HANDLE;
+  }
+  if (s.instance != XR_NULL_HANDLE) {
+    xrDestroyInstance(s.instance);
+    s.instance = XR_NULL_HANDLE;
+  }
+  s.system_id = XR_NULL_SYSTEM_ID;
+  if (s.device) {
+    s.device->Release();
+    s.device = nullptr;
+  }
+  // Instance-scoped function pointers: dangling the moment the instance dies.
+  s.bind_window = nullptr;
+  s.submit = nullptr;
+  s.snap = nullptr;
+  s.set_screen_flat_regions = nullptr;
+  s.request_display_mode = nullptr;
+  s.enumerate_modes = nullptr;
+  s.convert_time = nullptr;
+  // Session-scoped answers that must be re-resolved, not carried over.
+  s.mode_requestable = false;
+  s.mode_requestable_known = false;
+  s.requested_3d_valid = false;
+  s.latched_screen_flat_valid = false;
+  // The DP's phase reference is per-session; a new session's DP has never been
+  // told where this window is. INT32_MIN forces the next SnapWindowIfMoved to
+  // snap even if the window has not moved a pixel.
+  s.last_snap_x = INT32_MIN;
+  s.last_snap_y = INT32_MIN;
+  s.initialized = false;
+}
+
+// Fail an init attempt: release what it built, then decide whether the process
+// is allowed to try again. kUnavailable RE-LATCHES |initialized| — it is a
+// machine fact (no runtime, no weave extension, no D3D11 device on the runtime
+// adapter) and nothing should burn startup time asking twice. kTransient leaves
+// it clear so the caller's retry sees a clean slate.
+InitOutcome FailInit(WeaveClientState& s, InitOutcome outcome) {
+  ResetForRetry(s);
+  s.initialized = (outcome == InitOutcome::kUnavailable);
+  return outcome;
+}
+
 // Everything after the window lookup: forced-IPC env, instance, system,
 // display info, PFNs, D3D11 device, present-owner session, bindWindow. Shared
 // between the browser-process async-retry init (InitializeWin) and the
 // GPU-process pre-sandbox init (PreSandboxInitializeForGpuProcess).
-void InitializeCore(HWND hwnd) {
+InitOutcome InitializeCore(HWND hwnd) {
   WeaveClientState& s = State();
   if (s.initialized) {
-    return;
+    return s.session != XR_NULL_HANDLE ? InitOutcome::kOk
+                                       : InitOutcome::kUnavailable;
   }
   s.initialized = true;
 
