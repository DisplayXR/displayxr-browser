+    // permanent: |degraded| arms the bounded re-negotiation below.
+    const XrResult rig_error = r;
     LOG(ERROR) << "[DisplayXR] xrCreateInstance with the rig extensions failed: "
-               << r << " — retrying weave-only (inline-3D scenes stay mono)";
+               << rig_error << " — retrying weave-only (inline-3D scenes stay "
+                               "mono)";
     s.has_rig_views = false;
-    enabled.resize(weave_ext_count);
-    ci.enabledExtensionCount = static_cast<uint32_t>(enabled.size());
-    ci.enabledExtensionNames = enabled.data();
-    r = xrCreateInstance(&ci, &s.instance);
+    r = CreateWeaveInstance(exts, /*with_rig=*/false, &s.instance);
+    if (XR_SUCCEEDED(r)) {
+      // Only stamp the clock on the TRANSITION into degraded: a
+      // re-negotiation attempt that falls back again is still the same episode,
+      // and restarting the clock would understate how long the user has been
