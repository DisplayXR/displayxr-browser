+// ---------------------------------------------------------------------------
+// browser#92: bounded re-negotiation out of degraded (weave-only) mode.
+// ---------------------------------------------------------------------------
+
+// The backoff. Reasoning, so the numbers are arguable rather than magic:
+//   2s, 5s, 15s   — a displayxr-service restart resolves in SECONDS. This is
+//                   the #92 case (the observed -2 raced a restart at 20:59) and
+//                   the first three attempts are where essentially every real
+//                   recovery happens.
+//   60s           — an SR-stack / plug-in reinstall, or a service that is
+//                   crash-looping and needs a few cycles to settle: minutes.
+//   every 5 min   — beyond that it is almost certainly not a race at all but a
+//                   genuinely old runtime, and the permanent-rejection check
+//                   below has usually already switched us off. A five-minute
+//                   tail is one instance create/destroy per 300s — free — and
+//                   it is what makes "install the new runtime, keep browsing"
+//                   work without a restart.
+int RenegotiateDelaySeconds(int attempt) {
+  // A switch, not an array: indexing a fixed-size array by a variable trips
+  // -Wunsafe-buffer-usage under UNSAFE_BUFFERS_BUILD.
+  switch (attempt) {
+    case 0:
+      return 2;
+    case 1:
+      return 5;
+    case 2:
+      return 15;
+    case 3:
+      return 60;
+    default:
+      return 300;
+  }
+}
+
+void RenegotiateFullInstance() {
+  WeaveClientState& s = State();
+  if (!s.degraded || s.renegotiate_disabled || !s.renegotiable) {
+    return;  // recovered, given up, or not our process
+  }
+  const int attempt = s.renegotiate_attempts++;
+
+  // (1) Does this runtime still OFFER the rig at all? Instance-free, so it
+  //     costs nothing, and it catches the case the permanent-rejection check
+  //     cannot: a runtime DOWNGRADED under a running browser (or a plug-in
+  //     reinstall that dropped the extensions). If the names are simply not
+  //     there, no create will ever enable them — stop asking, for good.
+  std::vector<XrExtensionProperties> exts;
+  if (!EnumerateInstanceExtensions(&exts)) {
+    ScheduleRenegotiate();  // loader busy; try again on the schedule
+    return;
+  }
+  if (!RigEnumerated(exts)) {
+    s.renegotiate_disabled = true;
+    LOG(WARNING) << "[DisplayXR][weave-mode] degraded PERMANENTLY: this "
+                    "runtime does not offer XR_DXR_view_rig + "
+                    "XR_DXR_display_zones — "
+                    "re-negotiation disabled (inline-3D scenes stay mono; the "
+                    "weave and its batched submits are unaffected)";
+    return;
+  }
+
+  // (2) PROBE, don't swap-and-hope. Create a throwaway FULL instance: same
+  //     extension list as the real create (CreateWeaveInstance is shared
+  //     precisely so the two cannot drift), no session, no D3D device, no
+  //     window bind. A failure here costs one XrInstance and tells us the far
+  //     side is still not ready; a success means the real re-init is
+  //     overwhelmingly likely to work, which is what makes it safe to tear the
+  //     working degraded session down.
+  XrInstance probe = XR_NULL_HANDLE;
+  const XrResult pr = CreateWeaveInstance(exts, /*with_rig=*/true, &probe);
+  if (XR_FAILED(pr)) {
+    if (RigRejectionIsPermanent(pr)) {
+      s.renegotiate_disabled = true;
+      LOG(WARNING) << "[DisplayXR][weave-mode] degraded PERMANENTLY: the "
+                      "runtime enumerates the rig extensions but refuses to "
+                      "enable them ("
+                   << pr << ") — re-negotiation disabled";
+      return;
+    }
+    VLOG(1) << "[DisplayXR][weave-mode] re-negotiation attempt " << attempt + 1
+            << " declined (" << pr << "); still degraded";
+    ScheduleRenegotiate();
+    return;
+  }
+  xrDestroyInstance(probe);
+
+  // (3) SWAP. Safe here and only here: every browser-process toucher of State()
+  //     is UI-thread-sequenced — MaybeInitializeFromCommandLine's delayed task,
+  //     InitializeWin's retry chain, this task,
+  //     DisplayXRWeaverImpl::WeaveSubmit
+  //     (chrome_content_browser_client_receiver_bindings.cc posts the bind to
+  //     the UI thread), DisplayXRServiceImpl's LocateViewsForRect, the display-
+  //     mode controller, and the drag subclass (the window's message loop IS
+  //     the UI thread). Nothing can observe the intermediate state because
+  //     nothing else runs between the teardown and the re-init: they are one
+  //     task.
+  //
+  //     The GPU process does NOT do this. Its session is created pre-sandbox
+  //     and its State() is driven from Viz's present thread; post-LowerToken it
+  //     cannot open the runtime IPC pipe at all, so there is nothing to swap
+  //     TO.
+  //     Its defence is the bounded pre-sandbox retry instead.
+  //
+  //     STICKY STATE CARRIED ACROSS THE SWAP (everything in WeaveClientState
+  //     that the runtime holds per-session and would otherwise be lost):
+  //       hwnd                  — same window; passed back into InitializeCore,
+  //                               which re-runs xrCreateSession + bindWindow.
+  //       last_snap_x/y         — reset to INT32_MIN by ResetForRetry so the
+  //                               next SnapWindowIfMoved re-establishes the
+  //                               DP's phase reference even if the window has
+  //                               not moved.
+  //       latched_screen_flat   — 0069's memo. Copied out, cleared, re-sent
+  //                               through SetScreenFlatRegionsWin below (the
+  //                               runtime's set died with the old session).
+  //       requested_3d          — the panel hardware element (browser#55). The
+  //                               validity flag is cleared and the last value
+  //                               re-asserted; re-asking for the SAME state is
+  //                               the safe direction (the dangerous one is 2D
+  //                               while something is still submitting, and
+  //                               nothing submits during this task).
+  //       mode_requestable      — a per-session out-field; ResetForRetry clears
+  //                               the "known" flag so it is re-enumerated.
+  //       PFNs / ref_space      — instance/session-scoped; re-resolved.
+  //       weave_spec_version    — re-read from the fresh enumeration, and it is
+  //                               what the batch shape keys off, so the shape
+  //                               survives the swap by construction.
+  //     Not carried, deliberately: the woven/fence HANDLES held GPU-side. The
+  //     new session's runtime-side `exported` flag starts clear, so its first
+  //     submit re-exports and Viz re-imports — the existing first-submit path.
+  const HWND hwnd = s.hwnd;
+  std::vector<DisplayXRWeaveClient::WeaveRect> flat = s.latched_screen_flat;
+  const bool had_mode = s.requested_3d_valid;
+  const bool want_3d = s.requested_3d;
+
+  ResetForRetry(s);
+  const InitOutcome outcome = InitializeCore(hwnd);
+  if (outcome != InitOutcome::kOk || s.session == XR_NULL_HANDLE) {
+    // We gave up a working (if mono) session and did not get one back. The
+    // probe said yes a millisecond ago, so this is a very narrow race — come
+    // back at the SHORTEST delay rather than continuing the backoff, because
+    // right now inline-3D is not degraded, it is off.
+    LOG(ERROR) << "[DisplayXR][weave-mode] re-negotiation swap FAILED after a "
+                  "successful probe — no session; retrying immediately";
+    s.degraded = true;
+    s.renegotiate_attempts = 0;
+    ScheduleRenegotiate();
+    return;
+  }
+
+  // Re-assert the sticky state on the NEW session.
+  if (!flat.empty()) {
+    SetScreenFlatRegionsWin(flat);
+  }
+  if (had_mode) {
+    RequestDisplayModeWin(want_3d);
+  }
+
+  if (s.degraded) {
+    // Instance came up but the rig still did not take (InitializeCore fell back
+    // again). Stay on the schedule.
+    ScheduleRenegotiate();
+  }
+  // Otherwise InitializeCore has already logged the RECOVERED line and cleared
+  // the degraded bookkeeping.
+}
+
+void ScheduleRenegotiate() {
+  WeaveClientState& s = State();
+  if (!s.degraded || s.renegotiate_disabled || !s.renegotiable) {
+    return;
+  }
+  const int secs = RenegotiateDelaySeconds(s.renegotiate_attempts);
+  VLOG(1) << "[DisplayXR][weave-mode] re-negotiation armed: attempt "
+          << s.renegotiate_attempts + 1 << " in " << secs << "s";
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&RenegotiateFullInstance),
+      base::Seconds(secs));
+}
