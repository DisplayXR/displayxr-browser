+#define CHROME_BROWSER_DISPLAYXR_DISPLAYXR_POPUP_OCCLUDER_TRACKER_H_
+
+// DisplayXR inline-3D popup occluders (browser#88, Phase 3 item B).
+//
+// THE PROBLEM. The omnibox dropdown, autofill popups and every menu are not
+// part of the browser's compositor output. Each is a separate OWNED top-level
+// HWND that DWM composites ABOVE the browser window, so its pixels never reach
+// Viz and can never be woven. The panel underneath, however, is still
+// physically 3D — the lens does not know the popup is there — so the popup's
+// perfectly flat pixels are viewed through a lenticular they did not ask for
+// and read soft and ghosted. (If you want the proof that this is structural
+// rather than incidental, see ui/views/controls/menu/menu_host.cc, which sets
+// force_software_compositing = true for menus on Windows: they are drawn by the
+// software compositor into their own HWND and there is no Viz frame to weave.)
+//
+// WHY THIS IS ITS OWN CHANNEL. Patch 0067 already lets the browser name flat
+// regions, but on the weave SUBMIT — so a region is only republished when a Viz
+// frame is produced. The failing case here is precisely the one with no frames:
+// an inline-3D page sitting IDLE (nothing animating, no damage) when the user
+// clicks the omnibox. A submit-chained wish would never republish and the popup
+// would ghost for as long as it stayed open. Hence XR_DXR_weave v8's STICKY
+// channel (xrWeaveSetScreenFlatRegionsDXR), which the runtime applies
+// immediately: it re-rasters and republishes the wish inside the call.
+//
+// WHAT THIS DOES NOT DO. It does NOT suppress weaving beneath a popup — no
+// subtracting popup rects from the weave rects, no skipping the draw-back
+// there. That was considered and rejected: the omnibox and autofill popups are
+// kTranslucent, with shadows and rounded corners, so a hole punched in the
+// woven output would show raw unwoven page through the popup's own translucency
+// instead of the woven content the user expects behind it. The ghost is a LENS
+// artefact, not a compositing one, and switching the panel's 3D element off
+// over the region removes it outright. Do not "optimize" this into a clip.
+//
+// HOW THE SET IS BUILT. Generically, from two hooks — deliberately NOT by
+// special-casing the three popup types, which would go stale the moment anyone
+// adds a fourth:
+//
+//  1. aura::EnvObserver::OnHostInitialized fires for every new desktop-aura
+//     host, i.e. every new top-level HWND. That is the universal "a popup may
+//     have appeared" edge; it is coarser than a views-level parent hook but it
+//     cannot be routed around by an unusual parenting choice.
+//  2. views::Widget::GetAllOwnedWidgets() on each browser window's native view
+//     then enumerates what actually exists. On Windows that walks the HWND
+//     OWNER relationship (DesktopWindowTreeHostWin::GetOwnedWindowTreeHosts),
+//     which is exactly the relationship DWM composites above the owner — so the
+//     enumeration and the visual problem have the same definition.
+//
+// Each enumerated popup gets a views::WidgetObserver so its subsequent moves,
+// shows/hides and destruction drive a recompute without waiting for another
+// host to be created.
+//
+// FULL SET, EVERY TIME. The runtime latch is sticky and wholesale, so a leaked
+// rect is a permanent flat band over live 3D (risk R7). The set is therefore
+// recomputed from scratch on every event, cleared when inline-3D demand goes
+// away, and cleared on teardown. Nothing accumulates.
+//
+// Browser process, UI thread. Windows-only: the coordinate conversion is
+// display::win::ScreenWin and the consumer is the Windows weave session.
+
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/timer/timer.h"
+#include "ui/aura/env_observer.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace aura {
+class WindowTreeHost;
+}  // namespace aura
+
+namespace views {
+class Widget;
+}  // namespace views
+
+namespace displayxr {
+
+class DisplayXRPopupOccluderTracker : public aura::EnvObserver,
+                                     public views::WidgetObserver {
+ public:
+  // Called with the full set of occluder rects in ABSOLUTE PHYSICAL SCREEN px,
+  // largest-area-first, whenever it changes. An empty vector clears the latch.
+  using SinkCallback =
+      base::RepeatingCallback<void(const std::vector<gfx::Rect>&)>;
+
+  explicit DisplayXRPopupOccluderTracker(SinkCallback sink);
+  ~DisplayXRPopupOccluderTracker() override;
+
+  DisplayXRPopupOccluderTracker(const DisplayXRPopupOccluderTracker&) = delete;
+  DisplayXRPopupOccluderTracker& operator=(
+      const DisplayXRPopupOccluderTracker&) = delete;
+
+  // The panel is only 3D when something demands inline-3D, and a flat hint on a
+  // panel that is already flat is noise. Pushed by the display-mode controller
+  // from its own wish rather than recomputed here, so there is exactly one
+  // definition of "the browser wants 3D" in the process. False clears the set.
+  void SetInline3DDemand(bool demanded);
+
+  // Something outside changed the browser's window set (a window opened,
+  // closed, or changed its active tab). Cheap; just schedules a recompute.
+  void OnBrowserWindowsChanged();
+
+  // The GPU process went away and a new one has nothing latched. Forget what we
+  // believe the runtime is holding — modelling the fresh session as "empty
+  // latch" rather than "unknown" is what keeps a browser with no popups open
+  // from sending a pointless clear (and so from binding the pipe at all).
+  void OnSinkReset();
+
+  // Clear the latch and go inert. For browser shutdown.
+  void Shutdown();
+
+  // aura::EnvObserver:
+  void OnHostInitialized(aura::WindowTreeHost* host) override;
+
+  // views::WidgetObserver:
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override;
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  // (Re)start the coalescing timer. Short on purpose — see kDebounce.
+  void ScheduleRefresh();
+
+  // Recompute, diff against what we last sent, and send if it moved.
+  void Refresh();
+
+  // Every visible owned top-level popup of every browser window, in absolute
+  // physical screen px, coarsened to the wire cap. Also (re)attaches the
+  // per-widget observations as a side effect, since it is the one place that
+  // enumerates.
+  std::vector<gfx::Rect> ComputeOccluders();
+
+  // Attach on first need. aura::Env exists by the time anything demands
+  // inline-3D, and a browser that never shows inline-3D never observes at all.
+  void EnsureEnvObserved();
+
+  void StopObservingWidget(views::Widget* widget);
+  void StopObservingAllWidgets();
+
+  SinkCallback sink_;
+
+  // Popups we currently hold a WidgetObserver on. Entries are removed in
+  // OnWidgetDestroying and when a refresh no longer finds them, so no key ever
+  // dangles.
+  base::flat_set<raw_ptr<views::Widget, CtnExperimental>> observed_widgets_;
+
+  // What the runtime is believed to be holding. Starts EMPTY-and-authoritative
+  // (a fresh session has no latch), which is what makes "send only on change"
+  // silent until there is actually a popup to report.
+  std::vector<gfx::Rect> latched_;
+
+  base::OneShotTimer debounce_;
+
+  bool env_observed_ = false;
+  bool demanded_ = false;
+  bool shutting_down_ = false;
+};
+
+}  // namespace displayxr
+
+#endif  // CHROME_BROWSER_DISPLAYXR_DISPLAYXR_POPUP_OCCLUDER_TRACKER_H_
