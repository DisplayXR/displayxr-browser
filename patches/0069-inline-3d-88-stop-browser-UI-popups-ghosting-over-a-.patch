--- /dev/null
+++ b/chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc
@@ -0,0 +1,352 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/displayxr/displayxr_popup_occluder_tracker.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "ui/aura/env.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/base_window.h"
+#include "ui/display/win/screen_win.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/win/hwnd_util.h"
+
+namespace displayxr {
+
+namespace {
+
+// Deliberately an order of magnitude shorter than the display-mode
+// controller's 300 ms. That timer guards a HARDWARE transition of the whole
+// panel, where being wrong costs a visible full-screen flicker, so it waits for
+// the world to settle. This one only moves a lens hint over pixels that are
+// already correct: nothing flickers if it is wrong, and popup open/close has to
+// feel instant — a third of a second of ghosting on every omnibox click is
+// exactly the bug being fixed. One frame's worth of coalescing is enough to
+// collapse the burst of host-init + show + bounds events a single popup emits,
+// which is all this needs to do (risk R8: it also bounds how often the runtime
+// pays for the immediate re-raster).
+constexpr base::TimeDelta kDebounce = base::Milliseconds(16);
+
+// Mirrors XR_WEAVE_SET_MAX_SCREEN_FLAT_RECTS_DXR (= 8) from XR_DXR_weave spec
+// v8. Not #included: chrome/browser must not depend on the vendored OpenXR
+// headers (they live behind //components/displayxr), so the number is
+// duplicated here and DisplayXRWeaveClient clamps again on its own side — the
+// same split patch 0067 used for the per-submit cap.
+constexpr size_t kMaxScreenFlatRects = 8;
+
+// Reduce |rects| to at most kMaxScreenFlatRects, largest-area-first.
+//
+// Same bias rule as CoarsenInline3dFlatRects() in
+// components/viz/service/display/direct_renderer.cc, and for the same reason:
+// dedupe is lossless (a rect fully inside a kept one adds nothing), but past
+// the cap we DROP rather than merge. A dropped popup keeps ghosting — the
+// pre-v8 status quo — whereas a bounding box around two popups would switch the
+// panel's 3D element off across the live 3D between them, turning a soft edge
+// into a mono regression. Never grow a rect.
+void Coarsen(std::vector<gfx::Rect>* rects) {
+  // Sorting first makes the containment test one-directional: a rect can only
+  // be contained by an EARLIER one, so exact duplicates collapse onto their
+  // first occurrence instead of eliminating each other.
+  //
+  // Area descending, then a positional tie-break. That tie-break is not
+  // cosmetic: the enumeration walks a std::set of Widget POINTERS, so without
+  // it equal-area popups would order by heap address — making both which one is
+  // dropped at the cap and whether the set compares equal to the last one
+  // depend on the allocator.
+  std::sort(rects->begin(), rects->end(),
+            [](const gfx::Rect& a, const gfx::Rect& b) {
+              if (a.size().Area64() != b.size().Area64()) {
+                return a.size().Area64() > b.size().Area64();
+              }
+              if (a.x() != b.x()) {
+                return a.x() < b.x();
+              }
+              if (a.y() != b.y()) {
+                return a.y() < b.y();
+              }
+              return a.width() < b.width();
+            });
+
+  std::vector<gfx::Rect> kept;
+  kept.reserve(std::min(rects->size(), kMaxScreenFlatRects));
+  size_t dropped = 0;
+  for (const gfx::Rect& r : *rects) {
+    if (r.IsEmpty()) {
+      continue;
+    }
+    bool contained = false;
+    for (const gfx::Rect& k : kept) {
+      if (k.Contains(r)) {
+        contained = true;
+        break;
+      }
+    }
+    if (contained) {
+      continue;
+    }
+    if (kept.size() < kMaxScreenFlatRects) {
+      kept.push_back(r);
+    } else {
+      ++dropped;
+    }
+  }
+  if (dropped > 0) {
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      VLOG(1) << "[DisplayXR] popup occluders: " << dropped
+              << " past the cap of " << kMaxScreenFlatRects
+              << " — dropping the smallest (those regions keep ghosting)";
+    }
+  }
+  *rects = std::move(kept);
+}
+
+// The views::Widget of |browser|'s top-level window, or null.
+views::Widget* WidgetFor(BrowserWindowInterface* browser) {
+  ui::BaseWindow* window = browser->GetWindow();
+  if (!window) {
+    return nullptr;
+  }
+  gfx::NativeWindow native_window = window->GetNativeWindow();
+  if (!native_window) {
+    return nullptr;
+  }
+  return views::Widget::GetWidgetForNativeWindow(native_window);
+}
+
+}  // namespace
+
+DisplayXRPopupOccluderTracker::DisplayXRPopupOccluderTracker(SinkCallback sink)
+    : sink_(std::move(sink)) {}
+
+DisplayXRPopupOccluderTracker::~DisplayXRPopupOccluderTracker() {
+  StopObservingAllWidgets();
+  if (env_observed_ && aura::Env::HasInstance()) {
+    aura::Env::GetInstance()->RemoveObserver(this);
+  }
+}
+
+void DisplayXRPopupOccluderTracker::SetInline3DDemand(bool demanded) {
+  if (demanded_ == demanded) {
+    return;
+  }
+  demanded_ = demanded;
+  if (demanded_) {
+    // Only start watching once something actually wants 3D. Nothing before that
+    // point can produce a ghost, and this keeps the whole mechanism off in a
+    // browser that never opens an inline-3D page.
+    EnsureEnvObserved();
+  }
+  // Both directions schedule: true starts hinting, false clears the latch
+  // (risk R7 — the runtime holds the set until told otherwise, so "the panel
+  // went flat anyway" is not a reason to leave rects behind).
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::OnBrowserWindowsChanged() {
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::OnSinkReset() {
+  // A fresh GPU process means a fresh weave session, which latches nothing.
+  // Modelling that as "empty" rather than "unknown" is what stops a
+  // no-popups-open browser from sending a redundant clear through a pipe it
+  // would otherwise never have to bind.
+  latched_.clear();
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::Shutdown() {
+  if (shutting_down_) {
+    return;
+  }
+  debounce_.Stop();
+  // Best-effort: the latch dies with the session anyway, but the GPU process
+  // can outlive the browser's teardown by a moment and a stale flat band is the
+  // one failure mode of this feature that is visible rather than merely absent.
+  if (!latched_.empty()) {
+    latched_.clear();
+    sink_.Run(latched_);
+  }
+  StopObservingAllWidgets();
+  shutting_down_ = true;
+}
+
+void DisplayXRPopupOccluderTracker::OnHostInitialized(
+    aura::WindowTreeHost* host) {
+  // A new top-level HWND exists. It is very likely not visible yet and may not
+  // even be parented yet, so do not try to read it here: schedule, and let the
+  // enumeration find it. If it is still not enumerable when the timer lands,
+  // the WidgetObserver attached on the next enumeration covers it, and if it
+  // never becomes an owned widget it was never a popup over the browser.
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::OnWidgetBoundsChanged(
+    views::Widget* widget,
+    const gfx::Rect& new_bounds) {
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::OnWidgetVisibilityChanged(
+    views::Widget* widget,
+    bool visible) {
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::OnWidgetDestroying(views::Widget* widget) {
+  StopObservingWidget(widget);
+  ScheduleRefresh();
+}
+
+void DisplayXRPopupOccluderTracker::ScheduleRefresh() {
+  if (shutting_down_) {
+    return;
+  }
+  debounce_.Start(FROM_HERE, kDebounce,
+                  base::BindOnce(&DisplayXRPopupOccluderTracker::Refresh,
+                                 base::Unretained(this)));
+}
+
+void DisplayXRPopupOccluderTracker::Refresh() {
+  if (shutting_down_) {
+    return;
+  }
+  // Recomputed from scratch every time; nothing is carried forward. That is the
+  // R7 guard: the only way a rect survives is by still being there.
+  std::vector<gfx::Rect> rects =
+      demanded_ ? ComputeOccluders() : std::vector<gfx::Rect>();
+  if (rects == latched_) {
+    return;  // nothing moved; do not make the runtime re-raster for free
+  }
+  latched_ = std::move(rects);
+  sink_.Run(latched_);
+  VLOG(1) << "[DisplayXR] popup occluders: " << latched_.size()
+          << " rect(s) latched";
+}
+
+std::vector<gfx::Rect> DisplayXRPopupOccluderTracker::ComputeOccluders() {
+  std::vector<gfx::Rect> rects;
+  base::flat_set<views::Widget*> seen;
+
+  // Every browser window, not just the frontmost. Two reasons: it avoids a
+  // second copy of the display-mode controller's foreground policy that could
+  // drift from it, and it is strictly MORE correct — a popup belonging to
+  // another browser window that happens to overlap this one really is a flat
+  // HWND over that part of the panel, so flattening there is right. Rects that
+  // do NOT overlap cost nothing: the runtime intersects them with its own bound
+  // window's client area and they clip away (risk R9).
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this, &rects, &seen](BrowserWindowInterface* browser) {
+        views::Widget* browser_widget = WidgetFor(browser);
+        if (!browser_widget) {
+          return true;
+        }
+        const views::Widget::Widgets owned =
+            views::Widget::GetAllOwnedWidgets(browser_widget->GetNativeView());
+        for (views::Widget* popup : owned) {
+          if (!popup || seen.contains(popup)) {
+            continue;  // owned sets of two windows can legitimately overlap
+          }
+          seen.insert(popup);
+
+          // Only separate TOP-LEVEL widgets. A non-top-level owned widget
+          // shares the browser's compositor, so its pixels DO reach Viz and are
+          // already covered by patch 0067's per-submit flat list — hinting it
+          // again would just spend one of eight wire slots twice.
+          if (!popup->is_top_level()) {
+            continue;
+          }
+          // IsVisible(), not IsVisibleOnScreen(): the strict test is derived
+          // from occlusion tracking and lags, and this hint has to land in the
+          // same frame the popup does. Over-hinting is confined to a popup on a
+          // hidden virtual desktop — where the browser window is not on the
+          // panel either, so there is nothing to flatten wrongly.
+          if (!popup->IsVisible()) {
+            continue;
+          }
+          const gfx::Rect dip = popup->GetWindowBoundsInScreen();
+          if (dip.IsEmpty()) {
+            continue;
+          }
+          // GetWindowBoundsInScreen() is DIP; the runtime wants absolute
+          // PHYSICAL screen px (the XrWeaveWindowGeometryDXR convention). Scale
+          // against the POPUP's own HWND so a popup on a second monitor with a
+          // different DSF converts against that monitor, not the browser's.
+          const HWND popup_hwnd = views::HWNDForWidget(popup);
+          const gfx::Rect screen =
+              display::win::GetScreenWin()->DIPToScreenRect(popup_hwnd, dip);
+          if (screen.IsEmpty()) {
+            continue;
+          }
+          rects.push_back(screen);
+
+          if (!observed_widgets_.contains(popup)) {
+            popup->AddObserver(this);
+            observed_widgets_.insert(popup);
+          }
+        }
+        return true;
+      });
+
+  // Drop observations of popups that are gone or no longer qualify, so the set
+  // does not grow for the life of the process. |seen| is the right filter
+  // rather than |rects|: a widget that still exists but is currently hidden
+  // must stay observed, or its next show would go unnoticed.
+  std::vector<views::Widget*> stale;
+  for (views::Widget* widget : observed_widgets_) {
+    if (!seen.contains(widget)) {
+      stale.push_back(widget);
+    }
+  }
+  for (views::Widget* widget : stale) {
+    StopObservingWidget(widget);
+  }
+
+  Coarsen(&rects);
+  return rects;
+}
+
+void DisplayXRPopupOccluderTracker::EnsureEnvObserved() {
+  if (env_observed_) {
+    return;
+  }
+  // Env is up long before anything can demand inline-3D (a window has to exist
+  // for a page to be in it), but this is not a place to CHECK.
+  if (!aura::Env::HasInstance()) {
+    return;
+  }
+  aura::Env::GetInstance()->AddObserver(this);
+  env_observed_ = true;
+}
+
+void DisplayXRPopupOccluderTracker::StopObservingWidget(
+    views::Widget* widget) {
+  auto it = observed_widgets_.find(widget);
+  if (it == observed_widgets_.end()) {
+    return;
+  }
+  observed_widgets_.erase(it);
+  widget->RemoveObserver(this);
+}
+
+void DisplayXRPopupOccluderTracker::StopObservingAllWidgets() {
+  // Copy first: RemoveObserver must not run while the set is being iterated.
+  std::vector<views::Widget*> widgets(observed_widgets_.begin(),
+                                      observed_widgets_.end());
+  observed_widgets_.clear();
+  for (views::Widget* widget : widgets) {
+    widget->RemoveObserver(this);
+  }
+}
+
+}  // namespace displayxr
