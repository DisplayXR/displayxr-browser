@@ -31,4 +31,23 @@ void DisplayXRDisplayModeImpl::SetDisplayMode(bool three_d) {
   DisplayXRWeaveClient::RequestDisplayMode(three_d);
 }
 
+void DisplayXRDisplayModeImpl::SetPopupOccluders(
+    const std::vector<gfx::Rect>& screen_rects) {
+  // browser#88. Straight pass-through to the v8 sticky wish channel: the
+  // browser owns the policy (which HWNDs, when, debounced) and the client owns
+  // the wire (spec gate, cap, idempotence). Nothing here can usefully refuse —
+  // a pre-v8 runtime leaves the entry point null and the call evaporates.
+  //
+  // gfx::Rect -> WeaveRect the same way the per-frame flat list is converted in
+  // displayxr_weave_gpu.cc, so the client header stays gfx-free. The ORDER is
+  // load-bearing (largest-area-first; the client clamps by dropping the tail),
+  // so it is preserved verbatim.
+  std::vector<DisplayXRWeaveClient::WeaveRect> rects;
+  rects.reserve(screen_rects.size());
+  for (const gfx::Rect& r : screen_rects) {
+    rects.push_back({r.x(), r.y(), r.width(), r.height()});
+  }
+  DisplayXRWeaveClient::SetScreenFlatRegions(rects);
+}
+
 }  // namespace displayxr
