+// =====================================================================
+// browser#103 EXPERIMENT E0 — THROWAWAY DIAGNOSTIC, DO NOT MERGE.
+//
+// A full second xrCreateInstance in whatever process calls this, reusing the
+// REAL init helpers (EnumerateInstanceExtensions + CreateWeaveInstance) rather
+// than a hand-rolled create — a probe that enabled a different extension set
+// than the real create would prove nothing about whether the real create is
+// going to work. This is the same trick 0071's re-negotiation probe already
+// plays; the only new thing is WHERE it runs (post-LowerToken, GPU process).
+//
+// The live session is left completely alone: nothing here touches State().
+// See the header for the g_live_instance caveat.
+// =====================================================================
+DisplayXRWeaveClient::E0CreateProbeResult E0ProbeCreateInstanceWin() {
+  DisplayXRWeaveClient::E0CreateProbeResult out;
+  std::vector<XrExtensionProperties> exts;
+  if (!EnumerateInstanceExtensions(&exts)) {
+    // Interesting on its own: the loader could not answer AT ALL post-sandbox.
+    // That is an ActiveRuntime/manifest read, not the runtime pipe, so it would
+    // localise the failure to R2 rather than to the connection.
+    return out;
+  }
+  out.enumerated = true;
+
+  // Try the FULL set first, then weave-only — the split separates "the loader
+  // and the pipe refused us" (both fail) from "only the rig refused" (the first
+  // fails, the second succeeds), which is exactly the A vs A' fork in §3.
+  XrInstance probe = XR_NULL_HANDLE;
+  out.rig_result = static_cast<int32_t>(
+      CreateWeaveInstance(exts, /*with_rig=*/RigEnumerated(exts), &probe));
+  if (XR_SUCCEEDED(static_cast<XrResult>(out.rig_result)) &&
+      probe != XR_NULL_HANDLE) {
+    out.created = true;
+    xrDestroyInstance(probe);  // immediately — see the g_live_instance caveat
+    return out;
+  }
+
+  probe = XR_NULL_HANDLE;
+  out.weave_only_result = static_cast<int32_t>(
+      CreateWeaveInstance(exts, /*with_rig=*/false, &probe));
+  if (XR_SUCCEEDED(static_cast<XrResult>(out.weave_only_result)) &&
+      probe != XR_NULL_HANDLE) {
+    out.created = true;
+    xrDestroyInstance(probe);
+  }
+  return out;
+}
+
