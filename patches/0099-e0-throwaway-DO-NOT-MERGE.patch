 //
 // The runtime exposes requestability as a per-session out-field of
@@ -2307,6 +2355,17 @@ void DisplayXRWeaveClient::NoteSessionLost(SessionLostReason reason,
 #endif
 }
 
+// static
+// browser#103 E0 — THROWAWAY DIAGNOSTIC, DO NOT MERGE.
+DisplayXRWeaveClient::E0CreateProbeResult
+DisplayXRWeaveClient::E0ProbeCreateInstance() {
+#if BUILDFLAG(IS_WIN)
+  return E0ProbeCreateInstanceWin();
+#else
+  return {};
+#endif
+}
