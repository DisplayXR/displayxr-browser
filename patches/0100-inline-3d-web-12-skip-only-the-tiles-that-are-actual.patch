From daeb25caaf32ae64c6435e184396d7217f3f97b6 Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Sat, 22 Aug 2026 05:55:48 +0000
Subject: [PATCH] inline-3d(web#12): skip only the tiles that are actually
 holes, and latch the logs

A device run showed the 0074 guard firing every frame - misses=2701 and
climbing - and taking six of seven tiles with it: "GPU canvas-layer id
miss ... among 1 canvas layers", then "lookup returned NO resource", then
"weave tile skipped: no clean canvas resource". Those tiles fell back to
raw canvas, regressing content that wove correctly before 0074.

Diagnosed from source, not from the symptom. The registry is not
platform-gated and 0072's registration is not failing. SurfaceAggregator
records a candidate only for a ROOT-pass resource-bearing quad; its
identity join needs a quad stamped with the canvas layer's own id; and
its geometric fallback normalises the overlap by max(quad area, target
area). A canvas that rastered into the enclosing PictureLayer instead of
being promoted to its own composited layer therefore has no isolated
quad at all - it fails the id join (no such quad) AND the geometry
fallback (a page tile's area dwarfs the canvas, so the ratio never
clears 70%). One promoted canvas out of seven yields exactly one entry.
The shortfall is promotion, not matching, and nothing downstream can
repair it.

The actionable half is that the skip test is wrong independently of
that. It asks a per-FRAME question ("was anything suppressed?") to
decide a per-TILE one. display.cc suppresses EXACTLY the resolved canvas
resources - that is what "resolve before suppress" bought - so a tile
absent from the list had its resource left UNSUPPRESSED, and |output| at
its rect still holds the page's own side-by-side quad. Another tile
being suppressed punches no hole in this one. So test whether any
suppressed layer's rect actually covers THIS tile; if none does, degrade
to the pre-0074 snapshot, which is the same thing the "list empty" arm
already does for the same reason. Where a suppressed layer does cover
it, the skip stands - the pollution 0074 exists to prevent is real
there.

Android only. The reasoning is platform-neutral but Windows ships the
frame-scoped test against a failure that produced black tiles, so it
keeps the conservative rule until this has device miles; Android also
has the narrower blast radius, its draw-back being per-rect and now
frosted-clipped.

All three sites relatched to first-3-then-decades (checklist item 15) -
1-in-300 on a steady-state condition is per-frame logging by another
name. Added one latched line naming the promotion cause, so the counts
stop reading like a bug in the lookup.

Refs web#12

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 .../skia_output_surface_impl_on_gpu.cc        | 93 ++++++++++++++++++-
 1 file changed, 89 insertions(+), 4 deletions(-)

diff --git a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
index 10143db675ad0..269c7fa731e9b 100644
--- a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
+++ b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
@@ -3122,9 +3122,15 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
       // is precisely the distinction the no-clean-resource gate below acts on —
       // and at VLOG(1) it was invisible in every default-verbosity run, so
       // "no id-miss lines" was never evidence of absence.
+      // LATCHED (checklist item 15): 1-in-300 is still PER-FRAME logging on a
+      // page where the condition is steady-state - a device run reached
+      // misses=2701 and climbing, which is log bloat, not diagnosis. First 3,
+      // then decades (10th, 100th, 1000th...), so a persistent miss costs ~8
+      // lines for the life of the process while a NEW one still shows up
+      // immediately and the running total stays readable.
       static int id_miss_dbg = 0;
       const int n = id_miss_dbg++;
-      if (n < 3 || (n % 300) == 0) {
+      if (n < 3 || n == 9 || n == 99 || n == 999 || n == 9999) {
         LOG(ERROR) << "[DisplayXR] GPU canvas-layer id miss: id="
                    << id.ToString() << " rect=" << r.ToString() << " among "
                    << inline_3d_canvas_layers_.size()
@@ -3179,13 +3185,34 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     {
       static int null_dbg = 0;
       const int n = null_dbg++;
-      if (n < 3 || (n % 300) == 0) {
+      if (n < 3 || n == 9 || n == 99 || n == 999 || n == 9999) {
         LOG(ERROR)
             << "[DisplayXR] GPU canvas-layer lookup returned NO resource:"
             << " id=" << id.ToString() << " rect=" << r.ToString()
             << " layers=" << inline_3d_canvas_layers_.size()
             << " (misses=" << (n + 1) << ")";
       }
+      // Say the CAUSE once, because the counts alone read like a bug in this
+      // lookup and it is not one. |inline_3d_canvas_layers_| holds one entry
+      // per canvas that got its OWN composited layer, and that is decided far
+      // upstream: SurfaceAggregator records a candidate only for a ROOT-pass
+      // resource-bearing quad, its id join needs a quad stamped with the
+      // canvas layer's own id, and its geometric fallback normalises the
+      // overlap by max(quad area, target area) - so a canvas that rastered
+      // into the enclosing PictureLayer instead of being promoted has NO
+      // isolated quad, matches nothing, and can match nothing. Fewer layers
+      // than tiles means promotion, not matching.
+      if (n == 0 && !inline_3d_canvas_layers_.empty()) {
+        LOG(WARNING)
+            << "[DisplayXR] inline-3D: " << inline_3d_canvas_layers_.size()
+            << " isolated canvas layer(s) for " << inline_3d_rects_.size()
+            << " weave tile(s). A shortfall means those canvases were not "
+               "promoted to their own composited layer this frame, so the "
+               "aggregator had no isolated resource quad to register - check "
+               "canvas promotion, not this lookup. Unpromoted tiles were "
+               "never suppressed either, so they weave from the page snapshot "
+               "(pre-0074 behaviour).";
+      }
     }
     return SkiaOutputSurface::Inline3dLayerMailbox();
   };
@@ -3310,10 +3337,68 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     // produced a black tile. Returning false is also already wired correctly
     // downstream — the caller clears |pending_rect| / |drawn_rect| for this
     // target, so phase (B) will not draw a stale region back for it either.
-    if (clean_sbs_mailbox.IsZero() && !inline_3d_canvas_layers_.empty()) {
+    // (fix12) ...but "list NON-EMPTY" is the WRONG TEST, and on Android it is
+    // wrong for most tiles. The list is per-FRAME while the question is
+    // per-TILE: display.cc suppresses EXACTLY the resolved canvas resources
+    // (that is the whole point of "resolve before suppress"), so a tile whose
+    // canvas is absent from the list had its resource left UNSUPPRESSED and
+    // |output| at its rect still holds the page's own side-by-side quad. One
+    // OTHER tile being suppressed does not punch a hole in THIS one.
+    //
+    // That is not a corner case here. The list holds one entry per canvas that
+    // was promoted to its own composited layer; a device run showed 1 layer
+    // against 7 tiles, so six tiles that wove correctly before 0074 were being
+    // skipped into a raw-canvas fallback by a hole that does not exist at their
+    // rects.
+    //
+    // So test COVERAGE of this tile instead: if any suppressed layer's rect
+    // touches |rect|, the pollution 0074 exists to prevent is possible and the
+    // skip stands. If none does, degrade to the pre-0074 snapshot - which is
+    // exactly what the "list EMPTY" arm above already does for the same reason.
+    //
+    // ANDROID ONLY. The reasoning is platform-neutral, but the Windows path
+    // ships with the frame-scoped test and the failure it guards against is the
+    // one that produced black tiles, so it keeps the conservative rule until
+    // this has device miles. Android additionally has the narrower blast
+    // radius: its draw-back is per-rect and now clipped, so a tile that is not
+    // drawn back leaves the page quad in place rather than a stale region.
+    bool tile_is_a_hole = !inline_3d_canvas_layers_.empty();
+#if BUILDFLAG(IS_ANDROID)
+    tile_is_a_hole = false;
+    for (const auto& c : inline_3d_canvas_layers_) {
+      // Both rects are root-target space, window-relative DEVICE px, y-down -
+      // |c.rect| is the aggregator's compositor-exact quad rect and |rect| is
+      // this tile's clipped visible rect, the same space the weave submits in.
+      gfx::Rect inter = c.rect;
+      inter.Intersect(rect);
+      if (!inter.IsEmpty()) {
+        tile_is_a_hole = true;
+        break;
+      }
+    }
+    if (clean_sbs_mailbox.IsZero() && !tile_is_a_hole &&
+        !inline_3d_canvas_layers_.empty()) {
+      // Latched once: this is the degrade the paragraph above authorises, and
+      // it is a RECOVERY of pre-0074 behaviour, not a new failure - so it must
+      // be visible once and silent thereafter.
+      static bool logged_degrade = false;
+      if (!logged_degrade) {
+        logged_degrade = true;
+        LOG(WARNING) << "[DisplayXR] weave tile has no isolated canvas layer "
+                        "but no suppressed layer covers it (rect="
+                     << rect.ToString() << " layers="
+                     << inline_3d_canvas_layers_.size()
+                     << "); weaving from the page snapshot, which for this tile "
+                        "is real page pixels, not a hole (pre-0074 behaviour)";
+      }
+    }
+#endif
+    if (clean_sbs_mailbox.IsZero() && tile_is_a_hole) {
+      // LATCHED (checklist item 15): first 3, then decades. Steady-state at
+      // 1-in-300 is per-frame logging by another name.
       static int s_noclean = 0;
       const int n = s_noclean++;
-      if (n < 3 || (n % 300) == 0) {
+      if (n < 3 || n == 9 || n == 99 || n == 999 || n == 9999) {
         LOG(ERROR) << "[DisplayXR] weave tile skipped: no clean canvas resource"
                    << " (id=" << inline_3d_rects_[t].id.ToString()
                    << " rect=" << rect.ToString()
