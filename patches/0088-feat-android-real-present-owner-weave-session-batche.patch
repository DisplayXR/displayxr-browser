+package org.chromium.components.displayxr;
+
+import android.content.Context;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JNINamespace;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Hands the application Context to native DisplayXR code (the GPU process's OpenXR loader init).
+ *
+ * <p>Why this class exists at all: the Khronos loader's {@code xrInitializeLoaderKHR} needs a real
+ * {@code XrLoaderInitInfoAndroidKHR{applicationVM, applicationContext}} before ANY other {@code
+ * xr*} call, and it rejects a null Context outright — leaving LoaderInitData uninitialized, after
+ * which runtime discovery never runs and inline-3D is dead.
+ *
+ * <p>Native used to reach the Context by resolving {@code org.chromium.base.ContextUtils} by NAME
+ * (FindClass / ClassLoader.loadClass). That cannot work in a release APK: R8 renames our Java, so
+ * the source name does not exist at run time and the lookup returns null. Generated JNI is the
+ * R8-proof route — jni_zero emits the matching {@code -keep} rules and rewrites the class/method
+ * references alongside the obfuscation, so this survives shrinking.
+ *
+ * <p>Deliberately {@link ContextUtils#getApplicationContextUnsafe()}: a null Context is a condition
+ * the caller reports and disables inline-3D over, not one worth aborting the process for.
+ */
+@JNINamespace("displayxr")
+@NullMarked
+public class DisplayXrContextBridge {
+    private DisplayXrContextBridge() {}
+
+    @CalledByNative
+    private static @Nullable Context getApplicationContext() {
+        return ContextUtils.getApplicationContextUnsafe();
+    }
+}
