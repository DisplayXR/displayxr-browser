+
+// The application Context, fetched reflectively out of org.chromium.base.
+// XR_KHR_android_create_instance wants a VM + an Activity/Context; the GPU
+// process has no Activity, and the runtime only uses the object to reach the
+// package manager / asset loader, so the application Context is the right (and
+// only available) answer here.
+//
+// This is NOT best-effort: the Khronos loader's xrInitializeLoaderKHR rejects a
+// null applicationContext outright, leaving LoaderInitData uninitialized, after
+// which every xr* call fails ("cannot run because xrInitializeLoaderKHR was not
+// successfully called"). So a null here kills inline-3D entirely.
+//
+// Resolving this by NAME is not an option — not env->FindClass() (a natively
+// created Chromium thread has no Java frames, so FindClass sees only the
+// bootstrap class loader), and not base::android::GetClass() either: a release
+// chrome_public_apk is R8-shrunk, so "org.chromium.base.ContextUtils" simply
+// does not exist at run time and the lookup returns null. Generated JNI is the
+// R8-proof route — jni_zero emits the -keep rules and rewrites the references
+// in step with the obfuscation. See DisplayXrContextBridge.java.
+jobject GetApplicationContextOrNull(JNIEnv* env) {
+  if (!env) {
+    LOG(ERROR) << "[DisplayXR] no JNIEnv — cannot reach the application Context";
+    return nullptr;
+  }
+  base::android::ScopedJavaLocalRef<jobject> ctx =
+      Java_DisplayXrContextBridge_getApplicationContext(env);
+  if (ctx.is_null()) {
+    LOG(ERROR) << "[DisplayXR] application Context is null (ContextUtils not "
+                  "initialized in this process?)";
+    return nullptr;
+  }
+  // Global-ref it: this outlives the current JNI frame by the whole session.
+  return env->NewGlobalRef(ctx.obj());
+}
+
+// Create the VkInstance/VkDevice the XR session binds to, via
+// XR_KHR_vulkan_enable2 (xrCreateVulkanInstanceKHR / xrCreateVulkanDeviceKHR),
+// mirroring the reference client. No surface/swapchain extensions: unlike the
+// reference client we do NOT present through Vulkan — Viz presents.
+bool CreateVulkanDevice(AndroidWeaveState& s) {
+  auto get_reqs = GetXr<PFN_xrGetVulkanGraphicsRequirements2KHR>(
+      s.instance, "xrGetVulkanGraphicsRequirements2KHR");
+  auto create_vk_instance = GetXr<PFN_xrCreateVulkanInstanceKHR>(
+      s.instance, "xrCreateVulkanInstanceKHR");
+  auto get_phys = GetXr<PFN_xrGetVulkanGraphicsDevice2KHR>(
+      s.instance, "xrGetVulkanGraphicsDevice2KHR");
+  auto create_vk_device = GetXr<PFN_xrCreateVulkanDeviceKHR>(
+      s.instance, "xrCreateVulkanDeviceKHR");
+  if (!get_reqs || !create_vk_instance || !get_phys || !create_vk_device) {
+    LOG(ERROR) << "[DisplayXR] XR_KHR_vulkan_enable2 PFNs missing";
+    return false;
+  }
+
+  XrGraphicsRequirementsVulkanKHR reqs = {
+      XR_TYPE_GRAPHICS_REQUIREMENTS_VULKAN_KHR};
+  if (XR_FAILED(get_reqs(s.instance, s.system_id, &reqs))) {
+    LOG(ERROR) << "[DisplayXR] xrGetVulkanGraphicsRequirements2KHR failed";
+    return false;
+  }
+
+  VkApplicationInfo app_info = {VK_STRUCTURE_TYPE_APPLICATION_INFO};
+  app_info.pApplicationName = "DisplayXRBrowser";
+  app_info.apiVersion =
+      VK_MAKE_VERSION(XR_VERSION_MAJOR(reqs.minApiVersionSupported),
+                      XR_VERSION_MINOR(reqs.minApiVersionSupported), 0);
+  VkInstanceCreateInfo vk_ici = {VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+  vk_ici.pApplicationInfo = &app_info;
+
+  XrVulkanInstanceCreateInfoKHR xr_vk_ici = {
+      XR_TYPE_VULKAN_INSTANCE_CREATE_INFO_KHR};
