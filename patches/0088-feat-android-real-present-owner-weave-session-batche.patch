+// (Re)publish the window geometry. Required on Android — a bind with no
+// geometry chain leaves the DP weaving display-scoped (ADR-036 D6).
+void EnsureBound(AndroidWeaveState& s) {
+  if (!s.bind_window2 || s.session == XR_NULL_HANDLE) {
+    return;
+  }
+  if (!s.geometry_dirty && s.ever_bound) {
+    return;
+  }
+  if (s.geom_w <= 0 || s.geom_h <= 0) {
+    return;  // nothing sensible to publish yet
+  }
+  XrWeaveWindowGeometryDXR geom = {XR_TYPE_WEAVE_WINDOW_GEOMETRY_DXR};
+  geom.windowOriginOnScreen = {s.geom_x, s.geom_y};
+  geom.clientSize = {s.geom_w, s.geom_h};
+  geom.displayId = s.geom_display;
+
+  XrWeaveBindWindowInfoDXR bind = {XR_TYPE_WEAVE_BIND_WINDOW_INFO_DXR};
+  bind.next = &geom;
+  bind.windowHandle = nullptr;  // Android: the Surface is ours, never the
+                                // runtime's; the geometry chain is everything.
+  const XrResult r = s.bind_window2(s.session, &bind);
+  s.geometry_dirty = false;
+  if (XR_FAILED(r)) {
+    static int fails = 0;
+    if (fails < 3) {
+      ++fails;
+      LOG(ERROR) << "[DisplayXR] xrWeaveBindWindow2DXR failed: " << r;
+    }
+    return;
+  }
+  if (!s.ever_bound) {
+    s.ever_bound = true;
+    LOG(WARNING) << "[DisplayXR] weave window bound: origin " << s.geom_x << ","
+                 << s.geom_y << " client " << s.geom_w << "x" << s.geom_h
+                 << " display " << s.geom_display;
+  }
+}
