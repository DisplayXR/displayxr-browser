 #include "components/viz/common/quads/draw_quad.h"
@@ -479,7 +480,20 @@ class VIZ_SERVICE_EXPORT SurfaceAggregator : public SurfaceObserver {
 
   // DisplayXR inline-3D (#625, Step B / B4b): inline-3d canvas rects from all
   // surfaces, transformed to the root render pass space.
-  std::vector<gfx::Rect> inline_3d_rects_;
+  //
+  // Phase-1 identity: each rect now carries WHO it is. |id| is the element's
+  // TrackedElementId — a real token, stable for the element's lifetime, which
+  // is what the GPU stage keys its per-target weave state by. |sqs_layer_id| +
+  // |layer_namespace_id| are the within-frame join key against
+  // RootResourceQuad, replacing the geometric best-overlap guess. Both are
+  // zero on the legacy main-thread metadata channel.
+  struct Inline3dTrackedRect {
+    gfx::Rect rect;
+    base::Token id;
+    uint32_t sqs_layer_id = 0;
