+++ b/components/viz/service/display/surface_aggregator.cc
@@ -2400,12 +2400,25 @@ AggregatedFrame SurfaceAggregator::Aggregate(
   // DisplayXR inline-3D (#625): deterministic order — the weave consumer keys
   // per-target state by vector index, and the tracked-element and legacy paths
   // enumerate in different orders.
-  std::ranges::sort(
-      inline_3d_rects_, [](const gfx::Rect& a, const gfx::Rect& b) {
-        return std::make_tuple(a.y(), a.x(), a.width(), a.height()) <
-               std::make_tuple(b.y(), b.x(), b.width(), b.height());
-      });
-  frame.inline_3d_rects = std::move(inline_3d_rects_);
+  //
+  // Phase-1 identity: order by ID FIRST. The old (y,x,w,h) order was stable
+  // only while nothing moved: two tiles crossing in the scroll direction swap
+  // their indices, and the index-keyed GPU state (woven mailbox, scratch
+  // image, provider slot, in-flight submit) then followed the wrong tile for a
+  // frame. Identity does not flip. The geometric comparison stays as the
+  // tiebreak so legacy (zero-id) rects keep exactly today's order. Ordering
+  // still matters even once the GPU keys by token: the provider's batch
+  // contract puts the frame's fresh woven/fence handles on the FIRST entry.
+  std::ranges::sort(inline_3d_rects_, [](const Inline3dTrackedRect& a,
+                                         const Inline3dTrackedRect& b) {
+    if (a.id != b.id) {
+      return a.id < b.id;
+    }
+    return std::make_tuple(a.rect.y(), a.rect.x(), a.rect.width(),
+                           a.rect.height()) <
+           std::make_tuple(b.rect.y(), b.rect.x(), b.rect.width(),
+                           b.rect.height());
+  });
   // Exclusion holes (browser#18): same deterministic order for stable logging /
   // comparison only — the weave consumer associates them to targets
   // geometrically, never by index.
@@ -2479,6 +2492,78 @@ AggregatedFrame SurfaceAggregator::Aggregate(
     }
     return found;
   };
+  // DisplayXR Phase-1 identity: the EXACT join, tried before best_match above.
+  // A tracked rect was collected FROM a cc::LayerImpl, and that same LayerImpl
+  // stamped its stable id into the SharedQuadState of every quad it emitted;
+  // the aggregator then namespaced both by client. So equality on
+  // (namespace, layer id) names the quads that draw this element's pixels —
+  // no overlap score, no scroll-lag sensitivity, no ambiguity between
+  // co-located quads. Returns nullopt when the rect carries no identity
+  // (legacy channel) or when nothing in the root pass claims it.
+  auto id_match = [](const Inline3dTrackedRect& target,
+                     const std::vector<RootResourceQuad>& quads)
+      -> std::optional<RootResourceQuad> {
+    if (target.sqs_layer_id == 0) {
+      return std::nullopt;
+    }
+    std::optional<RootResourceQuad> found;
+    for (const RootResourceQuad& cand : quads) {
+      if (cand.sqs_layer_id == target.sqs_layer_id &&
+          cand.layer_namespace_id == target.layer_namespace_id) {
+        // LAST match wins, matching best_match's tie policy: one layer can
+        // emit several quads and the later one is the topmost.
+        found = cand;
+      }
+    }
+    return found;
+  };
+  // Phase-1 identity, risk L2 — DUPLICATE ID. One element can emit more than
+  // one tracked rect in a frame: HTMLCanvasPainter registers the rect on the
+  // canvas's ForeignLayer, and a canvas that ALSO records a background paint
+  // chunk (it has a background colour, a touch-action region, or a wheel
+  // handler) emits a second copy that merges into the enclosing PictureLayer.
+  // Same token, different layer ids — and the GPU keys per-target state by
+  // token, so it cannot hold both. Collapse them, keeping the copy whose layer
+  // id actually names a root resource quad, i.e. the layer holding the pixels.
+  // The id-primary sort above has already made duplicates adjacent.
+  {
+    std::vector<Inline3dTrackedRect> deduped;
+    deduped.reserve(inline_3d_rects_.size());
+    for (const Inline3dTrackedRect& r : inline_3d_rects_) {
+      if (!r.id.is_zero() && !deduped.empty() && deduped.back().id == r.id) {
+        // Deliberately NOT a DCHECK: this is reachable on a perfectly ordinary
+        // page (any inline-3d canvas with a background colour), so it must
+        // degrade, not crash. Prefer the copy that id-matches a root resource
+        // quad; failing that, prefer one that carries an identity at all.
+        const uint32_t incumbent_layer_id = deduped.back().sqs_layer_id;
+        const bool incumbent_matches =
+            id_match(deduped.back(), root_resource_quads_).has_value();
+        const bool new_matches = id_match(r, root_resource_quads_).has_value();
+        if ((new_matches && !incumbent_matches) ||
+            (new_matches == incumbent_matches && incumbent_layer_id == 0 &&
+             r.sqs_layer_id != 0)) {
+          deduped.back() = r;
+        }
+        static int dup_dbg = 0;
+        if ((dup_dbg++ % 60) == 0) {
+          VLOG(1) << "[DisplayXR] inline-3D ID-MATCH FALLBACK: reason="
+                     "duplicate id id="
+                  << r.id.ToString() << " layer_ids=" << incumbent_layer_id
+                  << "/" << r.sqs_layer_id
+                  << " kept=" << deduped.back().sqs_layer_id;
+        }
+        continue;
+      }
+      deduped.push_back(r);
+    }
+    inline_3d_rects_ = std::move(deduped);
+  }
+  // Hand the frame the {rect, id} pairs. |inline_3d_rects_| itself stays alive
+  // for the identity join below, which needs the layer half of the key too.
+  frame.inline_3d_rects.reserve(inline_3d_rects_.size());
+  for (const Inline3dTrackedRect& r : inline_3d_rects_) {
+    frame.inline_3d_rects.push_back({r.rect, r.id});
+  }
   // browser#22 DIAGNOSTIC: why does page-global chrome (the sticky header) blow
   // up for a frame or two during a fast scroll? Two candidate mechanisms, and
   // they need different fixes, so distinguish them explicitly:
@@ -2527,15 +2612,16 @@ AggregatedFrame SurfaceAggregator::Aggregate(
       // (B) declared but unmatched: does it sit over a 3D canvas region? If so
       // it is exactly the chrome-over-tile case we care about — report the
       // overlap so a miss over empty page can be told from a miss over a tile.
-      for (const gfx::Rect& canvas : frame.inline_3d_rects) {
-        if (excl.Intersects(canvas)) {
+      for (const AggregatedFrame::Inline3dTrackedRect& canvas :
+           frame.inline_3d_rects) {
+        if (excl.Intersects(canvas.rect)) {
           static int b_dbg = 0;
           if (b_dbg++ % 30 == 0) {
             gfx::Rect ov = excl;
-            ov.Intersect(canvas);
+            ov.Intersect(canvas.rect);
             VLOG(1) << "[DisplayXR] #22 (B) declared overlay UNMATCHED over a 3D "
                        "canvas: excl="
-                    << excl.ToString() << " canvas=" << canvas.ToString()
+                    << excl.ToString() << " canvas=" << canvas.rect.ToString()
                     << " overlap=" << ov.ToString();
           }
           break;
@@ -2543,10 +2629,34 @@ AggregatedFrame SurfaceAggregator::Aggregate(
       }
     }
   }
-  for (const gfx::Rect& canvas : frame.inline_3d_rects) {
-    if (auto m = best_match(canvas, root_resource_quads_)) {
+  // Phase-1 identity: match each inline-3d canvas rect to the resource quad
+  // that draws it by IDENTITY first, geometry only as a fallback.
+  for (const Inline3dTrackedRect& canvas : inline_3d_rects_) {
+    std::optional<RootResourceQuad> m = id_match(canvas, root_resource_quads_);
+    if (!m) {
+      // Log WHY the exact join could not be used — the two reasons need
+      // different follow-ups, and telling them apart from a log is the whole
+      // value of the marker. Throttled: a persistent fallback would otherwise
+      // spam at frame rate.
+      const char* reason =
+          canvas.sqs_layer_id == 0
+              ? "no layer_id stamped (legacy/TreesInViz channel or pre-Phase-1 "
+                "renderer)"
+              : "layer_id stamped but no root quad carries it (canvas quad "
+                "occluded, in a child pass, or resource not ready)";
+      static int fallback_dbg = 0;
+      if ((fallback_dbg++ % 60) == 0) {
+        VLOG(1) << "[DisplayXR] inline-3D ID-MATCH FALLBACK: reason=" << reason
+                << " id=" << canvas.id.ToString()
+                << " layer_id=" << canvas.sqs_layer_id
+                << " target=" << canvas.rect.ToString() << " among "
+                << root_resource_quads_.size() << " root quads";
+      }
+      m = best_match(canvas.rect, root_resource_quads_);
+    }
+    if (m) {
       frame.inline_3d_canvas_resources.push_back(
-          {m->resource_id, m->rect, m->visible_rect, m->uv});
+          {m->resource_id, m->rect, m->visible_rect, m->uv, canvas.id});
     }
   }
   if (!frame.inline_3d_overlays.empty() ||
@@ -2709,10 +2819,9 @@ void SurfaceAggregator::CollectTrackedElementRects(
     const gfx::Transform& transform_to_root_target,
     const std::optional<gfx::Rect> root_target_clip_rect,
     // DisplayXR Phase-1 identity: carried here so a tracked rect can keep the
-    // namespace half of its (namespace, sqs_layer_id) join key. Consumed by the
-    // canvas identity join and the exclusion join built on top of this patch.
-    [[maybe_unused]] const std::pair<uint32_t, uint32_t>&
-        client_namespace_id) {
+    // namespace half of its (namespace, sqs_layer_id) join key — a layer id is
+    // only unique within one client.
+    const std::pair<uint32_t, uint32_t>& client_namespace_id) {
   // DisplayXR inline-3D (#625, scroll-sync P3): prefer the compositor-thread
   // tracked-element rects for the weave. cc projects them through the layer's
   // ScreenSpaceTransform at DRAW time (live property trees, current impl
@@ -2732,9 +2841,13 @@ void SurfaceAggregator::CollectTrackedElementRects(
         if (rect_data.visible_bounds.IsEmpty()) {
           continue;
         }
-        inline_3d_rects_.push_back(TransformRectToDestRootTargetSpace(
-            rect_data.visible_bounds, target_transform,
-            transform_to_root_target, root_target_clip_rect));
+        // Phase-1 identity: carry the element's token and the (namespace,
+        // layer id) join key alongside the geometry.
+        inline_3d_rects_.push_back(
+            {TransformRectToDestRootTargetSpace(
+                 rect_data.visible_bounds, target_transform,
+                 transform_to_root_target, root_target_clip_rect),
+             rect_data.id, rect_data.sqs_layer_id, client_namespace_id});
         has_tracked_inline3d = true;
       }
       if (has_tracked_inline3d) {
@@ -2759,9 +2872,16 @@ void SurfaceAggregator::CollectTrackedElementRects(
   // old path stays a live fallback and nothing regresses.
   if (!has_tracked_inline3d) {
     for (const gfx::Rect& rect : frame_metadata.inline_3d_rects) {
-      inline_3d_rects_.push_back(TransformRectToDestRootTargetSpace(
-          rect, target_transform, transform_to_root_target,
-          root_target_clip_rect));
+      // Phase-1 identity: the legacy main-thread channel carries no element
+      // token and no layer id. Zeroes here are the documented "no identity"
+      // signal — the consumer falls back to geometric matching and to
+      // positional per-target state, i.e. exactly today's behaviour.
+      inline_3d_rects_.push_back({TransformRectToDestRootTargetSpace(
+                                      rect, target_transform,
+                                      transform_to_root_target,
+                                      root_target_clip_rect),
+                                  base::Token(), /*sqs_layer_id=*/0u,
+                                  std::pair<uint32_t, uint32_t>()});
     }
   }
   // DisplayXR overlay-exclusion rects (browser#18): unconditional — exclusions
diff --git a/components/viz/service/display/surface_aggregator.h b/components/viz/service/display/surface_aggregator.h
index 45642481cdf1b..a61f771384092 100644
--- a/components/viz/service/display/surface_aggregator.h
+++ b/components/viz/service/display/surface_aggregator.h
@@ -17,6 +17,7 @@
 #include "base/containers/flat_set.h"
 #include "base/memory/raw_ptr.h"
 #include "base/rand_util.h"
+#include "base/token.h"
 #include "base/time/time.h"
