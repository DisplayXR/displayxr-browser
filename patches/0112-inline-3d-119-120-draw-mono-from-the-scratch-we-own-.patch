           if (!frosted.IsEmpty()) {
             inline3d_frosted_rects_.push_back(frosted);
             raw_flat.push_back(frosted);
+            // ---- (browser#120) MONO UNDER FROST -------------------------
+            //
+            // (1) removed the weave from this rect and (3) accepted that the
+            // scene behind the glass reads flat. What (1)-(3) never said is
+            // that it reads EMPTY — but that is what ships today, because the
