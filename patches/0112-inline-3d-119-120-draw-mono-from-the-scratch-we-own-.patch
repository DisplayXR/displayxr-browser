 }
 
+void SkiaRenderer::DrawInline3dMonoUnderFrost(
+    const DrawQuad* quad,
+    const absl::InlinedVector<gfx::Rect, 2>& frosted) {
+  // A tile's canvas resource is a TextureDrawQuad. Any other material would
+  // ignore the eye-half override in DrawTextureQuad and draw the RAW
+  // side-by-side squeezed to half width — visibly worse than the void this is
+  // fixing — so refuse rather than guess.
+  if (quad->material != DrawQuad::Material::kTextureContent) {
+    static int mono_material_dbg = 0;
+    const int n = mono_material_dbg++;
+    if (n < 3 || n == 9 || n == 99 || n == 999) {
+      LOG(ERROR) << "[DisplayXR] inline-3D mono-under-frost: tile canvas quad "
+                    "is not a texture quad (material="
+                 << static_cast<int>(quad->material)
+                 << "); the frosted region keeps its void (skips=" << (n + 1)
+                 << ")";
+    }
+    return;
+  }
+  // ONE draw per frosted rect, each with an INTERSECT clip, rather than one
+  // draw clipped to their union: the union of a rect list is not a rect, and
+  // painting mono outside a frosted rect would put a flat left eye where the
+  // weave is about to draw correct stereo. Frosted rects over one tile are a
+  // handful at most (they are per backdrop-filter pass), and overlapping ones
+  // paint the same pixels twice with the same source, which is idempotent.
+  inline3d_mono_left_eye_ = true;
+  for (const gfx::Rect& rect : frosted) {
+    if (rect.IsEmpty()) {
+      continue;
+    }
+    SetInline3dQuadClips({}, rect);
+    DrawQuadParams params =
+        CalculateDrawQuadParams(current_frame()->target_to_device_transform,
+                                scissor_rect_, quad, /*draw_region=*/nullptr);
+    DrawQuadInternal(quad, /*rpdq=*/nullptr, &params);
+  }
+  // Flush before dropping the clip and the eye-half flag: both are applied at
+  // PrepareCanvas / DrawTextureQuad time, so a quad still sitting in the batch
+  // when they change would be replayed under the wrong ones.
+  // SetInline3dQuadClips does the flush itself whenever the clip is live, which
+  // it is here (clip_in has a value), so the reset call below is the flush.
+  SetInline3dQuadClips({}, std::nullopt);
+  inline3d_mono_left_eye_ = false;
+  // Countable, on the 0070 throttle discipline: first 3, then decades. This is
+  // the only line that says the frosted region is being filled at all, and at
+  // VLOG(1) "no lines" would never have been evidence of absence.
+  static int mono_dbg = 0;
+  const int n = mono_dbg++;
+  if (n < 3 || n == 9 || n == 99 || n == 999 || n == 9999) {
+    LOG(ERROR) << "[DisplayXR] inline-3D mono under frost: " << frosted.size()
+               << " rect(s) filled from the suppressed tile canvas (draws="
+               << (n + 1) << ")";
+  }
+}
