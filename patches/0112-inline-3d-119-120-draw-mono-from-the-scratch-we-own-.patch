+        it != inline3d_mono_clips_.end()) {
+      DrawInline3dMonoUnderFrost(quad, it->second);
+      return;
+    }
+  }
   DrawQuadParams params =
       CalculateDrawQuadParams(current_frame()->target_to_device_transform,
                               scissor_rect_, quad, draw_region);
@@ -2832,6 +2907,16 @@ void SkiaRenderer::DrawTextureQuad(const TextureDrawQuad* quad,
       gfx::Size(image->width(), image->height()));
   params->vis_tex_coords = cc::MathUtil::ScaleRectProportional(
       uv_rect, gfx::RectF(quad->rect), params->visible_rect);
+  // (browser#120) MONO: halve the texel window so |visible_rect| maps to the
+  // LEFT EYE of the side-by-side instead of to both, i.e. a 2x horizontal
+  // magnification of the left half over the same destination. Applied to
+  // |vis_tex_coords| — the quad's OWN uv window, already scaled to the visible
+  // rect — and not to the whole texture, for the browser#73 reason: for an
+  // atlased or partially-mapped canvas resource the two are different
+  // rectangles and halving the texture would sample another tile's pixels.
+  if (inline3d_mono_left_eye_) {
+    params->vis_tex_coords.set_width(params->vis_tex_coords.width() * 0.5f);
+  }
 
   gfx::RectF valid_texel_bounds = gfx::RectF(image->width(), image->height());
   // For video frames, `valid_texel_bounds` is VideoFrame::visible_rect which is
