+// ---------------------------------------------------------------------------
+// browser#171: HOLD the release of the whole-panel FLAT until the next weave
+// submit.
+//
+// On every navigation the browser drops inline-3D demand (the old page's
+// session ends), which since browser#159 latches a whole-panel FLAT, and then
+// raises demand again for the new page, which clears it. The runtime services
+// that clear by republishing "from the LAST submitted 3D rects -- they are
+// still the active geometry; only the flat set moved". Across a navigation
+// that is false: the last submitted rects are the PREVIOUS page's. Measured on
+// the gallery, back from a product page:
+//
+//   16:11:07.127 [weave_wish] sticky screen flat regions latched: 0 rect(s)
+//   16:11:07.127 ZONES SVC: wish mask ... 1 3D rect(s) - 0 flat rect(s)
+//   16:11:07.568 inline-3D layers: canvas_res=1   <- new tile resolves only now
+//
+// For those ~0.4 s the lens is ON over a rect the new page has not woven, and
+// whatever 2D sits there is seen through it: the reported "2D element woven on
+// nav back". The browser cannot retract the stale set -- a zero-rect batch
+// submit is refused by the OpenXR layer (rectCount < 1) -- but it can choose
+// WHEN the flat is released: after the new page's first real submit, at which
+// point "the last submitted 3D rects" are the right ones by construction.
+//
+// Rules, each a one-liner in the code below:
+//   * a set that ADDS the whole-panel rect is never held -- flattening is
+//     always safe, and it supersedes any held release;
+//   * a set that REMOVES it while the runtime holds it is deferred until the
+//     next successful submit, then applied on the thread that received it;
+//   * any newer set supersedes a held one (generation-guarded), so a demand
+//     that drops again before the page weaves never gets un-flattened by a
+//     stale release arriving late;
+//   * the re-send after a session re-negotiation goes through the raw
+//     applier, NOT this policy, so a reconnect cannot cancel a held release
+//     (which would leave the panel flat with nothing ever to lift it).
+// A page that demands 3D but never submits stays FLAT. That is the correct
+// rendering of a page that is not weaving.
+//
+// Threads: the policy wrapper and the release run on the sequence that owns
+// WeaveClientState (the GPU main thread, where the mojo receiver lives); the
+// submit runs on Viz's present thread and only ever POSTS the release. The
+// held record is the one thing both touch, hence the lock.
+namespace {
+
+bool IsWholePanelRect(const DisplayXRWeaveClient::WeaveRect& r) {
+  // Mirrors chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc
+  // WholePanelRect(): origin -(1<<20), extent 1<<21. No real screen is a
+  // million px wide, so the extent alone identifies it.
+  return r.w >= (1 << 20) && r.h >= (1 << 20);
+}
+
+bool HasWholePanelRect(
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& rects) {
+  for (const DisplayXRWeaveClient::WeaveRect& r : rects) {
+    if (IsWholePanelRect(r)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct HeldScreenFlat {
+  base::Lock lock;
+  // Bumped by every incoming set; a held release carries the generation it was
+  // recorded under and is dropped if a newer set has since arrived.
+  uint64_t generation = 0;
+  bool valid = false;
+  bool posted = false;
+  std::vector<DisplayXRWeaveClient::WeaveRect> rects;
+  scoped_refptr<base::SequencedTaskRunner> runner;
+};
+
+HeldScreenFlat& Held() {
+  static base::NoDestructor<HeldScreenFlat> held;
+  return *held;
+}
+
+void ReleaseHeldScreenFlat(uint64_t generation) {
+  std::vector<DisplayXRWeaveClient::WeaveRect> rects;
+  {
+    HeldScreenFlat& h = Held();
+    base::AutoLock lock(h.lock);
+    h.posted = false;
+    if (!h.valid || h.generation != generation) {
+      return;  // superseded, or already released
+    }
+    rects = std::move(h.rects);
+    h.rects.clear();
+    h.valid = false;
+  }
+  VLOG(1) << "[DisplayXR] screen-flat latch: whole-panel FLAT released after "
+             "the new page's first weave submit (browser#171)";
+  ApplyScreenFlatRegionsWin(rects);
+}
+
+}  // namespace
+
+// The present thread calls this right after a successful non-empty batch
+// submit. It never touches WeaveClientState; it only posts the release back to
+// the sequence that recorded it.
+void MaybePostHeldScreenFlatRelease() {
+  scoped_refptr<base::SequencedTaskRunner> runner;
+  uint64_t generation = 0;
+  {
+    HeldScreenFlat& h = Held();
+    base::AutoLock lock(h.lock);
+    if (!h.valid || h.posted || !h.runner) {
+      return;
+    }
+    h.posted = true;
+    runner = h.runner;
+    generation = h.generation;
+  }
+  runner->PostTask(FROM_HERE,
+                   base::BindOnce(&ReleaseHeldScreenFlat, generation));
+}
+
+void SetScreenFlatRegionsWin(
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& screen_rects) {
+  WeaveClientState& s = State();
+  const bool incoming_whole = HasWholePanelRect(screen_rects);
+  const bool runtime_holds_whole =
+      s.latched_screen_flat_valid && HasWholePanelRect(s.latched_screen_flat);
+  HeldScreenFlat& h = Held();
+  {
+    base::AutoLock lock(h.lock);
+    ++h.generation;
+    if (runtime_holds_whole && !incoming_whole) {
+      h.valid = true;
+      h.posted = false;
+      h.rects = screen_rects;
+      h.runner = base::SequencedTaskRunner::GetCurrentDefault();
+      VLOG(1) << "[DisplayXR] screen-flat latch: release of the whole-panel "
+                 "FLAT held until the next weave submit (browser#171)";
+      return;
+    }
+    // Everything else applies now and supersedes whatever was held.
+    h.valid = false;
+    h.rects.clear();
+  }
+  ApplyScreenFlatRegionsWin(screen_rects);
+}
+
