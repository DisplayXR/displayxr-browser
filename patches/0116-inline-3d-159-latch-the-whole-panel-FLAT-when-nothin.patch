From 9f5b04b7811eac3fcf9bbb50be691cec4c22e460 Mon Sep 17 00:00:00 2001
From: DisplayXR <dev@displayxr.invalid>
Date: Mon, 24 Aug 2026 20:46:32 -0700
Subject: [PATCH] inline-3d(#159): latch the whole panel FLAT when nothing
 wants 3D

Leaving an inline-3D page -- Back, a tab switch, or just opening a new tab --
left the panel physically in 3D over ordinary 2D content, indefinitely.

The service derives the hardware wish from the weave path, and that wish is
STICKY: it holds the last value a submit gave it. When the 3D content goes
away its compositor STOPS PRODUCING FRAMES, so it never submits the empty set
that would clear the wish. Measured on a clean 2.12.0: last submit and last
wish publish at the same instant, then nothing for minutes, panel still 3D.
DisplayXRDisplayModeController::Apply()'s note that "the weave has already
stopped by now" is true, and is exactly the problem -- a stopped producer
cannot say anything, so SetDisplayMode(false) alone never retracts the mask.

xrWeaveSetScreenFlatRegionsDXR is the channel that can. Its contract says it
is applied immediately, "no submit required... it works while the page is IDLE
and producing no frames at all" -- written for precisely this case. So when
demand goes false, latch ONE full-screen flat rect instead of clearing: the
wish goes empty and the panel returns to 2D. Demand returning restores the
popup-only set, because Refresh() recomputes from scratch.

Routed through the popup tracker rather than a second caller because the
sticky set is WHOLESALE -- two producers would erase each other's rects on
every call. One owner, one set. The tracker already receives the demand edge
(Apply() calls SetInline3DDemand before its early returns) and already owns
the debounce, so this adds no new plumbing.

The full-panel rect is deliberately unmeasured: the runtime intersects screen
flat rects with its own bound window and clips the rest, so an over-large rect
is as correct as a fitted one, cannot go stale across a resolution or monitor
change, and is not a coordinate this process can get wrong. Origin is negative
because a secondary panel can sit left of or above the primary.

Unchanged: a browser that never opens a 3D page still sends nothing (the
demand edge never fires), and Shutdown() still clears rather than leaving a
flat band latched.
---
 .../displayxr_popup_occluder_tracker.cc       | 50 ++++++++++++++++++-
 1 file changed, 48 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc b/chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc
index d3d8eab..b3936c7 100644
--- a/chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc
+++ b/chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc
@@ -35,6 +35,23 @@ namespace {
 // pays for the immediate re-raster).
 constexpr base::TimeDelta kDebounce = base::Milliseconds(16);
 
+// browser#159: one rect that covers any panel, in absolute physical screen px.
+//
+// Deliberately not measured from a display: the runtime intersects screen flat
+// rects with its own bound window's client area and clips the remainder (risk
+// R9, the same property that lets popups from another browser window be sent
+// unconditionally), so an over-large rect is exactly as correct as a fitted one
+// and cannot go stale when the panel is re-arranged, hot-plugged or scaled. It
+// is also not a coordinate this process can get wrong.
+//
+// Negative origin because a secondary display can sit left of or above the
+// primary, putting the panel at negative screen coordinates.
+gfx::Rect WholePanelRect() {
+  constexpr int kOrigin = -(1 << 20);
+  constexpr int kExtent = 1 << 21;
+  return gfx::Rect(kOrigin, kOrigin, kExtent, kExtent);
+}
+
 // Mirrors XR_WEAVE_SET_MAX_SCREEN_FLAT_RECTS_DXR (= 8) from XR_DXR_weave spec
 // v8. Not #included: chrome/browser must not depend on the vendored OpenXR
 // headers (they live behind //components/displayxr), so the number is
@@ -223,8 +240,37 @@ void DisplayXRPopupOccluderTracker::Refresh() {
   }
   // Recomputed from scratch every time; nothing is carried forward. That is the
   // R7 guard: the only way a rect survives is by still being there.
-  std::vector<gfx::Rect> rects =
-      demanded_ ? ComputeOccluders() : std::vector<gfx::Rect>();
+  //
+  // browser#159: when nothing wants 3D, do not merely CLEAR the latch — latch
+  // the WHOLE PANEL flat instead.
+  //
+  // Clearing was correct for popups (no popup, no ghost) but it is not a
+  // retraction of the panel's 3D state, and nothing else retracts it either.
+  // The service derives the hardware wish from the weave path, and that wish is
+  // STICKY: it holds the last value a submit gave it. When the 3D content goes
+  // away — Back, a tab switch, a new tab — its compositor simply STOPS
+  // PRODUCING FRAMES, so it never submits the empty set that would clear the
+  // wish. Measured on 2.12.0: last submit and last wish publish at the same
+  // instant, then nothing, and the panel sat in 3D indefinitely over ordinary
+  // 2D content. Apply()'s "the weave has already stopped by now" is true and is
+  // exactly the problem: a stopped producer cannot say anything.
+  //
+  // This channel is the one that can, and it was built for it —
+  // xrWeaveSetScreenFlatRegionsDXR is applied IMMEDIATELY, "no submit
+  // required... it works while the page is IDLE and producing no frames at
+  // all". A full-screen flat rect makes the wish empty, which is what puts the
+  // panel back to 2D. Restored as soon as demand returns, because the next
+  // Refresh() recomputes from scratch.
+  //
+  // Routed through THIS tracker rather than a second caller on purpose: the
+  // sticky set is WHOLESALE, so two independent producers would each erase the
+  // other's rects on every call. One owner, one set.
+  std::vector<gfx::Rect> rects;
+  if (demanded_) {
+    rects = ComputeOccluders();
+  } else {
+    rects.push_back(WholePanelRect());
+  }
   if (rects == latched_) {
     return;  // nothing moved; do not make the runtime re-raster for free
   }
-- 
