index 9029753948b87..6b9c01382f556 100644
--- a/components/displayxr/browser/displayxr_weave_client.cc
+++ b/components/displayxr/browser/displayxr_weave_client.cc
@@ -49,6 +49,12 @@
 #include "components/displayxr/browser/displayxr_weave_client_mac.h"
 #endif
 
+#if BUILDFLAG(IS_ANDROID)
+// The third dispatcher arm (docs/android-port.md M2). Same shape as the mac
+// header: OpenXR-free, so this TU stays platform-agnostic.
+#include "components/displayxr/browser/displayxr_weave_client_android.h"
+#endif
+
 namespace displayxr {
 
 namespace {
@@ -2882,6 +2888,14 @@ DisplayXRWeaveClient::WeaveSubmitResult DisplayXRWeaveClient::SubmitBatch(
   // makes ignoring it conformant — the panel is simply 3D where the caller asked
   // for flat, which is what ships today.
   return SubmitBatchMac(input_handle, rects, input_is_dxgi, overlay_handle);
+#elif BUILDFLAG(IS_ANDROID)
+  // |input_is_dxgi| is meaningless here (no DXGI); |input_handle| is an
+  // AHardwareBuffer* and the submit must declare
+  // XR_WEAVE_HANDLE_KIND_AHARDWAREBUFFER_DXR. |flat_rects| (v8) is accepted and
+  // ignored: the Android weave path takes flat regions and ignores them
+  // ((void)flat_rects in comp_multi_weave_android.c), and the wish being
+  // advisory makes that conformant.
+  return SubmitBatchAndroid(input_handle, rects, overlay_handle);
 #else
   return {};
 #endif
@@ -2893,6 +2907,8 @@ uint32_t DisplayXRWeaveClient::WeaveSpecVersion() {
   return State().weave_spec_version;
 #elif BUILDFLAG(IS_MAC)
   return WeaveSpecVersionMac();
+#elif BUILDFLAG(IS_ANDROID)
+  return WeaveSpecVersionAndroid();
 #else
   return 0;
 #endif
@@ -2904,6 +2920,8 @@ bool DisplayXRWeaveClient::IsSupported() {
   return IsSupportedWin();
 #elif BUILDFLAG(IS_MAC)
   return IsSupportedMac();
+#elif BUILDFLAG(IS_ANDROID)
+  return IsSupportedAndroid();
 #else
   return false;
 #endif
@@ -3034,6 +3052,8 @@ DisplayXRWeaveClient::LocateViewsForRect(const WeaveRect& rect,
   return LocateViewsForRectWin(rect, virtual_display_height);
 #elif BUILDFLAG(IS_MAC)
   return LocateViewsForRectMac(rect, virtual_display_height);
+#elif BUILDFLAG(IS_ANDROID)
+  return LocateViewsForRectAndroid(rect, virtual_display_height);
 #else
   return {};
 #endif
@@ -3100,6 +3120,11 @@ void DisplayXRWeaveClient::MaybeInitializeFromCommandLine() {
   // retry — the runtime stores window id 0 and the snap is identity). Dormant
   // when the runtime/loader is absent.
   InitializeCoreMac();
+#elif BUILDFLAG(IS_ANDROID)
+  // The session itself belongs to the GPU process on Android (it is the process
+  // that was handed the runtime socket), so this browser-process entry only
+  // checks the seam. See displayxr_weave_client_android.cc.
+  InitializeCoreAndroid();
 #else
   LOG(ERROR) << "[DisplayXR] inline-3D is not supported on this platform yet";
 #endif
diff --git a/components/displayxr/browser/displayxr_weave_client_android.cc b/components/displayxr/browser/displayxr_weave_client_android.cc
new file mode 100644
index 0000000000000..d30cfca0101a7
--- /dev/null
+++ b/components/displayxr/browser/displayxr_weave_client_android.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/displayxr/browser/displayxr_weave_client_android.h"
+
+#include <dlfcn.h>
+#include <stdlib.h>
+
+#include "base/logging.h"
+#include "base/memory/raw_ptr_exclusion.h"
+
+namespace displayxr {
+
+namespace {
+
+// The Khronos OpenXR loader, as installed on the device. Not vendored: unlike
+// Windows (patch 0001 vendors openxr_loader.dll + .lib) there is no prebuilt
+// Android loader in third_party/displayxr, and there must not be a bundled
+// RUNTIME copy either — see the git-tag note in EnsureLoader().
+constexpr char kLoaderSoName[] = "libopenxr_loader.so";
+
+struct AndroidWeaveState {
+  bool tried_loader = false;
+  // Not raw_ptr: these are a dlopen() module handle and a function pointer out
+  // of it, neither of which is a PartitionAlloc allocation.
+  RAW_PTR_EXCLUSION void* loader = nullptr;
+  RAW_PTR_EXCLUSION void* get_instance_proc_addr = nullptr;
+  bool logged_submit = false;
+  uint32_t weave_spec_version = 0;
+};
+
+AndroidWeaveState& State() {
+  static AndroidWeaveState state;
+  return state;
+}
+
+// The adopted runtime socket, published by gpu_main.cc's
+// MaybePublishDisplayXRAdoptedFd(). Its presence is the M2 signal that the
+// browser-side connector worked and this process can talk to the runtime at all;
+// without it there is no point loading anything.
+bool HaveAdoptedRuntimeSocket() {
+  const char* fd = getenv("DXR_IPC_FD");
+  return fd != nullptr && fd[0] != '\0';
+}
+
+// Load the OpenXR loader, but ONLY when the seam is actually present. A vanilla
+// device has no loader and no runtime; dlopen simply fails and we stay dormant
+// rather than crashing.
+//
+// THE GIT-TAG GATE (device bring-up concern, not solved here):
+// ipc_client_check_git_tag() strncmps the runtime CLIENT library's compiled-in
+// u_git_tag against the running displayxr-service's and fails xrCreateInstance
+// on any mismatch. The client library is the runtime .so the Khronos loader
+// pulls out of the INSTALLED runtime package, so the match is automatic as long
+// as nothing here ships its own copy. That is the whole reason this file
+// dlopen()s the system loader by soname instead of linking a vendored runtime:
+// the Android analogue of patch 0001 must vendor the LOADER only, never the
+// runtime.
+bool EnsureLoader() {
+  AndroidWeaveState& s = State();
+  if (s.tried_loader) {
+    return s.loader != nullptr;
+  }
+  s.tried_loader = true;
+
+  if (!HaveAdoptedRuntimeSocket()) {
+    LOG(WARNING) << "[DisplayXR] no adopted runtime socket (DXR_IPC_FD); "
+                    "inline-3D stays dormant in this process";
+    return false;
+  }
+
+  s.loader = dlopen(kLoaderSoName, RTLD_NOW | RTLD_LOCAL);
+  if (s.loader == nullptr) {
+    LOG(WARNING) << "[DisplayXR] " << kLoaderSoName
+                 << " not present; inline-3D stays dormant: " << dlerror();
+    return false;
+  }
+  s.get_instance_proc_addr = dlsym(s.loader, "xrGetInstanceProcAddr");
+  if (s.get_instance_proc_addr == nullptr) {
+    LOG(ERROR) << "[DisplayXR] " << kLoaderSoName
+               << " has no xrGetInstanceProcAddr; refusing to continue";
+    dlclose(s.loader);
+    s.loader = nullptr;
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+void InitializeCoreAndroid() {
+  if (!EnsureLoader()) {
+    return;
+  }
+  // M2 ends here on purpose. The next step (M3) is
+  // xrInitializeLoaderKHR(applicationVM/applicationContext) ->
+  // xrCreateInstance with XR_KHR_android_create_instance + XR_DXR_weave +
+  // XR_DXR_display_info + XR_DXR_view_rig, then the present-owner session and
+  // xrWeaveBindWindow2DXR with a chained XrWeaveWindowGeometryDXR (required on
+  // Android — ADR-036 D6). Doing that here would need the OpenXR headers and a
+  // VM/Context this browser-process TU does not have; the GPU-process backend
+  // (displayxr_weave_gpu_android) is where the session will live.
+  LOG(WARNING) << "[DisplayXR] Android weave seam is present (loader + adopted "
+                  "socket); session bring-up is M3";
+}
+
+bool IsSupportedAndroid() {
+  // No session yet, so nothing to report as supported. Deliberately does NOT
+  // report the mere presence of the loader: the WebXR detection contract is
+  // authoritative on a succeeding requestSession('inline-3d'), and claiming
+  // support we cannot deliver would make that fail late instead of early.
+  return false;
+}
+
+uint32_t WeaveSpecVersionAndroid() {
+  return State().weave_spec_version;
+}
+
+std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectAndroid(
+    const DisplayXRWeaveClient::WeaveRect& rect,
+    float virtual_display_height) {
+  return {};
+}
+
+DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchAndroid(
+    uintptr_t input_handle,
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& rects,
+    uintptr_t overlay_handle) {
+  AndroidWeaveState& s = State();
+  if (!s.logged_submit) {
+    s.logged_submit = true;
+    LOG(WARNING) << "[DisplayXR] SubmitBatchAndroid is not implemented yet (M1: "
+                    "AHardwareBuffer extraction + XR_WEAVE_HANDLE_KIND_"
+                    "AHARDWAREBUFFER_DXR submit); " << rects.size()
+                 << " rect(s) dropped, and this is logged once";
+  }
+  return {};
+}
+
+}  // namespace displayxr
diff --git a/components/displayxr/browser/displayxr_weave_client_android.h b/components/displayxr/browser/displayxr_weave_client_android.h
