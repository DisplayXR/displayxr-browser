diff --git a/components/displayxr/gpu/displayxr_weave_gpu_android.cc b/components/displayxr/gpu/displayxr_weave_gpu_android.cc
new file mode 100644
index 0000000000000..252c44923b893
--- /dev/null
+++ b/components/displayxr/gpu/displayxr_weave_gpu_android.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/displayxr/gpu/displayxr_weave_gpu_android.h"
+
+#if BUILDFLAG(IS_ANDROID)
+
+#include "base/logging.h"
+#include "components/displayxr/browser/displayxr_weave_client_android.h"
+
+namespace displayxr {
+
+DisplayXRWeaveGpuAndroid::DisplayXRWeaveGpuAndroid() {
+  // Same shape as the mac provider: the GPU-process weave session is brought up
+  // in the constructor. On Android that is only possible because the browser
+  // process already handed this process a connected runtime socket and
+  // gpu_main.cc published it as DXR_IPC_FD before we got here.
+  InitializeCoreAndroid();
+}
+
+DisplayXRWeaveGpuAndroid::~DisplayXRWeaveGpuAndroid() = default;
+
+bool DisplayXRWeaveGpuAndroid::IsLive() const {
+  return IsSupportedAndroid();
+}
+
+void DisplayXRWeaveGpuAndroid::BeginBatchSync(const gfx::Size& window_size) {
+  batch_open_ = true;
+  batch_size_ = window_size;
+}
+
+bool DisplayXRWeaveGpuAndroid::WeaveCanvasAndroid(uintptr_t ahardware_buffer,
+                                                  const gfx::Rect& src_rect,
+                                                  const gfx::Rect& window_rect,
+                                                  uint32_t target_id) {
+  if (!logged_unimplemented_) {
+    logged_unimplemented_ = true;
+    LOG(WARNING) << "[DisplayXR] Android weave input assembly is M1 "
+                    "(AHardwareBuffer blit into the shared window-sized input); "
+                    "logged once";
+  }
+  return false;
+}
+
+bool DisplayXRWeaveGpuAndroid::SubmitBatchSync() {
+  if (!batch_open_) {
+    return false;
+  }
+  batch_open_ = false;
+  // The real submit is SubmitBatchAndroid(input AHB, rects, overlay), which
+  // fails gracefully for now.
+  return SubmitBatchAndroid(/*input_handle=*/0, /*rects=*/{},
+                            /*overlay_handle=*/0)
+      .ok;
+}
+
+void DisplayXRWeaveGpuAndroid::PruneTarget(uint32_t target_id) {
+  // Nothing per-target is held yet. M1 releases this target's AHB + fence state
+  // here (patch 0061's contract) BEFORE the caller reuses the id.
+}
+
+}  // namespace displayxr
+
+#endif  // BUILDFLAG(IS_ANDROID)
diff --git a/components/displayxr/gpu/displayxr_weave_gpu_android.h b/components/displayxr/gpu/displayxr_weave_gpu_android.h
new file mode 100644
index 0000000000000..30b7d34922801
--- /dev/null
+++ b/components/displayxr/gpu/displayxr_weave_gpu_android.h
@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_DISPLAYXR_GPU_DISPLAYXR_WEAVE_GPU_ANDROID_H_
+#define COMPONENTS_DISPLAYXR_GPU_DISPLAYXR_WEAVE_GPU_ANDROID_H_
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_ANDROID)
+
+#include <cstdint>
+#include <vector>
+
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace displayxr {
+
+// Android GPU-process weave backend — the third arm of the patch-0052
+// dispatcher, mirroring DisplayXRWeaveGpuMac.
+//
+// M2 SCOPE: a compile-clean skeleton with the real method shape and no GPU work.
+// It is deliberately NOT yet a viz::DisplayXRWeaveProvider subclass: that
+// interface is #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_APPLE) and its per-platform
+// arm takes the platform texture type (ID3D11Texture2D* / IOSurfaceRef). Adding
+// the Android arm — WeaveCanvasAndroid(AHardwareBuffer*, ...) plus widening the
+// header guard — belongs to M1, which is where ProduceOverlayForWeave() starts
+// yielding AHardwareBuffers and there is something real to hand it. Registering
+// a provider that returns false for every call would only make Viz do pointless
+// work every frame.
+//
+// What the M1/M3 implementation has to own, recorded here so it is not
+// rediscovered:
+//   * ONE shared window-sized AHB weave input (SCANOUT usage so the SharedImage
+//     backing routes to the AHardwareBuffer path), blitted per visible element.
+//   * Two fences per frame, because the runtime has NO acquire fence on Android:
+//     wait the producer's ScopedHardwareBufferFenceSync::TakeFence() inbound,
+//     and wait our own blit's VkFence before xrWeaveSubmitDXR.
+//   * PruneTarget(target_id) (patch 0061) releasing whatever per-target AHB /
+//     fence state this ends up holding — seven lines if it copies mac's single-
+//     shared-input design.
+//   * The woven AHardwareBuffer comes back non-NULL on the FIRST submit and on
+//     every reallocation only; cache it and AHardwareBuffer_release() the old
+//     one when it is replaced.
+//
+// Created + called on the GPU main thread.
+class DisplayXRWeaveGpuAndroid {
+ public:
+  DisplayXRWeaveGpuAndroid();
+  DisplayXRWeaveGpuAndroid(const DisplayXRWeaveGpuAndroid&) = delete;
+  DisplayXRWeaveGpuAndroid& operator=(const DisplayXRWeaveGpuAndroid&) = delete;
+  ~DisplayXRWeaveGpuAndroid();
+
+  // True once the weave session in this process is live. False for all of M2.
+  bool IsLive() const;
+
+  // Batch bracket, matching the mac provider's contract:
+  //   BeginBatchSync(window_size);
+  //   WeaveCanvasAndroid(...) per visible target;   // copy-only
+  //   SubmitBatchSync();                            // one synchronous submit
+  void BeginBatchSync(const gfx::Size& window_size);
+  bool WeaveCanvasAndroid(uintptr_t ahardware_buffer,
+                          const gfx::Rect& src_rect,
+                          const gfx::Rect& window_rect,
+                          uint32_t target_id);
+  bool SubmitBatchSync();
+
+  // Drop everything held for one target id (patch 0061's PruneTarget).
+  void PruneTarget(uint32_t target_id);
+
+ private:
+  bool logged_unimplemented_ = false;
+  bool batch_open_ = false;
+  gfx::Size batch_size_;
+};
+
+}  // namespace displayxr
+
+#endif  // BUILDFLAG(IS_ANDROID)
+
+#endif  // COMPONENTS_DISPLAYXR_GPU_DISPLAYXR_WEAVE_GPU_ANDROID_H_
