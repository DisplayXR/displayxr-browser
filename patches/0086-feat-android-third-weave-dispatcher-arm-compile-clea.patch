@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_DISPLAYXR_BROWSER_DISPLAYXR_WEAVE_CLIENT_ANDROID_H_
+#define COMPONENTS_DISPLAYXR_BROWSER_DISPLAYXR_WEAVE_CLIENT_ANDROID_H_
+
+// Android platform impl of the DisplayXRWeaveClient statics — the THIRD arm of
+// the dispatchers in displayxr_weave_client.cc (patch 0052 made them
+// dispatchers; Windows and macOS are the other two). Same shape as
+// displayxr_weave_client_mac.h, and deliberately OpenXR-free so the C++
+// dispatcher TU can include it.
+//
+// M2 SCOPE (docs/android-port.md): this is a compile-clean skeleton. It proves
+// the seam — the adopted socket is visible, the OpenXR loader is reachable —
+// and stops there. The session, the AHardwareBuffer submit path and the
+// per-frame geometry publication are M1/M3.
+//
+// Unlike Windows and macOS, the runtime is NOT reached through a vendored
+// import library here. See InitializeCoreAndroid() for the loader seam and the
+// note on the git-tag gate.
+
+#include <cstdint>
+#include <vector>
+
+#include "components/displayxr/browser/displayxr_weave_client.h"
+
+namespace displayxr {
+
+// Bring up the weave session (idempotent). Dormant — logs and returns — when
+// the runtime seam is absent, so a vanilla device is unaffected.
+void InitializeCoreAndroid();
+
+// True once the weave session is live (backs WebXR isSessionSupported).
+bool IsSupportedAndroid();
+
+// The runtime-reported XR_DXR_weave spec version (0 until initialized).
+uint32_t WeaveSpecVersionAndroid();
+
+// Off-axis (Kooima) views of one inline-3D element. Empty until the rig is
+// live (M3).
+std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectAndroid(
+    const DisplayXRWeaveClient::WeaveRect& rect,
+    float virtual_display_height);
+
+// Batched synchronous weave. On Android |input_handle| will be an
+// AHardwareBuffer* and the submit must chain XrWeaveSubmitHandlesDXR with
+// inputKind = XR_WEAVE_HANDLE_KIND_AHARDWAREBUFFER_DXR (PLATFORM_DEFAULT is
+// wrong here). Not implemented in M2: logs once and fails gracefully.
+DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchAndroid(
+    uintptr_t input_handle,
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& rects,
+    uintptr_t overlay_handle);
+
+}  // namespace displayxr
+
+#endif  // COMPONENTS_DISPLAYXR_BROWSER_DISPLAYXR_WEAVE_CLIENT_ANDROID_H_
