From efe2a8b8a42078baaf9d3b4891f8cc0f308730c8 Mon Sep 17 00:00:00 2001
From: dfattal <dfattal@gmail.com>
Date: Thu, 20 Aug 2026 12:45:58 -0700
Subject: [PATCH] inline-3d(#103): latch sync/batch mode so a dead session
 degrades instead of switching paths
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Today the submit path is chosen by a liveness check:

  DisplayXRWeaveGpu::SyncMode()  = DisplayXRWeaveClient::IsSupported()
  IsSupportedWin()               = session != XR_NULL_HANDLE && submit
  DisplayXRWeaveGpu::BatchMode() = SyncMode() && WeaveSpecVersion() >= 3

That is a latent hole under 0070. Its mono recovery draw — the thing that
replaced browser#99's black flicker with an honest mono tile — runs only
`if (batch && !wove_this_frame)`. So the moment anything nulls the session on a
disconnect, BatchMode() flips false and 0070's recovery draw silently switches
OFF for the whole outage, putting the black flicker back. Worse, the frame then
falls through to the async single-rect mojo path: one rect per call, which is
the degraded signature #96 documents (starved vendor predictor, never-cleared
weave output trails). Recovering into a visibly worse mode is not recovery, and
neither is failing into one.

Fix: latch the mode instead of polling liveness.

  * WeaveClientState gains |sync_session_established|, set once in
    InitializeCore at the instant session + submit are both live (exactly
    IsSupportedWin()'s condition, right after xrWeaveBindWindowDXR). It is
    deliberately NOT cleared by ResetForRetry — which already runs on every
    0071 re-negotiation swap and will run on every #103 reconnect. Only a
    terminal give-up may clear it; nothing gives up terminally yet.
  * New DisplayXRWeaveClient::WasSyncSessionEstablished(); SyncMode() keys off
    it rather than IsSupported() — the two answer different questions (which
    submit path vs. does this machine support inline-3D) and only accidentally
    agreed.
  * IsSupported() is latched the same way, so a page does not lose
    isSessionSupported('inline-3d') for the few seconds an outage lasts.
  * WeaveSpecVersion() keeps the LAST LIVE enumeration. BatchMode() is
    SyncMode() && version >= 3, so an enumeration that answers nothing during
    an outage would demote the submit shape underneath the very latch that
    exists to stop that. |has_weave| still describes the CURRENT enumeration,
    so the availability check is unchanged.

Behaviour is unchanged today because nothing nulls the session: the GPU process
writes the latch exactly once (its session is created pre-sandbox and never
re-created), and the browser process's only teardown is 0071's swap, which
re-inits in the same task. The one window where the latch is observable today
is a 0071 swap that fails after a successful probe — where holding
isSupported() true across the immediate re-arm is the intended contract, not a
regression.

This is the #103 design of record §6.5, and it lands first because it fixes a
0070 hole on its own merit, independent of any detection or reconnect work.

Refs: DisplayXR/displayxr-browser#103, #99, #92, #96
---
 .../browser/displayxr_weave_client.cc         | 62 ++++++++++++++++++-
 .../browser/displayxr_weave_client.h          | 31 ++++++++++
 .../displayxr/gpu/displayxr_weave_gpu.cc      | 22 +++++--
 .../displayxr/gpu/displayxr_weave_gpu.h       | 18 ++++--
 4 files changed, 121 insertions(+), 12 deletions(-)

diff --git a/components/displayxr/browser/displayxr_weave_client.cc b/components/displayxr/browser/displayxr_weave_client.cc
index 5b44079..6e5230a 100644
--- a/components/displayxr/browser/displayxr_weave_client.cc
+++ b/components/displayxr/browser/displayxr_weave_client.cc
@@ -149,6 +149,17 @@ struct WeaveClientState {
   XrSession session = XR_NULL_HANDLE;
   HWND hwnd = nullptr;  // the bound browser top-level window
   bool initialized = false;
+  // browser#103: the submit-path LATCH. True from the first successful
+  // present-owner session create in this process onwards.
+  //
+  // Deliberately NOT cleared by ResetForRetry — which already runs on every
+  // 0071 re-negotiation swap, and will run on every #103 reconnect. The whole
+  // point is that |session| may be XR_NULL_HANDLE for seconds at a time while
+  // the submit SHAPE stays what it was: batch, so 0070's mono recovery draw
+  // keeps running and the frame never falls through to the async single-rect
+  // path. Only a terminal give-up may clear it; nothing gives up terminally
+  // yet. See DisplayXRWeaveClient::WasSyncSessionEstablished().
+  bool sync_session_established = false;
 
   // B3d: static display geometry (XR_DXR_display_info via xrGetSystemProperties)
   // + the latest weave frame, cached for the DisplayXRService renderer pull.
@@ -502,9 +513,20 @@ InitOutcome InitializeCore(HWND hwnd) {
       HasExtension(exts, XR_DXR_WIN32_WINDOW_BINDING_EXTENSION_NAME);
   const bool has_display_info =
       HasExtension(exts, XR_DXR_DISPLAY_INFO_EXTENSION_NAME);
-  s.weave_spec_version =
+  // browser#103: keep the LAST LIVE spec version. |has_weave| still describes
+  // THIS enumeration (a runtime that no longer offers the extension must still
+  // fail the availability check below), but the version number itself is only
+  // ever overwritten by a runtime that answered — because BatchMode() is
+  // SyncMode() && version >= 3, and an enumeration that answers nothing during
+  // an outage would otherwise demote the submit shape underneath the mode latch
+  // that exists precisely to stop that. Identical on a cold init, where the
+  // last-live value is 0 anyway.
+  const uint32_t enumerated_weave =
       GetExtensionVersion(exts, XR_DXR_WEAVE_EXTENSION_NAME);
-  s.has_weave = s.weave_spec_version > 0;
+  if (enumerated_weave > 0) {
+    s.weave_spec_version = enumerated_weave;
+  }
+  s.has_weave = enumerated_weave > 0;
   // The rig set: XR_DXR_view_rig makes the RUNTIME compute the off-axis
   // (Kooima) views, XR_DXR_display_zones scopes each locate to one element's
   // rect, and the KHR time conversion gives xrLocateViews a valid XrTime
@@ -711,6 +733,14 @@ InitOutcome InitializeCore(HWND hwnd) {
                << reinterpret_cast<void*>(s.hwnd) << ") failed -> " << br;
   }
 
+  // browser#103: LATCH the mode. |session| + |submit| are both live here, which
+  // is exactly IsSupportedWin()'s condition — so this is the instant the
+  // process becomes a weaving one, and from here on SyncMode()/BatchMode()/
+  // IsSupported() answer from the latch instead of from the session handle. A
+  // later disconnect then degrades INSIDE the batch path (0070's mono recovery
+  // draw) rather than switching to the async single-rect one.
+  s.sync_session_established = true;
+
   // Rig locates (#625): a LOCAL reference space + a real XrTime. Neither needs
   // a RUNNING session — xrLocateViews validates only the space, the view-config
   // type and displayTime > 0 — so this stays compatible with the submit-only
@@ -1310,9 +1340,24 @@ void PreSandboxInitializeForGpuProcessWin() {
 
 bool IsSupportedWin() {
   WeaveClientState& s = State();
+  // browser#103: latched. Once a session has come up, this machine HAS a
+  // glasses-free 3D display and a runtime that weaves; a service restart does
+  // not change that fact, and answering "no" for the few seconds an outage
+  // lasts would make WebXR's isSessionSupported('inline-3d') flap under pages
+  // that are simply asking whether the feature exists.
+  if (s.sync_session_established) {
+    return true;
+  }
   return s.session != XR_NULL_HANDLE && s.submit != nullptr;
 }
 
+// browser#103: the raw latch, for the callers that must not be fooled by
+// IsSupportedWin()'s pre-latch fallback — DisplayXRWeaveGpu::SyncMode() and
+// BatchMode(), which choose the SUBMIT PATH. See the header.
+bool WasSyncSessionEstablishedWin() {
+  return State().sync_session_established;
+}
+
 // browser#55: may this session drive the panel's 2D/3D element at all?
 //
 // The runtime exposes requestability as a per-session out-field of
@@ -1964,6 +2009,19 @@ bool DisplayXRWeaveClient::IsSupported() {
 #endif
 }
 
+// static
+bool DisplayXRWeaveClient::WasSyncSessionEstablished() {
+#if BUILDFLAG(IS_WIN)
+  return WasSyncSessionEstablishedWin();
+#else
+  // No sandbox split and no #103 disconnect path on the other backends (the mac
+  // weave session is created in-process by the provider itself and there is no
+  // second async path to fall through to), so the latch is exactly "is the
+  // weave live" there.
+  return IsSupported();
+#endif
+}
+
 // static
 void DisplayXRWeaveClient::SnapWindowIfMoved() {
 #if BUILDFLAG(IS_WIN)
diff --git a/components/displayxr/browser/displayxr_weave_client.h b/components/displayxr/browser/displayxr_weave_client.h
index 418b7a0..aa4a0a9 100644
--- a/components/displayxr/browser/displayxr_weave_client.h
+++ b/components/displayxr/browser/displayxr_weave_client.h
@@ -129,6 +129,12 @@ class COMPONENT_EXPORT(DISPLAYXR_WEAVE_CLIENT) DisplayXRWeaveClient {
   // The XR_DXR_weave spec version the RUNTIME reported at extension
   // enumeration (0 until initialized / extension absent). >= 3 means the
   // batched SubmitBatch path is available.
+  //
+  // browser#103: this is the LAST LIVE value. A re-enumeration that answers
+  // nothing (the runtime went away under us) leaves it alone rather than
+  // zeroing it, because BatchMode() = SyncMode() && >= 3 and demoting the
+  // submit shape mid-outage is exactly what WasSyncSessionEstablished() exists
+  // to prevent.
   static uint32_t WeaveSpecVersion();
 
   // One render-ready view, as the RUNTIME computed it for a zone-scoped
@@ -178,8 +184,33 @@ class COMPONENT_EXPORT(DISPLAYXR_WEAVE_CLIENT) DisplayXRWeaveClient {
   // True iff a glasses-free-3D display + runtime is present and the weave
   // session is live (the same session/submit guard SubmitWin uses). Backs
   // WebXR isSessionSupported('inline-3d').
+  //
+  // browser#103: LATCHED once a session has come up — see
+  // WasSyncSessionEstablished(). A weave that is momentarily disconnected is
+  // still a machine on which inline-3D is supported, and a page must not lose
+  // isSessionSupported('inline-3d') for the few seconds an outage lasts.
   static bool IsSupported();
 
+  // browser#103: has a present-owner weave session ever come up in THIS
+  // process? Set once, on the first successful create, and NEVER cleared by a
+  // disconnect — only by a terminal give-up (nothing gives up terminally yet).
+  //
+  // This is the submit-path LATCH and it exists so that a dead session
+  // DEGRADES instead of switching paths. DisplayXRWeaveGpu::SyncMode() and
+  // BatchMode() key off it: were they still keyed off "is the session handle
+  // non-null", nulling the session on a service restart would flip BatchMode()
+  // false, which (a) silently disables 0070's mono recovery draw, so
+  // browser#99's black flicker returns for the whole outage, and (b) hands
+  // every frame to the async single-rect mojo path — one rect per call, the
+  // degraded signature #96 documents (starved vendor predictor, never-cleared
+  // output trails). Recovering into a visibly worse mode is not recovery, and
+  // neither is failing into one.
+  //
+  // WeaveSpecVersion() is preserved across a dead session for the same reason:
+  // BatchMode() is SyncMode() && spec >= 3, so a re-enumeration that answers
+  // nothing must not silently demote the batch shape either.
+  static bool WasSyncSessionEstablished();
+
   // #625 phase-snap (CEF parity): if the bound browser window has moved since the
   // last call, drive xrWeaveSnapWindowRectDXR so the DP re-locks the interlace
   // lattice to the window's new absolute screen position. Idempotent + cheap
diff --git a/components/displayxr/gpu/displayxr_weave_gpu.cc b/components/displayxr/gpu/displayxr_weave_gpu.cc
index 7605c01..b18e1d9 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu.cc
+++ b/components/displayxr/gpu/displayxr_weave_gpu.cc
@@ -58,10 +58,16 @@ void DisplayXRWeaveGpu::Bind() {
 
 // static
 bool DisplayXRWeaveGpu::SyncMode() {
-  // The GPU-owned present session is live iff it was created pre-sandbox
-  // (--inline-3d-sync-weave). IsSupported() is the same session/submit guard the
-  // client uses; it is a process-global in this GPU process.
-  return DisplayXRWeaveClient::IsSupported();
+  // The GPU-owned present session was created pre-sandbox
+  // (--inline-3d-sync-weave). This asks the LATCH ("did that session ever come
+  // up in this process"), not "is the session handle non-null right now" —
+  // browser#103. The distinction is invisible today, because nothing nulls the
+  // session, and load-bearing the moment something does: SyncMode() picks the
+  // SUBMIT PATH, and a dead session must degrade inside the batch path (0070's
+  // mono recovery draw) rather than silently hand every frame to the async
+  // single-rect mojo one. See
+  // DisplayXRWeaveClient::WasSyncSessionEstablished().
+  return DisplayXRWeaveClient::WasSyncSessionEstablished();
 }
 
 // static
@@ -423,6 +429,14 @@ bool DisplayXRWeaveGpu::SubmitSync(WeaveInput& in,
 bool DisplayXRWeaveGpu::BatchMode() const {
   // Spec v3 is required for the chained rect-array submit; a spec-v2 runtime
   // keeps the per-target SubmitSync loop (still correct, just N submits).
+  //
+  // browser#103: BOTH terms are now latched — SyncMode() off
+  // WasSyncSessionEstablished(), WeaveSpecVersion() off the last LIVE
+  // enumeration. That is what makes this answer STABLE across a service
+  // restart, which 0070's recovery draw depends on: it runs only `if (batch &&
+  // !wove_this_frame)`, i.e. the exact condition an outage produces. A
+  // BatchMode() that went false during the outage would turn browser#99's
+  // black flicker back on for its whole duration.
   return SyncMode() && DisplayXRWeaveClient::WeaveSpecVersion() >= 3;
 }
 
diff --git a/components/displayxr/gpu/displayxr_weave_gpu.h b/components/displayxr/gpu/displayxr_weave_gpu.h
index a6b9568..b2aa3c5 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu.h
+++ b/components/displayxr/gpu/displayxr_weave_gpu.h
@@ -67,9 +67,9 @@ class DisplayXRWeaveGpu : public viz::DisplayXRWeaveProvider {
   void PruneTarget(uint32_t target_id) override;
   // Batched sync weave (spec v3, #625): one shared window-sized input, ONE
   // xrWeaveSubmitDXR per frame carrying every visible rect. BatchMode() is
-  // true iff the GPU-owned sync session is live AND the runtime reported
-  // XR_DXR_weave spec >= 3; a spec-v2 runtime falls back to the per-target
-  // SubmitSync loop untouched.
+  // true iff the GPU-owned sync session HAS COME UP (SyncMode(), latched —
+  // browser#103) AND the runtime reported XR_DXR_weave spec >= 3; a spec-v2
+  // runtime falls back to the per-target SubmitSync loop untouched.
   bool BatchMode() const override;
   void BeginBatchSync(const gfx::Size& window_size) override;
   bool SubmitBatchSync() override;
@@ -131,11 +131,17 @@ class DisplayXRWeaveGpu : public viz::DisplayXRWeaveProvider {
                    const gfx::Rect& window_rect,
                    uint32_t target_id);
 
-
   // #625 zero-lag: true iff the OpenXR weave session lives IN this GPU process
   // (created pre-sandbox, --inline-3d-sync-weave). When true the submit is a
-  // direct synchronous xrWeaveSubmitDXR on this thread (no mojo, no browser hop);
-  // when false the legacy async mojo path to the browser bridge is used.
+  // direct synchronous xrWeaveSubmitDXR on this thread (no mojo, no browser
+  // hop); when false the legacy async mojo path to the browser bridge is used.
+  //
+  // browser#103: this is a LATCH — "did that session ever come up" — not a
+  // liveness check. It never flips back once true, so a weave session that dies
+  // mid-run (a displayxr-service restart) leaves the submit PATH alone and
+  // degrades within it. Flipping to the async path mid-run would be a visible
+  // regression, not a fallback: one rect per call, starved vendor predictor,
+  // never-cleared output trails (#96).
   static bool SyncMode();
 
   // Synchronous in-process weave for |target_id|: xrWeaveSubmitDXR returns the
