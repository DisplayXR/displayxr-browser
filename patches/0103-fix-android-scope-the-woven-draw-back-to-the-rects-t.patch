From 4c005b60a975d435c756d9c624cc467a8ba33850 Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Sat, 22 Aug 2026 08:58:43 +0000
Subject: [PATCH] fix(android): scope the woven draw-back to the rects the
 runtime wove
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

wall-3d (10 tiles) reported the full chain green and every tile woven, but the
human saw ONLY the woven layer — the 2D page was gone.

The whole-window kSrcOver draw-back was a faithful port of Windows patch 0046,
and 0046's licence to ignore rects is a RUNTIME guarantee: the runtime "clears
the gaps to transparent on the frame's first chunk" (spec v5, in.firstChunk).
On Windows that guarantee is real and it covers BOTH buffers —
comp_d3d11_service.cpp clears the SBS input atlas (weave_sbs_rtv) AND the woven
OUTPUT (weave_output_rtv, at two separate sites).

On Android only half of it exists. comp_multi_weave_android.c clears the SBS
INPUT scratch on firstChunk (vkCmdClearColorImage on weave.sbs_image) and that
is the ONLY clear in the file. The woven OUTPUT is rendered through a render
pass declared .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD and is never cleared, while
process_atlas is a FULL-TARGET weave — so what lands in a gap is whatever the
display processor writes for a transparent input, an alpha this side has no
contract for. Sampled whole-window, a page whose tiles leave large gaps has its
entire 2D layer covered. Ten tiles is simply the first layout with gaps big
enough to make it unmissable.

So put the rects back, but ONLY as a CLIP. The runtime's placement stays
authoritative inside it: src == dst, so every pixel is still sampled from the
window coordinate the runtime wove it at.

This is NOT a return to the pre-0046 per-tile draw, and it does not reintroduce
that draw's coherent lateness, because the meaning of |drawn_rect| is tightened
in the same change: a target carrying NO RECT this frame now has its
pending/drawn rects cleared. The |absent_frames| grace deliberately keeps a
TARGET alive across a blip (a re-raster, a lazy-activation margin, a lost race,
all of which a scroll produces constantly) — but its GEOMETRY is only ever valid
for the frame that supplied it, and leaving it set is precisely what let the old
per-tile draw paint a target at an older frame's rect. |drawn_rect| now means
"wove THIS frame, at THIS frame's rect", so there is no stale rect left to be
late at. Zero lag is preserved; only the unwoven gaps are excluded.

Expressed as N sub-rect blits of the same image rather than a region clip, for
a handful of rects. kSrcOver as 0046 established: patch 0050 pre-blends the page
backdrop under the SBS, so a tile leaves the weave with alpha = 1 and kSrcOver
and kSrc coincide inside a tile.

The durable fix is runtime-side — clear the woven output on firstChunk, as the
D3D11 service already does. This clip is the belt that makes the browser
independent of that guarantee either way.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 .../skia_output_surface_impl_on_gpu.cc        | 91 +++++++++++++++++--
 1 file changed, 81 insertions(+), 10 deletions(-)

diff --git a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
index e7f94b5348c2b..4ec3814475b52 100644
--- a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
+++ b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
@@ -4252,6 +4252,32 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     }
   }
 
+  // A target that carries NO RECT this frame did not take part in this frame's
+  // weave, so it must not keep a rect that says it did. |absent_frames| grace
+  // deliberately keeps the TARGET alive across a blip (a re-raster, a lazy
+  // activation margin, a lost race) — but its GEOMETRY is only ever valid for
+  // the frame that supplied it. Leaving it set is what let the draw-back paint
+  // a target at a rect from an older frame, which is the coherent lateness the
+  // whole-window draw was brought in to end. The draw-back below is scoped to
+  // woven rects again (gap alpha is not guaranteed on Android — see there), so
+  // the invariant now has to be ENFORCED here rather than sidestepped.
+  //
+  // |pending_rect| goes with it: on the batch path the two always move together
+  // and a stale pending would simply be promoted back into |drawn_rect|.
+  for (auto& [absent_key, absent_st] : displayxr_targets_) {
+    bool present = false;
+    for (size_t t = 0; t < inline_3d_rects_.size(); ++t) {
+      if (DisplayXRTargetKey(inline_3d_rects_[t], t) == absent_key) {
+        present = true;
+        break;
+      }
+    }
+    if (!present) {
+      absent_st.pending_rect = gfx::Rect();
+      absent_st.drawn_rect = gfx::Rect();
+    }
+  }
+
   if (batch) {
     // (browser#88 Phase 3 Stage 2) Hand the runtime this frame's FLAT rects
     // before closing the batch, so they ride the same submit as the rects they
@@ -5465,18 +5491,63 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
         out_canvas->clipRect(gfx::RectToSkRect(frosted), SkClipOp::kDifference,
                              /*doAntiAlias=*/false);
       }
-      gfx::Rect woven_rect(displayxr_shared_woven_size_);
-      woven_rect.Intersect(window_bounds);
-      if (!woven_rect.IsEmpty()) {
-        const SkRect src_dst =
-            SkRect::MakeXYWH(woven_rect.x(), woven_rect.y(),
-                             woven_rect.width(), woven_rect.height());
+      // ---- Scoped to the rects the runtime WOVE THIS FRAME ----
+      //
+      // The whole-window draw this replaces was a faithful port of Windows
+      // patch 0046, and 0046's licence to ignore rects is a RUNTIME guarantee:
+      // "the runtime ... clears the gaps to transparent on the frame's first
+      // chunk" (spec v5, in.firstChunk). On Windows that is real and it clears
+      // BOTH buffers — comp_d3d11_service.cpp clears the SBS atlas
+      // (weave_sbs_rtv) AND the woven OUTPUT (weave_output_rtv, two sites).
+      //
+      // On Android only half of it exists. comp_multi_weave_android.c clears
+      // the SBS INPUT scratch on firstChunk (vkCmdClearColorImage on
+      // weave.sbs_image) and that is the ONLY clear in the file: the woven
+      // OUTPUT is rendered with .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD and is
+      // never cleared, while process_atlas is a FULL-TARGET weave. So what
+      // lands in a gap is whatever the display processor writes for a
+      // transparent input — an alpha this side has no contract for. Sampled
+      // whole-window, a page whose tiles leave large gaps (wall-3d, 10 tiles)
+      // gets its entire 2D layer covered.
+      //
+      // So put the rects back, but ONLY as a CLIP. The runtime's placement
+      // stays authoritative inside it: src == dst, so every pixel is still
+      // sampled from the window coordinate the runtime wove it at. This is NOT
+      // a return to the pre-0046 per-tile draw — |drawn_rect| now means "wove
+      // THIS frame, at THIS frame's rect", because a target absent from this
+      // frame's rect list has just had it cleared above. There is no stale rect
+      // left to be late at, so zero lag is preserved and only the unwoven gaps
+      // are excluded.
+      //
+      // Equivalent to one clipped whole-window blit, expressed as N sub-rect
+      // blits of the same image rather than building a region for a handful of
+      // rects. kSrcOver as 0046 established: patch 0050 pre-blends the page
+      // backdrop under the SBS, so a tile leaves the weave with alpha = 1 and
+      // kSrcOver and kSrc coincide inside a tile.
+      //
+      // The durable fix is runtime-side (clear the woven output on firstChunk,
+      // as the D3D11 service already does); this clip is the belt that makes
+      // the browser independent of that guarantee either way.
+      const gfx::Rect woven_bounds = gfx::IntersectRects(
+          gfx::Rect(displayxr_shared_woven_size_), window_bounds);
+      {
         SkPaint paint;
         paint.setBlendMode(SkBlendMode::kSrcOver);
-        out_canvas->drawImageRect(woven_img.get(), src_dst, src_dst,
-                                  SkSamplingOptions(SkFilterMode::kNearest),
-                                  &paint, SkCanvas::kStrict_SrcRectConstraint);
-        drew_any = true;
+        for (const auto& [woven_key, woven_st] : displayxr_targets_) {
+          const gfx::Rect r =
+              gfx::IntersectRects(woven_st.drawn_rect, woven_bounds);
+          if (r.IsEmpty()) {
+            continue;
+          }
+          const SkRect src_dst =
+              SkRect::MakeXYWH(r.x(), r.y(), r.width(), r.height());
+          out_canvas->drawImageRect(woven_img.get(), src_dst, src_dst,
+                                    SkSamplingOptions(SkFilterMode::kNearest),
+                                    &paint, SkCanvas::kStrict_SrcRectConstraint);
+          drew_any = true;
+        }
+      }
+      if (drew_any) {
         // COUNT WHAT WOVE, not what exists. The draw is now one whole-window
         // blit, so there is no per-tile draw to count — but reporting
         // displayxr_targets_.size() here would report the target COUNT and read
