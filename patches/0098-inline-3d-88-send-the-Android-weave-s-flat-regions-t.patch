From 2eb342555f96bd1e102abae6941ccba110a6bd9c Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Sat, 22 Aug 2026 02:35:03 +0000
Subject: [PATCH] inline-3d(88): send the Android weave's flat regions to the
 runtime

SkiaOutputSurfaceImplOnGpu computes this frame's flat rects, clips them
to the window and calls provider->SetBatchWish() on every batch
platform - and on Android that landed on DisplayXRWeaveProvider's
default no-op, so the list was computed and thrown away.

Plumb it the way Windows does: override SetBatchWish in the Android
provider, clear it in BeginBatchSync (a stale wish is worse than none -
after a scroll it switches the panel's 3D element off over live 3D), and
chain XrWeaveSubmitFlatRegionsDXR on the LAST batch chunk. Gated on the
runtime reporting weave spec >= 8 so the pre-v8 wire is byte-identical
rather than merely probably-ignored - an older runtime sees a struct
type it has never heard of, and the browser does not get to assume every
shipped runtime walks unknown chains politely.

Clamped by dropping the TAIL, exactly as SubmitBatchWin does: the
producer already coarsened largest-area-first via kInline3dMaxFlatRects,
so the tail IS the smallest regions. Dropping one leaves its area 3D
(only the pre-v8 ghosting); merging into a bounding box would switch the
lens off over working 3D, which is a mono regression. Never merge.

Units at every interface: window-relative device px, y-down, the same
space as the weave rects. No scaling, no rebasing, no y-flip.

Verified rather than assumed, and recorded because it changes how to
read a device test: the far end discards the list today -
comp_multi_weave_android.c does (void)flat_rect_count; (void)flat_rects;.
That is conformant because the wish is ADVISORY (it moves the hardware
element, never content), and closing the wire now is deliberate: the
browser is the only party that knows this geometry, so a runtime arm
growing a publisher must not also need a browser release.

Refs browser#88

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 .../browser/displayxr_weave_client.cc         | 16 +++--
 .../browser/displayxr_weave_client_android.cc | 67 ++++++++++++++++++-
 .../browser/displayxr_weave_client_android.h  | 22 +++++-
 .../gpu/displayxr_weave_gpu_android.cc        | 37 +++++++++-
 .../gpu/displayxr_weave_gpu_android.h         | 17 +++++
 5 files changed, 151 insertions(+), 8 deletions(-)

diff --git a/components/displayxr/browser/displayxr_weave_client.cc b/components/displayxr/browser/displayxr_weave_client.cc
index 6b9c01382f556..faeabb9fc2fb0 100644
--- a/components/displayxr/browser/displayxr_weave_client.cc
+++ b/components/displayxr/browser/displayxr_weave_client.cc
@@ -2891,11 +2891,17 @@ DisplayXRWeaveClient::WeaveSubmitResult DisplayXRWeaveClient::SubmitBatch(
 #elif BUILDFLAG(IS_ANDROID)
   // |input_is_dxgi| is meaningless here (no DXGI); |input_handle| is an
   // AHardwareBuffer* and the submit must declare
-  // XR_WEAVE_HANDLE_KIND_AHARDWAREBUFFER_DXR. |flat_rects| (v8) is accepted and
-  // ignored: the Android weave path takes flat regions and ignores them
-  // ((void)flat_rects in comp_multi_weave_android.c), and the wish being
-  // advisory makes that conformant.
-  return SubmitBatchAndroid(input_handle, rects, overlay_handle);
+  // XR_WEAVE_HANDLE_KIND_AHARDWAREBUFFER_DXR. |flat_rects| (v8) is now SENT,
+  // window-relative device px, chained on the last chunk exactly as on Windows.
+  //
+  // The far end still discards it today (comp_multi_weave_android.c:
+  // (void)flat_rect_count; (void)flat_rects;), which is conformant precisely
+  // because the wish is advisory - a DP that ignores it leaves the panel 3D
+  // where the caller asked for flat, i.e. the pre-v8 ghosting. Sending it
+  // anyway is deliberate: the browser is the only party that knows this
+  // geometry, and the runtime arm growing a publisher must not also require a
+  // browser release.
+  return SubmitBatchAndroid(input_handle, rects, overlay_handle, flat_rects);
 #else
   return {};
 #endif
diff --git a/components/displayxr/browser/displayxr_weave_client_android.cc b/components/displayxr/browser/displayxr_weave_client_android.cc
index a2c5bd38092d3..2384d10120b49 100644
--- a/components/displayxr/browser/displayxr_weave_client_android.cc
+++ b/components/displayxr/browser/displayxr_weave_client_android.cc
@@ -808,7 +808,8 @@ std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectAndroid(
 DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchAndroid(
     uintptr_t input_handle,
     const std::vector<DisplayXRWeaveClient::WeaveRect>& rects,
-    uintptr_t overlay_handle) {
+    uintptr_t overlay_handle,
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& flat_rects) {
   DisplayXRWeaveClient::WeaveSubmitResult result;
   AndroidWeaveState& s = State();
   const size_t rect_count = rects.size();
@@ -821,6 +822,37 @@ DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchAndroid(
   // before the first submit and re-published whenever it moves.
   EnsureBound(s);
 
+  // v8 (browser#88): the FLAT rects, converted once for the whole batch - the
+  // chain rides the LAST chunk only, so there is nothing per-chunk about them.
+  // WINDOW-RELATIVE DEVICE PX in, XrRect2Di device px out; no scaling, no
+  // rebasing, no y-flip. Clamped by DROPPING THE TAIL past the cap, exactly as
+  // SubmitBatchWin does: the producer (DirectRenderer::ComputeInline3dPlaneSplit
+  // via kInline3dMaxFlatRects) already coarsened largest-area-first, so the tail
+  // IS the smallest regions. Dropping one leaves its area 3D, which is only the
+  // pre-v8 ghosting; merging it into a bounding box would switch the lens off
+  // over working 3D, which is a mono regression. Never merge.
+  XrRect2Di xr_flat_rects[XR_WEAVE_SUBMIT_MAX_FLAT_RECTS_DXR];
+  const size_t flat_count =
+      std::min<size_t>(flat_rects.size(), XR_WEAVE_SUBMIT_MAX_FLAT_RECTS_DXR);
+  for (size_t i = 0; i < flat_count; ++i) {
+    const DisplayXRWeaveClient::WeaveRect& fr = flat_rects[i];
+    XrRect2Di& xf = xr_flat_rects[i];
+    xf.offset.x = fr.x;
+    xf.offset.y = fr.y;
+    xf.extent.width = fr.w;
+    xf.extent.height = fr.h;
+  }
+  if (flat_rects.size() > flat_count) {
+    static bool logged_flat_cap = false;
+    if (!logged_flat_cap) {
+      logged_flat_cap = true;
+      LOG(WARNING) << "[DisplayXR] android SubmitBatch: " << flat_rects.size()
+                   << " flat rects exceed the per-call cap "
+                   << XR_WEAVE_SUBMIT_MAX_FLAT_RECTS_DXR
+                   << " - dropping the smallest (those regions stay 3D)";
+    }
+  }
+
   XrRect2Di xr_rects[XR_WEAVE_SUBMIT_MAX_RECTS_DXR];
   size_t done = 0;
   while (done < rect_count) {
@@ -871,6 +903,39 @@ DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchAndroid(
       in.next = &overlays;
     }
 
+    // v8 (browser#88): the per-region hardware wish's FLAT list. Chained on the
+    // LAST chunk only, for the same reason the overlay atlas is - the wish is
+    // ONE whole-window statement derived from the frame's complete rect union,
+    // not a per-chunk property. Spliced ahead of whatever is already chained
+    // (OpenXR next-chains are unordered), so it composes with the overlay chain
+    // instead of replacing it.
+    //
+    // Gated on the runtime's reported spec version even though a pre-v8 runtime
+    // would presumably skip an unknown chained struct: an older runtime sees a
+    // type value (1004999198) it has never heard of, and the browser does not
+    // get to assume every shipped runtime walks unknown chains politely. The
+    // gate makes the pre-v8 wire byte-identical rather than merely
+    // probably-ignored.
+    XrWeaveSubmitFlatRegionsDXR flat = {XR_TYPE_WEAVE_SUBMIT_FLAT_REGIONS_DXR};
+    if (flat_count > 0 && last_chunk && s.weave_spec_version >= 8) {
+      flat.rectCount = static_cast<uint32_t>(flat_count);
+      flat.rects = xr_flat_rects;
+      flat.next = in.next;
+      in.next = &flat;
+      static bool logged_flat = false;
+      if (!logged_flat) {
+        logged_flat = true;
+        LOG(WARNING) << "[DisplayXR] android weave: per-region hardware wish "
+                        "live - "
+                     << flat_count
+                     << " flat rect(s) chained (window-relative device px, "
+                        "spec v"
+                     << s.weave_spec_version
+                     << "). ADVISORY: this moves the panel's 3D element only, "
+                        "never the woven pixels.";
+      }
+    }
+
     XrWeaveOutputDXR out = {XR_TYPE_WEAVE_OUTPUT_DXR};
     const XrResult xr = s.submit(s.session, &in, &out);
     if (XR_FAILED(xr)) {
diff --git a/components/displayxr/browser/displayxr_weave_client_android.h b/components/displayxr/browser/displayxr_weave_client_android.h
index 5122d41445d5f..d53474223673a 100644
--- a/components/displayxr/browser/displayxr_weave_client_android.h
+++ b/components/displayxr/browser/displayxr_weave_client_android.h
@@ -80,10 +80,30 @@ std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectAndroid(
 // |result.woven_handle| is the woven AHardwareBuffer*, non-zero on the FIRST
 // successful submit and again on every reallocation (window resize), 0 on
 // steady-state frames.
+//
+// |flat_rects| (spec v8, browser#88) are the sub-areas of |rects| whose visible
+// pixels are OPAQUE 2D page content rather than woven 3D. WINDOW-RELATIVE
+// DEVICE PX, y-down - the SAME space as |rects|, not screen space and not CSS
+// px. Chained on the LAST batch chunk as XrWeaveSubmitFlatRegionsDXR, from
+// which the runtime derives wish = union(rects) - union(flat_rects) and
+// publishes the per-region hardware wish to the display processor.
+//
+// ADVISORY and HARDWARE-ONLY (ADR-027 Decision 6 / ADR-030): it moves the
+// panel's physical 3D element and nothing else. The woven pixels are
+// bit-identical with and without it, so the caller may always pass it.
+//
+// Honest status of the far end, checked in the runtime source rather than
+// assumed: comp_multi_weave_android.c currently accepts the list and discards
+// it ((void)flat_rect_count; (void)flat_rects;). Sending it is therefore a
+// no-op on today's runtime and becomes live the moment that arm grows a wish
+// publisher - which is exactly why the WIRE is worth closing now: the browser
+// half is the half that has to know the geometry, and a runtime that starts
+// honouring the chain must not also need a browser release.
 DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchAndroid(
     uintptr_t input_handle,
     const std::vector<DisplayXRWeaveClient::WeaveRect>& rects,
-    uintptr_t overlay_handle);
+    uintptr_t overlay_handle,
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& flat_rects = {});
 
 }  // namespace displayxr
 
diff --git a/components/displayxr/gpu/displayxr_weave_gpu_android.cc b/components/displayxr/gpu/displayxr_weave_gpu_android.cc
index 02ff8d505f176..a738b13c015e7 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu_android.cc
+++ b/components/displayxr/gpu/displayxr_weave_gpu_android.cc
@@ -90,6 +90,8 @@ void DisplayXRWeaveGpuAndroid::BeginBatchSync(const gfx::Size& window_size) {
   batch_size_ = window_size;
   batch_entries_.clear();
   batch_input_ahb_ = 0;
+  // (browser#88) A stale wish is worse than no wish - see the member comment.
+  batch_flat_rects_.clear();
 
   // Window geometry (ADR-036 D6 / XR_DXR_weave v7): REQUIRED on Android, and
   // published from here because this is where the client-area size is known.
@@ -145,6 +147,30 @@ bool DisplayXRWeaveGpuAndroid::BatchKeepPrevious(const gfx::Rect& window_rect,
   return true;
 }
 
+// (browser#88 Phase 3 Stage 2) Per-region hardware wish. Advisory and
+// PIXEL-FREE: unlike the overlay atlas there is no texture, no import and no
+// copy here - the rects simply ride the submit's XrWeaveSubmitFlatRegionsDXR
+// chain, from which the runtime derives
+//
+//   wish = union(submitted weave rects) - union(flat rects)
+//
+// and republishes the per-region hardware wish. Called once per batch frame
+// between BeginBatchSync and SubmitBatchSync.
+//
+// UNITS/SPACE: |flat_rects| are window-relative DEVICE px, y-down - the same
+// space WeaveRectAndroid takes and the same space they are handed on to the
+// client in. Nothing is converted on this path.
+void DisplayXRWeaveGpuAndroid::SetBatchWish(
+    const std::vector<gfx::Rect>& flat_rects) {
+  if (!batch_open_) {
+    // Not an error and not logged: the caller sets the wish unconditionally
+    // (the wish is advisory, so there is nothing to feature-gate browser-side)
+    // and a closed batch simply has nothing to attach it to.
+    return;
+  }
+  batch_flat_rects_ = flat_rects;
+}
+
 bool DisplayXRWeaveGpuAndroid::SetBatchInputAndroid(uintptr_t ahardware_buffer,
                                                     int acquire_fence_fd) {
   if (!batch_open_ || ahardware_buffer == 0) {
@@ -175,12 +201,21 @@ bool DisplayXRWeaveGpuAndroid::SubmitBatchSync() {
     rects.push_back({e.rect.x(), e.rect.y(), e.rect.width(), e.rect.height()});
   }
 
+  // (browser#88) This frame's FLAT rects, in the same window-relative device px
+  // as |rects|. Empty on a frame that never called SetBatchWish, which omits
+  // the chain entirely.
+  std::vector<DisplayXRWeaveClient::WeaveRect> flat;
+  flat.reserve(batch_flat_rects_.size());
+  for (const gfx::Rect& f : batch_flat_rects_) {
+    flat.push_back({f.x(), f.y(), f.width(), f.height()});
+  }
+
   // ONE synchronous submit for the whole frame. The handle kind is declared
   // inside SubmitBatchAndroid (XR_WEAVE_HANDLE_KIND_AHARDWAREBUFFER_DXR); no
   // overlay atlas is staged on Android (the browser composites its own over-
   // plane, patch 0063-0065), so the overlay handle is 0.
   DisplayXRWeaveClient::WeaveSubmitResult sr =
-      SubmitBatchAndroid(batch_input_ahb_, rects, /*overlay_handle=*/0);
+      SubmitBatchAndroid(batch_input_ahb_, rects, /*overlay_handle=*/0, flat);
   batch_input_ahb_ = 0;
   if (!sr.ok) {
     static int fails = 0;
diff --git a/components/displayxr/gpu/displayxr_weave_gpu_android.h b/components/displayxr/gpu/displayxr_weave_gpu_android.h
index 917e1e629d952..e98b2176fd13e 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu_android.h
+++ b/components/displayxr/gpu/displayxr_weave_gpu_android.h
@@ -93,6 +93,7 @@ class DisplayXRWeaveGpuAndroid : public viz::DisplayXRWeaveProvider {
   bool SubmitBatchSync() override;
   bool BatchKeepPrevious(const gfx::Rect& window_rect,
                          uint32_t target_id) override;
+  void SetBatchWish(const std::vector<gfx::Rect>& flat_rects) override;
 
  private:
   bool batch_open_ = false;
@@ -145,6 +146,22 @@ class DisplayXRWeaveGpuAndroid : public viz::DisplayXRWeaveProvider {
   // would drag a copy behind the scroll. Dropped by PruneTarget(s) because a
   // retired target's slot may be reused by a different element.
   base::flat_map<uint32_t, gfx::Rect> batch_last_copied_;
+
+  // (browser#88 Phase 3 Stage 2) This batch frame's FLAT rects - the sub-areas
+  // of the submitted weave rects whose visible pixels are opaque 2D page
+  // content, staged by SetBatchWish and chained onto the LAST submit chunk as
+  // XrWeaveSubmitFlatRegionsDXR.
+  //
+  // UNITS/SPACE: window-relative DEVICE px, y-down, identical to |BatchEntry
+  // ::rect|. The caller (SkiaOutputSurfaceImplOnGpu) has already clipped them to
+  // the window, so nothing here rebases or clamps.
+  //
+  // CLEARED by BeginBatchSync, so a frame that never calls SetBatchWish submits
+  // no flat list at all - byte-for-byte the pre-v8 submit rather than a stale
+  // wish held over. A stale wish is strictly worse than none: it would switch
+  // the panel's 3D element off wherever LAST frame's 2D sat, which after a
+  // scroll is over live 3D.
+  std::vector<gfx::Rect> batch_flat_rects_;
 };
 
 }  // namespace displayxr
