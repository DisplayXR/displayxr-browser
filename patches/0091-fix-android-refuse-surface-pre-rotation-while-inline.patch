From ac442c66bd7d323b2de6987a8065f9b97d19b2b0 Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Thu, 20 Aug 2026 23:25:20 +0000
Subject: [PATCH] fix(android): refuse surface pre-rotation while inline-3D
 weaves
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

First light landed, but the woven 3D was 90 degrees off: a landscape
browser on a 2560x1600 panel produced a 1540x2560 staging image and
bound the same portrait-shaped window geometry.

That is Android surface PRE-ROTATION. With
OutputSurface::OrientationMode::kHardware, Viz renders the root render
pass in the display's NATURAL orientation and hands the 90/270
transform to the platform surface, letting SurfaceFlinger rotate at
scanout. The weave consumes those root-pass pixels RAW and hands them,
plus the window geometry, to a runtime that weaves for the PHYSICAL
panel and its physical lens — so a pre-rotated buffer weaves against
the lens.

The transform was reaching us and being dropped:
SkiaOutputSurfaceImplOnGpu::Reshape() kept params.GfxSize() and ignored
params.transform. It is now recorded and logged once with the buffer
size, so the next run states the transform outright instead of leaving
it to be inferred from the shape of a size.

Fix: ask for kLogic when --enable-inline-3d is set, so Viz applies the
rotation itself and the root pass is already in physical orientation —
after which inline_3d_rects_, the staging image, the bound geometry and
the woven draw-back all share the panel's space with no mapping at all.
SkiaOutputDeviceBufferQueue is the only Android device that asks for
kHardware (SkiaOutputDeviceGL does so on ChromeOS only, and
SkiaOutputDeviceVulkan already forces kLogic on Android), so one site
covers the platform — and that Vulkan precedent is why kLogic is a
shipped configuration here rather than an experiment.

Shipping (a), the opt-out, not (b), the transform-aware weave: (b) is
the durable answer because pre-rotation is a real power saving, but it
has to rotate the staging draw, invert it on the draw-back, and move
the runtime-facing geometry into physical space — a geometry change
across the whole weave contract that should not be made blind. The TODO
naming the exact mapping sits on the opt-out. A latched ERROR fires if
a non-identity transform ever survives it, so the day it does we learn
from a log and not from a photograph.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 .../skia_output_device_buffer_queue.cc        | 31 +++++++++++++++++++
 .../skia_output_surface_impl_on_gpu.cc        | 26 ++++++++++++++++
 .../skia_output_surface_impl_on_gpu.h         |  6 ++++
 3 files changed, 63 insertions(+)

diff --git a/components/viz/service/display_embedder/skia_output_device_buffer_queue.cc b/components/viz/service/display_embedder/skia_output_device_buffer_queue.cc
index e2b3f90e81575..f54e96225e130 100644
--- a/components/viz/service/display_embedder/skia_output_device_buffer_queue.cc
+++ b/components/viz/service/display_embedder/skia_output_device_buffer_queue.cc
@@ -174,6 +174,37 @@ SkiaOutputDeviceBufferQueue::SkiaOutputDeviceBufferQueue(
   }
 #endif
   capabilities_.orientation_mode = OutputSurface::OrientationMode::kHardware;
+#if BUILDFLAG(IS_ANDROID)
+  // DisplayXR inline-3D (#625): refuse surface PRE-ROTATION while the weave is
+  // active. This is the ONLY Android output device that asks for kHardware —
+  // SkiaOutputDeviceGL asks for it on ChromeOS only, and SkiaOutputDeviceVulkan
+  // already forces kLogic on Android — so this one site covers the platform.
+  //
+  // Under kHardware, Viz renders the root render pass in the display's NATURAL
+  // orientation and hands the 90/270 transform to the platform surface, letting
+  // SurfaceFlinger rotate at scanout: a real power win. But the weave consumes
+  // those root-pass pixels RAW and hands them, with the window geometry, to a
+  // runtime that weaves for the PHYSICAL panel and its physical lens. Pre-
+  // rotated input therefore weaves 90 degrees off: on a 2560x1600 landscape
+  // panel the staging image and the bound geometry came out 1540x2560, and the
+  // woven 3D rendered portrait in a landscape browser.
+  //
+  // kLogic makes Viz apply the rotation itself, so the root pass is already in
+  // physical orientation and every space downstream of it — inline_3d_rects_,
+  // the staging image, the bound window geometry, the woven draw-back — matches
+  // the panel with no further mapping. It is a supported configuration rather
+  // than an experiment: Android Vulkan Chrome ships kLogic unconditionally.
+  //
+  // TODO(displayxr): this buys correctness with the pre-rotation power saving,
+  // and only for processes running inline-3D. The durable fix is a transform-
+  // AWARE weave — map inline_3d_rects_ and the window geometry through
+  // gfx::OverlayTransformToTransform() into physical space, rotate the staging
+  // draw, and apply the inverse to the woven draw-back — after which this
+  // opt-out can be deleted and pre-rotation stays on for everyone.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("enable-inline-3d")) {
+    capabilities_.orientation_mode = OutputSurface::OrientationMode::kLogic;
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
 
   // Force the number of max pending frames to one when the switch
   // "double-buffer-compositing" is passed.
diff --git a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
index 05b777b1da4bc..4b60de1966f0d 100644
--- a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
+++ b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
@@ -486,6 +486,18 @@ void SkiaOutputSurfaceImplOnGpu::Reshape(
   }
 
   size_ = params.GfxSize();
+#if BUILDFLAG(IS_ANDROID)
+  // The transform was previously dropped on the floor here, which is why a
+  // pre-rotated root pass was invisible to the weave.
+  if (params.transform != displayxr_display_transform_android_) {
+    displayxr_display_transform_android_ = params.transform;
+    LOG(WARNING) << "[DisplayXR] android weave: root render pass "
+                 << size_.ToString() << " display_transform="
+                 << static_cast<int>(params.transform)
+                 << " (0 = NONE; anything else means the buffer is PRE-ROTATED "
+                    "and its orientation does not match the physical panel)";
+  }
+#endif
   if (!output_device_->Reshape(params)) {
     MarkContextLost(CONTEXT_LOST_RESHAPE_FAILED);
   }
@@ -2901,6 +2913,20 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
   if (displayxr_weave_backend_unusable_android_) {
     return;
   }
+  if (displayxr_display_transform_android_ != gfx::OVERLAY_TRANSFORM_NONE) {
+    // Deliberately NOT a bail-out: weaving at the wrong orientation is still
+    // better than not weaving, and the opt-out above should mean we never get
+    // here. If this fires, the pre-rotation opt-out did not take and the
+    // transform-aware weave in that TODO is now required.
+    static bool logged_transform = false;
+    if (!logged_transform) {
+      logged_transform = true;
+      LOG(ERROR) << "[DisplayXR] android weave: root pass is PRE-ROTATED "
+                    "(display_transform="
+                 << static_cast<int>(displayxr_display_transform_android_)
+                 << "); the woven output will be rotated against the panel";
+    }
+  }
 #endif
 #if BUILDFLAG(IS_WIN)
   // Windows weaves same-device: the canvas copy + keyed-mutex input live on the
diff --git a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.h b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.h
index 42452f2769964..2037fa60e17ee 100644
--- a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.h
+++ b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.h
@@ -910,6 +910,12 @@ class SkiaOutputSurfaceImplOnGpu
   // owns no per-target GPU state at all — and recreated on a window resize.
   gpu::Mailbox displayxr_staging_mailbox_android_;
   gfx::Size displayxr_staging_size_android_;
+  // The root surface's display transform, as handed to Reshape(). Non-identity
+  // means the root render pass is PRE-ROTATED relative to the physical panel,
+  // which the weave cannot consume raw — see the opt-out in
+  // skia_output_device_buffer_queue.cc.
+  gfx::OverlayTransform displayxr_display_transform_android_ =
+      gfx::OVERLAY_TRANSFORM_NONE;
   // Latched by FinishSkiaWritesForWeaveAndroid() when neither Skia backend can
   // discharge the outbound wait. One ERROR, then inline-3D stays inert for the
   // life of this GPU process instead of retrying (and re-logging) every frame.
