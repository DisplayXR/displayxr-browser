 // This class extends the OutputSurface for SkiaRenderer needs.
+// DisplayXR inline-3D LOCKSTEP: the set of elements whose canvas resource has
+// been PROVEN openable on the GPU thread at least once.
+//
+// Suppression is decided in Display, at aggregation time; whether the GPU stage
+// can actually source a recovery draw for that layer is only knowable later, on
+// the GPU thread. Both platforms fail DOWNSTREAM of a resolved, non-zero
+// mailbox (Android refuses at ProduceSkia, Windows at BeginScopedReadAccess),
+// so "the ResourceId resolved" — the predicate Display has — does not imply
+// "the hole can be filled". Suppressing on it punches holes nothing can fill,
+// which is the dark void seen on both platforms.
+//
+// So Display consults evidence the GPU thread writes: an element's quad is
+// suppressed only once its resource has been opened successfully at least once.
+// Both parties live in the GPU process on different threads, so a lock-guarded
+// set is the entire channel — no mojo, no per-frame allocation.
+//
+// A ZERO id (the legacy main-thread channel, which carries no element token)
+// reports USABLE: there is no key to learn under, so the conservative choice is
+// to leave that channel's behaviour exactly as it is today rather than withhold
+// suppression from it forever.
+VIZ_SERVICE_EXPORT void Inline3dMarkRecoveryUsable(const base::Token& id);
+// Recorded ONLY by code that tried to fill a hole and could not — that is the
+// exact evidence "this element must not be suppressed on the next frame".
+VIZ_SERVICE_EXPORT void Inline3dMarkRecoveryUnusable(const base::Token& id);
+VIZ_SERVICE_EXPORT bool Inline3dRecoveryUsable(const base::Token& id);
+
 class VIZ_SERVICE_EXPORT SkiaOutputSurface : public OutputSurface,
                                              public ExternalUseClient {
  public:
@@ -243,9 +269,18 @@ class VIZ_SERVICE_EXPORT SkiaOutputSurface : public OutputSurface,
   // Phase 2 retired the third (OVERLAY) list this used to carry: page content
   // over a tile is lifted by the draw-order split onto the over-plane below,
   // not by declared per-element overlays.
+  // |probe_layers| (LOCKSTEP) are resolved canvas layers that were NOT
+  // suppressed this frame because they are not yet proven usable. They are
+  // handed over anyway, every frame, purely so the GPU stage can try to open
+  // them and promote them into the proven set — without that, an unproven layer
+  // is never opened, never becomes proven, and stays unsuppressed forever.
+  // They are NEVER a weave source and never answer the hole question:
+  // |canvas_layers| remains EXACTLY the suppressed set, which is the invariant
+  // every "is |output| at this rect a hole?" test depends on.
   virtual void SetInline3DRects(
       std::vector<Inline3dRect> rects,
-      std::vector<Inline3dLayerMailbox> canvas_layers) {}
+      std::vector<Inline3dLayerMailbox> canvas_layers,
+      std::vector<Inline3dLayerMailbox> probe_layers) {}
 
   // DisplayXR inline-3D Phase 2 (plane split): the window-sized premultiplied
   // RGBA plane holding the page content that sits OVER the woven tiles, freshly
