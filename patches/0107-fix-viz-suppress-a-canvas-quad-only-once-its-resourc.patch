index f31982fb385f2..1a4a91c677a98 100644
--- a/components/viz/service/display/display.cc
+++ b/components/viz/service/display/display.cc
@@ -1015,8 +1015,24 @@ bool Display::DrawAndSwap(const DrawAndSwapParams& params) {
     // DrawAndSwap, BEFORE renderer_->DrawFrame() below consumes the suppression
     // set, and the resolve is a pure read of the resource provider Display
     // already owns.
+    // LOCKSTEP (shared with win/browser): |resolved_canvas| is what we are
+    // ALLOWED TO SUPPRESS — resolved AND proven openable by the GPU thread.
+    // |probe_canvas| is resolved but not yet proven: NOT suppressed, handed to
+    // the GPU stage anyway so it can try to open it and promote it.
+    //
+    // The predicate had to change. "The ResourceId resolved to a non-zero
+    // mailbox" is what Display can see, and it is NOT sufficient: both
+    // platforms fail downstream of exactly that (Android refuses at
+    // ProduceSkia, Windows at BeginScopedReadAccess) — the device capture reads
+    // "recovery draw: n=0 missing=10 ... produce=10" with no_mailbox=0, i.e.
+    // ten layers that all resolved and none of which could be opened. Suppress
+    // on the weaker predicate and we punch ten holes nothing can fill, which is
+    // the void. So suppress on the STRONGER one, which only the GPU thread can
+    // establish, and which it reports back through Inline3dRecoverySet.
     std::vector<SkiaOutputSurface::Inline3dLayerMailbox> resolved_canvas;
+    std::vector<SkiaOutputSurface::Inline3dLayerMailbox> probe_canvas;
     ResourceIdSet resolved_canvas_ids;
+    int unproven = 0;
     {
       // Resolve each isolated canvas layer's ResourceId → its SharedImage
       // mailbox here (Display owns the resource provider), handing the GPU
@@ -1030,6 +1046,16 @@ bool Display::DrawAndSwap(const DrawAndSwapParams& params) {
           ++dropped;
           continue;
         }
+        if (!Inline3dRecoveryUsable(layer.id)) {
+          // Not proven openable yet. Leave the page owning these pixels — the
+          // quad stays in the raster, so the worst case is one frame of the
+          // page's own side-by-side (which the weave draws over anyway when it
+          // succeeds). Flat is acceptable; empty never is.
+          probe_canvas.push_back(
+              {m, layer.rect, layer.visible_rect, layer.uv, layer.id});
+          ++unproven;
+          continue;
+        }
         resolved_canvas.push_back(
             {m, layer.rect, layer.visible_rect, layer.uv, layer.id});
         resolved_canvas_ids.insert(layer.resource_id);
@@ -1085,8 +1111,39 @@ bool Display::DrawAndSwap(const DrawAndSwapParams& params) {
       std::vector<SkiaOutputSurface::Inline3dRect> weave_rects;
       weave_rects.reserve(frame.inline_3d_rects.size());
       int unprepared = 0;
+      if (unproven > 0) {
+        // Loud and counted, on 0073's discipline: this is the moment a tile
+        // stops being suppressed, so it must never be inferred from pixels.
+        static int s_unproven = 0;
+        const int n = s_unproven++;
+        if (n < 3 || (n % 300) == 0) {
+          LOG(ERROR) << "[DisplayXR] inline-3D lockstep: " << unproven << " of "
+                     << frame.inline_3d_canvas_resources.size()
+                     << " canvas layer(s) resolved but are NOT yet proven "
+                        "openable by the GPU thread — NOT suppressing them, so "
+                        "the page keeps drawing those tiles (flat, not void). "
+                        "They are still handed over to be probed (events="
+                     << (n + 1) << ")";
+        }
+      }
+      // A rect is prepared if EITHER list holds its layer: an unproven layer is
+      // still a real resolved resource, and its rect must still be submitted —
+      // withholding it would stop the weave from ever running for that tile,
+      // and the weave's own successful canvas open is one of the two ways a
+      // layer gets promoted. Not suppressing it is what makes that safe: the
+      // page drew the quad, so the weave draws over real pixels, never a hole.
+      auto layer_matches = [](const SkiaOutputSurface::Inline3dLayerMailbox& l,
+                              const auto& r) {
+        return !r.id.is_zero() ? l.id == r.id : l.rect == r.rect;
+      };
       for (const auto& r : frame.inline_3d_rects) {
-        bool prepared = resolved_canvas.empty();
+        bool prepared = resolved_canvas.empty() && probe_canvas.empty();
+        for (const auto& layer : probe_canvas) {
+          if (layer_matches(layer, r)) {
+            prepared = true;
+            break;
+          }
+        }
         for (const auto& layer : resolved_canvas) {
           // Identity where there is one; the legacy zero-id channel has only
           // geometry, and Display's own tile join above uses the same pair of
@@ -1118,7 +1175,8 @@ bool Display::DrawAndSwap(const DrawAndSwapParams& params) {
         }
       }
       skia_output_surface_->SetInline3DRects(std::move(weave_rects),
-                                             std::move(resolved_canvas));
+                                             std::move(resolved_canvas),
+                                             std::move(probe_canvas));
     }
     // DisplayXR inline-3D (browser#22 B): hand the renderer the resources the
     // weave draw-back is the single source for, so their quads are not painted
diff --git a/components/viz/service/display/skia_output_surface.cc b/components/viz/service/display/skia_output_surface.cc
