 #include "components/viz/service/display/skia_output_surface.h"
 
+#include "base/containers/flat_set.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
 namespace viz {
 
+namespace {
+
+// Guarded by |Inline3dRecoveryLock()|. Written on the GPU thread (the only
+// party that can open a resource), read on the compositor thread by Display.
+base::Lock& Inline3dRecoveryLock() {
+  static base::NoDestructor<base::Lock> lock;
+  return *lock;
+}
+
+base::flat_set<base::Token>& Inline3dRecoveryUsableSet() {
+  static base::NoDestructor<base::flat_set<base::Token>> set;
+  return *set;
+}
+
+}  // namespace
+
+void Inline3dMarkRecoveryUsable(const base::Token& id) {
+  if (id.is_zero()) {
+    return;
+  }
+  base::AutoLock lock(Inline3dRecoveryLock());
+  Inline3dRecoveryUsableSet().insert(id);
+}
+
+void Inline3dMarkRecoveryUnusable(const base::Token& id) {
+  if (id.is_zero()) {
+    return;
+  }
+  base::AutoLock lock(Inline3dRecoveryLock());
+  Inline3dRecoveryUsableSet().erase(id);
+}
+
+bool Inline3dRecoveryUsable(const base::Token& id) {
+  if (id.is_zero()) {
+    return true;  // legacy channel: unchanged behaviour (see the header)
+  }
+  base::AutoLock lock(Inline3dRecoveryLock());
+  const auto& set = Inline3dRecoveryUsableSet();
+  return set.find(id) != set.end();
+}
+
 SkiaOutputSurface::SkiaOutputSurface() = default;
 
 SkiaOutputSurface::~SkiaOutputSurface() = default;
