@@ -2957,6 +2959,46 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     return;
   }
 
+  // ---- LOCKSTEP PROBE: promote what can be opened ---------------------------
+  //
+  // These are resolved canvas layers Display did NOT suppress this frame,
+  // because they are not yet proven openable. Nothing else in this function
+  // ever touches them — they are not a weave source and they do not answer the
+  // hole question. Their only purpose is to close the loop: without an attempt
+  // here, an unproven layer is never opened, so it never becomes proven, so it
+  // is never suppressed, and a tile that failed once would stay flat forever.
+  //
+  // Cost is zero in the steady state: a layer that opens is promoted, Display
+  // moves it into the suppressed list on the next frame, and this list empties.
+  for (const auto& probe : inline_3d_probe_layers_) {
+    if (probe.mailbox.IsZero()) {
+      continue;
+    }
+    auto probe_rep = shared_image_representation_factory_->ProduceSkia(
+        probe.mailbox, context_state_.get());
+    if (!probe_rep) {
+      continue;
+    }
+    std::vector<GrBackendSemaphore> pbegin, pend;
+    auto probe_access = probe_rep->BeginScopedReadAccess(&pbegin, &pend);
+    if (!probe_access) {
+      continue;
+    }
+    if (!probe_access->CreateSkImage(context_state_.get())) {
+      continue;
+    }
+    Inline3dMarkRecoveryUsable(probe.id);
+    static int s_promoted = 0;
+    const int n = s_promoted++;
+    if (n < 3 || (n % 300) == 0) {
+      LOG(ERROR) << "[DisplayXR] inline-3D lockstep: promoted element "
+                 << probe.id.ToString()
+                 << " to PROVEN (its canvas resource opened) — its quad may be "
+                    "suppressed from the next frame (promotions=" << (n + 1)
+                 << ")";
+    }
+  }
+
   // CEF sub-rect model (design §13.3), now ASYNC (design §13.6): the composited
   // page (2D chrome + each inline-3d canvas's flat SBS pixels, already squashed
   // together) is in |output| — exactly the Step-A CEF host's `pageTex`. |output|
@@ -3606,6 +3648,9 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
                 continue;
               }
               src_from_canvas = true;
+              // LOCKSTEP: this resource opened. That is the evidence Display
+              // needs to be allowed to suppress this element's quad.
+              Inline3dMarkRecoveryUsable(inline_3d_rects_[t].id);
               if (!cbegin.empty()) {
                 scratch_surface->wait(cbegin.size(), cbegin.data(),
                                       /*deleteSemaphoresAfterWait=*/false);
@@ -4667,6 +4712,53 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
             ++rec_fail_produce;
             break;
         }
+        // LOCKSTEP: this is the exact moment we learn we CANNOT fill a hole we
+        // punched. Retract the permission to suppress this element; Display
+        // leaves its quad in the page raster from the next frame, so the tile
+        // degrades to flat rather than to void. Flat acceptable, empty never.
+        Inline3dMarkRecoveryUnusable(c.id);
+
+        // ---- H1 vs H2, decided once per process, for one tile --------------
+        // The failure is DETERMINISTIC (produce=N/N every frame on Android,
+        // read_access=N/N on Windows), which rules out contention and points at
+        // a static mismatch. Two cheap discriminators, both free:
+        //
+        //  * Ask the SAME mailbox for an OVERLAY representation. If the overlay
+        //    succeeds where Skia refused, the backing is alive and healthy and
+        //    what differs is the representation the backing supports — i.e. a
+        //    usage/representation-type mismatch at CREATION (H1), and the fix
+        //    is a usage bit, not a new primitive. If both refuse, the mailbox
+        //    is not usable by this stage at all.
+        //  * Report whether this layer took part in this frame's weave. H2
+        //    (same-frame self-conflict: the weave still holds an access) can
+        //    only explain a tile the weave actually opened. A tile that was
+        //    NEVER submitted and still fails refutes H2 outright — and note the
+        //    weave path's own access is scoped to its compose block and
+        //    released well before this runs, and canvas mailboxes are never
+        //    entered into |skia_representations_|, so nothing caches an access
+        //    across the frame either.
+        static bool logged_h = false;
+        if (!logged_h) {
+          logged_h = true;
+          auto overlay_probe =
+              shared_image_representation_factory_->ProduceOverlayForWeave(
+                  c.mailbox);
+          LOG(ERROR)
+              << "[DisplayXR][H-PROBE] recovery could not open a resolved "
+                 "canvas: id=" << c.id.ToString()
+              << " rect=" << c.rect.ToString() << " failed_step="
+              << (rec_step == 2 ? "BeginScopedReadAccess"
+                                : (rec_step == 3 ? "CreateSkImage"
+                                                 : "ProduceSkia"))
+              << " overlay_representation="
+              << (overlay_probe ? "OK -> H1 (representation/usage mismatch at "
+                                  "creation; Skia refused, overlay did not)"
+                                : "ALSO REFUSED -> not a Skia-only gate")
+              << " this_layer_was_submitted_this_frame="
+              << (canvas_was_submitted(c.mailbox)
+                      ? "yes"
+                      : "NO -> H2 (same-frame self-conflict) refuted for it");
+        }
         continue;
       }
       // LEFT EYE = the left half of the quad's EXISTING UV WINDOW, not of the
@@ -4690,6 +4782,8 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
       // viewport-clipped WebGL canvas resource's physical texture can be
       // shorter than the SkImage claims and a source crop edge-clamps into a
       // downward smear.
+      // LOCKSTEP: opened here too — equally good evidence as the weave path.
+      Inline3dMarkRecoveryUsable(c.id);
       const SkRect dst = gfx::RectToSkRect(c.rect);
       SkPaint paint;
       paint.setBlendMode(SkBlendMode::kSrcOver);
