@@ -5443,21 +5465,30 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
         out_canvas->clipRect(gfx::RectToSkRect(frosted), SkClipOp::kDifference,
