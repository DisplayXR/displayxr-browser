@@ -1392,6 +1392,7 @@ DisplayXRWeaveClient::WeaveSubmitResult SubmitWin(uintptr_t input_handle,
 // chunk into multiple batched calls — the runtime's weave fence is one
 // monotonic timeline, so waiting the LAST chunk's fence value covers all.
 void MaybePostHeldScreenFlatRelease();  // browser#171, defined below
