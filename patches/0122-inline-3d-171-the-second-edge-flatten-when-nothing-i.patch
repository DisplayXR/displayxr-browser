 DisplayXRWeaveClient::WeaveSubmitResult SubmitBatchWin(
     uintptr_t input_handle,
@@ -1896,7 +1897,146 @@ bool IsDisplayModeRequestableWin() {
 // rect set that produces the weave rects, so by the time demand has been false
 // long enough to debounce, SubmitBatch has been early-returning on an empty
 // rect list for many frames.
+void ApplyScreenFlatRegionsWin(
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& screen_rects);
+
+namespace {
+
+bool IsWholePanelRect(const DisplayXRWeaveClient::WeaveRect& r) {
+  // Mirrors chrome/browser/displayxr/displayxr_popup_occluder_tracker.cc
+  // WholePanelRect(): origin -(1<<20), extent 1<<21. No real screen is a
+  // million px wide, so the extent alone identifies it.
+  return r.w >= (1 << 20) && r.h >= (1 << 20);
+}
+
+bool HasWholePanelRect(
+    const std::vector<DisplayXRWeaveClient::WeaveRect>& rects) {
+  for (const DisplayXRWeaveClient::WeaveRect& r : rects) {
+    if (IsWholePanelRect(r)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct HeldScreenFlat {
+  base::Lock lock;
+  // Bumped by every incoming set; a held release carries the generation it was
+  // recorded under and is dropped if a newer set has since arrived.
+  uint64_t generation = 0;
+  bool valid = false;
+  bool posted = false;
+  std::vector<DisplayXRWeaveClient::WeaveRect> rects;
+  scoped_refptr<base::SequencedTaskRunner> runner;
+  // browser#171 (second edge): the GPU side flattened the panel ITSELF because
+  // the compositor was drawing frames with nothing weavable in them. Cleared
+  // by the release, and by any tracker set that flattens on its own.
+  bool auto_flat = false;
+  // Consecutive root-sized frames with an empty weavable set. Present thread.
+  int empty_frames = 0;
+};
+
+// browser#171 (second edge): how many consecutive root-pass frames with NOTHING
+// weavable it takes before the GPU side flattens the panel on its own. One
+// frame is a resolve hiccup (web#12) and must not flicker the lens; the
+// transition this is for -- an SPA route change whose new tile takes ~1 s to
+// paint its first frame -- is ~70 frames. Three frames (~50 ms at 60 Hz) is
+// well clear of the hiccup and invisible against the transition.
+constexpr int kAutoFlatEmptyFrames = 3;
+
+HeldScreenFlat& Held() {
+  static base::NoDestructor<HeldScreenFlat> held;
+  return *held;
+}
+
+void ReleaseHeldScreenFlat(uint64_t generation) {
+  std::vector<DisplayXRWeaveClient::WeaveRect> rects;
+  {
+    HeldScreenFlat& h = Held();
+    base::AutoLock lock(h.lock);
+    h.posted = false;
+    if (!h.valid || h.generation != generation) {
+      return;  // superseded, or already released
+    }
+    rects = std::move(h.rects);
+    h.rects.clear();
+    h.valid = false;
+    h.auto_flat = false;
+    h.empty_frames = 0;
+  }
+  VLOG(1) << "[DisplayXR] screen-flat latch: whole-panel FLAT released after "
+             "the new page's first weave submit (browser#171)";
+  ApplyScreenFlatRegionsWin(rects);
+}
+
+// browser#171 (second edge): flatten the panel because the compositor is
+// drawing frames with nothing weavable in them. Runs on the sequence that owns
+// WeaveClientState, posted from the present thread.
+//
+// Why this exists: an SPA route change inside ONE inline-3D session never
+// drops demand, so browser#159's whole-panel FLAT never latches and the hold
+// above has nothing to hold. The old route's tile stops submitting (its canvas
+// is gone), the new route's tile is withheld until its first paint resolves
+// (~1.2 s on the storefront's hero viewer), and for that whole window the
+// runtime's sticky wish keeps the OLD tile's rect live over the new page's 2D
+// -- measured as the header's "Account / Sign in" coming back lensed on
+// "next". A static page never reaches here (no frames, no empties): only a
+// page that is compositing and has nothing to weave does, and for that page
+// FLAT is the correct rendering. The release is the same one as the hold's --
+// the next successful submit -- so the lens comes back exactly when the new
+// tile does.
+void EngageAutoFlat() {
+  WeaveClientState& s = State();
+  std::vector<DisplayXRWeaveClient::WeaveRect> base;
+  if (s.latched_screen_flat_valid) {
+    base = s.latched_screen_flat;
+  }
+  HeldScreenFlat& h = Held();
+  {
+    base::AutoLock lock(h.lock);
+    if (!h.auto_flat || h.valid) {
+      return;  // superseded by a release, or a tracker set is already held
+    }
+    if (s.session == XR_NULL_HANDLE || HasWholePanelRect(base)) {
+      h.auto_flat = false;  // nothing to do: no session, or already flat
+      return;
+    }
+    // Hold the pre-flat set as the release, exactly as the tracker path does.
+    h.valid = true;
+    h.posted = false;
+    h.rects = base;
+    h.generation++;
+  }
+  std::vector<DisplayXRWeaveClient::WeaveRect> flat = base;
+  DisplayXRWeaveClient::WeaveRect whole;
+  whole.x = -(1 << 20);
+  whole.y = -(1 << 20);
+  whole.w = 1 << 21;
+  whole.h = 1 << 21;
+  flat.insert(flat.begin(), whole);  // largest-area-first, per the cap rule
+  VLOG(1) << "[DisplayXR] screen-flat latch: auto FLAT -- "
+          << kAutoFlatEmptyFrames
+          << " frames with nothing weavable; held until the next weave "
+             "submit (browser#171)";
+  ApplyScreenFlatRegionsWin(flat);
+}
+
+void RecordOwningRunnerLocked(HeldScreenFlat& h) {
+  if (!h.runner) {
+    h.runner = base::SequencedTaskRunner::GetCurrentDefault();
+  }
+}
+
+}  // namespace
