+// Present thread, once per root-sized root-pass frame. Never touches
+// WeaveClientState.
+void NoteWeavableContentWin(bool any_weavable) {
+  scoped_refptr<base::SequencedTaskRunner> runner;
+  {
+    HeldScreenFlat& h = Held();
+    base::AutoLock lock(h.lock);
+    if (any_weavable) {
+      h.empty_frames = 0;
+      return;
+    }
+    if (h.auto_flat || h.valid || !h.runner) {
+      return;  // already flat (ours or the tracker's), or nowhere to post
+    }
+    if (++h.empty_frames < kAutoFlatEmptyFrames) {
+      return;
+    }
+    h.auto_flat = true;
+    runner = h.runner;
+  }
+  runner->PostTask(FROM_HERE, base::BindOnce(&EngageAutoFlat));
+}
+
 void SetScreenFlatRegionsWin(
     const std::vector<DisplayXRWeaveClient::WeaveRect>& screen_rects) {
   WeaveClientState& s = State();
@@ -2134,7 +2243,11 @@ void SetScreenFlatRegionsWin(
   HeldScreenFlat& h = Held();
   {
     base::AutoLock lock(h.lock);
+    RecordOwningRunnerLocked(h);
     ++h.generation;
+    if (incoming_whole) {
+      h.auto_flat = false;  // the tracker is flattening; ours is moot
+    }
     if (runtime_holds_whole && !incoming_whole) {
       h.valid = true;
       h.posted = false;
@@ -3239,6 +3352,13 @@ bool DisplayXRWeaveClient::RequestDisplayMode(bool three_d) {
 #endif
 }
 
