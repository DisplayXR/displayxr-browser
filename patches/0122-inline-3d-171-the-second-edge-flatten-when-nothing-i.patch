 bool RequestDisplayModeWin(bool three_d) {
+  {
+    // browser#171: demand always precedes weaving, so this is the earliest
+    // point the auto-FLAT path can learn which sequence owns the state.
+    HeldScreenFlat& h = Held();
+    base::AutoLock lock(h.lock);
+    RecordOwningRunnerLocked(h);
+  }
   WeaveClientState& s = State();
   if (!IsDisplayModeRequestableWin()) {
     return false;
@@ -2050,60 +2190,6 @@ void ApplyScreenFlatRegionsWin(
