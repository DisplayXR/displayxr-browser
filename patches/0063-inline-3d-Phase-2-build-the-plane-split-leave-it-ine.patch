+  EnsureScissorTestDisabled();
+
+  // A fresh SharedImage is UNCLEARED, so the first paint must clear all of it;
+  // afterwards only union(previously painted, current) is cleared and the rest
+  // of the plane stays untouched-transparent. Same shape as the mac 2D overlay
+  // atlas in SkiaOutputSurfaceImplOnGpu.
+  if (created_now) {
+    current_canvas_->clear(SK_ColorTRANSPARENT);
+  } else {
+    for (const std::vector<gfx::Rect>* rects :
+         {&inline_3d_over_plane_->painted_rects, &tile_rects}) {
+      for (const gfx::Rect& r : *rects) {
+        current_canvas_->save();
+        current_canvas_->clipRect(gfx::RectToSkRect(r), SkClipOp::kIntersect,
+                                  /*doAntiAlias=*/false);
+        current_canvas_->clear(SK_ColorTRANSPARENT);
+        current_canvas_->restore();
+      }
+    }
+  }
+
+  // Replay the OVER set in BACK-TO-FRONT order — i.e. DESCENDING quad-list
+  // index, which is exactly what BackToFrontBegin() gives — so painter's
+  // algorithm inside the plane matches the page's.
+  inline3d_painting_over_plane_ = true;
+  size_t draws = 0;
+  for (auto it = root->quad_list.BackToFrontBegin();
+       it != root->quad_list.BackToFrontEnd(); ++it) {
+    const DrawQuad* quad = *it;
+    auto found = inline3d_over_clips_.find(quad);
+    if (found == inline3d_over_clips_.end()) {
+      continue;
+    }
+    // One draw per tile rect the quad is over. Distinct inline-3D elements do
+    // not share pixels, so these clips are disjoint and the draws sum to the
+    // union; if overlapping tiles ever become possible this needs a region clip
+    // instead.
+    for (const gfx::Rect& clip : found->second) {
+      SetInline3dQuadClips({}, clip);
+      DoDrawQuad(quad, /*draw_region=*/nullptr);
+      ++draws;
+    }
+  }
+  if (!batched_quads_.empty()) {
+    FlushBatchedQuads();
+  }
+  inline3d_painting_over_plane_ = false;
+  inline3d_clip_out_.clear();
+  inline3d_clip_in_.reset();
+
+  // Finish exactly the way a NON-ROOT pass finishes (the subset of
+  // FinishDrawingRenderPass that applies: flush the batch, drop the canvas,
+  // EndPaint, flush the output surface). FinishDrawingRenderPass itself is not
+  // reusable here — it would see current_render_pass == root_render_pass and so
+  // take the root branch: delegated-ink replay, the root buffer queue's damage
+  // update, and is_overlay=true on Windows, which would defeat R8.
+  current_canvas_ = nullptr;
+  EndPaint(gfx::Rect(size), /*failed=*/false, /*is_overlay=*/false);
+  FlushOutputSurface();
+
+  inline_3d_over_plane_->painted_rects = tile_rects;
+  // Publish AFTER the paint task and BEFORE the root pass is painted — the GPU
+  // task queue is FIFO, so the consumer-to-be sees the plane already filled and
+  // strictly ahead of the page/weave. Risk guard R7.
+  skia_output_surface_->SetInline3dOverPlane(inline_3d_over_plane_->mailbox,
+                                             size);
+
+  static int over_dbg = 0;
+  if ((over_dbg++ % 60) == 0) {
+    VLOG(1) << "[DisplayXR] inline-3D plane-split: over-plane size="
+            << size.ToString() << " tiles=" << tile_rects.size()
+            << " over_set=" << inline3d_over_clips_.size() << " draws=" << draws
+            << (created_now ? " (allocated)" : "")
+            << " difference_clip=" << inline3d_difference_clip_enabled_
+            << " (no consumer in 0063)";
+  }
+}
