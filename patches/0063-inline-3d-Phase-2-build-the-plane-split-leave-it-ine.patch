+void SkiaRenderer::MaybeDrawInline3dOverPlane(
+    const AggregatedRenderPass* root) {
+  // DisplayXR inline-3D Phase 2 (plane split). Paint the OVER set — the page
+  // quads that sit in FRONT of a woven tile, as computed at draw time by
+  // DirectRenderer::ComputeInline3dPlaneSplit — into a separate window-sized
+  // transparent plane, and publish its mailbox.
+  //
+  // Patch 0063 stops there ON PURPOSE: nothing consumes the plane, and the page
+  // draw is not punched (|inline3d_difference_clip_enabled_| is false), so the
+  // frame that reaches the screen is bit-for-bit the Phase-1 frame. What this
+  // buys is that every allocation, transform, clear and replay path is live and
+  // observable on real hardware before the consumer lands.
+  //
+  // Gated on there being TILES this frame, not on the over set being non-empty:
+  // "tiles present, nothing over them" still has to clear and republish the
+  // plane, or a consumer would composite last frame's pixels as a ghost.
+  if (!root || !skia_output_surface_ || inline_3d_tiles_.empty()) {
+    return;
+  }
+  DCHECK(!current_canvas_);
+  DCHECK(batched_quads_.empty());
+
+  const gfx::Size size = current_frame()->device_viewport_size;
+  if (size.IsEmpty()) {
+    return;
+  }
+  // Premultiplied RGBA8, NOT scanout: this plane is sampled by a later stage,
+  // never handed to the OS compositor as a plane of its own. Keeping SCANOUT
+  // off also keeps it off the DComp/swap-chain paths entirely.
+  const SharedImageFormat format = SinglePlaneFormat::kRGBA_8888;
+  const gfx::ColorSpace color_space = RenderPassColorSpace(root);
+
+  if (inline_3d_over_plane_ &&
+      (inline_3d_over_plane_->size != size ||
+       inline_3d_over_plane_->format != format ||
+       inline_3d_over_plane_->color_space != color_space)) {
+    skia_output_surface_->DestroySharedImage(inline_3d_over_plane_->mailbox);
+    inline_3d_over_plane_.reset();
+  }
+  bool created_now = false;
+  if (!inline_3d_over_plane_) {
+    const gpu::SharedImageUsageSet usage =
+        gpu::SHARED_IMAGE_USAGE_DISPLAY_READ |
+        gpu::SHARED_IMAGE_USAGE_DISPLAY_WRITE;
+    gpu::Mailbox mailbox = skia_output_surface_->CreateSharedImage(
+        format, size, color_space, RenderPassAlphaType::kPremul, usage,
+        "DisplayXROverPlane", gpu::kNullSurfaceHandle);
+    if (mailbox.IsZero()) {
+      DLOG(ERROR) << "[DisplayXR] inline-3D plane-split: over-plane "
+                     "CreateSharedImage failed";
+      return;
+    }
+    inline_3d_over_plane_ =
+        Inline3dOverPlane{mailbox, size, format, color_space, {}};
+    created_now = true;
+  }
+
+  // The tile rects touched this frame (deduplicated); the clear set below is
+  // union(previous paint, these).
+  std::vector<gfx::Rect> tile_rects;
+  for (const Inline3dTile& tile : inline_3d_tiles_) {
+    if (!tile.rect.IsEmpty() &&
+        std::ranges::find(tile_rects, tile.rect) == tile_rects.end()) {
+      tile_rects.push_back(tile.rect);
+    }
+  }
+
+  // Draw with the ROOT pass's geometry, so a quad lands in exactly the same
+  // device pixels here as it does in the page draw. Anything else and the plane
+  // would be a subtly shifted copy.
+  base::AutoReset<raw_ptr<const AggregatedRenderPass>> reset_current_pass(
+      &current_frame()->current_render_pass, root);
+  base::AutoReset<gfx::AxisTransform2d> reset_target_to_device(
+      &current_frame()->target_to_device_transform,
+      CalculateTargetToDeviceTransform(root->output_rect, size));
+
+  // is_overlay=false is load-bearing (risk guard R8): it is what keeps
+  // SkiaOutputSurfaceImplOnGpu::MaybeWeaveRootRenderPass inert for this paint —
+  // that guard bails on !is_overlay — so the over-plane is never mistaken for
+  // the page and woven. This plane is also never added to render_pass_backings_
+  // or the frame's pass list, so nothing else can pick it up either.
+  static constexpr AggregatedRenderPassId kOverPlanePassId =
+      AggregatedRenderPassId::FromUnsafeValue(
+          std::numeric_limits<uint64_t>::max());
+  current_canvas_ = skia_output_surface_->BeginPaintRenderPass(
+      kOverPlanePassId, size, format, RenderPassAlphaType::kPremul,
+      skgpu::Mipmapped::kNo, /*scanout_dcomp_surface=*/false, color_space,
+      /*is_overlay=*/false, inline_3d_over_plane_->mailbox);
+  if (!current_canvas_) {
+    DLOG(ERROR) << "[DisplayXR] inline-3D plane-split: BeginPaintRenderPass "
+                   "for the over-plane failed";
