+
+void DirectRenderer::ComputeInline3dPlaneSplit(
+    const AggregatedRenderPass* root) {
+  inline3d_over_clips_.clear();
+  if (!root || inline_3d_tiles_.empty()) {
+    return;
+  }
+
+  // Snapshot the root pass in FRONT-TO-BACK order (index 0 == frontmost, see
+  // the ordering note on the declaration) together with each quad's rect in
+  // root target space — the space the tile rects are already in. The rect
+  // mapping mirrors DirectRenderer::ShouldSkipQuad so "does this quad touch the
+  // tile" agrees with what will actually be painted.
+  struct Candidate {
+    raw_ptr<const DrawQuad, CtnExperimental> quad;
+    gfx::Rect target_rect;
+  };
+  std::vector<Candidate> quads;
+  quads.reserve(root->quad_list.size());
+  for (const DrawQuad* quad : root->quad_list) {
+    gfx::Rect target_rect = quad->visible_rect;
+    if (auto* rpdq = quad->DynamicCast<AggregatedRenderPassDrawQuad>()) {
+      target_rect = GetExpandedRectForPixelMovingFilters(*rpdq);
+    }
+    target_rect = cc::MathUtil::MapEnclosingClippedRect(
+        quad->shared_quad_state->quad_to_target_transform, target_rect);
+    if (quad->shared_quad_state->clip_rect) {
+      target_rect.Intersect(*quad->shared_quad_state->clip_rect);
+    }
+    quads.push_back({quad, target_rect});
+  }
+
+  // The canvas resources of ALL registered tiles: a tile's own canvas quad is
+  // never in any over set, not even another tile's.
+  ResourceIdSet tile_canvas_resources;
+  for (const Inline3dTile& tile : inline_3d_tiles_) {
+    if (tile.canvas_resource_id != kInvalidResourceId) {
+      tile_canvas_resources.insert(tile.canvas_resource_id);
+    }
+  }
+
+  // Exclusion tallies, for the hardware-verification VLOG below.
+  size_t excl_sorting_context = 0;
+  size_t excl_blend_mode = 0;
+  size_t excl_render_pass_quad = 0;
+  size_t excl_requires_overlay = 0;
+  size_t excl_tile_canvas = 0;
+  size_t excl_suppressed = 0;
+  size_t tiles_without_k = 0;
+  std::string per_tile_k;
+
+  for (const Inline3dTile& tile : inline_3d_tiles_) {
+    if (tile.rect.IsEmpty()) {
+      continue;
+    }
+    // k(T): the tile canvas quad's front-to-back index. LAST match wins — a
+    // resource can legitimately appear more than once (a tiled raster, a
+    // background copy), and the last front-to-back match is the DEEPEST
+    // occurrence, i.e. the one painted first. Taking it makes [0, k) the widest
+    // over set the evidence supports, which is the right failure direction:
+    // everything painted after the tile's first appearance is included, rather
+    // than quads that really are in front of it being silently dropped from the
+    // plane and left to bury the tile. Risk guard R1.
+    std::optional<size_t> k;
+    if (tile.canvas_resource_id != kInvalidResourceId) {
+      for (size_t i = 0; i < quads.size(); ++i) {
+        if (quads[i].quad->resource_id == tile.canvas_resource_id) {
+          k = i;
+        }
+      }
+    }
+    if (!k.has_value()) {
+      // No quad for this tile in the live list (promoted to an overlay, removed
+      // as overdraw, or no canvas resource id was resolvable). Skip the split
+      // for this tile — Phase-1 behaviour, i.e. the page keeps painting over
+      // it. Risk guard R1.
+      ++tiles_without_k;
+      continue;
+    }
+    per_tile_k +=
+        base::StringPrintf(" {id=%s k=%zu rect=%s}", tile.id.ToString().c_str(),
+                           *k, tile.rect.ToString().c_str());
+
+    for (size_t i = 0; i < *k; ++i) {
+      const Candidate& c = quads[i];
+      if (!c.target_rect.Intersects(tile.rect)) {
+        continue;
+      }
+      const SharedQuadState* sqs = c.quad->shared_quad_state;
+      // v1 exclusions. Each is a case where lifting the quad onto a separate
+      // plane would change what it composites against, so it stays in the page.
+      if (sqs->sorting_context_id != 0) {
+        // Part of a 3D sorting context: the BSP tree, not the list order,
+        // decides what is in front of what.
+        ++excl_sorting_context;
+        continue;
+      }
+      if (sqs->blend_mode != SkBlendMode::kSrcOver) {
+        // A non-kSrcOver blend reads the backdrop it is drawn onto; moving it
+        // to an empty plane changes its result.
+        ++excl_blend_mode;
+        continue;
+      }
+      if (c.quad->material == DrawQuad::Material::kAggregatedRenderPass) {
+        // ALL of them, unconditionally: a render pass draw quad can carry
+        // pixel-moving filters (blur, drop-shadow) and backdrop filters that
+        // sample outside its own rect and outside this plane. "It only wraps
+        // one pass so it is safe" is FALSE.
+        ++excl_render_pass_quad;
+        continue;
+      }
+      if (OverlayCandidate::RequiresOverlay(c.quad)) {
+        // Protected/hardware-only content (e.g. protected video). The page draw
+        // already replaces it with a solid fallback rather than compositing it;
+        // it must not be duplicated onto another plane.
+        ++excl_requires_overlay;
+        continue;
+      }
+      if (c.quad->resource_id != kInvalidResourceId &&
+          tile_canvas_resources.contains(c.quad->resource_id)) {
+        ++excl_tile_canvas;
+        continue;
+      }
+      if (c.quad->resource_id != kInvalidResourceId &&
+          !inline_3d_suppressed_resources_.empty() &&
+          inline_3d_suppressed_resources_.contains(c.quad->resource_id)) {
+        // Already withheld from the page draw (ShouldSkipQuad) because the
+        // weave draw-back owns those pixels. Never painted into the page, so
+        // there is nothing for the over-plane to take over.
+        ++excl_suppressed;
+        continue;
+      }
+      inline3d_over_clips_[c.quad].push_back(tile.rect);
+    }
+  }
+
+  static int split_dbg = 0;
+  if ((split_dbg++ % 60) == 0) {
+    VLOG(1) << "[DisplayXR] inline-3D plane-split: tiles="
+            << inline_3d_tiles_.size() << " quads=" << quads.size()
+            << " over_set=" << inline3d_over_clips_.size()
+            << " tiles_without_k=" << tiles_without_k
+            << " excluded{sorting=" << excl_sorting_context
+            << " blend=" << excl_blend_mode << " rpdq=" << excl_render_pass_quad
+            << " overlay=" << excl_requires_overlay
+            << " tile_canvas=" << excl_tile_canvas
+            << " suppressed=" << excl_suppressed << "} k:" << per_tile_k;
+  }
+}
