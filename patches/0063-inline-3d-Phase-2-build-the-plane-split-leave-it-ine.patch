+
+  // DisplayXR inline-3D Phase 2 (plane split) --------------------------------
+  //
+  // Compute, for the frame about to be drawn, which quads in |root| sit OVER an
+  // inline-3D tile, and against which tile rect(s) each of them is clipped.
+  // Populates |inline3d_over_clips_|; clears it first.
+  //
+  // ORDERING TRUTH (get this right or the split inverts):
+  //   QuadList index 0 is the FRONTMOST quad — it is painted LAST and appears
+  //   on top (render_pass_internal.h: "quad_list ... store quad data in
+  //   front-to-back order"; the draw loop iterates BackToFrontBegin() ==
+  //   rbegin, i.e. from the highest index down to 0). So for the tile canvas
+  //   quad at front-to-back index k:
+  //     OVER  set = indices [0, k)      -- in front of the tile
+  //     UNDER set = indices (k, end)    -- behind the tile
+  //   and back-to-front order is DESCENDING index.
+  //
+  // This is computed HERE, at draw time, from the live |root->quad_list| —
+  // never from the aggregation-time quad ordinals in AggregatedFrame. Those
+  // ordinals are invalidated before drawing by Display::RemoveOverdrawQuads()
+  // and by OverlayProcessor::ProcessForOverlays(), both of which erase/reorder
+  // quads.
+  void ComputeInline3dPlaneSplit(const AggregatedRenderPass* root);
+
+  // Paint the OVER set (as computed above) into a separate transparent plane,
+  // so a consumer can composite it above the woven tiles. Default no-op;
+  // SkiaRenderer implements it. Called from DrawFrame immediately after
+  // ComputeInline3dPlaneSplit and immediately BEFORE the root pass is drawn, so
+  // the GPU-task queue is strictly ordered over-plane-then-page (risk guard
+  // R7).
+  virtual void MaybeDrawInline3dOverPlane(const AggregatedRenderPass* root) {}
+
   virtual void BeginDrawingFrame() = 0;
   virtual void FinishDrawingFrame() = 0;
   // If a pass contains a single tile draw quad and can be drawn without
@@ -395,6 +453,20 @@ class VIZ_SERVICE_EXPORT DirectRenderer {
   // (see SetInline3dSuppressedResources). Frame-scoped, like the set above.
   ResourceIdSet inline_3d_suppressed_resources_;
 
+  // DisplayXR inline-3D Phase 2 (plane split): this frame's weave targets, set
+  // by Display before DrawFrame (see SetInline3dTiles). Empty when inline-3D is
+  // inactive or --inline-3d-occlusion is off.
+  std::vector<Inline3dTile> inline_3d_tiles_;
+
+  // The OVER set for this frame: quad -> the tile rect(s) it is in front of.
+  // PER-QUAD, deliberately: a quad that is above tile A but below tile B is
+  // clipped against A only. Keyed by raw DrawQuad*, so it is valid ONLY for the
+  // duration of one DrawFrame — cleared at the top of DrawFrame and repopulated
