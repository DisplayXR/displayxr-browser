diff --git a/components/displayxr/gpu/displayxr_weave_gpu_mac.mm b/components/displayxr/gpu/displayxr_weave_gpu_mac.mm
index 259cac4..40d3a0e 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu_mac.mm
+++ b/components/displayxr/gpu/displayxr_weave_gpu_mac.mm
@@ -214,6 +214,101 @@ bool DisplayXRWeaveGpuMac::WeaveCanvasMac(IOSurfaceRef canvas_iosurface,
   return true;
 }
 
+// ---- (browser#143) THE REPACK, macOS ------------------------------------
+//
+// N destination sub-rects, 2 MTLBlits each (one per eye), 1 batch entry each.
+// Validate everything before the first blit: a half-run repack would leave one
+// eye of one sub-rect holding the previous frame's pixels.
+bool DisplayXRWeaveGpuMac::WeaveCanvasPiecesMac(
+    IOSurfaceRef canvas_iosurface,
+    const std::vector<viz::DisplayXRWeaveProvider::WeaveCopy>& copies,
+    const std::vector<gfx::Rect>& rects,
+    uint32_t target_id) {
+  if (!batch_open_ || !canvas_iosurface || !device_ || !queue_ ||
+      !input_iosurface_ || copies.empty() || rects.empty()) {
+    return false;
+  }
+  id<MTLDevice> device = (__bridge id<MTLDevice>)device_;
+  id<MTLCommandQueue> queue = (__bridge id<MTLCommandQueue>)queue_;
+  id<MTLTexture> src = WrapIOSurface(device, canvas_iosurface);
+  id<MTLTexture> dst = WrapIOSurface(device, input_iosurface_.get());
+  if (!src || !dst) {
+    return false;
+  }
+  const gfx::Rect src_bounds(0, 0, static_cast<int>(src.width),
+                             static_cast<int>(src.height));
+  const gfx::Rect dst_bounds(0, 0, static_cast<int>(dst.width),
+                             static_cast<int>(dst.height));
+  for (const auto& c : copies) {
+    if (c.src.IsEmpty() || c.src.size() != c.dst.size() ||
+        !src_bounds.Contains(c.src) || !dst_bounds.Contains(c.dst)) {
+      return false;
+    }
+  }
+  id<MTLCommandBuffer> cb = [queue commandBuffer];
+  id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+  for (const auto& c : copies) {
+    [blit copyFromTexture:src
+              sourceSlice:0
+              sourceLevel:0
+             sourceOrigin:MTLOriginMake(c.src.x(), c.src.y(), 0)
+               sourceSize:MTLSizeMake(c.src.width(), c.src.height(), 1)
+                toTexture:dst
+         destinationSlice:0
+         destinationLevel:0
+        destinationOrigin:MTLOriginMake(c.dst.x(), c.dst.y(), 0)];
+  }
+  [blit endEncoding];
+  [cb commit];
+  [cb waitUntilCompleted];
+  for (const gfx::Rect& r : rects) {
+    batch_entries_.push_back({target_id, r});
+  }
+  return true;
+}
+
+bool DisplayXRWeaveGpuMac::WeavePixelsPiecesMac(
+    const uint8_t* bgra_pixels,
+    uint32_t stride,
+    const gfx::Size& src_size,
+    const std::vector<viz::DisplayXRWeaveProvider::WeaveCopy>& copies,
+    const std::vector<gfx::Rect>& rects,
+    uint32_t target_id) {
+  if (!batch_open_ || !bgra_pixels || !input_iosurface_ || src_size.IsEmpty() ||
+      copies.empty() || rects.empty()) {
+    return false;
+  }
+  IOSurfaceRef surf = input_iosurface_.get();
+  const gfx::Rect src_bounds(src_size);
+  const gfx::Rect dst_bounds(static_cast<int>(IOSurfaceGetWidth(surf)),
+                             static_cast<int>(IOSurfaceGetHeight(surf)));
+  for (const auto& c : copies) {
+    if (c.src.IsEmpty() || c.src.size() != c.dst.size() ||
+        !src_bounds.Contains(c.src) || !dst_bounds.Contains(c.dst)) {
+      return false;
+    }
+  }
+  IOSurfaceLock(surf, 0, nullptr);
+  uint8_t* base = static_cast<uint8_t*>(IOSurfaceGetBaseAddress(surf));
+  const size_t dst_stride = IOSurfaceGetBytesPerRow(surf);
+  for (const auto& c : copies) {
+    const size_t row_bytes = static_cast<size_t>(c.src.width()) * 4u;
+    for (int r = 0; r < c.src.height(); ++r) {
+      uint8_t* d = base + (c.dst.y() + r) * dst_stride +
+                   static_cast<size_t>(c.dst.x()) * 4u;
+      const uint8_t* s = bgra_pixels +
+                         static_cast<size_t>(c.src.y() + r) * stride +
+                         static_cast<size_t>(c.src.x()) * 4u;
+      memcpy(d, s, row_bytes);
+    }
+  }
+  IOSurfaceUnlock(surf, 0, nullptr);
+  for (const gfx::Rect& r : rects) {
+    batch_entries_.push_back({target_id, r});
+  }
+  return true;
+}
