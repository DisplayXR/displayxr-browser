diff --git a/components/displayxr/gpu/displayxr_weave_gpu.cc b/components/displayxr/gpu/displayxr_weave_gpu.cc
index 60207bc..a1fd880 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu.cc
+++ b/components/displayxr/gpu/displayxr_weave_gpu.cc
@@ -1036,6 +1036,139 @@ bool DisplayXRWeaveGpu::BatchCopyPixels(ID3D11Device* device,
   return true;
 }
 
+// ---- (browser#143) THE REPACK ------------------------------------------
+//
+// N destination sub-rects, 2 copies each (one per eye), 1 batch entry each.
+// Everything geometric was decided by the caller — this only executes it, and
+// it executes ALL OF IT OR NONE: every box is validated before the first
+// CopySubresourceRegion, because a half-run repack would leave one eye of one
+// sub-rect holding the previous frame's pixels, which is precisely the
+// eye-inconsistency the topmost-wins work exists to end.
+bool DisplayXRWeaveGpu::BatchCopyPiecesFrom(
+    ID3D11Texture2D* src_tex,
+    UINT array_slice,
+    const std::vector<WeaveCopy>& copies,
+    const std::vector<gfx::Rect>& rects,
+    uint32_t target_id) {
+  if (!src_tex || copies.empty() || rects.empty()) {
+    return false;
+  }
+  D3D11_TEXTURE2D_DESC sd = {};
+  src_tex->GetDesc(&sd);
+
+  // Validate first, execute second (see above). A box is legal iff it is
+  // non-degenerate, wholly inside the source, and lands wholly inside the
+  // shared input at its destination — no clamping, deliberately: a clamp would
+  // silently shorten one eye and re-introduce the split disagreement.
+  for (const WeaveCopy& c : copies) {
+    if (c.src.IsEmpty() || c.src.size() != c.dst.size() || c.src.x() < 0 ||
+        c.src.y() < 0 || c.dst.x() < 0 || c.dst.y() < 0) {
+      return false;
+    }
+    if (static_cast<uint32_t>(c.src.right()) > sd.Width ||
+        static_cast<uint32_t>(c.src.bottom()) > sd.Height) {
+      return false;
+    }
+    if (static_cast<uint32_t>(c.dst.right()) > shared_input_.input_w ||
+        static_cast<uint32_t>(c.dst.bottom()) > shared_input_.input_h) {
+      return false;
+    }
+  }
+
+  for (const WeaveCopy& c : copies) {
+    D3D11_BOX box = {};
+    box.left = static_cast<UINT>(c.src.x());
+    box.top = static_cast<UINT>(c.src.y());
+    box.front = 0;
+    box.right = static_cast<UINT>(c.src.right());
+    box.bottom = static_cast<UINT>(c.src.bottom());
+    box.back = 1;
+    context_->CopySubresourceRegion(
+        shared_input_.input_tex.Get(), /*DstSubresource=*/0,
+        static_cast<UINT>(c.dst.x()), static_cast<UINT>(c.dst.y()),
+        /*DstZ=*/0, src_tex, array_slice, &box);
+  }
+  for (const gfx::Rect& r : rects) {
+    batch_entries_.push_back({target_id, r});
+  }
+  // (web#12 / browser#143) NOT recorded as keepable, and DROPPED if it was.
+  // |batch_last_copied_| means "this target's whole pair is at this one rect";
+  // after a repack the input content at a given address is a function of the
+  // whole decomposition, which changes shape as the occluder moves. A replay
+  // of a single recorded rect is unsound, so the record is erased rather than
+  // updated — the decline becomes structural instead of a flag the caller has
+  // to remember to set.
+  batch_last_copied_.erase(target_id);
+  return true;
+}
+
+bool DisplayXRWeaveGpu::WeaveCanvasPieces(ID3D11Device* device,
+                                          ID3D11Texture2D* canvas_tex,
+                                          UINT array_slice,
+                                          const std::vector<WeaveCopy>& copies,
+                                          const std::vector<gfx::Rect>& rects,
+                                          uint32_t target_id) {
+  // Batch mode only: the repack is a property of the SHARED window-sized
+  // input, and the per-target input the non-batch path uses holds exactly one
+  // pair at its origin.
+  if (!batch_open_ || !device || !canvas_tex) {
+    return false;
+  }
+  D3D11_TEXTURE2D_DESC cd = {};
+  canvas_tex->GetDesc(&cd);
+  if (!EnsureBatchInputAndAcquire(device, cd.Format)) {
+    return false;
+  }
+  return BatchCopyPiecesFrom(canvas_tex, array_slice, copies, rects, target_id);
+}
+
+bool DisplayXRWeaveGpu::WeavePixelsPieces(ID3D11Device* device,
+                                          const uint8_t* bgra_pixels,
+                                          uint32_t stride,
+                                          const gfx::Size& src_size,
+                                          const std::vector<WeaveCopy>& copies,
+                                          const std::vector<gfx::Rect>& rects,
+                                          uint32_t target_id) {
+  if (!batch_open_ || !device || !bgra_pixels || src_size.IsEmpty()) {
+    return false;
+  }
+  if (!EnsureBatchInputAndAcquire(device, DXGI_FORMAT_B8G8R8A8_UNORM)) {
+    return false;
+  }
+  // Upload the WHOLE tile once into the per-target staging texture, exactly as
+  // the single-rect path does, and let the repack run inside it. That keeps the
+  // |upload_tex| cache from thrashing (its dims still track the tile, not the
+  // decomposition) and costs no extra readback, allocation or CPU repack.
+  WeaveInput& in = inputs_[target_id];
+  const uint32_t w = static_cast<uint32_t>(src_size.width());
+  const uint32_t h = static_cast<uint32_t>(src_size.height());
+  if (!in.upload_tex || in.upload_w != w || in.upload_h != h) {
+    in.upload_tex.Reset();
+    D3D11_TEXTURE2D_DESC ud = {};
+    ud.Width = w;
+    ud.Height = h;
+    ud.MipLevels = 1;
+    ud.ArraySize = 1;
+    ud.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    ud.SampleDesc.Count = 1;
+    ud.Usage = D3D11_USAGE_DEFAULT;
+    ud.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(device_->CreateTexture2D(&ud, nullptr, &in.upload_tex))) {
+      LOG(ERROR) << "[DisplayXR] batch weave (repack): CreateTexture2D(upload)"
+                    " failed";
+      in.upload_tex.Reset();
+      return false;
+    }
+    in.upload_w = w;
+    in.upload_h = h;
+  }
+  context_->UpdateSubresource(in.upload_tex.Get(), /*DstSubresource=*/0,
+                              /*pDstBox=*/nullptr, bgra_pixels, stride,
+                              /*SrcDepthPitch=*/0);
+  return BatchCopyPiecesFrom(in.upload_tex.Get(), /*array_slice=*/0, copies,
+                             rects, target_id);
+}
