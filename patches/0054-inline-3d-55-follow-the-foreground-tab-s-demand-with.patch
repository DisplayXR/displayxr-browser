+void XRSession::ReportInline3DDemand(bool wants_3d) {
+  if (!is_inline_3d_) {
+    return;
+  }
+  if (inline_3d_demand_sent_ && inline_3d_demand_ == wants_3d) {
+    return;  // edge-triggered: nothing changed, stay off the wire
+  }
