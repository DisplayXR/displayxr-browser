diff --git a/chrome/browser/displayxr/displayxr_display_mode_controller.cc b/chrome/browser/displayxr/displayxr_display_mode_controller.cc
new file mode 100644
index 0000000000000..7ec51559c10d0
--- /dev/null
+++ b/chrome/browser/displayxr/displayxr_display_mode_controller.cc
@@ -0,0 +1,239 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/displayxr/displayxr_display_mode_controller.h"
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "components/displayxr/browser/displayxr_service_impl.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/gpu_service_registry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+
+namespace displayxr {
+
+namespace {
+
+// Long enough that tab flicking, a page load's layer churn, and a 3D element
+// scrolling past the viewport edge all settle before the panel moves; short
+// enough that leaving a 3D page feels immediate. The panel's own switch is the
+// slow part, so the cost of being wrong here is a visible flicker of the whole
+// display, not a dropped frame.
+constexpr base::TimeDelta kDebounce = base::Milliseconds(300);
+
+DisplayXRDisplayModeController*& InstancePtr() {
+  static DisplayXRDisplayModeController* instance = nullptr;
+  return instance;
+}
+
+// The tab currently shown by |browser|, or null.
+content::WebContents* ActiveContents(BrowserWindowInterface* browser) {
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  return tab ? tab->GetContents() : nullptr;
+}
+
+}  // namespace
+
+// static
+void DisplayXRDisplayModeController::CreateForBrowserProcess() {
+  if (InstancePtr()) {
+    return;
+  }
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("enable-inline-3d")) {
+    return;
+  }
+  // Deliberately leaked: it lives for the whole browser process and its
+  // observers must stay attached until the last window is gone.
+  InstancePtr() = new DisplayXRDisplayModeController();
+}
+
+// static
+DisplayXRDisplayModeController* DisplayXRDisplayModeController::GetIfExists() {
+  return InstancePtr();
+}
+
+DisplayXRDisplayModeController::DisplayXRDisplayModeController() {
+  collection_observation_.Observe(GlobalBrowserCollection::GetInstance());
+  // Windows opened before we got here (the startup window is one) never fire
+  // OnBrowserCreated at us.
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this](BrowserWindowInterface* browser) {
+        OnBrowserCreated(browser);
+        return true;
+      });
+  DisplayXRServiceImpl::SetInline3DDemandCallback(base::BindRepeating(
+      &DisplayXRDisplayModeController::OnFrameDemandChanged,
+      base::Unretained(this)));
+}
+
+DisplayXRDisplayModeController::~DisplayXRDisplayModeController() = default;
+
+void DisplayXRDisplayModeController::OnFrameDemandChanged(
+    content::GlobalRenderFrameHostId frame_id,
+    bool wants_3d) {
+  if (wants_3d) {
+    demanding_frames_.insert(frame_id);
+  } else {
+    demanding_frames_.erase(frame_id);
+  }
+  ScheduleApply();
+}
+
+bool DisplayXRDisplayModeController::ComputeWish() const {
+  if (demanding_frames_.empty()) {
+    return false;  // nothing anywhere wants 3D; skip the window walk
+  }
+
+  // Frontmost window that is actually on the panel. Visibility is the test, not
+  // window activation: app-level focus is deliberately NOT required, because a
+  // 3D page the user has clicked away from is still on screen and still being
+  // woven — that is the normal state of a 3D display sitting next to other
+  // apps, and the renderer keeps rendering for exactly that reason (see
+  // XRSession::UpdateVisibilityState, browser#625). A minimized or fully
+  // occluded window drops out here because content marks its tab non-VISIBLE,
+  // so it is skipped rather than allowed to veto a window behind it.
+  content::WebContents* foreground_contents = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&foreground_contents](BrowserWindowInterface* browser) {
+        content::WebContents* contents = ActiveContents(browser);
+        if (contents &&
+            contents->GetVisibility() == content::Visibility::VISIBLE) {
+          foreground_contents = contents;
+          return false;  // stop: frontmost visible window wins
+        }
+        return true;
+      });
+  if (!foreground_contents) {
+    return false;
+  }
+
+  // Any live frame of that tab reporting visible 3D content. Frames are held by
+  // id, not pointer, precisely so a dead one resolves to null here instead of
+  // dangling.
+  for (const content::GlobalRenderFrameHostId& id : demanding_frames_) {
+    content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(id);
+    if (rfh && rfh->IsActive() &&
+        content::WebContents::FromRenderFrameHost(rfh) == foreground_contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void DisplayXRDisplayModeController::ScheduleApply() {
+  if (shutting_down_) {
+    return;
+  }
+  // Restarts on every call, so a burst of events collapses into one decision.
+  debounce_.Start(FROM_HERE, kDebounce,
+                  base::BindOnce(&DisplayXRDisplayModeController::Apply,
+                                 base::Unretained(this)));
+}
+
+mojom::DisplayXRDisplayMode* DisplayXRDisplayModeController::GetSink() {
+  if (!sink_.is_bound()) {
+    content::BindInterfaceInGpuProcess(sink_.BindNewPipeAndPassReceiver());
+    sink_.set_disconnect_handler(
+        base::BindOnce(&DisplayXRDisplayModeController::OnSinkDisconnected,
+                       base::Unretained(this)));
+  }
+  return sink_.get();
+}
+
+void DisplayXRDisplayModeController::OnSinkDisconnected() {
+  sink_.reset();
+  // The GPU process went away with the panel in some state we no longer know.
+  // Forget what we think we applied so the next decision is sent unconditionally
+  // to whatever process replaces it.
+  applied_valid_ = false;
+  ScheduleApply();
+}
+
+void DisplayXRDisplayModeController::Apply() {
+  if (shutting_down_) {
+    return;
+  }
+  const bool wish = ComputeWish();
+  if (applied_valid_ && applied_3d_ == wish) {
+    return;  // transition-driven: nothing to do
+  }
+  if (!applied_valid_ && !wish) {
+    // Never asserted anything, and nothing wants 3D: stay silent rather than
+    // open with "go 2D". The panel is already 2D, and a standing 2D override
+    // would suppress the service's own force-3D warmup (which exists so the
+    // vendor eye tracker locks once weaving starts) for no reason. The first
+    // thing this controller ever says is "3D", when 3D content actually
+    // appears; from then on it tracks transitions in both directions. It also
+    // means a browser that never shows inline-3D never even binds the GPU
+    // interface.
+    return;
+  }
+  // The weave has already stopped by now when |wish| is false — it is fed from
+  // the same visible-rect set, and that has been empty for the whole debounce
+  // window. Requesting 2D before that would leave a woven atlas on screen with
+  // the lens off, which is blurry rather than ghosted: a different bug, not a
+  // fix.
+  GetSink()->SetDisplayMode(wish);
+  applied_3d_ = wish;
+  applied_valid_ = true;
+  VLOG(1) << "[DisplayXR] display-mode: foreground tab wants "
+          << (wish ? "3D" : "2D");
+}
+
+void DisplayXRDisplayModeController::ForceTwoDForShutdown() {
+  if (shutting_down_) {
+    return;
+  }
+  debounce_.Stop();
+  // Only if we already have a live pipe. Binding one here would spin up a GPU
+  // process during shutdown to tell it to do nothing — and an unbound sink
+  // means we never asserted 3D in the first place.
+  //
+  // Not gated on |applied_3d_| though: the weave may well have put the panel in
+  // 3D without us ever having asked for it, and this is the last moment anyone
+  // can hand it back. Best-effort even so — the message has to reach a GPU
+  // process being torn down alongside us. The reliable version of this is
+  // runtime-side (displayxr-runtime#814: fail safe to 2D when the last weave
+  // client disconnects), which covers the crash case too.
+  if (sink_.is_bound()) {
+    sink_->SetDisplayMode(/*three_d=*/false);
+  }
+  shutting_down_ = true;
+}
+
+void DisplayXRDisplayModeController::OnBrowserCreated(
+    BrowserWindowInterface* browser) {
+  if (!active_tab_subscriptions_.contains(browser)) {
+    active_tab_subscriptions_[browser] = browser->RegisterActiveTabDidChange(
+        base::BindRepeating([](DisplayXRDisplayModeController* self,
+                               BrowserWindowInterface*) { self->ScheduleApply(); },
+                            base::Unretained(this)));
+  }
+  ScheduleApply();
+}
+
+void DisplayXRDisplayModeController::OnBrowserClosed(
+    BrowserWindowInterface* browser) {
+  active_tab_subscriptions_.erase(browser);
+  ScheduleApply();
+}
+
+void DisplayXRDisplayModeController::OnBrowserActivated(
+    BrowserWindowInterface* browser) {
+  ScheduleApply();
+}
+
+void DisplayXRDisplayModeController::OnBrowserDeactivated(
+    BrowserWindowInterface* browser) {
+  ScheduleApply();
+}
+
+}  // namespace displayxr
diff --git a/chrome/browser/displayxr/displayxr_display_mode_controller.h b/chrome/browser/displayxr/displayxr_display_mode_controller.h
new file mode 100644
index 0000000000000..79cb3d8038f73
--- /dev/null
+++ b/chrome/browser/displayxr/displayxr_display_mode_controller.h
@@ -0,0 +1,134 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DISPLAYXR_DISPLAYXR_DISPLAY_MODE_CONTROLLER_H_
+#define CHROME_BROWSER_DISPLAYXR_DISPLAYXR_DISPLAY_MODE_CONTROLLER_H_
+
+// DisplayXR inline-3D display-mode policy (browser#55).
+//
+// The 3D panel's hardware element is STICKY: weaving turns it on, and stopping
+// weaving does not turn it off. Before this existed the browser only ever went
+// quiet — SubmitBatch early-returns on an empty rect list — so leaving an
+// inline-3D page left the lens on over flat content, which reads as soft and
+// ghosted. Nothing anywhere in the browser ever asked the panel to go back down.
+//
+// The policy is deliberately narrow: the panel follows the inline-3D demand of
+// the ACTIVE TAB OF THE FOREGROUND WINDOW, and nothing else. A 3D page in a
+// background tab, in a window behind another one, or in a minimized window
+// contributes nothing — it is not on the panel, so it has no claim on the panel.
+//
+// Two things this is careful about, both of which would sink a naive version:
+//
+//  1. xrRequestDisplayModeDXR is a HARDWARE-only override. It does not stop the
+//     weave. Asking for 2D while the weave still runs swaps ghosting for blur —
+//     the woven atlas stays on screen with the lens off. So 2D is only ever
+//     requested after demand has been false for the whole debounce window, by
+//     which point the same visible-rect set that feeds this has been producing
+//     empty weave batches for many frames.
+//
+//  2. Under a workspace controller the browser does not own the mode at all.
+//     The runtime answers that question (see
+//     DisplayXRWeaveClient::IsDisplayModeRequestable); we ask it rather than
+//     inferring anything from a return code, because the workspace gate is a
+//     silent XR_SUCCESS no-op.
+//
+// Browser process, UI thread. Windows-only in practice (the weave client is a
+// stub elsewhere), but the class itself is platform-neutral.
+
+#include <map>
+#include <set>
+
+#include "base/callback_list.h"
+#include "base/scoped_observation.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "components/displayxr/common/displayxr_weave.mojom.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class BrowserWindowInterface;
+class GlobalBrowserCollection;
+
+namespace displayxr {
+
+class DisplayXRDisplayModeController : public BrowserCollectionObserver {
+ public:
+  // Creates the process-wide instance and installs it as the demand sink.
+  // Idempotent; a no-op unless --enable-inline-3d. Call once from browser
+  // startup, after the weave client init has been posted.
+  static void CreateForBrowserProcess();
+
+  // The instance, or null if it was never created. Exposed for shutdown.
+  static DisplayXRDisplayModeController* GetIfExists();
+
+  DisplayXRDisplayModeController(const DisplayXRDisplayModeController&) =
+      delete;
+  DisplayXRDisplayModeController& operator=(
+      const DisplayXRDisplayModeController&) = delete;
+
+  // Drop the panel to 2D right now, skipping the debounce, and stop responding
+  // to anything further. For browser shutdown: the session dies with the
+  // process and the runtime does not return the panel on its own, so the last
+  // thing we do is hand it back flat.
+  void ForceTwoDForShutdown();
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+  void OnBrowserDeactivated(BrowserWindowInterface* browser) override;
+
+ private:
+  DisplayXRDisplayModeController();
+  ~DisplayXRDisplayModeController() override;
+
+  // Renderer said this frame's visible inline-3D content appeared/disappeared.
+  void OnFrameDemandChanged(content::GlobalRenderFrameHostId frame_id,
+                            bool wants_3d);
+
+  // Demand of the active tab of the frontmost window that is actually on screen.
+  bool ComputeWish() const;
+
+  // (Re)start the debounce. Anything that can change the wish calls this; the
+  // panel is only ever touched when the timer lands, so a flurry of tab flicks,
+  // a page load, or a 3D element scrolling past the viewport edge costs at most
+  // one hardware transition.
+  void ScheduleApply();
+  void Apply();
+
+  // The GPU process executes the request (that is where the weave session, and
+  // therefore the display processor the vendor keys its lens hint on, lives).
+  // Bound lazily and rebound after a GPU crash — a fresh GPU process inherits
+  // whatever state the old one left the panel in, so |applied_valid_| is
+  // dropped on disconnect to force the next decision through.
+  mojom::DisplayXRDisplayMode* GetSink();
+  void OnSinkDisconnected();
+
+  std::set<content::GlobalRenderFrameHostId> demanding_frames_;
+
+  mojo::Remote<mojom::DisplayXRDisplayMode> sink_;
+
+  // Per-window active-tab-change subscriptions. Switching tabs changes which
+  // document owns the panel, so it has to recompute even though no demand
+  // report accompanies it.
+  std::map<BrowserWindowInterface*, base::CallbackListSubscription>
+      active_tab_subscriptions_;
+
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      collection_observation_{this};
+
+  base::OneShotTimer debounce_;
+
+  // Last state handed to the runtime. Unset until the first apply, so the
+  // opening request always goes through.
+  bool applied_3d_ = false;
+  bool applied_valid_ = false;
+
+  bool shutting_down_ = false;
+};
+
+}  // namespace displayxr
+
+#endif  // CHROME_BROWSER_DISPLAYXR_DISPLAYXR_DISPLAY_MODE_CONTROLLER_H_
