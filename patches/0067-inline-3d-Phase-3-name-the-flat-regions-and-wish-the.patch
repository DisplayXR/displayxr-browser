     if (tile.rect.IsEmpty()) {
       continue;
@@ -686,9 +761,42 @@ void DirectRenderer::ComputeInline3dPlaneSplit(
         continue;
       }
       inline3d_over_clips_[c.quad].push_back(tile.rect);
+
+      // Phase 3 Stage 2 (browser#88): this quad's pixels are about to be lifted
+      // onto the over-plane and composited ON TOP of the woven tile, so where it
+      // covers the tile the viewer sees crisp 2D — that area wants the panel's
+      // physical 3D element OFF. |c.target_rect| is already the quad's mapped,
+      // clip-applied rect in root target space (computed once above), i.e. the
+      // same device-pixel space the weave rects use.
+      //
+      // OPAQUE ONLY. The over set admits translucent kSrcOver content too — a
+      // scrim, a fade, a rounded-corner mask — and there the woven 3D shows
+      // THROUGH the 2D. Calling that flat would switch the lens off over working
+      // 3D content: a mono regression, the one failure this feature must never
+      // cause. ShouldDrawWithBlending() covers every way the quad can be
+      // non-opaque over the tile (needs_blending, opacity < 1, blend mode, and a
+      // mask filter whose rounded corners expose the tile at the edges), so the
+      // guard is that single call, not a hand-rolled subset of it. A translucent
+      // quad simply leaves its area 3D = today's shipped ghosting.
+      if (c.quad->ShouldDrawWithBlending()) {
