diff --git a/components/viz/service/display/direct_renderer.cc b/components/viz/service/display/direct_renderer.cc
index 900e547637868..252e9c620aec7 100644
--- a/components/viz/service/display/direct_renderer.cc
+++ b/components/viz/service/display/direct_renderer.cc
@@ -77,6 +77,68 @@ enum class RenderPassDrawRectAssign {
   kMaxValue = kFullDamage,
 };
 
+// DisplayXR inline-3D Phase 3 Stage 2 (per-region hardware wish, browser#88).
+// Mirrors XR_WEAVE_SUBMIT_MAX_FLAT_RECTS_DXR (= 16) from XR_DXR_weave spec v8.
+// Not #included: this layer must not depend on the vendored OpenXR headers (they
+// live behind //components/displayxr), so the number is duplicated here and the
+// client clamps again on its own side.
+constexpr size_t kInline3dMaxFlatRects = 16;
+
+// Reduce |rects| to at most kInline3dMaxFlatRects, returning how many were
+// DROPPED. Two passes, in this order:
+//
+//   1. strict-containment dedupe — a rect wholly inside another kept rect adds
+//      nothing to the union, so removing it is LOSSLESS.
+//   2. largest-area-first cap — keep the 16 biggest, DROP the rest.
+//
+// Dropping rather than merging is the load-bearing rule. The runtime subtracts
+// this list from the hardware wish, so a rect that GREW past its true extent
+// switches the panel's 3D element off over pixels that are still woven 3D — a
+// mono regression on working content. A rect that is simply MISSING leaves that
+// area 3D, which is exactly the pre-v8 behaviour the browser ships today: the
+// flat 2D over the tile ghosts a little. Bounding-box merging trades the second
+// (recoverable, already-shipped) failure for the first (a visible regression),
+// so it is never done here — not even for two rects that look adjacent.
+size_t CoarsenInline3dFlatRects(std::vector<gfx::Rect>* rects) {
+  // Largest first, stable so equal-area rects keep the deterministic order the
+  // tile x quad loops produced. Sorting first also makes the containment test
+  // one-directional: a rect can only be contained by an EARLIER one, so exact
+  // duplicates collapse to their first occurrence instead of eliminating each
+  // other.
+  std::stable_sort(rects->begin(), rects->end(),
+                   [](const gfx::Rect& a, const gfx::Rect& b) {
+                     return a.size().Area64() > b.size().Area64();
+                   });
+
+  std::vector<gfx::Rect> kept;
+  kept.reserve(std::min(rects->size(), kInline3dMaxFlatRects));
+  size_t dropped = 0;
+  for (const gfx::Rect& r : *rects) {
+    if (r.IsEmpty()) {
+      continue;  // contributes nothing; not a drop.
+    }
+    bool contained = false;
+    for (const gfx::Rect& k : kept) {
+      if (k.Contains(r)) {
+        contained = true;
+        break;
+      }
+    }
+    if (contained) {
+      continue;  // lossless dedupe; not a drop.
+    }
+    // Keep testing containment past the cap so the reported count is honest:
+    // only rects that would really have widened the flat union are drops.
+    if (kept.size() < kInline3dMaxFlatRects) {
+      kept.push_back(r);
+    } else {
+      ++dropped;
+    }
+  }
+  *rects = std::move(kept);
+  return dropped;
+}
+
