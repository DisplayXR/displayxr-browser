+// DisplayXR client on the box, not just this browser.
+void DisplayXRWeaverImpl::RequestWeaveReconnect(
+    RequestWeaveReconnectCallback callback) {
+  uintptr_t raw_pipe = 0;
+  std::string service_tag;
+  const DisplayXRWeaveClient::ReconnectStatus status =
+      DisplayXRWeaveClient::BrokerIpcConnection(&raw_pipe, &service_tag);
+  base::win::ScopedHandle pipe(reinterpret_cast<HANDLE>(raw_pipe));
+
+  auto out = mojom::ReconnectResult::New();
+  out->status = static_cast<mojom::ReconnectStatus>(status);
+  out->service_tag = std::move(service_tag);
+  if (status == DisplayXRWeaveClient::ReconnectStatus::kOk && pipe.is_valid()) {
+    // mojo does the cross-process duplication itself. There is deliberately no
+    // OpenProcess/DuplicateHandle in this path: the browser never needs a handle
+    // to the GPU process, and the endpoint is one connection chosen at one
+    // moment rather than a standing capability to open the pipe at will.
+    out->pipe = mojo::PlatformHandle(std::move(pipe));
+  } else if (pipe.is_valid()) {
+    // Exported but not sendable — close it here rather than letting it ride out
+    // of scope unremarked, so the invariant is visible at the point it matters.
+    pipe.Close();
+    LOG(ERROR) << "[DisplayXR][weave-mode] reconnect: brokered endpoint could "
+                  "not be sent (status="
+               << static_cast<uint32_t>(status) << ") — handle closed";
+  }
+  std::move(callback).Run(std::move(out));
+}
+
 #endif  // BUILDFLAG(IS_WIN)
 
 }  // namespace displayxr
