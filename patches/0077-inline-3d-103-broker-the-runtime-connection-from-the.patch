+// ---------------------------------------------------------------------------
+// browser#103 (0077-B): the reconnect ladder and the broker. Design §4.1, §5-B,
+// §6.5-§6.8.
+// ---------------------------------------------------------------------------
+//
+// Two processes lost the same connection and only one of them can do anything
+// about it. Experiment E0 settled that: post-LowerToken the GPU process gets
+// ACCESS_DENIED opening \\.\pipe\displayxr\displayxr_comp_ipc (its USER_LIMITED
+// restricted token matches neither ACE on the pipe's SD), and it cannot spawn
+// displayxr-service either. So THIS process drives:
+//
+//   1. recover its own snap/query session — the probe, the service relaunch,
+//      and the fix for every inline-3D SCENE, in one xrCreateInstance;
+//   2. export a fresh un-handshaken endpoint from the recovered instance;
+//   3. hand it to the GPU process, which adopts it (0078-B).
+//
+// Step 1 is destroy-then-create, never create-then-swap: E0 also showed the
+// runtime's one-live-instance guard answers XR_ERROR_LIMIT_REACHED (-10) to a
+// second concurrent create, so overlapping instances are not merely
+// discouraged here, they are impossible.
+
+void AnswerSupportWaiters() {
+  WeaveClientState& s = State();
+  s.support_deadline_armed = false;
+  if (s.support_waiters.empty()) {
+    return;
+  }
+  const bool supported = IsSupportedWin();
+  std::vector<base::OnceCallback<void(bool)>> waiters =
+      std::move(s.support_waiters);
+  s.support_waiters.clear();
+  VLOG(1) << "[DisplayXR] inline-3D support: answering " << waiters.size()
+          << " deferred probe(s) -> " << supported;
+  for (base::OnceCallback<void(bool)>& cb : waiters) {
+    std::move(cb).Run(supported);
+  }
+}
+
+void RequestSupportWhenKnownWin(base::OnceCallback<void(bool)> callback) {
+  WeaveClientState& s = State();
+  // Knowable: a session came up in this process at some point. The latch, not
+  // the live handle — a machine that weaves is a machine that weaves, whether or
+  // not the pipe happens to be up in this millisecond.
+  if (s.sync_session_established) {
+    std::move(callback).Run(true);
+    return;
+  }
+  // Knowable the other way: init RAN and produced no session. That is either
+  // kUnavailable (no loader, no runtime, no weave extension — a machine fact) or
+  // a failure that left the latch clear, and in both cases false is the truth
+  // rather than a guess. This is the negative-control branch: on a box with no
+  // DisplayXR runtime it is reached within the first seconds and every probe
+  // after that answers synchronously, arming nothing.
+  if (s.initialized) {
+    std::move(callback).Run(false);
+    return;
+  }
+  // Not knowable yet — init is still finding the browser window or still racing
+  // a restarting service. Hold the answer rather than inventing one.
+  s.support_waiters.push_back(std::move(callback));
+  if (!s.support_deadline_armed) {
+    s.support_deadline_armed = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&AnswerSupportWaiters),
+        base::Seconds(kSupportProbeDeadlineSeconds));
+  }
+}
+
+void NoteVersionSkew() {
+  WeaveClientState& s = State();
+  s.weave_mode = WeaveMode::kSkew;
+  // Design §9: ONCE, unthrottled, naming the remedy. A line that tells the user
+  // what to do is worth nothing said twice and everything said once — and it
+  // must not be eligible for the 1-in-300 gate, because the very next thing this
+  // does is stop retrying often enough to reproduce it.
+  if (!s.skew_logged) {
+    s.skew_logged = true;
+    LOG(ERROR)
+        << "[DisplayXR][weave-mode] SKEW: this browser's DisplayXR client "
+           "library and the running displayxr-service are different builds "
+           "(xrCreateInstance -> XR_ERROR_RUNTIME_VERSION_SKEW_DXR "
+        << XR_ERROR_RUNTIME_VERSION_SKEW_DXR
+        << ") — the runtime was upgraded under a running browser; relaunch "
+           "DisplayXR Browser. Both git tags are named in the runtime's own "
+           "client log (%LOCALAPPDATA%\\DisplayXR\\DisplayXR_*.log); the "
+           "OpenXR surface does not expose them, so they cannot be repeated "
+           "here. Inline-3D tiles render MONO meanwhile. Re-probing every 5 "
+           "min — this is NOT permanent: an installer that finishes writing, "
+           "or a rollback, recovers without a relaunch.";
+  }
+  // Drop straight to the 5-minute tail (design §6.7). Never disable: the tail is
+  // one instance create per 300 s, which is free, and is exactly what makes
+  // "finish installing the runtime, keep browsing" work.
+  s.reconnect_attempts = std::max(s.reconnect_attempts, 4);
+  ArmReconnectLadder();
+}
+
+// One attempt at getting THIS process's session back. Returns kOk when the
+// browser has a live session afterwards — including the case where it already
+// had one and nothing needed doing.
+//
+// Everything about it is 0071's swap, reused rather than re-derived: the same
+// ResetForRetry + InitializeCore pair, the same sticky list, the same ordering.
+// The only difference is what it is recovering FROM.
+DisplayXRWeaveClient::ReconnectStatus RecoverOwnSession() {
+  using ReconnectStatus = DisplayXRWeaveClient::ReconnectStatus;
+  WeaveClientState& s = State();
+  // A live-looking session handle is NOT evidence: a dead pipe leaves the handle
+  // non-null and only the mode word knows better. Ask the mode.
+  if (s.weave_mode != WeaveMode::kDisconnected &&
+      s.weave_mode != WeaveMode::kReconnecting &&
+      s.weave_mode != WeaveMode::kSkew && s.session != XR_NULL_HANDLE) {
+    return ReconnectStatus::kOk;
+  }
+  const HWND hwnd = s.hwnd ? s.hwnd : FindMainWindowForCurrentProcess();
+  if (!hwnd) {
+    return ReconnectStatus::kNotReady;  // no window to bind; try again later
+  }
+
+  // Sticky state carried across the swap — 0071's list (§6.4), verbatim, for the
+  // same reasons. |latched_screen_flat| is the one that bites: the runtime's
+  // copy died with the session, the browser's is authoritative, and a lost latch
+  // is a permanently ghosted popup over live 3D.
+  const std::vector<DisplayXRWeaveClient::WeaveRect> flat =
+      s.latched_screen_flat;
+  const bool had_mode = s.requested_3d_valid;
+  const bool want_3d = s.requested_3d;
+
+  ResetForRetry(s);
+  const InitOutcome outcome = InitializeCore(hwnd);
+  if (outcome == InitOutcome::kVersionSkew) {
+    return ReconnectStatus::kVersionSkew;
+  }
+  if (outcome != InitOutcome::kOk || s.session == XR_NULL_HANDLE) {
+    return ReconnectStatus::kNotReady;
+  }
+
+  // Re-assert on the NEW session. ResetForRetry already reset |last_snap_x/y| to
+  // INT32_MIN, so the next SnapWindowIfMoved re-establishes the DP's phase
+  // reference even though the window has not moved a pixel.
+  if (!flat.empty()) {
+    SetScreenFlatRegionsWin(flat);
+  }
+  if (had_mode) {
+    RequestDisplayModeWin(want_3d);
+  }
+  return ReconnectStatus::kOk;
+}
+
+// The browser half of one ladder rung.
+void ReconnectLadderStep() {
+  using ReconnectStatus = DisplayXRWeaveClient::ReconnectStatus;
+  WeaveClientState& s = State();
+  s.reconnect_armed = false;
+  if (s.weave_mode != WeaveMode::kDisconnected &&
+      s.weave_mode != WeaveMode::kSkew) {
+    return;  // recovered underneath us (e.g. the GPU's request got there first)
+  }
+  ++s.reconnect_attempts;
+  const int attempt = s.reconnect_attempts;
+  s.weave_mode = WeaveMode::kReconnecting;
+
+  const ReconnectStatus st = RecoverOwnSession();
+  if (st == ReconnectStatus::kVersionSkew) {
+    NoteVersionSkew();
+    return;
+  }
+  if (st != ReconnectStatus::kOk) {
+    s.weave_mode = WeaveMode::kDisconnected;
+    if (WeaveModeLogGate(s.reconnect_fail_log_count)) {
+      LOG(ERROR) << "[DisplayXR][weave-mode] reconnect: connect failed "
+                    "(attempt "
+                 << attempt << ", last XrResult " << s.weave_last_result
+                 << ") — displayxr-service still unreachable; inline-3D scenes "
+                    "and tiles stay MONO";
+    }
+    ArmReconnectLadder();
+    return;
+  }
+
+  // This process is back. Its rig locates work again, so every inline-3D SCENE
+  // recovers here — the GPU's TILES recover when it asks for a brokered
+  // endpoint, which is 0078-B's ladder and is deliberately NOT pushed from here
+  // (the GPU owns its own backoff and its own present sequence).
+  const base::TimeDelta outage =
+      s.disconnected_since.is_null()
+          ? base::TimeDelta()
+          : base::TimeTicks::Now() - s.disconnected_since;
+  s.total_outage += outage;
+  s.weave_mode = s.degraded ? WeaveMode::kDegraded : WeaveMode::kRecovered;
+  LOG(INFO) << "[DisplayXR][weave-mode] RECONNECTED: browser weave session live "
+               "after "
+            << outage.InSeconds() << "s disconnected (" << attempt
+            << " attempt(s), generation " << s.weave_generation
+            << ", cumulative outage " << s.total_outage.InSeconds()
+            << "s) — inline-3D scenes are stereo again; the GPU process's tiles "
+               "recover on its next brokered reconnect";
+  // The browser's ladder is per-episode like the GPU's: the counter is reset
+  // here because a recovered browser session IS this axis's episode ending. The
+  // 60 s stability window that guards against a crash-looping service lives on
+  // the GPU side, where the per-frame evidence is.
+  s.reconnect_attempts = 0;
+  s.disconnected_since = base::TimeTicks();
+  // A disconnect SUPERSEDES a degrade, so the rig ladder was suppressed for the
+  // whole outage. InitializeCore has just re-derived |degraded| against the
+  // current runtime; re-arm it if it is still true.
+  if (s.degraded) {
+    ScheduleRenegotiate();
+  }
+}
+
+void ArmReconnectLadder() {
+  WeaveClientState& s = State();
+  // |renegotiable| is exactly "this process can create an OpenXR instance on its
+  // own", which is the browser process and not the sandboxed GPU one. Reusing it
+  // rather than adding a second word keeps one answer to one question.
+  if (!s.renegotiable || s.reconnect_armed) {
+    return;
+  }
+  if (s.weave_mode != WeaveMode::kDisconnected &&
+      s.weave_mode != WeaveMode::kSkew) {
+    return;
+  }
+  const int secs = RenegotiateDelaySeconds(s.reconnect_attempts);
+  s.reconnect_armed = true;
+  VLOG(1) << "[DisplayXR][weave-mode] RECONNECTING: attempt "
+          << s.reconnect_attempts + 1 << " in " << secs << "s";
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ReconnectLadderStep), base::Seconds(secs));
+}
+
+// The broker (design §5-B, runtime RC-4). Called from the mojo handler on the
+// UI thread, i.e. the same sequence every other browser-process toucher of
+// State() runs on.
+DisplayXRWeaveClient::ReconnectStatus BrokerIpcConnectionWin(
+    uintptr_t* out_pipe_handle,
+    std::string* out_service_tag) {
+  using ReconnectStatus = DisplayXRWeaveClient::ReconnectStatus;
+  WeaveClientState& s = State();
+  *out_pipe_handle = 0;
+  out_service_tag->clear();
+
+  // Negative control (design §9): a browser that never brought a weave client up
+  // has no instance to export from and must not start creating them because
+  // another process asked. This entry point is driven by IPC, so the guard is
+  // the load-bearing one — same reasoning as NoteSessionLostWin's.
+  if (!s.sync_session_established) {
+    return ReconnectStatus::kNotReady;
+  }
+
+  // Step 1 — and if it fails there is nothing to export from, which is the whole
+  // reason the browser recovers FIRST rather than in parallel.
+  const ReconnectStatus rec = RecoverOwnSession();
+  if (rec != ReconnectStatus::kOk) {
+    if (rec == ReconnectStatus::kVersionSkew) {
+      NoteVersionSkew();
+    } else {
+      // Keep the ladder honest: the GPU asked, we could not answer, so the
+      // browser's own ladder must still be running toward the same goal.
+      s.weave_mode = WeaveMode::kDisconnected;
+      ArmReconnectLadder();
+    }
+    return rec;
+  }
+
+  // Step 2. A pre-v9 runtime has no export at all; that is terminal FOR THIS
+  // RUNTIME (not for the process — an upgrade under a running browser is the
+  // whole reason the tail exists), so say it once and let the caller stop.
+  if (!s.export_ipc_connection) {
+    if (!s.broker_unsupported_logged) {
+      s.broker_unsupported_logged = true;
+      LOG(ERROR) << "[DisplayXR][weave-mode] reconnect: this runtime reports "
+                    "XR_DXR_weave spec "
+                 << s.weave_spec_version << " (< " << kWeaveSpecWithIpcExport
+                 << ") and has no xrWeaveExportIpcConnectionDXR — the GPU "
+                    "process cannot be handed a connection, so inline-3D tiles "
+                    "stay MONO until the browser is relaunched. Scenes DO "
+                    "recover (they read this process's session).";
+    }
+    return ReconnectStatus::kUnsupported;
+  }
+
+  XrWeaveIpcConnectionDXR conn = {XR_TYPE_WEAVE_IPC_CONNECTION_DXR};
+  conn.fd = -1;
+  const XrResult r = s.export_ipc_connection(s.instance, &conn);
+  if (XR_FAILED(r) || !conn.handle) {
+    // Deliberately NOT routed through NoteWeaveCallResult: this is an
+    // INSTANCE-level call on a session-free channel, and letting it feed the
+    // weave-session failure streak would let a broker hiccup masquerade as a
+    // dead weave.
+    if (WeaveModeLogGate(s.broker_fail_log_count)) {
+      LOG(ERROR) << "[DisplayXR][weave-mode] reconnect: broker failed — "
+                    "xrWeaveExportIpcConnectionDXR -> "
+                 << r << " (handle=" << conn.handle << ")";
+    }
+    return ReconnectStatus::kNotReady;
+  }
+
+  // Handle hygiene (§6.8): from here the endpoint is OWNED by the caller. It
+  // must be transferred or closed — a flapping service must not leak one pipe
+  // INSTANCE per attempt, because the service's pipe-instance count is finite
+  // and exhausting it would deny service to every DisplayXR client on the box.
+  *out_pipe_handle = reinterpret_cast<uintptr_t>(conn.handle);
+  VLOG(1) << "[DisplayXR][weave-mode] reconnect: brokered a fresh un-handshaken "
+             "endpoint for the GPU process (handle="
+          << conn.handle << ")";
+  return ReconnectStatus::kOk;
+}
