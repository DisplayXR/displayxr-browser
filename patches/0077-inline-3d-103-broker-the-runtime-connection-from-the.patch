+// browser#103 (0077-B): how one brokered reconnect attempt ended.
+//
+// Branch B of the design: experiment E0 showed the GPU process CANNOT open the
+// runtime pipe itself after LowerToken() — Chromium's GPU process runs a
+// `USER_LIMITED` restricted token whose restricted-SID list matches neither ACE
+// on the service pipe's security descriptor, so `CreateFileA` answers
+// ACCESS_DENIED. The unsandboxed browser process opens one FOR it and ships the
+// endpoint down this pipe.
+enum ReconnectStatus {
+  // |pipe| carries a fresh, connected, UN-HANDSHAKEN endpoint. Adopt it.
+  kOk,
+  // The browser could not recover its OWN session on this attempt, so there was
+  // nothing to export from — displayxr-service is still down (or still coming
+  // back up). Not an error: it is the expected answer on the early rungs of the
+  // ladder, because the browser's create attempt IS what relaunches the service.
+  kNotReady,
+  // xrCreateInstance reported XR_ERROR_RUNTIME_VERSION_SKEW_DXR: the installed
+  // client library and the running service are different builds. Recoverable
+  // (an installer that finishes writing, or a rollback, heals it) but not by
+  // retrying quickly — the caller drops to the 5-minute tail and says so once.
+  kVersionSkew,
+  // The runtime has no xrWeaveExportIpcConnectionDXR (XR_DXR_weave spec < 9).
+  // Terminal for THIS runtime: nothing can broker, so the caller stops asking.
+  kUnsupported,
+};
+
+// browser#103 (0077-B): the reply to RequestWeaveReconnect.
+struct ReconnectResult {
+  // The connected pipe endpoint, on kOk only. Mojo duplicates the underlying
+  // HANDLE into the receiving process itself — there is deliberately no
+  // hand-rolled OpenProcess/DuplicateHandle anywhere in this path (design §7).
+  // Null on every other status.
+  handle<platform>? pipe;
+  ReconnectStatus status;
+  // The service's build tag when the browser could name it, for the kVersionSkew
+  // line. Empty when it could not: the runtime logs both tags client-side
+  // (runtime #1108) and exposes neither through the OpenXR surface, so the
+  // consumer's SKEW line points at the runtime client log for the pair.
+  string service_tag;
+};
+
 interface DisplayXRWeaver {
   // Weave one window sub-rect. |texture| is the pre-weave SBS keyed-mutex shared
   // texture; |rect| is its window-relative device-pixel placement. Replies with
@@ -101,6 +142,23 @@ interface DisplayXRWeaver {
   WeaveSessionLost(WeaveSessionLostReason reason,
                    int32 last_result,
                    uint32 fail_count);
+
+  // browser#103 (0077-B): ask the browser process to broker a fresh runtime IPC
+  // endpoint for this GPU process. ONE ladder step; the caller owns the backoff.
+  //
+  // Answering this is not a lookup — the browser first recovers its OWN
+  // snap/query session (destroy-then-create; a second live XrInstance in one
+  // process is XR_ERROR_LIMIT_REACHED, so the order is mandatory). That create
+  // does triple duty (design §4.1): it is the liveness PROBE, it is what
+  // RELAUNCHES displayxr-service (only an unsandboxed process can spawn it), and
+  // it is what recovers the rig locates every inline-3D SCENE reads. Only then
+  // does it call xrWeaveExportIpcConnectionDXR for the endpoint returned here.
+  //
+  // Reply-carrying, unlike WeaveSessionLost, because the handle IS the reply.
+  // It is posted from the GPU-main sequence and marshalled back to it (like
+  // OnWeaveReply) — never waited on, so the present sequence never blocks.
+  [EnableIf=is_win]
+  RequestWeaveReconnect() => (ReconnectResult result);
 };
 
