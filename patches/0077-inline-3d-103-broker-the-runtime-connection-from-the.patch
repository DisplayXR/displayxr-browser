+// A fresh, connected, UN-HANDSHAKEN runtime IPC endpoint. Exactly one of the two
+// value fields is meaningful per platform; both are always present so the
+// layout does not change between them.
+// RAW_PTR_EXCLUSION on both pointers: this is an ABI struct the RUNTIME writes
+// through, so its layout is fixed by the extension, not by us — and neither
+// field is an owning C++ pointer the raw_ptr machinery could usefully track.
+// (The vendored OpenXR headers escape the plugin by living under third_party;
+// this declaration does not, so it has to say so out loud.)
+typedef struct XrWeaveIpcConnectionDXR {
+  XrStructureType type;
+  RAW_PTR_EXCLUSION void* XR_MAY_ALIAS next;
+  RAW_PTR_EXCLUSION void* handle;  // Windows: connected pipe HANDLE
+  int32_t fd;                      // POSIX: connected socket fd; -1 on Windows
+} XrWeaveIpcConnectionDXR;
+
+typedef XrResult(XRAPI_PTR* PFN_xrWeaveExportIpcConnectionDXR)(
+    XrInstance instance,
+    XrWeaveIpcConnectionDXR* connection);
+#endif  // XR_TYPE_WEAVE_IPC_CONNECTION_DXR
+
+// The XR_DXR_weave spec version that first carries xrWeaveExportIpcConnectionDXR.
+// A runtime below this cannot broker at all, which is a terminal answer for that
+// runtime rather than something to keep asking about.
+constexpr uint32_t kWeaveSpecWithIpcExport = 9;
+
+// browser#103 (0077-B): the runtime DLL that EXPORTS the adopt half of the
+// broker contract, and the export's name.
+//
+// GetModuleHandle, never LoadLibrary: the Khronos loader already loaded this DLL
+// into every process that has a weave session (the GPU process pre-sandbox), and
+// a post-LowerToken LoadLibrary would be a new privileged act. The DLL is
+// libopenxr.def's DisplayXRClient.dll — the OpenXR runtime library itself, which
+// is where runtime PR #1108 adds `ipc_client_connection_adopt_handle` to the
+// export list.
+//
+// The EXPORT is the contract, not the DXR_IPC_HANDLE environment variable that
+// the same runtime patch also accepts. The env form is unusable here: the
+// runtime DLL is loaded pre-sandbox at browser start, so its static-CRT
+// environment snapshot is taken then, and a SetEnvironmentVariableA at reconnect
+// time updates only the Win32 block — invisible to the CRT `getenv` the runtime
+// reads it with. (Same trap XRT_FORCE_MODE documents, and the reason
+// InitializeCore sets that one before anything loads.) The env form serves its
+// Android twin, where the value is set before the process starts.
+constexpr wchar_t kRuntimeClientDll[] = L"DisplayXRClient.dll";
+constexpr char kAdoptHandleExport[] = "ipc_client_connection_adopt_handle";
+
+// browser#103 (E0 fold-in): how long a support probe may wait for an answer that
