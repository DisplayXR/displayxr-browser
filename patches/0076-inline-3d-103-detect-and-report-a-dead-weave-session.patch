   return DisplayXRWeaveClient::WasSyncSessionEstablished();
 }
 
+// browser#103: push the client's dead-session verdict to the browser process.
+//
+// Two processes have to know. The GPU process is where detection happens (it
+// owns the weaving session and sees every failed call), but the BROWSER process
+// owns the other half of the problem: its own snap/query session backs
+// LocateViewsForRect, i.e. every inline-3D SCENE, and it is the only process
+// that can ever relaunch displayxr-service — a sandboxed GPU process cannot
+// spawn children. So the verdict has to cross, even though 0076 does nothing
+// with it yet beyond recording and logging.
+void DisplayXRWeaveGpu::ReportWeaveSessionLostIfDetected() {
+  DisplayXRWeaveClient::SessionLostReason reason =
+      DisplayXRWeaveClient::SessionLostReason::kUnknown;
+  int32_t last_result = 0;
+  uint32_t fail_count = 0;
+  if (!DisplayXRWeaveClient::TakeSessionLostReport(&reason, &last_result,
+                                                   &fail_count)) {
+    return;
+  }
+  if (!weaver_.is_bound()) {
+    // Sync mode never calls WeaveSubmit, so this remote is otherwise idle —
+    // but it IS bound (ChromeContentGpuClient::PostCompositorThreadCreated
+    // calls Bind() unconditionally under --enable-inline-3d). If it somehow is
+    // not, the client has already logged the DISCONNECTED line locally and
+    // dropping the hop is strictly better than wedging the present sequence.
+    LOG(ERROR) << "[DisplayXR][weave-mode] weave session lost but the browser "
+                  "bridge is not bound — reported GPU-side only";
+    return;
+  }
+  // Value-for-value with the client enum; asserted once, at the receiving cast
+  // in displayxr_weaver_impl.cc, which fails the same build if either drifts.
+  weaver_->WeaveSessionLost(static_cast<mojom::WeaveSessionLostReason>(reason),
+                            last_result, fail_count);
+}
