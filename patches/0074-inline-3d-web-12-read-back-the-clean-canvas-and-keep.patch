@@ -26,6 +26,15 @@ bool DisplayXRWeaveProvider::SubmitBatchSync() {
   return false;
 }
 
+// (web#12) Keep-previous default: refuse. A provider with no shared, never-
+// cleared window-sized input has nothing to keep, and answering "yes" would
+// tell the caller a tile was woven when nothing was. The caller treats false
+// exactly as it treated a failed copy before this existed.
+bool DisplayXRWeaveProvider::BatchKeepPrevious(const gfx::Rect& window_rect,
+                                               uint32_t target_id) {
+  return false;
+}
+
 // Per-region hardware wish (spec v8, browser#88) default: accept and ignore.
 // This is the whole macOS story too — the mac provider's weave path publishes no
 // wish yet, and because the wish is ADVISORY (hardware element only, never
diff --git a/components/viz/service/display_embedder/displayxr_weave_provider.h b/components/viz/service/display_embedder/displayxr_weave_provider.h
index 5670e5ec9db9f..30783e9f17043 100644
--- a/components/viz/service/display_embedder/displayxr_weave_provider.h
+++ b/components/viz/service/display_embedder/displayxr_weave_provider.h
@@ -170,6 +170,39 @@ class VIZ_SERVICE_EXPORT DisplayXRWeaveProvider {
   virtual void BeginBatchSync(const gfx::Size& window_size);
   virtual bool SubmitBatchSync();
 
+  // (web#12) KEEP-PREVIOUS: submit |target_id| at |window_rect| WITHOUT copying
+  // anything into the shared input, so the runtime re-weaves the pixels already
+  // sitting there from the last frame that did copy.
+  //
+  // This is only sound because of a property of the batch model that the rest
+  // of this interface never had to name: the shared input is window-sized,
+  // every target writes it AT ITS OWN WINDOW POSITION, and it is NEVER cleared
+  // between frames.
+  // So after a successful copy the input holds that tile's SBS at exactly the
+  // window rect the runtime will weave from — indefinitely, until something
+  // overwrites it or the texture is reallocated. A tile whose copy fails this
+  // frame therefore does not have to become a hole: not overwriting it leaves
+  // last frame's correct stereo pixels in place, and re-submitting the same
+  // rect re-weaves them.
+  //
+  // The caller must only ask for this when the tile's rect is UNCHANGED since
+  // its last successful copy — at a different rect the input holds someone
+  // else's pixels (or nothing) there. The implementation enforces the same
+  // guard from its own bookkeeping and returns false if it cannot honour it (no
+  // prior copy, rect moved, input reallocated by a resize/format/device change,
+  // batch not open), in which case the caller is exactly as it was before this
+  // existed.
+  //
+  // Returns true if an entry was staged, i.e. the tile counts as woven this
+  // frame: the batch still submits, the liveness gate still passes, and phase
+  // (B) still draws the tile back. That is the whole point — the failure mode
+  // this replaces is "every tile declines → zero entries → no submit at all →
+  // the runtime's woven output is never refreshed and the suppressed tiles show
+  // as holes". Default: false (non-batch providers have no shared input to
+  // keep).
+  virtual bool BatchKeepPrevious(const gfx::Rect& window_rect,
+                                 uint32_t target_id);
+
   // Per-region hardware wish (XR_DXR_weave spec v8, browser#88 Phase 3 Stage 2).
   // Set ONCE per batch frame, between BeginBatchSync and SubmitBatchSync, with
   // this frame's FLAT rects: the sub-areas of the submitted weave rects whose
diff --git a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
index 7188ce68a2978..3ece7cc5e34ab 100644
--- a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
+++ b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
@@ -3133,6 +3133,55 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     const gfx::Rect clean_sbs_rect = clean_sbs.rect;  // UNCLIPPED full tile
     const gfx::RectF clean_sbs_uv = clean_sbs.uv;     // resource sub-rect (#73)
 
+    // ---- (web#12, 0074 — PART 2) KEEP THIS TILE'S PREVIOUS CONTENT ----
+    //
+    // The last resort, reached from every point below at which this tile can no
+    // longer produce pixels this frame. 0073 taught the weave to REFUSE bad
+    // sources; refusing is right, but a refusal with nothing behind it is still
+    // a dark tile, and the field logs are that fact stated in numbers: 301+
+    // "CPU readback would sample the suppression hole" skips against a recovery
+    // draw that also produced nothing (n=0 missing=2).
+    //
+    // There is, however, something behind it. The batch weave input is ONE
+    // window-sized texture, written per target at the target's own window
+    // position, and never cleared between frames — so this tile's last
+    // successful copy is still sitting there, at this rect, correct and stereo.
+    // A tile that cannot be copied this frame does not have to be overwritten;
+    // it can simply be re-submitted, and the runtime re-weaves what is already
+    // in the input. The visual result when the tile is static is
+    // indistinguishable from success; when it is animating it is one frame (or,
+    // under a long failure run, several frames) stale — a slowed animation
+    // rather than a black hole. That is the right trade in both directions.
+    //
+    // GUARD: rect-unchanged-since-the-last-copy, enforced inside the provider
+    // from its own bookkeeping (it is the only party that knows when the shared
+    // texture is reallocated, so it is the only correct home for that fact). At
+    // a moved rect the input holds someone else's pixels there, and keeping
+    // would drag a copy of the element behind the scroll — so the provider says
+    // no and this decays to exactly the pre-0074 behaviour.
+    //
+    // Nothing expires the kept content. A heavy producer whose canvas resource
+    // stays contended for a long RUN of frames is kept every one of them, from
+    // the same unchanged record; only a real copy, a rect change, a resize or a
+    // target retirement moves it.
+    auto keep_previous = [&]() -> bool {
+      if (!provider->BatchMode() ||
+          !provider->BatchKeepPrevious(rect, st.slot)) {
+        return false;
+      }
+      // Submit-time rect for phase (B), same as a real submit: the woven output
+      // will hold this tile at this rect.
+      st.pending_rect = rect;
+      // Count as submitted for the per-tile recovery draw. Its mono repaint is
+      // a rescue from BLACK; painting it over a correctly kept STEREO tile
+      // would be a downgrade — the same "never repaint a tile that has good
+      // pixels" rule the 0073 canvas_was_submitted() check exists to enforce.
+      if (!clean_sbs_mailbox.IsZero()) {
+        submitted_canvas_mailboxes.push_back(clean_sbs_mailbox);
+      }
+      return true;
+    };
+
     // ---- (web#12) NEVER WEAVE THE HOLE ----
     //
     // |inline_3d_canvas_layers_| is now EXACTLY the set display.cc suppressed
@@ -3168,7 +3217,7 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
                    << " layers=" << inline_3d_canvas_layers_.size()
                    << " skips=" << (n + 1) << ")";
       }
-      return false;
+      return keep_previous();
     }
 
     // B4d GPU-resident weave (DComp path, prefer_zero_copy). Keep the
@@ -3180,15 +3229,30 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     // write access. Any step failing falls through to the CPU readback below.
     if (prefer_zero_copy) {
       bool zc = [&]() -> bool {
-        // If any step fails we fall back to the WeavePixels CPU readback (still
-        // correct), logging the first reason once at VLOG(1) so a future
-        // regression is diagnosable without spamming default chrome.
-        static bool logged_fail = false;
-        auto fail = [&](const char* why) -> bool {
-          if (!logged_fail) {
-            logged_fail = true;
-            VLOG(1) << "[DisplayXR] B4d zero-copy fell back to WeavePixels: "
-                    << why;
+        // (web#12, 0074) THE INSTRUMENTATION THIS PATH NEVER HAD.
+        //
+        // Every step below could fail, and all of them shared ONE `static bool
+        // logged_fail` at VLOG(1) — so after the first failure in the process's
+        // life, at a verbosity nobody runs, this whole leg was mute. That is
+        // why the field capture could say "the CPU-readback leg is being
+        // reached 301 times" and not say WHY: the answer was in a line that had
