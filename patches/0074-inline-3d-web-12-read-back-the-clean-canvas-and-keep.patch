+                         uint32_t target_id) override;
   bool SetBatchOverlay(ID3D11Device* device,
                        ID3D11Texture2D* atlas_tex,
                        UINT array_slice) override;
@@ -199,6 +205,17 @@ class DisplayXRWeaveGpu : public viz::DisplayXRWeaveProvider {
   gfx::Size batch_size_;           // window client size this batch frame
   std::vector<BatchEntry> batch_entries_;
 
+  // (web#12) Where each target's pixels were last SUCCESSFULLY copied into
+  // |shared_input_|, in window-relative device px. Survives across frames (the
+  // shared input is never cleared), which is exactly what makes
+  // BatchKeepPrevious sound; dropped for a target by PruneTarget (its slot may
+  // be reused by an unrelated element) and cleared WHOLESALE whenever
+  // |shared_input_.input_tex| is reallocated, because the pixels it describes
+  // died with the old texture. Not merged into |inputs_| deliberately: in batch
+  // mode a WeaveInput's shared texture is unused, and this must be keyed to the
+  // SHARED input's lifetime.
+  base::flat_map<uint32_t, gfx::Rect> batch_last_copied_;
+
   // v4 DP-composited 2D overlay atlas (browser#18/#22): a second window-sized
   // legacy-DXGI keyed-mutex input holding the caller's premultiplied-alpha RGBA
   // overlay atlas, staged by SetBatchOverlay and submitted alongside
