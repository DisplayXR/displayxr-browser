diff --git a/components/displayxr/gpu/displayxr_weave_gpu.cc b/components/displayxr/gpu/displayxr_weave_gpu.cc
index d239344dd6c1a..7605c01cbc4d2 100644
--- a/components/displayxr/gpu/displayxr_weave_gpu.cc
+++ b/components/displayxr/gpu/displayxr_weave_gpu.cc
@@ -527,11 +527,21 @@ bool DisplayXRWeaveGpu::EnsureBatchInputAndAcquire(ID3D11Device* device,
     }
     return false;
   }
+  // (web#12) |batch_last_copied_| describes pixels living in a SPECIFIC
+  // texture. EnsureInput silently reallocates on a size, format or device
+  // change, and the new texture's contents are undefined — so a keep-previous
+  // decision taken against the old bookkeeping would re-weave garbage rather
+  // than last frame's tile. Notice the swap by identity (the only thing that
+  // cannot lie about it) and forget everything.
+  ID3D11Texture2D* const before = shared_input_.input_tex.Get();
   if (!EnsureInput(shared_input_, device,
                    format, static_cast<uint32_t>(batch_size_.width()),
                    static_cast<uint32_t>(batch_size_.height()))) {
     return false;
   }
+  if (shared_input_.input_tex.Get() != before) {
+    batch_last_copied_.clear();
+  }
   if (!batch_mutex_held_) {
     if (shared_input_.input_mutex->AcquireSync(0, 1000) != S_OK) {
       LOG(ERROR) << "[DisplayXR] batch weave: AcquireSync(0) failed";
@@ -596,6 +606,11 @@ bool DisplayXRWeaveGpu::BatchCopyCanvas(ID3D11Device* device,
                                   /*DstSubresource=*/0, dst_x, dst_y,
                                   /*DstZ=*/0, canvas_tex, array_slice, &box);
   batch_entries_.push_back({target_id, window_rect});
+  // (web#12) This target's pixels now live at |window_rect| in the current
+  // shared texture — the fact BatchKeepPrevious needs on a later frame whose
+  // copy fails. Recorded on the UNCLAMPED |window_rect| (what the submit and
+  // the keep-previous guard both speak), not the clamped D3D11_BOX.
+  batch_last_copied_[target_id] = window_rect;
   return true;
 }
 
@@ -654,6 +669,62 @@ bool DisplayXRWeaveGpu::BatchCopyPixels(ID3D11Device* device,
                                   /*DstSubresource=*/0, dst_x, dst_y,
                                   /*DstZ=*/0, in.upload_tex.Get(), 0, &box);
   batch_entries_.push_back({target_id, window_rect});
+  batch_last_copied_[target_id] = window_rect;  // (web#12) see BatchCopyCanvas
+  return true;
+}
+
+// (web#12) Stage a submit entry for a target that could NOT be copied this
+// frame, relying on the pixels its last successful copy left in the shared
+// input. See the header for why that is sound; the guards here are what make it
+// safe in the cases where it is not.
+bool DisplayXRWeaveGpu::BatchKeepPrevious(const gfx::Rect& window_rect,
+                                          uint32_t target_id) {
+  if (!batch_open_ || window_rect.IsEmpty() || !device_) {
+    return false;
+  }
+  // (a) This exact target must have written this EXACT rect. A moved tile's old
+  // pixels are at the old position; weaving them at the new one would drag a
+  // copy of the element behind the scroll. Rect-unchanged is the whole licence.
+  auto it = batch_last_copied_.find(target_id);
+  if (it == batch_last_copied_.end() || it->second != window_rect) {
+    return false;
+  }
+  // (b) The texture those pixels are in must still be the one we will submit,
+  // at the size this frame's batch was opened for. |batch_last_copied_| is
+  // cleared on reallocation, so this is belt-and-braces against a resize that
+  // has not yet reached EnsureInput — and it also guarantees the
+  // EnsureBatchInputAndAcquire below cannot itself trigger the reallocation.
+  if (!shared_input_.input_tex ||
+      shared_input_.input_w != static_cast<uint32_t>(batch_size_.width()) ||
+      shared_input_.input_h != static_cast<uint32_t>(batch_size_.height())) {
+    return false;
+  }
+  // (c) Acquire the shared input's keyed mutex even though we write nothing.
+  // Two reasons, both load-bearing: SubmitBatchSync only submits when the mutex
+  // was held (had_copies), and the service acquires the input on the other side
+  // of a matching release — a submit whose input was never acquired/released
+  // this frame is not a handoff the runtime's keyed-mutex protocol accepts. The
+  // format is the input's own, so EnsureInput takes its already-sized early
+  // return and nothing is recreated.
+  if (!EnsureBatchInputAndAcquire(device_.Get(), shared_input_.input_format)) {
+    return false;
+  }
+  batch_entries_.push_back({target_id, window_rect});
+  // NOT updated: |batch_last_copied_| already names this rect, and a keep is
+  // not a copy. Leaving it untouched is what lets a tile be kept for an
+  // unbounded RUN of failing frames (the heavy-producer case: a splat canvas
+  // whose read access is lost frame after frame) — every frame re-reads the
+  // same true fact and re-weaves the same pixels. Nothing here expires, decays
+  // or invalidates it; only a real copy, a rect change, or a texture
+  // reallocation moves it.
+  static int s_keep = 0;
+  const int n = s_keep++;
+  if (n < 3 || (n % 300) == 0) {
+    LOG(ERROR)
+        << "[DisplayXR] batch weave: keeping PREVIOUS content for target "
+        << target_id << " at " << window_rect.ToString()
+        << " (copy failed this frame; keeps=" << (n + 1) << ")";
+  }
   return true;
 }
 
@@ -678,15 +749,26 @@ bool DisplayXRWeaveGpu::SubmitBatchSync() {
     // frozen" with not one line in either log. It was completely silent. It is
     // now the discriminator for that window: when every target declines (a
     // canvas resource that will not open, a readback that returns nothing, or —
-    // since this patch — every tile refusing to weave the page's suppression
-    // hole) this is the line that says so. First 3, then 1-in-300, matching the
+    // since 0073 — every tile refusing to weave the page's suppression hole)
+    // this is the line that says so. First 3, then 1-in-300, matching the
     // submit-failure counter below.
+    //
+    // (web#12, 0074) This should now be RARE rather than the steady state under
+    // load. A tile whose copy fails at a rect it has copied before is kept
+    // (BatchKeepPrevious) instead of declining, which stages an entry — so the
+    // batch stays non-empty, the submit still goes out, the runtime still runs
+    // its first-chunk clear and re-weaves every kept rect, and the whole
+    // "multi-second silent no-submit window" class needs EVERY tile to be both
+    // uncopyable AND unkeepable (first frames, or a rect that just moved). If
+    // this line is still frequent after 0074, that is the fact to report: it
+    // means the failures are landing on frames where the rects are moving.
     static int s_empty = 0;
     const int n = s_empty++;
     if (n < 3 || (n % 300) == 0) {
       LOG(ERROR) << "[DisplayXR] batch weave: ZERO copies this frame — no "
                     "submit issued (acquired_input="
                  << had_mutex << " entries=" << batch_entries_.size()
+                 << " keepable=" << batch_last_copied_.size()
                  << " empties=" << (n + 1) << ")";
     }
     return false;
@@ -873,6 +955,15 @@ void DisplayXRWeaveGpu::PruneTargets(size_t count) {
       ++it;
     }
   }
+  // (web#12) Same rule as PruneTarget: a retired id's keep-previous record must
+  // not be inherited by whoever takes the id next.
+  for (auto it = batch_last_copied_.begin(); it != batch_last_copied_.end();) {
+    if (it->first >= count) {
+      it = batch_last_copied_.erase(it);
+    } else {
+      ++it;
+    }
+  }
 }
 
 void DisplayXRWeaveGpu::PruneTarget(uint32_t target_id) {
@@ -892,6 +983,11 @@ void DisplayXRWeaveGpu::PruneTarget(uint32_t target_id) {
     ResetInput(input_it->second);
     inputs_.erase(input_it);
   }
+  // (web#12) Slots are recycled, so a retiring target's keep-previous record
+  // must die with it: inherited by the next element admitted to this slot it
+  // would authorise weaving the OLD element's pixels at a rect the new one
+  // happens to share. Same reasoning as the result handles and the input above.
+  batch_last_copied_.erase(target_id);
 }
 
 // static
