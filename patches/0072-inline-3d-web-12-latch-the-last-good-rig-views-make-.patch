+  // there is no setter for it, and a resize already cleared views_ above.
   if (views_.size() != 1) {
     views_.clear();
   }
   if (views_.empty()) {
-    views_.emplace_back(MakeGarbageCollected<XRViewData>(
-        /*index=*/0, device::mojom::blink::XREye::kNone,
-        gfx::Rect(0, 0, output_width_, output_height_), graphics_api_));
+    const gfx::Rect mono_viewport(0, 0, output_width_, output_height_);
