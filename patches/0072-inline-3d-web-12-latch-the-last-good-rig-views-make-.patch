+constexpr unsigned kInline3DMaxEmptyReplies = 30;
+
 }  // namespace
 
 #define DCHECK_HIT_TEST_SOURCES()                                         \
@@ -1632,6 +1637,11 @@ void XRSession::ForceEnd(ShutdownPolicy shutdown_policy) {
       layer->close();
     }
   }
+  // web#12: session end is a real capability change, not a rig miss — drop the
+  // latched views outright rather than letting them age out. (The layer sweep
