+  // rate is the thing to watch, and without counters a latched miss leaves no
+  // trace at all. |pose_invalid| is the load-sensitive one (xrLocateViews
+  // succeeded but the head tracker had no fresh sample) and had NO log of any
+  // kind before.
+  uint64_t rig_miss_total = 0;
+  uint64_t rig_miss_locate_fail = 0;
+  uint64_t rig_miss_pose_invalid = 0;
+  uint64_t rig_miss_no_rect = 0;
+  uint64_t rig_miss_no_session = 0;
+  uint64_t rig_miss_time_fail = 0;
+  // Last XrResult from a failed xrLocateViews, carried into the throttled dump
+  // so the rate line still names the error.
+  XrResult rig_last_locate_result = XR_SUCCESS;
+  // One WARNING per process the first time head tracking starves badly enough
+  // that the latch is what is holding the scene together.
+  bool rig_starving_warned = false;
   // browser#92 weave-mode negotiation. |degraded| means the weave came up but
   // the rig did not, i.e. the session is live and batching normally while every
   // inline-3D scene renders MONO. |renegotiable| is set only on the
@@ -1692,6 +1713,79 @@ void SnapWindowIfMovedWin() {
   }
 }
 
+// web#12: why one rig locate came back with nothing. Every empty return from
+// LocateViewsForRectWin goes through NoteRigMiss so the reason is counted and
+// the rate is observable — the renderer's view latch deliberately hides
+// individual misses, so a silent producer would make a starving head tracker
+// undiagnosable.
+// A rig that was never negotiated is NOT a miss (it is the inert negative
+// control) and never reaches here.
+enum class RigMiss {
+  kNoSession,    // rig negotiated, but session/ref-space/time-converter gone
+  kNoRect,       // degenerate element rect from the caller
+  kTimeFail,     // QPC, or the KHR performance-counter -> XrTime conversion
+  kLocateFail,   // xrLocateViews errored or returned zero views
+  kPoseInvalid,  // located, but the head pose was not valid this instant
+};
+
+// Counts the miss, and speaks only when the RATE says something. Returns the
+// empty view list so each exit can `return NoteRigMiss(...)`.
+std::vector<DisplayXRWeaveClient::RigView> NoteRigMiss(RigMiss why) {
+  WeaveClientState& s = State();
+  ++s.rig_miss_total;
+  switch (why) {
+    case RigMiss::kNoSession:
+      ++s.rig_miss_no_session;
+      break;
+    case RigMiss::kNoRect:
+      ++s.rig_miss_no_rect;
+      break;
+    case RigMiss::kTimeFail:
+      ++s.rig_miss_time_fail;
+      break;
+    case RigMiss::kLocateFail:
+      ++s.rig_miss_locate_fail;
+      break;
+    case RigMiss::kPoseInvalid:
+      ++s.rig_miss_pose_invalid;
+      break;
+  }
+
+  // A hard locate failure is a capability-shaped event, not a load symptom, and
+  // it is worth a default-verbosity line — but exactly once, and derived from
+  // the rolling counter rather than a static bool, so it stays honest about
+  // being the first of a series.
+  if (why == RigMiss::kLocateFail && s.rig_miss_locate_fail == 1) {
+    LOG(ERROR) << "[DisplayXR] xrLocateViews (rig) failed -> "
+               << s.rig_last_locate_result
+               << "; inline-3D scenes fall back to mono";
+  }
+
+  // The rate dump: 1 line per 300 misses, first miss included so a session that
+  // is missing at all says so early.
+  if (s.rig_miss_total % 300 == 1) {
+    VLOG(1) << "[DisplayXR] inline3d rig miss: locate_fail="
+            << s.rig_miss_locate_fail
+            << " pose_invalid=" << s.rig_miss_pose_invalid
+            << " no_rect=" << s.rig_miss_no_rect
+            << " no_session=" << s.rig_miss_no_session
+            << " time_fail=" << s.rig_miss_time_fail
+            << " total=" << s.rig_miss_total
+            << " last_locate_result=" << s.rig_last_locate_result;
+  }
+
+  // Head tracking starving under load is the shape behind the reported dark
+  // blinking, and it is now INVISIBLE on screen thanks to the renderer's latch
+  // — so say it out loud once, at a verbosity a field log will actually have.
+  if (s.rig_miss_pose_invalid > 60 && !s.rig_starving_warned) {
+    s.rig_starving_warned = true;
+    LOG(WARNING) << "[DisplayXR] inline3d rig: head tracking starving under "
+                    "load — scene tiles would blink without the view latch ("
+                 << s.rig_miss_pose_invalid << " pose-invalid locates)";
+  }
+  return {};
+}
+
 // XR_DXR_view_rig + XR_DXR_display_zones: let the RUNTIME build the off-axis
 // views for one element. See the header for why this replaces the renderer-side
 // Kooima entirely.
@@ -1700,22 +1794,35 @@ std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectWin(
     float virtual_display_height) {
   WeaveClientState& s = State();
   std::vector<DisplayXRWeaveClient::RigView> out;
-  if (!s.has_rig_views || s.session == XR_NULL_HANDLE ||
-      s.ref_space == XR_NULL_HANDLE || !s.convert_time || rect.w <= 0 ||
-      rect.h <= 0) {
+  // No rig negotiated at all is the documented inert case (no service, or a
+  // degraded session) — a permanent, per-frame, by-design "no", already
+  // reported by the browser#92 [weave-mode] logging. Counting it as a miss
+  // every frame would bury the real ones, so it stays off the books.
+  if (!s.has_rig_views) {
     return out;
   }
+  // The rig WAS negotiated but the handles are not there: an anomaly, unlike
+  // the case above. Split from the rect check below because "the session is not
+  // usable" and "this element has no area" are different failures and only one
+  // of them is the caller's.
+  if (s.session == XR_NULL_HANDLE || s.ref_space == XR_NULL_HANDLE ||
+      !s.convert_time) {
+    return NoteRigMiss(RigMiss::kNoSession);
+  }
+  if (rect.w <= 0 || rect.h <= 0) {
+    return NoteRigMiss(RigMiss::kNoRect);
+  }
 
   // xrLocateViews rejects displayTime <= 0. QPC -> XrTime is the canonical
   // conversion; the time only drives the head/display-plane pose prediction
   // (the eyes come from the DP's latest sample), so "now" is right here.
   LARGE_INTEGER qpc = {};
   if (!::QueryPerformanceCounter(&qpc)) {
-    return out;
+    return NoteRigMiss(RigMiss::kTimeFail);
   }
   XrTime now = 0;
   if (XR_FAILED(s.convert_time(s.instance, &qpc, &now)) || now <= 0) {
-    return out;
+    return NoteRigMiss(RigMiss::kTimeFail);
   }
 
   // The rig: virtualDisplayHeight sets the scene scale (m2v = it / the
@@ -1751,18 +1858,17 @@ std::vector<DisplayXRWeaveClient::RigView> LocateViewsForRectWin(
   const XrResult lr =
       xrLocateViews(s.session, &li, &vs, 2, &view_count, views);
   if (XR_FAILED(lr) || view_count == 0) {
-    static bool warned = false;
-    if (!warned) {
-      warned = true;
-      LOG(ERROR) << "[DisplayXR] xrLocateViews (rig) failed -> " << lr;
-    }
-    return out;
+    s.rig_last_locate_result = lr;
+    return NoteRigMiss(RigMiss::kLocateFail);
   }
   // Both flags must be set: without POSITION_VALID the poses are meaningless
-  // and we would silently render a mono-ish scene at the origin.
+  // and we would silently render a mono-ish scene at the origin. This is the
+  // load-sensitive exit — under GPU pressure the tracker simply has no fresh
+  // sample for this instant, which is a MISS and not a capability change, so
+  // the renderer rides it out on the last-good views (web#12).
   if (!(vs.viewStateFlags & XR_VIEW_STATE_POSITION_VALID_BIT) ||
       !(vs.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT)) {
-    return out;
+    return NoteRigMiss(RigMiss::kPoseInvalid);
   }
 
   // Range-for, not views[i]: indexing a fixed-size array by variable trips
