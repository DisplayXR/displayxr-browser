+  ClearInline3DViewLatch();
 
   xr_->ExitPresent(
       BindOnce(&XRSession::OnExitPresent, WrapWeakPersistent(this)));
@@ -2582,13 +2592,25 @@ void XRSession::UpdateInlineView() {
 
   // Mono inline path. If we were previously in the 2-view inline-3d layout,
   // drop it so we rebuild a single view.
+  //
+  // web#12: rebuild the LIST, but reuse the same XRViewData. An inline-3D
+  // session flips 2<->1 whenever the rig misses, and minting a fresh view each
+  // time discarded state the page owns (requested viewport scale, the depth
+  // manager, visibility-mask event bookkeeping) and changed the identity behind
+  // getViewerPose().views[0]. |mono_view_| only has to be rebuilt when the
