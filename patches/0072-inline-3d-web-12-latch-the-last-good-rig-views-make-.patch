   }
 
   float aspect = 1.0f;
@@ -2659,9 +2681,45 @@ gfx::Rect XRSession::Inline3DSceneWindowRect() const {
   return gfx::ToRoundedRect(css_rect);
 }
 
+// web#12: an empty rig reply LATCHES the previous views instead of dropping
+// the session to mono.
+//
+// The producer (DisplayXRWeaveClient::LocateViewsForRect) returns nothing on
+// five different exits, and the load-sensitive one — xrLocateViews answering
+// without POSITION/ORIENTATION_VALID because the head tracker did not have a
+// fresh sample this instant — is a routine miss, not a statement that the rig
+// is gone. Since patch 0032 the reply is consumed on EVERY animation frame, so
+// a single miss used to flip views_ from 2 to 1 for one frame: the page's
+// getViewerPose() hands back one mono view, the SDK renders one eye's worth of
+// content into a side-by-side canvas, and the tile visibly blinks. Under GPU
+// load the misses cluster, which is exactly when the blinking was reported.
+//
+// Latching costs at most |kInline3DMaxEmptyReplies| frames of slightly stale
+// head parallax on a genuine capability loss, which is invisible; unlatched
+// misses cost a black-looking frame each, which is not. Capability changes that
+// really do end the rig (session end, the scene layer closing) clear the latch
+// at once via ClearInline3DViewLatch instead of waiting this out.
 void XRSession::OnInline3DViews(
     Vector<mojom::blink::DisplayXRViewPtr> views) {
-  inline_3d_views_ = std::move(views);
+  if (!views.empty()) {
+    inline_3d_empty_replies_ = 0;
+    inline_3d_views_ = std::move(views);
+    return;
+  }
+  // Empty reply. Hold the previous rig if we have one and the run of empties is
+  // still short enough to be a miss rather than a capability change.
+  if (inline_3d_views_.size() >= 2u) {
+    ++inline_3d_empty_replies_;
+    if (inline_3d_empty_replies_ < kInline3DMaxEmptyReplies) {
+      return;
+    }
+  }
+  ClearInline3DViewLatch();
+}
+
+void XRSession::ClearInline3DViewLatch() {
+  inline_3d_empty_replies_ = 0;
+  inline_3d_views_.clear();
 }
 
 void XRSession::RegisterDisplayLayer(XRDisplayLayer* layer) {
@@ -2685,9 +2743,32 @@ void XRSession::UnregisterDisplayLayer(XRDisplayLayer* layer) {
   display_layers_.erase(layer);
   // A closed scene layer must stop scoping the views (its canvas is gone), or
   // we'd keep building frusta for a stale rect.
-  if (inline_3d_scene_layer_ == layer) {
-    inline_3d_scene_layer_ = nullptr;
-    inline_3d_virtual_display_height_ = 0.f;
+  if (inline_3d_scene_layer_ != layer) {
+    return;
+  }
+  inline_3d_scene_layer_ = nullptr;
+  inline_3d_virtual_display_height_ = 0.f;
+  // web#12: but "the layer that happened to hold the scene role closed" is not
+  // "the page has no scene any more". A lazy-scrolled gallery closes and
+  // re-creates tile layers constantly, and the session holds exactly ONE scene
+  // layer pointer, so recycling whichever tile owned it used to null the
+  // pointer — which empties the locate rect (Inline3DSceneWindowRect), which
+  // makes the producer answer empty, which drops every scene on the page to
+  // mono. Adopt any other still-registered layer that asked for a scene scale;
+  // set iteration order is unspecified, but any live scene layer is a valid
+  // scoping element and the churn re-points it on the next create anyway.
+  for (const auto& other : display_layers_) {
+    if (other->VirtualDisplayHeight() > 0.0) {
+      inline_3d_scene_layer_ = other;
+      inline_3d_virtual_display_height_ =
+          static_cast<float>(other->VirtualDisplayHeight());
+      break;
+    }
+  }
+  if (!inline_3d_scene_layer_) {
+    // No scene element left anywhere: a genuine capability change, so concede
+    // to mono at once instead of latching stale views for half a second.
+    ClearInline3DViewLatch();
   }
 }
 
