From 8b2151aad827d78a32e7b597eb09c2888e4ec379 Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Sat, 22 Aug 2026 02:12:11 +0000
Subject: [PATCH] feat(android): auto-disable SurfaceControl when inline-3D is
 requested
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The durable half of what has been a manual /data/local/tmp/chrome-command-line
flag on the device.

Same mechanism and same reasoning as the Windows DelegatedCompositing block
directly above it (patch 0041, displayxr-browser#16): a system compositor that
promotes page content into its own overlay planes takes that content OUT of the
root render pass, and the inline-3D weave can only see, suppress and weave what
is in the root render pass. On Android that compositor is SurfaceControl, and
with promotion on the two halves of the weave disagree about what is on screen
— viz suppresses a canvas quad it no longer owns, or draws woven pixels back
into a root pass the promoted layer is composited OVER.

WHAT THIS LOOKS LIKE ON A PAGE, because it is a one-tile symptom and reads as
anything but a compositing setting: the three.js crate on samples/windows
renders raw side-by-side while all six other tiles weave correctly. It is the
page's ONE promoted canvas — a WebGL canvas gets its own composited layer, the
2D tiles do not — and a promoted layer is composited by the display controller
ON TOP of the root surface, which is precisely where the draw-back writes. So
the promoted canvas keeps showing its own raw SBS over our woven pixels and
nothing else on the page can be affected. (It is NOT 0074's clean-canvas leg
failing: that handoff is shared code Android already runs — ProduceSkia ->
BeginScopedReadAccess -> CreateSkImage with 0074's in-frame retry, |src_from_
canvas| set, drawn into the destination at |dst_offset|. keep_previous() is
reachable only from the WeaveRectAndroid !submitted exit, never from the canvas
path.)

TWO PLACES, and the second is the one that works.

  * Belt — ChromeMainDelegate::BasicStartupComplete appends AndroidSurfaceControl
    to --disable-features. That is the right place for the FeatureList to learn
    it, and it is the earliest callback, before the FeatureList is created.

  * Braces — IsAndroidSurfaceControlEnabled() returns false when
    --enable-inline-3d is on the ASKING PROCESS's own command line. The belt
    alone requires --enable-inline-3d to already be on the BROWSER command line
    at BasicStartupComplete, which is not guaranteed for every way inline-3D
    gets turned on; if it is not there, the override never lands. Evaluating it
    where the decision is actually made removes that dependency on
    initialisation order entirely — the switch is forwarded to the GPU process
    by AppendExtraCommandLineSwitches and read there by gpu_main.cc, so it is
    reliably present in the process that asks. Logged once, latched.

Device-verified in this shape: the GPU-process gate line fires and the WebGL
canvas weaves.

Gated on --enable-inline-3d rather than on the build flag, because inline-3D is
not yet on by default on Android (the block above is IS_WIN-only).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 chrome/app/chrome_main_delegate.cc | 36 ++++++++++++++++++++++++++++++
 gpu/config/gpu_finch_features.cc   | 25 +++++++++++++++++++++
 2 files changed, 61 insertions(+)

diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
index 692fe971c6227..4481cd6028f2e 100644
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -1143,6 +1143,42 @@ std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
   }
 #endif  // BUILDFLAG(IS_WIN)
 
+#if BUILDFLAG(IS_ANDROID)
+  // DisplayXR inline-3D on Android: the durable half of what has been a manual
+  // /data/local/tmp/chrome-command-line flag on the device. Same shape and same
+  // reasoning as the Windows DelegatedCompositing block above — a system
+  // compositor that promotes page content into its own overlay planes takes
+  // that content OUT of the root render pass, and the inline-3D weave can only
+  // see, suppress and weave what is in the root render pass.
+  //
+  // On Android that system compositor is SurfaceControl. With overlay promotion
+  // on, a tile (or the 2D content around it) can be lifted into a separate
+  // SurfaceControl layer, and the two halves of the weave then disagree about
+  // what is on screen: viz suppresses a canvas quad it no longer owns, or draws
+  // woven pixels back into a root pass the promoted layer is composited over.
+  //
+  // Disabled here, in the earliest callback, before the FeatureList is created,
+  // so the override lands in the BROWSER FeatureList and is serialized to the
+  // GPU process — which is where IsAndroidSurfaceControlEnabled() is evaluated.
+  // Gated on the switch rather than on a build flag because inline-3D is not
+  // yet on by default on Android (the Windows block above is IS_WIN-only); the
+  // switch is on the command line by this point because Android's command-line
+  // file is parsed into base::CommandLine before ContentMain runs.
+  if (!command_line.HasSwitch(switches::kProcessType) &&
+      command_line.HasSwitch("enable-inline-3d")) {
+    auto* mutable_command_line = base::CommandLine::ForCurrentProcess();
+    std::string disabled =
+        mutable_command_line->GetSwitchValueASCII("disable-features");
+    if (disabled.find("AndroidSurfaceControl") == std::string::npos) {
+      if (!disabled.empty()) {
+        disabled += ",";
+      }
+      disabled += "AndroidSurfaceControl";
+      mutable_command_line->AppendSwitchASCII("disable-features", disabled);
+    }
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
+
   // The DevTools remote debugging pipe file descriptors need to be checked
   // before any other files are opened, see https://crbug.com/40259890.
   const bool is_browser = !command_line.HasSwitch(switches::kProcessType);
diff --git a/gpu/config/gpu_finch_features.cc b/gpu/config/gpu_finch_features.cc
index 0273624365912..f670777e66855 100644
--- a/gpu/config/gpu_finch_features.cc
+++ b/gpu/config/gpu_finch_features.cc
@@ -749,6 +749,31 @@ bool IsLegacyIpcDisabled() {
 
 #if BUILDFLAG(IS_ANDROID)
 bool IsAndroidSurfaceControlEnabled() {
+  // DisplayXR inline-3D: SurfaceControl overlay promotion and the inline-3D
+  // weave are mutually exclusive. A promoted layer is composited by the display
+  // controller ON TOP of the root surface, so the weave's draw-back — which
+  // writes into that root surface — cannot cover it: the ONE promoted canvas on
+  // a page (a WebGL canvas gets its own composited layer; 2D tiles do not)
+  // keeps showing its raw side-by-side while every other tile weaves correctly.
+  //
+  // ChromeMainDelegate::BasicStartupComplete also appends AndroidSurfaceControl
+  // to --disable-features, and that is the right place for the FeatureList to
+  // learn it. This is the belt: it is evaluated HERE, in whichever process asks,
+  // from that process's own command line — and --enable-inline-3d is forwarded
+  // to the GPU process by AppendExtraCommandLineSwitches and read there by
+  // gpu_main.cc, so it is reliably present. That removes the dependency on the
+  // switch already being on the browser command line when BasicStartupComplete
+  // runs, which is not guaranteed for every way inline-3D can be turned on.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("enable-inline-3d")) {
+    static bool logged_inline3d = false;
+    if (!logged_inline3d) {
+      logged_inline3d = true;
+      LOG(WARNING) << "[DisplayXR] SurfaceControl overlay promotion is OFF: "
+                      "inline-3D weaving needs every layer in the root render "
+                      "pass, or a promoted canvas composites over the weave";
+    }
+    return false;
+  }
   if (base::android::android_info::sdk_int() <=
           base::android::android_info::SDK_VERSION_S &&
       (IsDeviceBlocked(base::android::android_info::device(), "capri|caprip") ||
