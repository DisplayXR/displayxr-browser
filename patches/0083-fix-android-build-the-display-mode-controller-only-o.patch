From 38dd1c3649cb652f315dfda6969adcdd8a79382b Mon Sep 17 00:00:00 2001
From: David <dfattal@gmail.com>
Date: Thu, 20 Aug 2026 07:45:05 +0000
Subject: [PATCH] fix(android): build the display-mode controller only on
 desktop
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

chrome/browser/displayxr/displayxr_display_mode_controller.{cc,h} — added to
source_set("core")'s unconditional sources list by 0054 (#55) and extended by
0066 (#90) / 0069 (#88) — is desktop-only code. Compiling it for Android fails:

  no member named 'GetActiveTabInterface' in 'BrowserWindowInterface'
  no member named 'RegisterActiveTabDidChange' in 'BrowserWindowInterface'

Both are desktop tab-strip APIs; Android's BrowserWindowInterface has neither,
and it never will — Android has no tab strip in the desktop sense, its
foreground-tab notion is the CompositorViewHolder's active WebContents.

Move the two entries into the target's existing `if (!is_android)` sources
block. This is the Android arm of 0054, not a workaround: every call site is
already inside `#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_APPLE)` in
chrome_browser_main.cc, so nothing on Android references the symbols. Nothing
is lost on Android because the Android weave takes its 2D/3D demand straight
from the registered display layers (the browser-process weave client), not
from a tab-strip observer.

A tab-model abstraction that would let Android share 0054's controller is
future work; it is not a prerequisite for the weave.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019Lf6vUbdL59MqXMwJxB489
---
 chrome/browser/BUILD.gn | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index 1cb576e644a22..5a8e30e52b558 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -847,12 +847,6 @@ source_set("core") {
     "chrome_resource_bundle_helper.cc",
     "chrome_resource_bundle_helper.h",
 
-    # DisplayXR inline-3D display-mode policy (browser#55): the panel's
-    # hardware 2D/3D element follows the foreground window's active tab.
-    # Lives here, not in //components/displayxr, because the decision needs
-    # the tab/window model.
-    "displayxr/displayxr_display_mode_controller.cc",
-    "displayxr/displayxr_display_mode_controller.h",
     "expired_flags_list.h",
     "file_select_helper.cc",
     "font_family_cache.cc",
@@ -1266,6 +1260,16 @@ source_set("core") {
 
     sources += [
       "chrome_process_singleton.cc",
+
+      # DisplayXR inline-3D display-mode policy (browser#55): the panel's
+      # hardware 2D/3D element follows the foreground window's active tab.
+      # Lives here, not in //components/displayxr, because the decision needs
+      # the tab/window model -- which is why it is !is_android: it uses the
+      # desktop BrowserWindowInterface tab-strip API (GetActiveTabInterface /
+      # RegisterActiveTabDidChange), absent on Android. Its call sites in
+      # chrome_browser_main.cc are already #if IS_WIN || IS_APPLE.
+      "displayxr/displayxr_display_mode_controller.cc",
+      "displayxr/displayxr_display_mode_controller.h",
       "intranet_redirect_detector.cc",
       "process_singleton_startup_lock.cc",
       "repost_form_warning_controller.cc",
