From b27cce699dd44911f2e5da26c6e1253068ef32e0 Mon Sep 17 00:00:00 2001
From: dfattal <dfattal@gmail.com>
Date: Tue, 18 Aug 2026 14:53:57 -0700
Subject: [PATCH 58/58] inline-3d(#87): clear the inline-3D rect state on
 session end and navigation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

cc::CommitState::inline_3d_rects / _exclusion_rects / _exclusion_fixed_rects /
_scroll_base had exactly one writer: LayerTreeHost::SetInline3DRects, reached
only from WebFrameWidgetImpl::SetInline3DRects <- XRSession::ReportInline3DRects,
which only ever runs inside a LIVE session's rAF. Nothing ever cleared it. The
rects therefore outlive the document that measured them, and on a same-renderer
navigation (or a bfcache restore) the new page inherits the old page's tiles —
displaced, because the browser#83 scroll base they were measured against is
stale too.

Two clears, both through the existing SetInline3DRects channel (no new mojo, no
new plumbing):

(1) XRSession::HandleShutdown -> ClearInline3DRects(), next to the existing
    ReportInline3DDemand(false). The demand flag only decides the panel's
    hardware 2D/3D element; the rects are what Viz weaves, so both have to be
    retracted. Guarded by the same window/frame/widget chain ReportInline3DRects
    uses, since any of them can already be gone during teardown, and gated on
    is_inline_3d_ like ReportInline3DDemand.

(2) WebFrameWidgetImpl::DidNavigate(), which LocalFrameClientImpl::
    DidCommitNavigation calls on the local root precisely so "the browser and
    compositor could reset their states". This is the load-bearing half for
    browser#87: (1) alone does NOT cover navigation, because an INLINE session
    is never force-ended when its context is destroyed —
    XRFrameProvider::Dispose force-ends immersive_session_ only, and
    XRSystem::Dispose does not touch non-immersive sessions — so HandleShutdown
    is not on the navigation path at all. (1) covers an explicit
    session.end() / immersive teardown; (2) covers navigation and bfcache.

A new inline-3d session re-reports its rects on its first frame, and
LayerTreeHost::SetInline3DRects' dedup early-out makes a redundant clear free.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../core/frame/web_frame_widget_impl.cc       | 12 +++++++
 .../blink/renderer/modules/xr/xr_session.cc   | 33 +++++++++++++++++++
 .../blink/renderer/modules/xr/xr_session.h    |  9 +++++
 3 files changed, 54 insertions(+)

diff --git a/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc b/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc
index 0810a621efb5c..e4edbd6eca2e4 100644
--- a/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc
+++ b/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc
@@ -4131,6 +4131,18 @@ void WebFrameWidgetImpl::SetNeedsUnbufferedInputForDebugger(bool unbuffered) {
 }
 
 void WebFrameWidgetImpl::DidNavigate() {
+  // browser#87: a same-renderer navigation (Back included) reuses this widget
+  // and its LayerTreeHost, so the previous document's inline-3D rects stay
+  // committed in cc and keep being weaved over the NEW page — displaced by the
+  // stale browser#83 scroll base they were measured against. Nothing else clears
+  // them: only a live XRSession's rAF pushes rects, and an INLINE session is not
+  // force-ended when the context is destroyed (XRFrameProvider::Dispose ends the
+  // immersive session only), so XRSession::HandleShutdown never runs on this
+  // path. Reset the state here, alongside the other per-navigation compositor
+  // resets; a new inline-3d session re-reports its rects on its first frame.
+  SetInline3DRects(std::vector<gfx::Rect>(), std::vector<gfx::Rect>(),
+                   std::vector<gfx::Rect>(), gfx::PointF());
+
   // The input handler wants to know about navigation so that it can
   // suppress input until the newly navigated page has a committed frame.
   // It also resets the state for UMA reporting of input arrival with respect
diff --git a/third_party/blink/renderer/modules/xr/xr_session.cc b/third_party/blink/renderer/modules/xr/xr_session.cc
index 88835cc0b8a84..b6deba276f66d 100644
--- a/third_party/blink/renderer/modules/xr/xr_session.cc
+++ b/third_party/blink/renderer/modules/xr/xr_session.cc
@@ -1638,6 +1638,15 @@ void XRSession::HandleShutdown() {
   // forget mojo call, not script.
   ReportInline3DDemand(false);
 
+  // browser#87: and it has no rects either. The demand flag above only decides
+  // the panel's hardware 2D/3D element; the RECTS are what Viz weaves, and they
+  // live in cc::CommitState until something replaces them. ReportInline3DRects
+  // is only reached from a live session's rAF, so without this the last frame's
+  // rects + exclusions + scroll base outlive the session and get applied to the
+  // next document in this renderer (ghost tiles displaced by a stale scroll
+  // base after Back / a bfcache restore).
+  ClearInline3DRects();
+
   if (xr_->IsContextDestroyed()) {
     // If this is being called due to the context being destroyed,
     // it's illegal to run JavaScript code, so we cannot emit an
@@ -2781,6 +2790,30 @@ void XRSession::ReportInline3DRects() {
   ReportInline3DDemand(any_visible_3d);
 }
 
+void XRSession::ClearInline3DRects() {
+  if (!is_inline_3d_) {
+    return;
+  }
+  // Same guard chain as ReportInline3DRects: during teardown any of these can
+  // already be gone, and there is then nothing left to clear.
+  LocalDOMWindow* window = DynamicTo<LocalDOMWindow>(GetExecutionContext());
+  if (!window) {
+    return;
+  }
+  LocalFrame* frame = window->GetFrame();
+  if (!frame) {
+    return;
+  }
+  FrameWidget* widget = frame->GetWidgetForLocalRoot();
+  if (!widget) {
+    return;
+  }
+  // Empty rects, empty exclusions, reset scroll base — LayerTreeHost's
+  // SetInline3DRects dedup early-out makes this a no-op if it is already clear.
+  widget->SetInline3DRects(std::vector<gfx::Rect>(), std::vector<gfx::Rect>(),
+                           std::vector<gfx::Rect>(), gfx::PointF());
+}
+
 void XRSession::ReportInline3DDemand(bool wants_3d) {
   if (!is_inline_3d_) {
     return;
diff --git a/third_party/blink/renderer/modules/xr/xr_session.h b/third_party/blink/renderer/modules/xr/xr_session.h
index 90f42538dda0d..79631a6fdf0d6 100644
--- a/third_party/blink/renderer/modules/xr/xr_session.h
+++ b/third_party/blink/renderer/modules/xr/xr_session.h
@@ -358,6 +358,15 @@ class XRSession final : public EventTarget,
   // once per animation frame after the rAF callbacks have painted the canvases.
   void ReportInline3DRects();
 
+  // browser#87: push the EMPTY inline-3D rect state down the same channel, so
+  // no stale rects / exclusions / scroll base survive this session. Nothing else
+  // ever clears them: ReportInline3DRects is only reached from a live session's
+  // rAF, so once the session ends the last-committed rects (and the scroll base
+  // they were measured against) stay in cc::CommitState and keep being weaved /
+  // scroll-shifted on whatever document the renderer shows next — the ghost after
+  // a same-renderer navigation or a bfcache restore.
+  void ClearInline3DRects();
+
   // browser#55: push this document's inline-3D DEMAND to the browser, but only
   // when it changes. |wants_3d| is "a registered layer's target intersects the
   // viewport right now", the same signal that decides whether the frame has any
