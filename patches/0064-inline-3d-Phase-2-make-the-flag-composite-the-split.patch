   if (inline3d_difference_clip_enabled_) {
     for (const gfx::Rect& rect : inline3d_clip_out_) {
       current_canvas_->clipRect(gfx::RectToSkRect(rect), SkClipOp::kDifference,
@@ -3767,11 +3771,12 @@ void SkiaRenderer::MaybeDrawInline3dOverPlane(
   // DirectRenderer::ComputeInline3dPlaneSplit — into a separate window-sized
   // transparent plane, and publish its mailbox.
   //
-  // Patch 0063 stops there ON PURPOSE: nothing consumes the plane, and the page
