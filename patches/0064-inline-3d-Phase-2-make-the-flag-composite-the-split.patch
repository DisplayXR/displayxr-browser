diff --git a/components/viz/service/display/display.cc b/components/viz/service/display/display.cc
index 16bbb8439fc0c..2ba3eeead127a 100644
--- a/components/viz/service/display/display.cc
+++ b/components/viz/service/display/display.cc
@@ -1024,11 +1024,31 @@ bool Display::DrawAndSwap(const DrawAndSwapParams& params) {
     {
       ResourceIdSet suppressed;
       if (!frame.inline_3d_rects.empty()) {
+        // The canvas resources are unconditional: their pixels are the weave
+        // INPUT and come back as woven output, so painting them into the page
+        // as well would show the raw side-by-side under the weave. True in both
+        // phases.
         for (const auto& layer : frame.inline_3d_canvas_resources) {
           suppressed.insert(layer.resource_id);
         }
-        for (const auto& layer : frame.inline_3d_overlays) {
-          suppressed.insert(layer.resource_id);
+        // The exclusion OVERLAYS are Phase-1 only. Suppressing them is half of
+        // the legacy occlusion mechanism (the other half is the GPU-side atlas
+        // that stages them as the DP's overlay input, which
+        // WeaveCompositedSurface stands down under the same flag): a declared
+        // overlay is lifted out of the page so the DP can composite it over the
+        // weave. Phase 2 (--inline-3d-occlusion) replaces that with the
+        // draw-order split, which lifts whatever is actually over a tile —
+        // declared or not — onto the over-plane. So with the flag on these stay
+        // ORDINARY PAGE QUADS: the split then sees them (0063 excludes
+        // already-suppressed resources from the over set, so suppressing them
+        // here would make them invisible to it), the difference clip punches
+        // their over-tile part out of the page raster, and the over-plane
+        // composite draws it back on top. Suppressing them here AND running the
+        // split would drop them entirely.
+        if (!DirectRenderer::IsInline3dOcclusionEnabled()) {
+          for (const auto& layer : frame.inline_3d_overlays) {
+            suppressed.insert(layer.resource_id);
+          }
         }
       }
       renderer_->SetInline3dSuppressedResources(std::move(suppressed));
