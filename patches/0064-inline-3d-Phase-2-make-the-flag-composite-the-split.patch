@@ -3916,8 +3921,9 @@ void SkiaRenderer::MaybeDrawInline3dOverPlane(
 
   inline_3d_over_plane_->painted_rects = tile_rects;
   // Publish AFTER the paint task and BEFORE the root pass is painted — the GPU
-  // task queue is FIFO, so the consumer-to-be sees the plane already filled and
-  // strictly ahead of the page/weave. Risk guard R7.
+  // task queue is FIFO, so the consumer (WeaveCompositedSurface phase (B),
+  // which runs off the root pass's FinishPaintRenderPass) sees the plane
+  // already filled and strictly ahead of the page/weave. Risk guard R7.
   skia_output_surface_->SetInline3dOverPlane(inline_3d_over_plane_->mailbox,
                                              size);
 
