+// Wait for a sync_file fd to signal. This IS libsync's sync_wait(): a sync
+// fence fd becomes POLLIN-readable when it signals, so poll() is the whole
+// mechanism, minus a header dependency on <android/sync.h>. Always consumes
+// (closes) the fd.
+void WaitAndCloseFenceFd(int fd) {
+  if (fd < 0) {
+    return;
+  }
+  struct pollfd pfd = {};
+  pfd.fd = fd;
+  pfd.events = POLLIN;
+  // Bounded, like the runtime's own 1 s server-side wait: a fence that never
+  // signals is a driver bug, and blocking Viz's present thread forever on it
+  // turns that bug into a hang.
+  int rc;
+  do {
+    rc = poll(&pfd, 1, /*timeout_ms=*/1000);
+  } while (rc == -1 && errno == EINTR);
+  if (rc <= 0) {
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      LOG(WARNING) << "[DisplayXR] android weave: acquire fence wait "
+                   << (rc == 0 ? "timed out" : "failed")
+                   << "; weaving anyway (logged once)";
+    }
+  }
+  close(fd);
+}
+
+}  // namespace
