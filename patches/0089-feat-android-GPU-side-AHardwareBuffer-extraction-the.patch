+bool DisplayXRWeaveGpuAndroid::TryTakeWovenResult(uint32_t target_id,
+                                                  Result* out) {
+  auto it = results_.find(target_id);
+  if (it == results_.end() || !it->second.have) {
+    return false;
+  }
+  *out = it->second.result;
+  // The handle is a one-shot: clear it so a second read of the same frame's
+  // result does not tell Viz to re-import a buffer it already holds.
+  it->second.result.woven_handle = 0;
+  return true;
 }
 
 void DisplayXRWeaveGpuAndroid::PruneTarget(uint32_t target_id) {
-  // Nothing per-target is held yet. M1 releases this target's AHB + fence state
-  // here (patch 0061's contract) BEFORE the caller reuses the id.
+  // Patch 0061's contract. Like mac, this provider owns NO per-target GPU
+  // resources — the whole page goes through one shared window-sized staging
+  // input (owned by Viz) and one cached woven AHardwareBuffer — so retiring a
+  // target is just dropping its stored result.
+  results_.erase(target_id);
+}
+
+void DisplayXRWeaveGpuAndroid::PruneTargets(size_t count) {
+  for (auto it = results_.begin(); it != results_.end();) {
+    if (it->first >= count) {
+      it = results_.erase(it);
+    } else {
+      ++it;
+    }
+  }
 }
 
