+  // browser#117 (third mechanism): ONE COLLECTED PASS, and how it hangs off its
+  // parent.
+  //
+  // This function used to look at the root pass and nothing else. That is the
+  // draw-time half of the same blind spot the aggregator had: a canvas inside
+  // the render surface a backdrop-filter forces onto its enclosing effect node
+  // (RenderSurfaceReason::kBackdropScope) draws into a CHILD pass, so no root
+  // quad carries its resource, k was never found, and the tile was reported as
+  // tiles_without_k and skipped. Skipping was harmless while the tile was not
+  // woven either. It stops being harmless the moment the aggregator's join
+  // starts succeeding for such a tile: the weave draw-back would then blit
+  // woven pixels over the very frosted header that caused the isolation.
+  //
+  // So the collection follows the tile. |accum| maps this pass's TARGET space
+  // to root target space, built by descent from the root (identity there, so
+  // the root pass's own numbers are bit-identical to what this function
+  // produced before), composing each RenderPassDrawQuad's
+  // quad_to_target_transform on the way down. Deriving it by descent rather
+  // than reading transform_to_root_target keeps one convention: the root pass's
+  // quads are mapped by quad_to_target_transform alone here, and every child is
+  // expressed relative to exactly that.
+  struct PassQuads {
+    AggregatedRenderPassId id;
+    std::vector<Candidate> quads;
+    size_t parent = std::numeric_limits<size_t>::max();  // index into per_pass
+    size_t index_in_parent = 0;  // the RPDQ's front-to-back index there
+  };
+  // Bounds. A page can nest passes arbitrarily and this runs every frame on the
+  // draw thread; over any of these the extra passes are simply not collected
+  // and the tiles inside them degrade to exactly the pre-#117 behaviour.
+  constexpr size_t kMaxCollectedPasses = 32;
+  constexpr size_t kMaxCollectedQuads = 8192;
+  std::vector<PassQuads> per_pass;
+  size_t collected_quads = 0;
+  size_t passes_skipped_over_cap = 0;
+
+  auto collect = [&](const AggregatedRenderPass* pass,
+                     const gfx::Transform& accum,
+                     const std::optional<gfx::Rect>& inherited_clip,
+                     size_t parent, size_t index_in_parent) {
+    PassQuads pq;
+    pq.id = pass->id;
+    pq.parent = parent;
+    pq.index_in_parent = index_in_parent;
+    pq.quads.reserve(pass->quad_list.size());
+    for (const DrawQuad* quad : pass->quad_list) {
+      const SharedQuadState* quad_sqs = quad->shared_quad_state;
+      gfx::Transform to_root = accum;
+      to_root.PreConcat(quad_sqs->quad_to_target_transform);
+      gfx::Rect own_rect =
+          cc::MathUtil::MapEnclosingClippedRect(to_root, quad->visible_rect);
+      gfx::Rect target_rect = own_rect;
+      if (auto* rpdq = quad->DynamicCast<AggregatedRenderPassDrawQuad>()) {
+        target_rect = cc::MathUtil::MapEnclosingClippedRect(
+            to_root, GetExpandedRectForPixelMovingFilters(*rpdq));
+      }
+      if (quad_sqs->clip_rect) {
+        // The SQS clip is in this pass's TARGET space; map it the same way.
+        const gfx::Rect mapped_clip =
+            cc::MathUtil::MapEnclosingClippedRect(accum, *quad_sqs->clip_rect);
+        target_rect.Intersect(mapped_clip);
+        own_rect.Intersect(mapped_clip);
+      }
+      if (inherited_clip) {
+        target_rect.Intersect(*inherited_clip);
+        own_rect.Intersect(*inherited_clip);
+      }
+      pq.quads.push_back({quad, target_rect, own_rect});
     }
-    if (quad_sqs->clip_rect) {
-      target_rect.Intersect(*quad_sqs->clip_rect);
-      own_rect.Intersect(*quad_sqs->clip_rect);
+    collected_quads += pq.quads.size();
+    per_pass.push_back(std::move(pq));
+  };
+
+  collect(root, gfx::Transform(), std::nullopt,
+          /*parent=*/std::numeric_limits<size_t>::max(),
+          /*index_in_parent=*/0);
+  // Breadth-first from the root, descending ONLY into passes that could carry a
+  // tile. Most pages have render passes for reasons that have nothing to do
+  // with inline-3D; walking into them would cost real work for a list nothing
+  // ever queries.
+  if (passes) {
+    auto pass_by_id =
+        [passes](AggregatedRenderPassId id) -> const AggregatedRenderPass* {
+      for (const auto& p : *passes) {
+        if (p->id == id) {
+          return p.get();
+        }
+      }
+      return nullptr;
+    };
+    // |accum| per collected pass, kept alongside so the descent can compose.
+    // Index-parallel to |per_pass| — appended in lockstep with it, right after
+    // each collect().
+    std::vector<gfx::Transform> accum(1);
+    for (size_t p = 0; p < per_pass.size(); ++p) {
+      for (size_t i = 0; i < per_pass[p].quads.size(); ++i) {
+        // Read everything needed out of the candidate BEFORE collect() can
+        // reallocate |per_pass| and dangle a reference into it.
+        AggregatedRenderPassId child_id;
+        gfx::Rect child_clip;
+        gfx::Transform child_accum;
+        {
+          const Candidate& c = per_pass[p].quads[i];
+          const auto* rpdq =
+              c.quad->DynamicCast<AggregatedRenderPassDrawQuad>();
+          if (!rpdq) {
+            continue;
+          }
+          bool touches_tile = false;
+          for (const Inline3dTile& tile : inline_3d_tiles_) {
+            if (!tile.rect.IsEmpty() && c.target_rect.Intersects(tile.rect)) {
+              touches_tile = true;
+              break;
+            }
+          }
+          if (!touches_tile) {
+            continue;
+          }
+          if (per_pass.size() >= kMaxCollectedPasses ||
+              collected_quads >= kMaxCollectedQuads) {
+            ++passes_skipped_over_cap;
+            continue;
+          }
+          child_id = rpdq->render_pass_id;
+          // The child's pixels land inside the RPDQ's own rect, so that rect is
+          // the clip every quad it contains inherits.
+          child_clip = c.own_rect;
+          child_accum = accum[p];
+          child_accum.PreConcat(
+              c.quad->shared_quad_state->quad_to_target_transform);
+        }
+        const AggregatedRenderPass* child = pass_by_id(child_id);
+        if (!child) {
+          continue;
+        }
+        collect(child, child_accum, child_clip, p, i);
+        accum.push_back(child_accum);
+      }
     }
-    quads.push_back({quad, target_rect, own_rect});
   }
