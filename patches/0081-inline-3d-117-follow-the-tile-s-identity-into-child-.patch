     }
+    if (home != 0) {
+      // ---- browser#117: THE TILE IS INSIDE A RENDER SURFACE ----
+      //
+      // Everything below this block lifts page quads OUT of the page and onto
+      // a root-space over-plane. That is sound only for quads the root pass
+      // draws directly: a quad inside a child pass composites against that
+      // pass's own contents, and moving it to an empty plane changes its
+      // result — the same reason the v1 exclusions refuse a non-kSrcOver blend
+      // or a 3D sorting context. So a tile whose canvas lives in a child pass
+      // gets NO over-plane at all.
+      //
+      // What it gets instead is D' (browser#88), generalised. D' already knows
+      // how to leave a region to the page: clip the woven draw-back out of it
+      // (SkClipOp::kDifference) and put the same rect in the flat list so a
+      // capable panel switches its 3D element off there. That is exactly the
+      // treatment every quad in front of this tile needs — the page has
+      // already drawn it correctly, and the weave must not paint over it.
+      //
+      // This is the geometric form of the same law display.cc enforces on the
+      // submission: NEVER WEAVE WHAT YOU DID NOT PREPARE. The failure mode it
+      // exists to stop is not subtle — with the tile's rect clipped to a strip
+      // at the top of the viewport, the strip lies under the site's sticky
+      // frosted header, and weaving it pushed the header's title text through
+      // the interlace lattice while the rest of the tile showed raw SBS.
+      //
+      // The rects are EXACT, never coarsened per rect: under-punching weaves
+      // over 2D (corruption), and merging two rects into their bounding box
+      // punches page pixels the tile SHOULD have woven. So the list is neither
+      // truncated nor merged, exactly as 0068 left the frosted rects.
+      //
+      // It is, however, BOUNDED — every rect is one SkClipOp::kDifference on
+      // the draw-back's single blit, and a page is free to stack hundreds of
+      // quads over a tile. Over |kMaxWithheldPerTile| the tile withholds its
+      // WHOLE rect instead. That is a real degradation (the tile reads as the
+      // flat page pixels behind it for that frame) but it is not a corruption
+      // and it is not a hole: the canvas quad's suppression exposes the page's
+      // own background, which is still drawn beneath it. Losing 3D beats both
+      // weaving the site's chrome and blacking the tile out.
+      //
+      // Both the tile's OWN pass and the ancestor spine above it are walked: a
+      // quad drawn after this pass's RenderPassDrawQuad in the parent is in
+      // front of the tile just as surely as one after k here. Walking the spine
+      // is also what makes the fix independent of WHICH effect node the
+      // backdrop-filter turned into a render surface — a page-dependent choice
+      // this patch deliberately does not have to predict.
+      constexpr size_t kMaxWithheldPerTile = 64;
+      std::vector<gfx::Rect> withheld;
+      auto withhold = [&](const Candidate& c) {
+        gfx::Rect r = c.own_rect;
+        r.Intersect(tile.rect);
+        if (r.IsEmpty()) {
+          return;
+        }
+        // Lossless containment dedupe on the way in: a difference clip does not
+        // care about duplicates, but the COUNT is what costs, and a rect
+        // already covered by one in the list contributes nothing at all.
+        for (const gfx::Rect& have : withheld) {
+          if (have.Contains(r)) {
+            return;
+          }
+        }
+        withheld.push_back(r);
+      };
+      size_t level = home;
+      size_t front_of = *k;
+      while (true) {
+        for (size_t i = 0; i < front_of; ++i) {
+          const Candidate& c = per_pass[level].quads[i];
+          if (c.target_rect.Intersects(tile.rect)) {
+            withhold(c);
+          }
+        }
+        const size_t parent = per_pass[level].parent;
+        if (parent == std::numeric_limits<size_t>::max()) {
+          break;
+        }
+        front_of = per_pass[level].index_in_parent;
+        level = parent;
+      }
+      if (withheld.size() > kMaxWithheldPerTile) {
+        ++tiles_withheld_whole;
+        withheld.assign(1, tile.rect);
+      }
+      for (const gfx::Rect& r : withheld) {
+        inline3d_frosted_rects_.push_back(r);
