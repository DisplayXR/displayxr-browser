@@ -43,6 +45,11 @@ class DisplayXRDisplayModeImpl : public mojom::DisplayXRDisplayMode {
   void SetDisplayMode(bool three_d) override;
   void SetPopupOccluders(
       const std::vector<gfx::Rect>& screen_rects) override;
+#if BUILDFLAG(IS_ANDROID)
