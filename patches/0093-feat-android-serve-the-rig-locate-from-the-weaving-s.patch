diff --git a/components/displayxr/browser/BUILD.gn b/components/displayxr/browser/BUILD.gn
index ef3cff9066a3a..8b38ed414d108 100644
--- a/components/displayxr/browser/BUILD.gn
+++ b/components/displayxr/browser/BUILD.gn
@@ -90,14 +90,17 @@ source_set("browser") {
   # directly (to initialize the client), so consumers of :browser must see it.
   # browser#55: displayxr_service_impl.h exposes content::GlobalRenderFrameHostId
   # (the demand report's frame identity), so consumers must see content/public.
+  # Android rig locate: displayxr_service_impl.h holds a
