+      }
       if (!provider->BatchMode() ||
           !provider->BatchKeepPrevious(rect, st.slot)) {
         return false;
@@ -3880,6 +4050,16 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
         // scratch_write / scratch_rep release here; content is submitted.
         }
 
+        // (browser#131) FULLY COVERED BY UPPER TILES. Deliberately placed
+        // AFTER the compose: the scratch has just been refreshed and armed, so
+        // the mono leg draws this tile's LIVE content rather than freezing at
