+                                          rb_stride);
 #if BUILDFLAG(IS_WIN)
           const bool ok = provider->WeavePixels(
-              device_x.Get(), rb_pixels, static_cast<uint32_t>(rb_stride), rect,
+              device_x.Get(), rb_band, static_cast<uint32_t>(rb_stride), weave,
               st.slot);
