+  // ---- (browser#131) TOPMOST-WINS: MAKE THE FRAME'S WEAVE RECTS DISJOINT ----
+  //
+  // THE MECHANISM, settled from source and not re-derived here. The batch weave
+  // input is ONE window-sized texture; each target's side-by-side is copied
+  // into it AT ITS OWN WINDOW POSITION and the input is never cleared. Where
+  // two targets' rects overlap, the later copy CLOBBERS the earlier — and the
+  // copy order is the aggregator's base::Token sort, not z. The runtime then
+  // samples each submitted rect's LEFT half into the left eye and its RIGHT
+  // half into the right eye (comp_d3d11_service.cpp), so an overlap that falls
+  // in one half of a rect corrupts exactly ONE EYE: the lower tile keeps a
+  // clean left eye and grows a displaced replica of its neighbour in the right.
+  // That is worse than any wrong-looking-but-consistent answer, because it
+  // breaks fusion rather than merely looking wrong.
+  //
+  // Clipping the COPY cannot fix it: both tiles need their own pixels at the
+  // same input address, and one address cannot hold two values. Disjointness
+  // has to be achieved at the RECT level, which is what this does.
+  //
+  // THE POLICY (David, browser#131): TOPMOST-WINS. In an overlap the UPPER tile
+  // owns the pixels — that is what the DOM already says, and it is the only
+  // answer that preserves depth for the tile the author put in front. So the
+  // LOWER tile's weave rect is reduced by the upper tile's rect.
+  //
+  // WHY THE REDUCTION IS A ROW BAND AND NEVER A COLUMN BAND. A submitted rect
+  // is not a window onto the input; it is a SIDE-BY-SIDE PAIR whose eye split
+  // is the rect's own horizontal midpoint. Trimming rows leaves the split where
+  // it was and simply weaves fewer scanlines — every downstream leg reduces to
+  // a row offset. Trimming COLUMNS moves the midpoint, so the runtime would cut
+  // the pair somewhere other than between the eyes and hand each eye a mixture
+  // of both — re-creating, by construction, the exact eye-inconsistency this
+  // patch exists to end. A column trim is therefore not a cheaper variant of
+  // this fix; it is the bug. Hence:
+  //
+  //   * SUBTRACT (exact) — the overlap spans the lower tile's full width and
+  //     touches its top or bottom edge. The remainder is a single row band, so
+  //     the lower tile weaves everything it still owns, in stereo, and the
+  //     overlap is woven in stereo by the upper tile. Nothing is lost.
+  //   * FALLBACK (tier-2, and the documented one) — every other geometry: a
+  //     corner overlap (the case reported on browser#131), an interior one, or
+  //     any overlap narrower than the tile. Subtraction would leave an L or a
+  //     pair of bands, which one rect cannot express. Keep the LARGER of the
+  //     two clean row bands and WITHHOLD the rest. The withheld rows are then
+  //     drawn MONO from the tile's own scratch (browser#119's primitive), so
+  //     the region degrades from stereo to flat rather than to a hole — and it
+  //     is eye-consistent, which is the point.
+  //
+  // Both paths are gated on an overlap actually existing. With no overlap
+  // |topmost_bands[t]| is bit-for-bit the rect the pre-patch code computed and
+  // every consumer below degenerates to its previous arithmetic.
+  std::vector<gfx::Rect> topmost_bands(inline_3d_rects_.size());
+  std::vector<uint8_t> topmost_overlap(inline_3d_rects_.size(), 0);
+  {
+    // Each target's on-screen FOOTPRINT. Under topmost-wins a tile owns this
+    // whole rect, including the part it may itself withhold from the weave —
+    // so this, not the reduced band, is what a lower tile subtracts. (The
+    // input outside a tile's submitted band holds no defined content for it,
+    // so letting a lower tile weave there would sample stale pixels.)
+    std::vector<gfx::Rect> own(inline_3d_rects_.size());
+    for (size_t i = 0; i < inline_3d_rects_.size(); ++i) {
+      own[i] = inline_3d_rects_[i].rect;
+      own[i].Intersect(window_bounds);
+      topmost_bands[i] = own[i];
+    }
+    size_t pairs = 0;
+    size_t fallbacks = 0;
+    std::string detail;
+    for (size_t l = 0; l < own.size(); ++l) {
+      if (own[l].IsEmpty()) {
+        continue;
+      }
+      for (size_t u = 0; u < own.size(); ++u) {
+        if (u == l || own[u].IsEmpty()) {
+          continue;
+        }
+        // Front-to-back, with the vector position (the aggregator's token
+        // sort) as the tiebreak so the relation is TOTAL and stable across
+        // frames even where two tiles report the same or an unknown z.
+        const bool u_is_upper =
+            inline_3d_rects_[u].z_order != inline_3d_rects_[l].z_order
+                ? inline_3d_rects_[u].z_order < inline_3d_rects_[l].z_order
+                : u < l;
+        if (!u_is_upper) {
+          continue;
+        }
+        const gfx::Rect band = topmost_bands[l];
+        gfx::Rect isect = band;
+        isect.Intersect(own[u]);
+        if (isect.IsEmpty()) {
+          continue;
+        }
+        ++pairs;
+        // Both ends of the pair are marked: the record BatchKeepPrevious
+        // replays names a region the other tile may have written, so neither
+        // may take that road this frame (see |keep_previous| below).
+        topmost_overlap[l] = 1;
+        topmost_overlap[u] = 1;
+        const int top_h = isect.y() - band.y();
+        const int bot_h = band.bottom() - isect.bottom();
+        gfx::Rect keep;
+        if (top_h >= bot_h) {
+          keep = gfx::Rect(band.x(), band.y(), band.width(),
+                           top_h > 0 ? top_h : 0);
+        } else {
+          keep = gfx::Rect(band.x(), isect.bottom(), band.width(), bot_h);
+        }
+        // |keep| is a full-width row band of |band|, so the complement is one
+        // row band too and Rect::Subtract returns it exactly. The step is
+        // LOSSLESS iff what we gave up is precisely the overlap.
+        gfx::Rect given_up = band;
+        given_up.Subtract(keep);
+        if (given_up != isect) {
+          ++fallbacks;
+        }
+        topmost_bands[l] = keep;
+        if (detail.size() < 400) {
+          detail += base::StringPrintf(
+              " {lower=%s z=%zu rect=%s upper=%s z=%zu rect=%s overlap=%s "
+              "kept=%s %s}",
+              inline_3d_rects_[l].id.ToString().c_str(),
+              inline_3d_rects_[l].z_order, band.ToString().c_str(),
+              inline_3d_rects_[u].id.ToString().c_str(),
+              inline_3d_rects_[u].z_order, own[u].ToString().c_str(),
+              isect.ToString().c_str(), keep.ToString().c_str(),
+              given_up == isect ? "SUBTRACT" : "FALLBACK(mono)");
+        }
+        if (keep.IsEmpty()) {
+          break;
+        }
+      }
+    }
+    if (pairs > 0) {
+      // 0073's discipline (first 3, then 1-in-300). An overlap is never
+      // silent: the SUBTRACT path costs nothing but the FALLBACK path is a
+      // tier-2 degradation of real pixels, and which one fired is decided by
+      // page geometry that changes as the user scrolls.
+      static int s_overlap = 0;
+      const int n = s_overlap++;
+      if (n < 3 || (n % 300) == 0) {
+        LOG(ERROR) << "[DisplayXR] inline-3D OVERLAPPING tiles (browser#131): "
+                   << pairs << " pair(s), " << fallbacks
+                   << " needing the mono fallback — topmost-wins reduced the "
+                      "lower tile's weave rect (frames="
+                   << (n + 1) << ")" << detail;
+      }
+    }
+  }
+
