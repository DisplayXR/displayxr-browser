+        // left to weave, so leave the batch alone and let the caller route the
+        // whole tile to the recovery draw.
+        if (weave.IsEmpty()) {
+          return false;
+        }
+
 #if !BUILDFLAG(IS_ANDROID)
         // ---- (web#12, 0074 — PART 1) CPU READBACK FROM THE CLEAN CANVAS ----
         //
@@ -3964,13 +4144,20 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
             rb_pixels = rb_ganesh.data();
             rb_stride = row;
           }
+          // (browser#131) Upload only the rows this target still owns. The
