+    // path byte-identical: |weave_src_y| is 0, |weave| == |rect|, and every
+    // expression below reduces to the one it replaced. |rect| is deliberately
+    // NOT reduced — the scratch stays sized to and composed at the WHOLE tile,
+    // so the mono primitive still has a live, full-tile source for the rows
+    // this frame withholds.
+    const gfx::Rect weave = topmost_bands[t];
+    const int weave_src_y = weave.IsEmpty() ? 0 : weave.y() - rect.y();
     const SkiaOutputSurface::Inline3dLayerMailbox clean_sbs =
         canvas_mailbox_for(inline_3d_rects_[t].id, rect);
     const gpu::Mailbox clean_sbs_mailbox = clean_sbs.mailbox;
@@ -3306,6 +3465,17 @@ void SkiaOutputSurfaceImplOnGpu::WeaveCompositedSurface(SkSurface* output,
     // the same unchanged record; only a real copy, a rect change, a resize or a
     // target retirement moves it.
     auto keep_previous = [&]() -> bool {
+      // (browser#131) NEVER KEEP AN OVERLAPPING TILE. |batch_last_copied_|
+      // records "target P's pixels are at rect P", and where two tiles share
+      // input pixels that record can name a region the OTHER tile has since
+      // written — so a replay would re-weave the neighbour's content and log
+      // it as a clean keep. Topmost-wins makes the submitted rects disjoint
+      // going forward, but the record predates this frame and the band itself
+      // moves as the overlap does, so the honest answer for an overlapping
