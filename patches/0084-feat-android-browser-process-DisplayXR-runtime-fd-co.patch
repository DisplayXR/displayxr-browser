--- /dev/null
+++ b/components/displayxr/android/displayxr_runtime_connector_android.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/displayxr/android/displayxr_runtime_connector_android.h"
+
+#include "base/android/jni_android.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "content/public/browser/gpu_data_manager.h"
+#include "content/public/browser/gpu_data_manager_observer.h"
+
+// Must come after the other includes (jni_zero convention).
+#include "components/displayxr/android/jni_headers/DisplayXrRuntimeConnector_jni.h"
+
+namespace displayxr {
+
+namespace {
+
+// GPU-process restart handling (docs/android-port.md M2 step 4). Slot ownership
+// and the death link attribute to the CONNECTOR (this process), so a GPU crash
+// costs us nothing but the socket: we drop it here, and the next GPU launch's
+// GetAdditionalMappedFilesForChildProcess re-connects and hands over a fresh fd.
+// The adopting side is stateless about this — it just reads DXR_IPC_FD again.
+class GpuLossObserver : public content::GpuDataManagerObserver {
+ public:
+  GpuLossObserver() = default;
+  ~GpuLossObserver() override = default;
+
+  void OnGpuProcessCrashed() override {
+    LOG(WARNING) << "[DisplayXR] GPU process lost; dropping the adopted runtime "
+                    "socket so the next launch reconnects";
+    Java_DisplayXrRuntimeConnector_onAdopterLost(
+        base::android::AttachCurrentThread());
+  }
+};
+
+}  // namespace
+
+void WarmUpRuntimeConnection() {
+  Java_DisplayXrRuntimeConnector_warmUp(base::android::AttachCurrentThread());
+}
+
+base::ScopedFD TakeRuntimeIpcFdForChildProcess() {
+  const int fd = Java_DisplayXrRuntimeConnector_takeFdForChildProcess(
+      base::android::AttachCurrentThread());
+  if (fd < 0) {
+    return base::ScopedFD();
+  }
+  return base::ScopedFD(fd);
+}
+
+bool IsRuntimeConnected() {
+  return Java_DisplayXrRuntimeConnector_isConnected(
+      base::android::AttachCurrentThread());
+}
+
+void StartObservingGpuProcessForReconnect() {
+  static base::NoDestructor<GpuLossObserver> observer;
+  static bool added = false;
+  if (added) {
+    return;
+  }
+  added = true;
+  content::GpuDataManager::GetInstance()->AddObserver(observer.get());
+}
+
+}  // namespace displayxr
diff --git a/components/displayxr/android/displayxr_runtime_connector_android.h b/components/displayxr/android/displayxr_runtime_connector_android.h
