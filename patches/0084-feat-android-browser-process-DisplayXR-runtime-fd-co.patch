+# Copyright 2026 The Chromium Authors / DisplayXR
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# DisplayXR inline-3D on Android (runtime #1056, docs/android-port.md M2): the
+# browser-process runtime connector. The Java half performs the reflective
+# connect into the installed runtime apk; the C++ half is the JNI seam the
+# ContentBrowserClient uses to hand the resulting socket to the GPU process.
+
+import("//build/config/android/rules.gni")
+import("//third_party/jni_zero/jni_zero.gni")
+
+generate_jni("jni_headers") {
+  sources = [ "java/src/org/chromium/components/displayxr/DisplayXrRuntimeConnector.java" ]
+}
+
+android_library("java") {
+  sources = [ "java/src/org/chromium/components/displayxr/DisplayXrRuntimeConnector.java" ]
+  srcjar_deps = [ ":jni_headers" ]
+  deps = [
+    "//base:base_java",
+    "//build/android:build_java",
+    "//third_party/jni_zero:jni_zero_java",
+  ]
+}
+
+source_set("android") {
+  sources = [
+    "displayxr_runtime_connector_android.cc",
+    "displayxr_runtime_connector_android.h",
+  ]
+  deps = [
+    ":jni_headers",
+    "//base",
+    "//content/public/browser",
+  ]
+}
diff --git a/components/displayxr/android/displayxr_runtime_connector_android.cc b/components/displayxr/android/displayxr_runtime_connector_android.cc
new file mode 100644
