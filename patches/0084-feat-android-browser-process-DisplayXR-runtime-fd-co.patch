@@ -0,0 +1,40 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_DISPLAYXR_ANDROID_DISPLAYXR_RUNTIME_CONNECTOR_ANDROID_H_
+#define COMPONENTS_DISPLAYXR_ANDROID_DISPLAYXR_RUNTIME_CONNECTOR_ANDROID_H_
+
+#include "base/files/scoped_file.h"
+
+// Browser-process C++ face of DisplayXrRuntimeConnector.java (runtime #1056,
+// docs/android-port.md M2). The Java side does the reflective connect to the
+// installed runtime apk; this is only the thin JNI seam the ContentBrowserClient
+// and the browser-main hook call.
+//
+// Everything here is browser-process only, and everything is dormant unless
+// --enable-inline-3d is on the command line (checked by the callers, so a
+// vanilla build never reaches into the runtime package at all).
+
+namespace displayxr {
+
+// Start the ~300 ms runtime connect on a background thread. Idempotent.
+void WarmUpRuntimeConnection();
+
+// A fresh dup of the connected runtime socket, for handing to a child process
+// via PosixFileDescriptorInfo::Transfer. Invalid when the runtime is absent.
+// Called on the process-launcher thread; blocks for the connect if the warm-up
+// has not landed yet.
+base::ScopedFD TakeRuntimeIpcFdForChildProcess();
+
+// True once a runtime socket is held.
+bool IsRuntimeConnected();
+
+// Observe GPU-process loss so the next GPU launch gets a FRESH socket rather
+// than a dup of the one the dead process adopted. Idempotent; call once from
+// the browser-main hook.
+void StartObservingGpuProcessForReconnect();
+
+}  // namespace displayxr
+
+#endif  // COMPONENTS_DISPLAYXR_ANDROID_DISPLAYXR_RUNTIME_CONNECTOR_ANDROID_H_
diff --git a/components/displayxr/android/java/src/org/chromium/components/displayxr/DisplayXrRuntimeConnector.java b/components/displayxr/android/java/src/org/chromium/components/displayxr/DisplayXrRuntimeConnector.java
new file mode 100644
index 0000000000000..c9ab99ac9b2ac
--- /dev/null
+++ b/components/displayxr/android/java/src/org/chromium/components/displayxr/DisplayXrRuntimeConnector.java
@@ -0,0 +1,198 @@
+// Copyright 2026 The Chromium Authors / DisplayXR
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.components.displayxr;
+
+import android.content.Context;
+import android.os.ParcelFileDescriptor;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JNINamespace;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+
+/**
+ * Browser-process half of the DisplayXR runtime fd handoff (runtime #1056, docs/android-port.md
+ * M2). Modelled line-for-line on the reference client's RuntimeFdConnector.kt.
+ *
+ * <p>On Android the OpenXR session that owns the weave has to live in the GPU process
+ * (:privileged_process0), but connecting to the runtime service is a Java affair — it needs a
+ * Context, {@code <queries>} package visibility, cross-apk class loading and the right to
+ * bindService. All of that belongs to the browser process. So the browser connects once here and
+ * ships the resulting socket fd to the GPU process, which adopts it via DXR_IPC_FD and never binds
+ * anything itself.
+ *
+ * <p>Everything is REFLECTIVE on purpose: {@code org.freedesktop.monado.ipc.Client} lives in the
+ * installed runtime apk, not in ours.
+ *
+ * <p>Two lifetime rules from the spec, both load-bearing:
+ *
+ * <ul>
+ *   <li>The Client instance is RETAINED for the browser-process lifetime. It owns the
+ *       ServiceConnection, the satellite-slot claim and the slot death-link token; dropping it
+ *       unbinds the service and releases the slot out from under the adopter.
+ *   <li>What we hand out is always a {@code dup()}. SO_PEERCRED, slot ownership and the death link
+ *       all attribute to THIS process (the connector), not the adopter — which is exactly why a GPU
+ *       crash does not cost us the slot.
+ * </ul>
+ *
+ * <p>Budget 283-372 ms for a connect (measured on NP02J), so {@link #warmUp} runs it off the
+ * critical path; {@link #takeFdForChildProcess} only blocks if a child launches before the warm-up
+ * finished.
+ */
+@JNINamespace("displayxr")
+@NullMarked
+public class DisplayXrRuntimeConnector {
+    private static final String TAG = "DisplayXrRuntime";
+    private static final String CLIENT_CLASS = "org.freedesktop.monado.ipc.Client";
+
+    /**
+     * Non-zero, never dereferenced. Client(long nativePointer) has no native counterpart here — the
+     * ADOPTING process owns the native side — but NativeCounterpart rejects 0.
+     */
+    private static final long HANDOFF_SENTINEL = 1L;
+
+    private static final String[] RUNTIME_PACKAGES = {
+        "org.freedesktop.monado.openxr_runtime.out_of_process",
+        "org.freedesktop.monado.openxr_runtime.in_process",
+    };
+
+    private static final Object sLock = new Object();
+
+    /** The runtime's org.freedesktop.monado.ipc.Client. Retained; see the class comment. */
+    private static @Nullable Object sClient;
+
+    /** Our dup of the connected socket end. Every child launch gets a dup OF THIS. */
+    private static @Nullable ParcelFileDescriptor sSocket;
+
+    private static boolean sWarmUpPosted;
+
+    private DisplayXrRuntimeConnector() {}
+
+    /**
+     * Kick the (slow) connect off on a background thread. Idempotent; safe to call before the
+     * runtime is known to be installed.
+     */
+    @CalledByNative
+    private static void warmUp() {
+        synchronized (sLock) {
+            if (sWarmUpPosted) return;
+            sWarmUpPosted = true;
+        }
+        PostTask.postTask(TaskTraits.USER_BLOCKING_MAY_BLOCK, () -> ensureConnected());
+    }
+
+    /**
+     * Return a fresh dup of the connected runtime socket, detached so the native caller owns it (it
+     * goes straight into a PosixFileDescriptorInfo::Transfer). -1 when the runtime is not reachable.
+     *
+     * <p>Called on the process-launcher thread. Blocks for the connect if the warm-up has not landed
+     * yet — a bounded ~370 ms one-off, and far better than launching a GPU process that can never
+     * weave.
+     */
+    @CalledByNative
+    private static int takeFdForChildProcess() {
+        ParcelFileDescriptor socket = ensureConnected();
+        if (socket == null) return -1;
+        try {
+            return socket.dup().detachFd();
+        } catch (Exception e) {
+            Log.w(TAG, "dup for child process failed", e);
+            return -1;
+        }
+    }
+
+    @CalledByNative
+    private static boolean isConnected() {
+        synchronized (sLock) {
+            return sSocket != null;
+        }
+    }
+
+    /**
+     * The process that adopted the last fd is gone (GPU crash / restart).
+     *
+     * <p>Drops the socket but KEEPS the Client: slot ownership and the death link belong to this
+     * process, so the satellite slot survives. The next takeFdForChildProcess() performs a fresh
+     * blockingConnect (a new socketpair) on the retained Client, which is what the spec means by
+     * "reconnect = a new socketpair from the browser process and a fresh fd handoff; the slot never
+     * moves".
+     */
+    @CalledByNative
+    private static void onAdopterLost() {
+        synchronized (sLock) {
+            if (sSocket == null) return;
+            try {
+                sSocket.close();
+            } catch (Exception e) {
+                Log.w(TAG, "closing the stale runtime socket failed", e);
+            }
+            sSocket = null;
+        }
+        Log.i(TAG, "adopter lost; the next child launch will get a fresh socket");
+    }
+
+    private static @Nullable ParcelFileDescriptor ensureConnected() {
+        synchronized (sLock) {
+            if (sSocket != null) return sSocket;
+            Context appContext = ContextUtils.getApplicationContext();
+            for (String pkg : RUNTIME_PACKAGES) {
+                ParcelFileDescriptor socket;
+                try {
+                    socket = connectTo(appContext, pkg);
+                } catch (Exception e) {
+                    Log.w(TAG, "connect via " + pkg + " failed", e);
+                    continue;
+                }
+                if (socket != null) {
+                    sSocket = socket;
+                    Log.i(TAG, "connected via " + pkg + ", fd " + socket.getFd());
+                    return socket;
+                }
+            }
+            return null;
+        }
+    }
+
+    private static @Nullable ParcelFileDescriptor connectTo(Context appContext, String pkg)
+            throws Exception {
+        Object client = sClient;
+        if (client == null) {
+            // Cross-apk class load — the browser process's job, never the GPU process's.
+            Context runtimeContext =
+                    appContext.createPackageContext(
+                            pkg, Context.CONTEXT_INCLUDE_CODE | Context.CONTEXT_IGNORE_SECURITY);
+            Class<?> clientClass = runtimeContext.getClassLoader().loadClass(CLIENT_CLASS);
+            client = clientClass.getConstructor(Long.TYPE).newInstance(HANDOFF_SENTINEL);
+        }
+
+        Class<?> clientClass = client.getClass();
+        // The APPLICATION context, deliberately: Client.blockingConnect only attaches a MonadoView /
+        // SystemUiController when handed an Activity, and a present-owner must keep its own surface.
+        // The browser process has no relevant Activity anyway.
+        Method blockingConnect =
+                clientClass.getMethod("blockingConnect", Context.class, String.class);
+        Object result = blockingConnect.invoke(client, appContext, pkg);
+        if (!(result instanceof Integer) || (Integer) result < 0) return null;
+
+        // Client owns `fd`; take our own reference so the handoff and the Client lifetime are
+        // independent.
+        Field field = clientClass.getDeclaredField("fd");
+        field.setAccessible(true);
+        Object theirs = field.get(client);
+        if (!(theirs instanceof ParcelFileDescriptor)) return null;
+        ParcelFileDescriptor ours = ((ParcelFileDescriptor) theirs).dup();
+
+        sClient = client; // keep the slot claim + the binding alive
+        return ours;
+    }
+}
